  <description type="2">
   <narrative xml:lang="SV">Bidra till &#xf6;kad kunskap om skadat br&#xe4;nsle i k&#xe4;rnkraftverk</narrative>
   <narrative xml:lang="EN">Contribute to increased knowledge about damaged fuel in nuclear power plants</narrative>
