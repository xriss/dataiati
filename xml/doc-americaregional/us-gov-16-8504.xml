  <title>
   <narrative xml:lang="EN">Department of Commerce, National Institute of Standards and Technology (NIST): First Meeting of the World Trade Organization (WTO) Technical Barriers to Trade (TBT) Enquiry Points of the Western Hemisphere (Americas) WTO member countries</narrative>
  </title>
  <description type="1">
