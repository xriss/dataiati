   <indicator aggregation-status="1" ascending="0" measure="5">
    <title>
     <narrative xml:lang="EN">Legislation, policies and safeguard measures adopted and under implementation</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">Legislation, policies and safeguard measures adopted and under implementation in catchment management plans; PA management plans; and Island Environmental Management Plans (IEMPs, within Island Development Plans [IDPs]).</narrative>
