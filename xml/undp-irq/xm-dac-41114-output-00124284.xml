    <period>
     <period-start iso-date="2022-01-01"></period-start>
     <period-end iso-date="2022-12-31"></period-end>
     <target>
      <comment>
       <narrative xml:lang="EN">50, 000 people have access to safe and drinking water services and living in water resilient communities.</narrative>
      </comment>
     </target>
     <actual>
      <comment>
       <narrative xml:lang="EN">UNDP is working on rehabilitation of three water treatment plants in Basra to ensure clean drinking water for 850,000 people in three districts of Basra, including Al-Swafwan, Al-Shuiaba and Khor Al-Zubair. Al-Sawfan project completed by 57 %. Al-Shuiaba, completed by 54 % and Khor Al-Zubair project completed 60% of the works have been completed in 2022 and the project is expected to be completed by mid 2023.</narrative>
      </comment>
     </actual>
    </period>
