  <result type="2">
   <title>
    <narrative xml:lang="EN">Results achieved</narrative>
    <narrative xml:lang="FR">R&#xe9;sultats atteints</narrative>
   </title>
   <indicator measure="5">
    <title>
     <narrative xml:lang="EN">Results achieved</narrative>
     <narrative xml:lang="FR">R&#xe9;sultats atteints</narrative>
    </title>
    <description>
     <narrative xml:lang="FR">Parmi les r&#xe9;sultats obtenus jusqu&apos;en d&#xe9;cembre 2023 : 1) le projet a vaccin&#xe9; 205 millions d&#x2019;enfants suppl&#xe9;mentaires; 2) introduit 42 nouveaux programmes de vaccination; 3) sauv&#xe9; 3,7 millions de vies; 4) g&#xe9;n&#xe9;r&#xe9; 52 milliards de dollars am&#xe9;ricains d&#x2019;avantages &#xe9;conomiques.</narrative>
     <narrative xml:lang="EN">Results achieved as of December 2023 include: (1) the project vaccinated 205 million children; (2) introduced 42 new vaccine programs; (3) saved 3.7 million additional lives; and (4) produced US$52 billion in economic benefits.</narrative>
    </description>
   </indicator>
  </result>
