  <result aggregation-status="0" type="2">
   <title>
    <narrative xml:lang="EN">Project Outcome</narrative>
   </title>
   <description>
    <narrative xml:lang="EN">Capacity and operations of Nukualofa Port improved.</narrative>
   </description>
   <indicator measure="1">
    <title>
     <narrative xml:lang="EN">Indicator 1</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">Container throughput capacity increased to 45,000 TEUs (2018 baseline: 30,000) 
Progress/Status: All four mooring or berthing dolphins already constructed. Navigation markers and wave measuring device installed. The port was commissioned on 31 October 2025. Civil works, including new gate house, are expected to be completed by Q2 2026. 
Data Source: PAT annual reports 
Actual value:</narrative>
    </description>
    <baseline value="30000" year="2018"></baseline>
    <period>
     <period-start iso-date="2027-01-01"></period-start>
     <period-end iso-date="2027-12-31"></period-end>
     <target value="45000"></target>
    </period>
   </indicator>
   <indicator measure="5">
    <title>
     <narrative xml:lang="EN">Indicator 2</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">Maximum length of vessels calling at the port increased to 220 m (2020 baseline: 180 m) 
Progress/Status: Wharf 2 extension completed. The port was commissioned on 31 October 2025. Civil works, including new gate house, are expected to be completed by Q2 2026. 
Data Source: PAT annual reports 
Baseline value: 180 m</narrative>
    </description>
    <period>
     <period-start iso-date="2027-01-01"></period-start>
     <period-end iso-date="2027-12-31"></period-end>
    </period>
   </indicator>
  </result>
