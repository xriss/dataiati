   <narrative xml:lang="EN">International Development Law Organization (IDLO)</narrative>
  </reporting-org>
  <title>
   <narrative xml:lang="EN">Moldova: Commercial Mediation and Arbitration (Phase IV)</narrative>
  </title>
  <description type="1">
   <narrative xml:lang="EN">1) To assist the Government of Moldova with promoting and facilitating the use of commercial mediation on a national scale. 2) To assist the Government of Moldova and existing institutions in the field of arbitration with improving access to arbitration and raising the level of skills relevant for arbitration with the overall goal of making the use of ADR a business norm in Moldova.</narrative>
  </description>
  <description type="3">
   <narrative xml:lang="EN">Direct beneficiaries: Ministry of Justice, Mediation Council, Mediation Center, Chamber of Commerce and Industry, National Institute of Justice, Faculty of Law. Indirect beneficiaries: Moldovan judicial and business sectors.</narrative>
  </description>
  <description type="2">
   <narrative xml:lang="EN">The project aimed to improve the investment climate in Moldova by facilitating the use of commercial mediation and arbitration on a national scale and increase the use of Alternative Dispute Resolution (ADR) mechanisms offering a faster and more satisfying dispute resolution tool to people and to the entrepreneurial sector.</narrative>
  </description>
