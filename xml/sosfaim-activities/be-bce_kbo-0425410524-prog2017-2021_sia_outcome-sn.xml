  <document-link format="APPLICATION/PDF" url="https://aidstream.s3.us-west-2.amazonaws.com/documents/DGD-17-21_SIA_Partie-II_10-SN_vf-(03-2017)-20180202030248.pdf">
   <title>
    <narrative xml:lang="FR">Document de Programme S&#xe9;n&#xe9;gal</narrative>
   </title>
   <category code="A02"></category>
   <language code="FR"></language>
   <document-date iso-date="2017-03-01"></document-date>
