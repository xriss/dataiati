  <title>
   <narrative xml:lang="EN">Plan of the Alliance for Prosperity in the Northern Triangle: A Road Map</narrative>
   <narrative xml:lang="ES">Reformas anticorrupci&#xf3;n</narrative>
   <narrative xml:lang="ES">Reformas anticorrupci&#xf3;n</narrative>
