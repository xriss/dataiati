  <title>
   <narrative xml:lang="EN">Biodiversity and adaptation to climate change of central forest eco systems</narrative>
   <narrative xml:lang="DE">Biodiversit&#xe4;t und Anpassung von bewaldeten Schl&#xfc;ssel&#xf6;kosystemen an den Klimawandel</narrative>
