  <title>
   <narrative xml:lang="EN">Ghana - Accra-Tema Water Supply Rehabilitation</narrative>
   <narrative xml:lang="FR">Ghana - R&#xe9;habilitation du syst&#xe8;me d&apos;approvisionnement en eau d&apos;Accra-Tema</narrative>
  </title>
  <description type="1">
   <narrative xml:lang="EN">The project will increase the reliability of the water supply to the Accra-Tema Metropolitan Area (ATMA) and increase the water production from the existing 250,000 cubic metres/day to 300,000 cubic metres/day. The Project will also strengthen GWSC by providing training of staff and operational equipment.</narrative>
   <narrative xml:lang="FR"></narrative>
  </description>
