  <activity-date iso-date="2022-10-01" type="2">
   <narrative xml:lang="EN">The Centre formally began on 01/10/2022.</narrative>
  </activity-date>
  <activity-date iso-date="2027-09-30" type="3">
   <narrative xml:lang="EN">The Centre is currently funded for 5 years, so the current planned end date is 30/09/2027</narrative>
  </activity-date>
