  <result aggregation-status="0" type="1">
   <title>
    <narrative xml:lang="EN">By 2030, communities living in areas with frequented and re-current natural disasters have more resilient WASH infrastructure andcapacities to adopt mitigation measures to a changing climate and degrading environment (Climate, Environment and Energy)</narrative>
