  <result aggregation-status="1" type="1">
   <title>
    <narrative xml:lang="EN">Annual Output Results</narrative>
   </title>
   <indicator ascending="0" measure="5">
    <title>
     <narrative xml:lang="EN">Output Indicator</narrative>
    </title>
    <description>
     <narrative xml:lang="EN"># of insider mediators recruited and trained to facilitate peaceful conflict resolution (disaggregated by gender). 
# of gender-sensitive conflict analysis conducted.Overall .
# of community-based mechanisms established and facilitated by insider mediators.
# of local authorities, VCC, PUNOs sensitized and trained on gender- and conflict-sensitive approaches and social cohesion.
# of VCCs established/ reactivated and operational.
# of conflict- and gender-sensitive community resilience plans developed
# of selected priority interventions identified under the community resilience plans which have been implemented.
# of local authorities supported and able to implement priority interventions to improve service delivery.
# of DMTs reactivated to restore public service delivery
# of local authorities trained on planning and development
# of citizen monitoring mechanisms established</narrative>
    </description>
    <baseline year="2019">
     <comment>
      <narrative xml:lang="EN">8 DMTs reactiviated and 8 district recovery plans developed
213 VCCs established in the targeted communities
213 resilience plans developed 
321 compact initiative implemented
414 sel-help initiatives were implemented</narrative>
     </comment>
    </baseline>
    <period>
     <period-start iso-date="2021-01-01"></period-start>
     <period-end iso-date="2021-12-31"></period-end>
     <target>
      <comment>
       <narrative xml:lang="EN"># 4 gender-sensitive conflict analysis conducted 
# 31 conflict mitigating interventions implemented.</narrative>
      </comment>
     </target>
     <actual>
      <comment>
       <narrative xml:lang="EN"># 28 conflict mitigating interventions are implemented.
# 16 selected priority interventions have been identified under the community resilience plans which have been implemented
# 8 targeted local authorities are supported and able to revitalize service delivery by operationalizing recovery plans</narrative>
      </comment>
     </actual>
    </period>
    <period>
     <period-start iso-date="2022-01-01"></period-start>
     <period-end iso-date="2022-12-31"></period-end>
     <target>
      <comment>
       <narrative xml:lang="EN">10 selected priority interventions (compact initiatives) implemented at village level. 

5 of selected priority interventions identified under the community resilience plans which have been implemented (at sub-district level).</narrative>
      </comment>
     </target>
     <actual>
      <comment>
       <narrative xml:lang="EN">15 priority interventions (compact initiatives) implemented at village level. 

13 selected priority interventions identified under the community resilience plans are implemented at sub district level</narrative>
      </comment>
     </actual>
    </period>
    <period>
     <period-start iso-date="2020-01-01"></period-start>
     <period-end iso-date="2020-12-31"></period-end>
     <target>
      <comment>
       <narrative xml:lang="EN">1. 120 insider mediators would be identified and trained for conflict mediation and resolution
2. 4 conflict analysis reports would be produced 
3. 5 community based mechanism would be developed. 
4. 4 SDC would be established
5. 100 local authorities would be trained on social cohesion
6. 24 Resilience Plans would be developed
7. 179 self help and community initiatives would be implemented
8. 8 DMTs would be reactivated.
9. 200 local authorities officials would be trained on planning and budgeting.
10. 8 district recovery plans would be implemented.</narrative>
      </comment>
     </target>
     <actual>
      <comment>
       <narrative xml:lang="EN">Quarter 1 Results:
1. 23 insider mediators recruited and trained to facilitate peaceful conflict resolution (disaggregated by gender). 
2. 3 conflict- and gender-sensitive community resilience plans developed
3. 75 local authorities trained on planning and development
Quarter 2 Results:
1. 44 insider mediators recruited and trained to facilitate peaceful conflict resolution (disaggregated by gender). 
2. 4 conflict- and gender-sensitive community resilience plans developed
3. 20 selected priority interventions identified under the community resilience plans which have been implemented.
4. 01 DMTs reactivated to restore public service delivery
5. 75 local authorities trained on planning and development
6. 10 citizen monitoring mechanisms established
Quarter 3 Results:
1. 22 insider mediators recruited and trained to facilitate peaceful conflict resolution (disaggregated by gender).
2. 3 conflict and gender sensitive community resilience plans developed
3. 6 sub-district level priority interventions implemented.
4. 1 DMT was established.
5. 70 local authorities were trained on planning and budgeting.</narrative>
      </comment>
     </actual>
    </period>
   </indicator>
