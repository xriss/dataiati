  <result aggregation-status="1" type="1">
   <title>
    <narrative xml:lang="EN">Annual Output Results</narrative>
   </title>
   <indicator ascending="0" measure="5">
    <title>
     <narrative xml:lang="EN">Output Indicator</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">1.1: % of target communities with improved access to basic services, improved capacities and peace due to resilience planning and conflict mitigating interventions
1.2: % of targeted communities reporting reduction in frequency of conflicts
1.3: % of community institutions reported improvement in the capacity on gender sensitive resilience, resilience planning, conflict resolution and social cohesion</narrative>
    </description>
    <baseline year="2022">
     <comment>
      <narrative xml:lang="EN">1.1: 30% targeted communities with improved access to basic services, improved capacities
1.2: 56% targeted communities reporting reduction in frequency of conflicts
1.3: 30% targeted institutions reported improvement in the capacity on gender sensitive resilience, planning, conflict resolution and social cohesion</narrative>
     </comment>
    </baseline>
    <period>
     <period-start iso-date="2022-01-01"></period-start>
     <period-end iso-date="2022-12-31"></period-end>
     <target>
      <comment>
       <narrative xml:lang="EN">- 40 of community-based institutions established / reactivated by 2022
- 200 of IPs, SDCs and LC trained on CRP, planning, gender and local conflicts by 2022
- 25 of community resilience plans developed (and operationalized) at sub-district level by 2022</narrative>
      </comment>
     </target>
     <actual>
      <comment>
       <narrative xml:lang="EN">- 15 community-based institutions were not established and 10 of small-scale initiatives not achieved because implementation started late after the inception phase of ERRYIII which was from March till August 2022. Therefore, budget revision was made to implement the target by 2023
 - 2 conflict analysis and 75 of community representative and institutions training were not conducted because of the late implementation due to time needed for the inception of f ERRYIII. Therefore, budget revision was made, and implementation will be in 2023
- 10 community dialogues were not facilitated, and 8 conflict resolution initiatives not implemented because of the same abov-mentioned reason. Therefore, budget revision was made, and implementation will be in 2023</narrative>
      </comment>
     </actual>
    </period>
   </indicator>
  </result>
