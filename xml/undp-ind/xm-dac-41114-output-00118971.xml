  <result aggregation-status="1" type="1">
   <title>
    <narrative xml:lang="EN">Annual Output Results</narrative>
   </title>
   <indicator ascending="0" measure="5">
    <title>
     <narrative xml:lang="EN">Output Indicator</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">PMU established and 12 consultants hired under the PMU</narrative>
    </description>
    <baseline year="2019">
     <comment>
      <narrative xml:lang="EN">0</narrative>
     </comment>
    </baseline>
    <period>
     <period-start iso-date="2022-01-01"></period-start>
     <period-end iso-date="2022-12-31"></period-end>
     <target>
      <comment>
       <narrative xml:lang="EN">1. Institutional Strengthening of the Department of skill development and employment to convert selected 24 Industrial Training Institutes (ITI) into model ITIs.
2. Capacity Building for new and existing staff of Department of Skill Development and Employment in order to enhance their capacities in delivering training courses in relevant fields
3. Strengthening monitoring and evaluation mechanism under Uttarakhand Workforce Development Project (UKWPD) through converting ITIs into model ITIs</narrative>
      </comment>
     </target>
     <actual>
      <comment>
       <narrative xml:lang="EN">1. Exposure visit planned to facilitate learning on the best practices across skill development sector, for UKSDM officials in Orissa. 
2. Organised a capacity building workshop for staff on financial management by Dale Carnegie. 
3. Organised a workshop on Gender Equality and Social Inclusion of 23 principals and staff of ITIs.</narrative>
      </comment>
     </actual>
    </period>
    <period>
     <period-start iso-date="2021-01-01"></period-start>
     <period-end iso-date="2021-12-31"></period-end>
     <target>
      <comment>
       <narrative xml:lang="EN">1. Institutional Strengthening of the Department of skill development and employment
2. Capacity Building of new and existing staff and, knowledge management. New and existing staff of Department of Skill Development and Employment have enhanced capacites on delivering training courses in various fields of Skill Development.</narrative>
      </comment>
     </target>
     <actual>
      <comment>
       <narrative xml:lang="EN">1. Multi-stakeholder consultation workshop at state level with ITI Principals / other think tanks and consultancies, in the presence of Secretary Skills
2. Formation of SPIU by bringing in 10 domain experts under UKWDP project to strengthen 24 model ITIs.</narrative>
      </comment>
     </actual>
    </period>
    <period>
     <period-start iso-date="2020-01-01"></period-start>
     <period-end iso-date="2020-12-31"></period-end>
     <target>
      <comment>
       <narrative xml:lang="EN">1. Project Managemnt Unit (PMU) of Uttrakhand Workforce Development Project to be establised and fully functional.
2. MIS portal to be developed and housed within the Department of Skills Development and Employment, Govt. of Uttarakhand.
3. The officials and state and district level to have enhanced capacities to deliver trainings on skill development.</narrative>
      </comment>
     </target>
     <actual>
      <comment>
       <narrative xml:lang="EN">1. PMU established and fully functional</narrative>
      </comment>
     </actual>
    </period>
   </indicator>
