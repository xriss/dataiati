   <indicator ascending="0" measure="5">
    <title>
     <narrative xml:lang="EN">Output Indicator</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">Number of scalable initiatives incorporating improved management of ozone depleting substances, chemicals and/or wastes</narrative>
    </description>
    <baseline year="2021">
     <comment>
      <narrative xml:lang="EN">2</narrative>
     </comment>
    </baseline>
    <period>
     <period-start iso-date="2021-01-01"></period-start>
     <period-end iso-date="2021-12-31"></period-end>
     <target>
      <comment>
       <narrative xml:lang="EN">4 (Total number of scalable initiatives for improved management of ozone depleting substances)</narrative>
      </comment>
     </target>
     <actual>
      <comment>
       <narrative xml:lang="EN">Development of HPMP Stage III plan and Submission to MLF for its consideration and approval. The HPMP Stage-III would be the last of the HPMPs programme, to be implemented from 2023 to 2030 during which India will have to achieve the 2025 and 2030 compliance targets i.e., 67.5% and 97.5% reduction from the baseline respectively, as per the accelerated phase out schedule of the Montreal Protocol for HCFCs.</narrative>
      </comment>
     </actual>
    </period>
    <period>
     <period-start iso-date="2022-01-01"></period-start>
     <period-end iso-date="2022-12-31"></period-end>
     <target>
      <comment>
       <narrative xml:lang="EN">Preparation of sector-specific strategy and plan for HCFC phase-out management program Stage-III, its submission to MLF secretariat and approval</narrative>
      </comment>
     </target>
     <actual>
      <comment>
       <narrative xml:lang="EN">Stage III of HPMP of India was timely prepared and submitted to MLF secretariat in Aug2022. HPMP Stage-III proposal of India was approved during the 91st meeting of Executive Committee of the Multilateral Fund for US$25.1 million with UNDP components of US$14.84 million.</narrative>
      </comment>
     </actual>
    </period>
   </indicator>
