   <indicator aggregation-status="1" ascending="0" measure="5">
    <title>
     <narrative xml:lang="EN">NDC, Adaptation and FTC reporting</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">Progress in reporting on NDC implementation, climate change impacts and adaptation, and support needed and received in compliance with MPG requirements.</narrative>
    </description>
    <baseline year="2025">
     <comment>
      <narrative xml:lang="EN">BTR1, Previous NC, BUR submitted to the UNFCCC</narrative>
     </comment>
    </baseline>
    <period>
     <period-start iso-date="2026-01-01"></period-start>
     <period-end iso-date="2026-12-31"></period-end>
     <target>
      <comment>
       <narrative xml:lang="EN">Information on the status of NDC implementation, climate change impacts and adaptation and support needed and received is compiled up to 2024 as part of the BTR2 in line with MPG requirements and by using the common reporting tables and tabular formats of Decision 5/CMA.3, while allowing for flexibility provisions for developing countries that need it in light of their capacities.</narrative>
      </comment>
     </target>
    </period>
   </indicator>
