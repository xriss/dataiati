  <title>
   <narrative xml:lang="EN">SHO - Earthquake Response Syria / Turkey</narrative>
  </title>
  <description type="1">
   <narrative xml:lang="EN">An earthquake hit the southern part of Turkiye and the nothern part of Syria on the 6th of February.</narrative>
  </description>
  <description type="3">
   <narrative xml:lang="EN">Anybody affected by the earthquake, with specific focus on marginalised people and underserved areas.</narrative>
  </description>
  <description type="2">
   <narrative xml:lang="EN">provide lifesaving emergency support as well as early recovery relief</narrative>
  </description>
