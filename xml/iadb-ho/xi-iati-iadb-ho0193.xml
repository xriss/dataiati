  <title>
   <narrative xml:lang="ES">Apoyo a Comunidades Indgenas y Negras</narrative>
   <narrative xml:lang="EN">Indigenous and Black Communities Support</narrative>
  </title>
  <description type="1">
   <narrative xml:lang="EN">The general objective of the program is to improve the conditions for the development of infrastructure investments in the black and indigenous communities in Honduras. The specific objectives are to build infrastructure works using the etno-engineering model and to promote the social and gender equity.</narrative>
   <narrative xml:lang="ES"></narrative>
  </description>
