  <title>
   <narrative xml:lang="SV">Org. f&#xF6;r samh&#xE4;llsvetenskapligt forskning i &#xF6;stra  och s&#xF6;dra Afrika (OSSREA)</narrative>
   <narrative xml:lang="EN">Org.for Soc. Sci. Research in Eastern and SouthernAfrica (OSSREA) 2010-2013</narrative>
