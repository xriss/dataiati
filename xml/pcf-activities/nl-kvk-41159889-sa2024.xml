  <activity-date iso-date="2024-09-06" type="4">
   <narrative xml:lang="EN">The 100 Prince Claus Seed Award recipients were announced on 6 September 2024, to coincide with the anniversary of the Prince Claus Fund&apos;s founding.</narrative>
  </activity-date>
  <activity-date iso-date="2023-12-12" type="2">
