     <period-end iso-date="2026-12-31"></period-end>
     <target value="23"></target>
    </period>
   </indicator>
   <indicator aggregation-status="1" ascending="0" measure="2">
    <title>
     <narrative xml:lang="ES">Frecuencia con la que las personas han le&#xed;do, escuchado noticias falsas a trav&#xe9;s de los medios de comunicaci&#xf3;n o las redes sociales</narrative>
    </title>
    <description>
     <narrative xml:lang="ES">El indicador mide la frecuencia con la que las personas perciben haber estado expuestas a noticias falsas en medios de comunicaci&#xf3;n tradicionales y plataformas digitales, como redes sociales. Este indicador eval&#xfa;a la prevalencia de la desinformaci&#xf3;n en el entorno medi&#xe1;tico y su impacto potencial en la percepci&#xf3;n p&#xfa;blica, especialmente en contextos preelectorales.</narrative>
    </description>
    <baseline value="39" year="2024"></baseline>
    <period>
