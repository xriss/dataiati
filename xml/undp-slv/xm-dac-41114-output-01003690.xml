     <actual value="39"></actual>
    </period>
    <period>
     <period-start iso-date="2026-01-01"></period-start>
     <period-end iso-date="2026-12-31"></period-end>
     <target value="39"></target>
    </period>
   </indicator>
   <indicator aggregation-status="1" ascending="0" measure="2">
    <title>
     <narrative xml:lang="ES">Percepci&#xf3;n de circulaci&#xf3;n de informaci&#xf3;n falsa en Prensa escrita</narrative>
    </title>
    <description>
     <narrative xml:lang="ES">El indicador mide la percepci&#xf3;n de la poblaci&#xf3;n respecto a la frecuencia y magnitud con la que consideran que circula informaci&#xf3;n falsa en la prensa escrita. Este indicador busca reflejar los niveles de confianza y credibilidad que los ciudadanos asignan a este medio de comunicaci&#xf3;n, as&#xed; como identificar tendencias de desinformaci&#xf3;n que puedan impactar la opini&#xf3;n p&#xfa;blica.</narrative>
    </description>
    <baseline value="39" year="2024"></baseline>
