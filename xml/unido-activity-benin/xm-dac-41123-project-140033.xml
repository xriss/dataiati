   <narrative xml:lang="EN">United Nations Industrial Development Organization</narrative>
  </reporting-org>
  <title>
   <narrative xml:lang="EN">Technical Assistance in Establishing a Biomass Gasification Technology Resource Center in Songhai Centre Port-Novo, Benin</narrative>
  </title>
  <description type="1">
   <narrative xml:lang="EN">The aims of the project is to scale-up utilization of biomass gasification technology for increasing access to clean energy in Sub-S aharan Africa. This is a follow-up to the technical cooperation assistance provided by UNIDO Centre for South-South Industrial Cooperation (UCSSIC # India), where a 25kW biomass gasification power demonstration project was recently commissioned in Songhai Centre, Porto-Novo,Benin. Subsequently, a request dated 28 June 2013, has been received to scale up the dissemination of Biomass Gasification Technology through establishing a Knowledge and Technology Centre for Biomass Gasification for Sub Saharan Africa in Sonhai Centre Porto-Novo, Benin (preparatory assistance)  - Related to Item 140032 (pipeline)</narrative>
  </description>
  <participating-org role="1">
   <narrative xml:lang="EN">Special Resources for Africa</narrative>
  </participating-org>
