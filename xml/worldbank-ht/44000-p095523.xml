  <conditions attached="1">
   <condition type="2">
    <narrative xml:lang="EN">MEF shall furnish to IDA, not later than 60 days prior to the end of each FY a projection of monthly proceeds from taxes earmarkedfor road maintenance for next FY</narrative>
   </condition>
   <condition type="2">
    <narrative xml:lang="EN">MEF shall furnish to IDA, not later than 90 days after the end of FY, documentary evidence that all proceeds from taxes earmarkedfor road maintenance have been transferred to FER on monthly basis</narrative>
   </condition>
   <condition type="2">
    <narrative xml:lang="EN">MTPTC shall furnish to IDA a technical assessment of the civil works for roads completed under the Project as well as a forecastofmaintenance needs for next 5 years after closing</narrative>
   </condition>
   <condition type="2">
    <narrative xml:lang="EN">MTPTC shall furnish to IDA the list of completed civil works, including those carried out on any road segment financed under theProject</narrative>
   </condition>
   <condition type="2">
    <narrative xml:lang="EN">MTPTC shall furnish to IDA the published list of roads whose maintenance is the responsibility of FER</narrative>
   </condition>
   <condition type="2">
    <narrative xml:lang="EN">MTPTC shall furnish to IDA, not later than the end of each FY, the maintenance program of the next FY</narrative>
   </condition>
  </conditions>
