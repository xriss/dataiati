  <title>
   <narrative xml:lang="EN">International Urban and Regional Cooperation (IURC): EU- Asia &amp; Australasia</narrative>
  </title>
  <description type="1">
   <narrative xml:lang="EN">&lt;p class=&quot;ql-align-justify&quot;&gt;&lt;span style=&quot;color: black;&quot;&gt;To lead and develop a form of decentralised international urban and regional cooperation for sustainable urban development and regional innovation in key partner countries, regions and territories of Asia and Australasia, in line with the external dimension of the Urban Agenda for the EU, the EU Green Deal, the Paris Climate Agreement, and the UN New Urban Agenda.&lt;/span&gt;&lt;/p&gt;</narrative>
  </description>
