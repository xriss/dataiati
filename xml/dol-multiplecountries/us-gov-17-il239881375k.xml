  <title>
   <narrative xml:lang="EN">Educafuturo: Project to Combat Child Labor Among Vulnerable Populations in Ecuador and Panama by Providing Direct Education and Livelihood Services</narrative>
  </title>
  <description type="1">
   <narrative xml:lang="EN">To improve educational outcomes for child and adolescents involved in child labor; and improve family income so that households do not need to rely on the work of children for survival.</narrative>
  </description>
