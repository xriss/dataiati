  <title>
   <narrative xml:lang="EN">Building Climate Conflict Resilient Communities</narrative>
  </title>
  <description type="1">
   <narrative xml:lang="EN">To establish community-based systems to bring herders, farmers, women, youth, and government and security actors together to anticipate climate-related conflict drivers and proactively prevent farmer-herder conflict along the Niger-Benin border.</narrative>
  </description>
