    <baseline iso-date="2006-01-01" value="8000.00" year="2006">
     <comment>
      <narrative xml:lang="EN">Production capacity at Al Karkh was excluded as it improved in quality, not quanitity.</narrative>
     </comment>
    </baseline>
    <period>
     <period-start iso-date="2006-01-01"></period-start>
     <period-end iso-date="2013-06-30"></period-end>
     <target value="19000.00"></target>
     <actual value="19000.00">
      <comment>
       <narrative xml:lang="EN">Production at Abu Nuwas increased from 8,000 m3/hr to 19,000 m3/hr (raw water).Data from Shark Dijla to be provided by PMT</narrative>
      </comment>
     </actual>
    </period>
   </indicator>
  </result>
