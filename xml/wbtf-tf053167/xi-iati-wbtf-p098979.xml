   <indicator ascending="1" measure="5">
    <title>
     <narrative xml:lang="EN">PRS priorities are integrated into the budget and PRS activities are implemented</narrative>
    </title>
    <baseline iso-date="2006-07-24" value="No" year="2006">
     <comment>
      <narrative xml:lang="EN"></narrative>
     </comment>
