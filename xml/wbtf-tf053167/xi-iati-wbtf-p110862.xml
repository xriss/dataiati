  <result aggregation-status="0" type="1">
   <title>
    <narrative xml:lang="EN">Intermediate Results Indicator</narrative>
   </title>
   <indicator ascending="1" measure="5">
    <title>
     <narrative xml:lang="EN">Component 1 - New Budget Instructions approved and guidelines ready</narrative>
    </title>
    <baseline iso-date="2009-06-30" value="No" year="2009">
     <comment>
      <narrative xml:lang="EN">Budget instructions have been fragmented and not sufficiently clear, and framework for expenditure &apos;ceilings&apos; not in use. As aresult, budget not adhered to.</narrative>
     </comment>
    </baseline>
    <period>
     <period-start iso-date="2009-06-30"></period-start>
     <period-end iso-date="2013-08-31"></period-end>
     <target value="Yes">
      <comment>
       <narrative xml:lang="EN">Budget calendar adhered to. 50% improvement in compliance with ministry/agency budget requests (based on realism, timeliness andcompleteness of submission, etc.)</narrative>
      </comment>
     </target>
     <actual value="No">
      <comment>
       <narrative xml:lang="EN">The consultancy contract with e.Gen was terminated due to a contractual dispute. Hence the outcome could not be delivered.</narrative>
      </comment>
     </actual>
    </period>
   </indicator>
  </result>
