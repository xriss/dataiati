  <result aggregation-status="1" type="1">
   <title>
    <narrative xml:lang="FR">Annual Output Results</narrative>
   </title>
   <indicator aggregation-status="1" ascending="0" measure="5">
    <title>
     <narrative xml:lang="FR">&quot;Percentage increase in the number of beneficiaries of social protection programmes in Guinea Bissau and level of government support for social protection policies</narrative>
    </title>
    <description>
     <narrative xml:lang="FR">This indicator measures the progress made in increasing the coverage of social protection programmes and the level of support from the government  in order to reduce poverty and vulnerability among the population in Guinea Bissau. It helps to determine the effectiveness of social protection policies and practices, as well as the commitment of the government to facilitate access to social services.
The data should be disaggregated by the type of programme that UNDP supported with the goverment (cash transfers, food assistance, health care, etc.)</narrative>
    </description>
    <baseline year="2022">
     <comment>
      <narrative xml:lang="FR">30%</narrative>
     </comment>
    </baseline>
    <period>
     <period-start iso-date="2024-01-01"></period-start>
     <period-end iso-date="2024-12-31"></period-end>
     <target>
      <comment>
       <narrative xml:lang="FR">100%</narrative>
      </comment>
     </target>
     <actual>
      <comment>
       <narrative xml:lang="FR">60%</narrative>
      </comment>
     </actual>
    </period>
   </indicator>
  </result>
