  <result aggregation-status="0" type="2">
   <title>
    <narrative xml:lang="EN">Project Outcome</narrative>
   </title>
   <description>
    <narrative xml:lang="EN">A growing, resilient, and efficient financial system</narrative>
   </description>
   <indicator measure="1">
    <title>
     <narrative xml:lang="EN">Indicator 4</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">Increased number of qualified Kampuchea Institute of Certified Public Accountants and Auditors members by 2011  (10 in 2006) 
Data Source: Reports from the National Accounting Council and Kampuchea Institute of Certified Public Accountants and Auditors</narrative>
    </description>
    <baseline value="10" year="2006"></baseline>
   </indicator>
   <indicator measure="2">
    <title>
     <narrative xml:lang="EN">Indicator 2</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">Ratio of nonperforming loans to total loans of banks maintained below 10.0% (9.8% in 2006) 
Data Source: Published audited reports of banks, MFIs, and insurance firms</narrative>
    </description>
    <baseline value="10" year="2006"></baseline>
   </indicator>
   <indicator measure="2">
    <title>
     <narrative xml:lang="EN">Indicator 1</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">All banks and MFIs meet minimum capital adequacy requirements set by regulatory authorities 
Data Source: Economic reports and statistics published by regulatory authorities and other international development agencies</narrative>
    </description>
    <baseline value="15" year="2006"></baseline>
   </indicator>
   <indicator measure="2">
    <title>
     <narrative xml:lang="EN">Indicator 3</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">Access to credit by the total population to reach 6% by 2010 (3% in 2006) 
Data Source: Progress reports from NBC</narrative>
    </description>
    <baseline value="3" year="2006"></baseline>
   </indicator>
  </result>
  <result aggregation-status="0" type="1">
   <title>
    <narrative xml:lang="EN">Project Output/s</narrative>
   </title>
   <description>
    <narrative xml:lang="EN">Output/s as listed by the project staff.</narrative>
   </description>
   <indicator measure="5">
    <title>
     <narrative xml:lang="EN">Output 1  Indicator 1</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">Output: 1.  Improved confidence and financial intermediation.
Modernized payments, clearance, and settlement system (PCSS) 
Indicator: PCSS upgraded, including standardized checks and a more efficient check clearing system by 2011 
Data Source: Reports of NBC: coordinated payment system working group including banks</narrative>
    </description>
   </indicator>
   <indicator measure="5">
    <title>
     <narrative xml:lang="EN">Output 2  Indicator 1</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">Output: 2.  Maintain stability in the finance sector.
Strengthened bank supervision capacity and measures adopted to sustain financial stability 
Indicator: Trained staff to monitor implementation of Basel I requirements and undertake on-site inspection of banks once a year 
Data Source: NBC report on assessment of capacity building needs</narrative>
    </description>
   </indicator>
   <indicator measure="5">
    <title>
     <narrative xml:lang="EN">Output 3  Indicator 1</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">Output: 3.  Promote good governance.
International initiatives on anti-money laundering and combating the financing of terrorism promoted 
Indicator: Functioning CAFIU with at least 20 suspicious transactions reports processed by 2010 
Data Source: Official copy of adopted anti-money-laundering prakas and reports from the CAFIU</narrative>
    </description>
   </indicator>
   <indicator measure="5">
    <title>
     <narrative xml:lang="EN">Output 4  Indicator 1</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">Output: 4.  Enhance efficiency in the finance sector.
Key operating functions of NBC fully computerized and integrated 
Indicator: NBC operating an integrated management information system by 2010 
Data Source: Final report confirming successful installation, testing of software systems, training of staff on use of application</narrative>
    </description>
   </indicator>
  </result>
