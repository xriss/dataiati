   <indicator measure="1">
    <title>
     <narrative xml:lang="EN">Output 1  Indicator 6</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">Output: 1. Rural infrastructure is improved 
Indicator: - 230 km of rural access roads are rehabilitated. 
Progress/Status: Construction works for 54 sub-projects to rehabilitate 205.91 km of roads have been completed, which is equivalent to 90% of the target of 230 km. Out of the 205.91 km, 84.7 km are road maintenance. 
Data Source: PPMS and Progress Reports 
Actual value:</narrative>
    </description>
    <baseline value="0" year="2011"></baseline>
    <period>
     <period-start iso-date="2015-01-01"></period-start>
     <period-end iso-date="2015-12-31"></period-end>
     <target value="230"></target>
    </period>
   </indicator>
   <indicator measure="1">
    <title>
     <narrative xml:lang="EN">Output 1  Indicator 3</narrative>
    </title>
    <description>
