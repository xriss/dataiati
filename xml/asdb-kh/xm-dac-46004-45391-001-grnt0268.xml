  <result aggregation-status="0" type="2">
   <title>
    <narrative xml:lang="EN">Project Outcome</narrative>
   </title>
   <description>
    <narrative xml:lang="EN">Expected outcome is fill the gap of insufficient rice seeds and provide flood affected communities with immediate works.</narrative>
   </description>
   <indicator measure="1">
    <title>
     <narrative xml:lang="EN">Indicator 1</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">Affected communities in targeted areas received rice seeds 
Progress/Status: The contract for supply/delivery of pre-wet season 2012 of IR66 rice seeds of 583.86 tons amounting to $0.39 million was signed 9 March 2012 and 12,071 flood affected households were reported to benefit from the subsidized seed sales. 
Data Source: Government&amp;apos;s report</narrative>
    </description>
    <baseline value="0" year="2011"></baseline>
    <period>
     <period-start iso-date="2012-01-01"></period-start>
     <period-end iso-date="2012-12-31"></period-end>
    </period>
   </indicator>
   <indicator measure="5">
    <title>
     <narrative xml:lang="EN">Indicator 2</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">Numbers of damaged canals repaired 
Progress/Status: 35 small scale flood damaged canals, with 17.89 km in length and amounting to $0.29 million, were rehabilitated/repaired. 
Data Source: Government&amp;apos;s report 
Base year: 2011 
Baseline value: Y</narrative>
    </description>
    <period>
     <period-start iso-date="2012-01-01"></period-start>
     <period-end iso-date="2012-12-31"></period-end>
    </period>
   </indicator>
   <indicator measure="5">
    <title>
