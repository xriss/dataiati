  <result type="2">
   <title>
    <narrative xml:lang="EN">DACs are more (re)integrated through improved access to basic services and HLP rights and participation in cohesion activity</narrative>
   </title>
   <description>
    <narrative xml:lang="EN">This outcomes focusses are leveraging DAC forum milestones through delivery of basic social services as per the priorities in the community action plans. This entails provision of primary health care services, water, hygiene and sanitation, basic primary education and guaranteeing land tenure security for IDPs; plus ensuring their active engagement in peace building initiatives in the displacement affected communities.</narrative>
   </description>
   <indicator ascending="0" measure="2">
    <title>
     <narrative xml:lang="EN"># of individuals from DAC benefiting from improved basic services resulting from implemented community action plans and updates</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">These are individuals in displacement affected communities who are benefiting from a wide range of basic social services like primary health care, improved water supply and access, plus hygiene and sanitation including</narrative>
    </description>
    <period>
     <period-start iso-date="2019-04-01"></period-start>
     <period-end iso-date="2020-03-31"></period-end>
    </period>
   </indicator>
