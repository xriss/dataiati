   <title>
    <narrative xml:lang="EN">DAC target population have increased self-reliance through inclusive economic opportunities</narrative>
   </title>
   <description>
    <narrative xml:lang="EN">These are beneficiaries of livelihood interventions : SHGs, L2E, SMEs and TVETs plus those involved in CfW initiatives in IDP camps</narrative>
   </description>
   <indicator ascending="0" measure="2">
    <title>
     <narrative xml:lang="EN">Increased economic opportunities &amp; access to finance are provided to DACs</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">Households benefiting from VSLAs / Self-help groups, business  skills &amp; entrepreneurship trainings plus short term employment like CfW</narrative>
    </description>
    <period>
     <period-start iso-date="2019-04-01"></period-start>
     <period-end iso-date="2020-03-31"></period-end>
    </period>
   </indicator>
