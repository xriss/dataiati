   <narrative xml:lang="EN">EAS- 2nd congress-Re-invisioning Higher edc &amp; rese</narrative>
   <narrative xml:lang="SV">EAS- 2nd kongress-Re-invisioning H&#xf6;gre utbildning</narrative>
