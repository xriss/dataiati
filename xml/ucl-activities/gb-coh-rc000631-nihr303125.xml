  <iati-identifier>GB-COH-RC000631-NIHR303125</iati-identifier>
  <reporting-org ref="GB-COH-RC000631" type="80">
   <narrative xml:lang="EN">University College London</narrative>
  </reporting-org>
  <title>
   <narrative xml:lang="EN">Mitigating Chronic Respiratory Disease through the lens of Multi-Morbidity</narrative>
  </title>
  <description type="2">
   <narrative xml:lang="EN">MARES-1: To evaluate the discriminative accuracy of the COLA-6 questionnaire in identifying Brazilian individuals with chronic respiratory disease (CRD) who attend primary health care (PHC) services for the treatment of other non-communicable diseases (NCD).MARES-2: To assess the feasibility of implementing the COLA-6 questionnaire in PHC settings for NCDscare in Brazil by primary care professionals.MARES-3: To investigate how individuals with NCDs who use PHC services, identified as havingCRDs or as being at high risk for CRDs, access further diagnostic and treatment services in Brazil.</narrative>
  </description>
  <description type="3">
   <narrative xml:lang="EN">The study will include two main groups of participants.1. Individuals with one or more non-communicable diseases (NCDs) who attend primary healthcare (PHC) services.2. Healthcare professionals working in these settings, providing care to these individuals.</narrative>
  </description>
  <description type="1">
   <narrative xml:lang="EN">This study represents an equitable partnership between University College London (UCL), United Kingdom, and the Federal University of S&#xe3;o Carlos (UFSCar), Brazil. The study is called MARES &#x2013; Multimorbidity Approach for REspiratory Solutions and is funded by UK NIHR.</narrative>
  </description>
  <participating-org activity-id="NIHR303125" crs-channel-code="10000" role="4" type="15">
