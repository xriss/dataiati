  <recipient-country code="BR" percentage="100">
   <narrative xml:lang="EN">The project is an equitable partnership between UFSCar (Brazil) and UCL (UK).</narrative>
  </recipient-country>
  <sector code="12182" percentage="20" vocabulary="1">
   <narrative xml:lang="EN">A key component of this study is medical research aimed at understanding and addressing multimorbidity in individuals with non-communicable diseases (NCDs) within primary healthcare settings. This includes data collection, statistical analysis, and the development of evidence-basedstrategies to improve NCD management. The research findings will contribute to scientific literature, inform healthcare policies, and support the implementation of effective interventions for multimorbidity care.</narrative>
  </sector>
  <sector code="12382" percentage="70" vocabulary="1">
   <narrative xml:lang="EN">This study focuses on improving the identification, management, and care pathways for individualswith chronic respiratory diseases (CRDs) and NCDs within primary healthcare (PHC) settings in Brazil.</narrative>
  </sector>
  <sector code="12220" percentage="10" vocabulary="1">
   <narrative xml:lang="EN">This study will be conducted in Primary Health Care (PHC) services, including Basic Health units (BHUs) and Family Health Units (FHUs), located in the municipalities of S&#xe3;o Carlos and S&#xe3;o Paulo, both in the state of S&#xe3;o Paulo/Brazil.</narrative>
  </sector>
