  <reporting-org ref="XM-DAC-46004" type="40">
   <narrative xml:lang="EN">Asian Development Bank</narrative>
  </reporting-org>
  <title>
   <narrative xml:lang="EN">Integrated Urban Flood Management for the Chennai-Kosasthalaiyar Basin Project</narrative>
  </title>
  <description>
   <narrative xml:lang="EN">The project will strengthen climate and disaster resilience in the Chennai-Kosasthalaiyar River basin. It will reduce the exposure of 1.9 million people to seasonal flooding by (i) improving climate-resilient urban flood protection infrastructure; (ii) enhancing urban flood preparedness of the Greater Chennai Corporation (GCC), the civic body that governs the city of Chennai, and project communities; and (iii) establishing measures for sustaining the operation and maintenance (O&amp;M) of the stormwater drainage system in the GCC.</narrative>
  </description>
