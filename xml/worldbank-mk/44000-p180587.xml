   <title>
    <narrative xml:lang="EN">Intermediate Results Indicator</narrative>
   </title>
   <indicator ascending="1" measure="5">
    <title>
     <narrative xml:lang="EN">Central Disability Assessment Unit established</narrative>
    </title>
    <baseline iso-date="2022-11-26" value="No" year="2022">
     <comment>
      <narrative xml:lang="EN"></narrative>
     </comment>
    </baseline>
    <period>
     <period-start iso-date="2022-11-26"></period-start>
     <period-end iso-date="2024-12-13"></period-end>
     <target value="Yes">
      <comment>
       <narrative xml:lang="EN">Partially achieved. In 2024, the CDCCU structure was designed, and technical specifications for business processes were prepared. The premises for the CDCCU have also been identified. The systematization act necessary for hiring CDCCU staff is under the government&apos;s review, and it is expected to be achieved by end-2025.</narrative>
      </comment>
     </target>
     <actual value="Partially achieved"></actual>
    </period>
   </indicator>
  </result>
