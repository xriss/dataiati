  <result aggregation-status="0" type="1">
   <title>
    <narrative xml:lang="EN">Intermediate Results Indicator</narrative>
   </title>
   <indicator ascending="1" measure="2">
    <title>
     <narrative xml:lang="EN">General government deficit with State Roads reduced</narrative>
    </title>
    <baseline iso-date="2022-11-26" value="4.8" year="2022">
     <comment>
      <narrative xml:lang="EN"></narrative>
     </comment>
    </baseline>
    <period>
     <period-start iso-date="2022-11-26"></period-start>
     <period-end iso-date="2024-12-13"></period-end>
     <target value="4.0">
      <comment>
       <narrative xml:lang="EN">Not achieved. However, importantly, the new law introduced fiscal rules that require the government to comply with after the adjustment period of maximum five years, and the independent Fiscal Council has been set up to monitor the compliance. The revised GFS for 2025-2029 anticipates a gradual fiscal consolidation, aiming to achieve a budget fiscal rule of 3 percent of GDP deficit by 2027 and debt fiscal rule of 60 percent of GDP by 2028.</narrative>
      </comment>
     </target>
     <actual value="5.0"></actual>
    </period>
   </indicator>
  </result>
