   <title>
    <narrative xml:lang="EN">Annual Output Results</narrative>
   </title>
   <indicator aggregation-status="1" ascending="0" measure="2">
    <title>
     <narrative xml:lang="EN">Percentage of people living with HIV</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">This indicator is for Benguela, Cuanza Sul and Bi&#xe9;.
The numerator of this indicator is the number of people living with HIV. The denominator is the total population.</narrative>
    </description>
    <baseline value="1" year="2024"></baseline>
    <period>
     <period-start iso-date="2024-01-01"></period-start>
     <period-end iso-date="2024-12-31"></period-end>
     <target value="1"></target>
     <actual value="0.94"></actual>
    </period>
   </indicator>
   <indicator aggregation-status="1" ascending="0" measure="2">
    <title>
     <narrative xml:lang="EN">Estimated percentage of children newly infected with HIV from mother-to-child transmission among women living with HIV delivering in the past 12 months.</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">This indicator is National level.
The numerator is the estimated number of children newly infected with HIV via mother-to-child transmission. The denominator is the estimated number of women living with HIV delivering in the past 12 months.</narrative>
    </description>
    <baseline value="15" year="2024"></baseline>
    <period>
     <period-start iso-date="2024-01-01"></period-start>
     <period-end iso-date="2024-12-31"></period-end>
     <target value="8"></target>
     <actual value="13.49"></actual>
    </period>
   </indicator>
   <indicator aggregation-status="1" ascending="0" measure="1">
    <title>
     <narrative xml:lang="EN">TB incidence rate per 100,000 population</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">This indicator is national level. 
The numerator is the number of new and relapse TB cases occuring during the year. The denominator is the number of people in the population x 100,000.</narrative>
    </description>
    <baseline value="333" year="2024"></baseline>
    <period>
     <period-start iso-date="2025-01-01"></period-start>
     <period-end iso-date="2025-12-31"></period-end>
     <target value="289"></target>
     <actual value="193.8"></actual>
    </period>
   </indicator>
   <indicator aggregation-status="1" ascending="0" measure="1">
    <title>
     <narrative xml:lang="EN">In-patient malaria deaths: rate per 100,000 persons per year</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">This is a subnational indicator.
The numerator is the number of in-patient malaria deaths x 100,000. The denominator is the population at risk (number of people living in areas where malaria transmission occurs).</narrative>
    </description>
    <baseline value="39" year="2024"></baseline>
    <period>
     <period-start iso-date="2024-01-01"></period-start>
     <period-end iso-date="2024-12-31"></period-end>
     <target value="19"></target>
     <actual value="30"></actual>
    </period>
   </indicator>
   <indicator aggregation-status="1" ascending="0" measure="2">
    <title>
     <narrative xml:lang="EN">Malaria I-4 Malaria test positivity rate</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">This indicator is Subnational.
The numerator is the number of confirmed malaria cases (by microscopy or RDT). The denominator is the number of patients who received a parasitological test.</narrative>
    </description>
