   <indicator aggregation-status="1" ascending="0" measure="1">
    <title>
     <narrative xml:lang="EN">Number of women and men in agropastoral communities adopting CSA and climate resilient livelihoods</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">Measures the number of female and male individuals in agropastoral communities who have adopted Climate-Smart Agriculture (CSA) practices and diversified, climate-resilient livelihood strategies. This indicator captures gender-disaggregated progress in building adaptive capacity and reducing vulnerability to climate-related shocks through sustainable, resilient farming and income-generation approaches.</narrative>
    </description>
