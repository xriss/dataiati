   <indicator ascending="1" measure="1">
    <title>
     <narrative xml:lang="EN">ACC-I2 - Number of adaptations in the design and/or implementation of the JR, as a result of the input from beneficiaries</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">Based on PDM and CFRM, there could be adaptations.</narrative>
    </description>
    <reference code="ACC-I2" indicator-uri="https://www.zoa-international.com" vocabulary="99"></reference>
    <baseline value="0" year="2025"></baseline>
    <period>
     <period-start iso-date="2025-04-01"></period-start>
     <period-end iso-date="2025-09-30"></period-end>
     <target value="2"></target>
     <actual value="2">
      <comment>
       <narrative xml:lang="EN">Minor adjustments were made during the distributions. Due to the large number of participants and long waiting times, groups were divided into smaller batches to reduce waiting time and improve efficiency. In addition, both local partners were able to reach extra households with MPCA following feedback received, supported by exchange-rate gains.</narrative>
      </comment>
     </actual>
    </period>
   </indicator>
  </result>
