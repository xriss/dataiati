   <indicator ascending="1" measure="5">
    <title>
     <narrative xml:lang="EN">Budget Variance (defined as the difference between the budgeted and actual fiscal balance)</narrative>
    </title>
    <baseline iso-date="2022-06-13" value="8.3 percent of GDP (Average over FY20-22)" year="2022"></baseline>
    <period>
     <period-start iso-date="2022-06-13"></period-start>
     <period-end iso-date="2027-06-13"></period-end>
     <target value="4 percent of GDP (Average over FY24-27)">
      <comment>
       <narrative xml:lang="EN">Result partially achieved. Based on the updated data from authorities, the baseline (average from FY20-FY22) would be 6.7 percent. Even with this lower baseline, progress has been noted.</narrative>
      </comment>
     </target>
     <actual value="6.1"></actual>
    </period>
   </indicator>
  </result>
  <result aggregation-status="0" type="1">
   <title>
    <narrative xml:lang="EN">Intermediate Results Indicator</narrative>
   </title>
   <indicator ascending="1" measure="5">
    <title>
     <narrative xml:lang="EN">Stock of government guarantees</narrative>
    </title>
    <baseline iso-date="2022-06-13" value="8.7 percent of GDP (Average FY21-22)" year="2022"></baseline>
    <period>
     <period-start iso-date="2022-06-13"></period-start>
     <period-end iso-date="2025-06-13"></period-end>
     <target value="&lt; 8 percent of GDP (Average FY23-FY25)">
      <comment>
       <narrative xml:lang="EN">Results fully achieved. Noting that while the improved monitoring and oversight has helped, the decline is also due to the default of guaranteed Samoa Airways (SA) loan being repaid by Government and removed guarantee status. Also noting that the data for government guarantees have been revised and the baseline average for FY21-FY22 should now be 7.5 percent of GDP. Even with a lower baseline and accounting for the removal of the SA guarantee (2.3 percent of GDP), the result is assessed as achieved.</narrative>
      </comment>
     </target>
     <actual value="3.7"></actual>
    </period>
   </indicator>
  </result>
