  <result aggregation-status="1" type="1">
   <title>
    <narrative xml:lang="EN">Annual Output Results</narrative>
   </title>
   <indicator ascending="0" measure="5">
    <title>
     <narrative xml:lang="EN">Output Indicator</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">1. Existence of Country Action Agenda and Investment Prospectus  
2. Existence of strategies and regulatory framework for off-grid electrification 
3. Existence of energy database and information system
4. Data management and modelling software utilized by stakeholders 
5. Disbursement of funds from FSS for establishment of mini-grids and energy centres
6. Availability of business model for off-grid electrification
7. 10 mini-grids and 10 Energy Centres operational
8. Existence of an outreach programme for the project</narrative>
    </description>
    <baseline year="2016">
     <comment>
      <narrative xml:lang="EN">1. No Country Action Agenda and Investment Prospectus in Lesotho
2. No strategies and regulatory framework to facilitate investment in RET and mini-grids for off-grid electrification.
3. No energy database and information system in Lesotho
4. Lack of capacity of stakeholders in energy data management and modelling
5. No financial mechanisms to facilitate private sector&apos;s investment in mini-grids and energy centres
6. No business models to facilitate private developers for off-grid electrification
7. Mini-grids and Energy Centres are non-existent
8. No outreach programme for dissemination of project results</narrative>
     </comment>
    </baseline>
    <period>
     <period-start iso-date="2020-01-01"></period-start>
     <period-end iso-date="2020-12-31"></period-end>
     <target>
      <comment>
       <narrative xml:lang="EN">- sign 10 concession agreements for minigrids in 10 locations
- sign 10 energy center agreements for sale of climate change mitigation devices at community level</narrative>
      </comment>
     </target>
     <actual>
      <comment>
       <narrative xml:lang="EN">8 concession agreement signed
7 energy center agreement sign</narrative>
      </comment>
     </actual>
    </period>
