  <title xml:lang="EN">
   <narrative xml:lang="EN">Lebanon Digital Acceleration Project</narrative>
  </title>
  <description type="1" xml:lang="EN">
   <narrative xml:lang="EN">The proposed operation aims to support the implementation of digital foundations and enablers such as digital public infrastructure (including digital ID, electronic signature, and trusted data sharing platforms), modern data infrastructure and cloud computing, cybersecurity, data protection, artificial intelligence, and digital skills, to improve the delivery of high-impact public services.</narrative>
  </description>
  <description type="2" xml:lang="EN">
   <narrative xml:lang="EN">To strengthen digital foundations and enablers to improve the delivery of high-impact public services.</narrative>
  </description>
