   <narrative xml:lang="EN">HelpAge International</narrative>
  </reporting-org>
  <title>
   <narrative xml:lang="EN">Community-Based Service for Older Persons in Vietnam</narrative>
  </title>
  <description type="2">
   <narrative xml:lang="EN">Development of a good practice (a model) of community care</narrative>
  </description>
  <description type="2">
   <narrative xml:lang="EN">Development of policy recommendations for adapting community care</narrative>
  </description>
  <description type="2">
   <narrative xml:lang="EN">Promote public and government awareness</narrative>
  </description>
  <description type="2">
   <narrative xml:lang="EN">Share experiences among ASEAN Member Countries</narrative>
  </description>
  <description type="1">
   <narrative xml:lang="EN">The project supports the ASEAN Member Countries in implementing the Community-Based Service model for older persons adopted from an existing Korean model but adapted to suit Vietnam local socio-cultural and economic context. It aims at enhancing the capacity for national governments and NGOs to implement Community-Based Service for older persons and strengthening networking in Vietnam.</narrative>
  </description>
