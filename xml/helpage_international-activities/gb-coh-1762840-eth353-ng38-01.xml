  <title>
   <narrative xml:lang="EN">Emergency response for drought affected communities and IDPs of Borena zone</narrative>
  </title>
  <description type="1">
   <narrative xml:lang="EN">This project delivers emergency response for drought affected communities and IDPs of Borena zone</narrative>
  </description>
  <description type="2">
   <narrative xml:lang="EN">To contribute to improved food security of 2,400 at risk households led by older persons and other vulnerable community groups through cash-based response and nutrition assessment &amp; referral.</narrative>
  </description>
  <description type="2">
   <narrative xml:lang="EN">To improve access to a clean and sustainable water supply and improved hygiene and sanitation practices for  individuals through water trucking, rehabilitation of critical water sources and building capacity of woreda water office and community.</narrative>
  </description>
