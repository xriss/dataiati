  <iati-identifier>GB-COH-1762840-UGA077-BM01-01</iati-identifier>
  <reporting-org ref="GB-COH-1762840" type="21">
   <narrative xml:lang="EN">HelpAge International</narrative>
  </reporting-org>
  <title>
   <narrative xml:lang="EN">Strengthening of Governmental and Non-Governmental monitoring mechanisms to implement Uganda&apos;s Social Policy</narrative>
  </title>
  <description type="2">
   <narrative xml:lang="EN">1. an effective civil society-led monitoring and accountability mechanism for the implementation of the SCG in the target districts is in place</narrative>
  </description>
  <description type="2">
   <narrative xml:lang="EN">2. through a complaints, follow-up, referral and feedback mechanism established by older people and community leaders, and regular dialogue events, the accountability of social protection services for older people in the six target districts will be improved.</narrative>
  </description>
  <description type="2">
   <narrative xml:lang="EN">3. a national network of older people focused organisations is established and uses social accountability and evidence-based advocacy materials to serve as a collective civil society voice on older people&apos;s issues.</narrative>
  </description>
  <description type="1">
   <narrative xml:lang="EN">Monitoring accountability systems for Uganda&apos;s social policies.</narrative>
  </description>
  <description type="2">
   <narrative xml:lang="EN">Older people and community leaders in Uganda&apos;s six target districts are strengthening accountability systems to improve accessibility to national social protection programmes and other social services.</narrative>
  </description>
  <description type="3">
   <narrative xml:lang="EN">Older persons and government officials.</narrative>
  </description>
