  <title>
   <narrative xml:lang="EN">Healthy Ageing Video Production</narrative>
  </title>
  <description type="1">
   <narrative xml:lang="EN">HelpAge produces a video that will profile older adults from both rural and urban settings from seven low and middle income countries around the world speaking about the opportunities related to healthy ageing to help understand what they need to achieve their goals. HelpAge also produces a shorter social media version of this video.</narrative>
  </description>
  <description type="2">
   <narrative xml:lang="EN">To produce a thirty to sixty second social media version of the video</narrative>
  </description>
  <description type="2">
   <narrative xml:lang="EN">To produce a two to three minute video on healthy ageing around the world</narrative>
  </description>
  <description type="3">
   <narrative xml:lang="EN">representatives of older people in seven countries around the world</narrative>
  </description>
