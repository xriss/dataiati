  <title>
   <narrative xml:lang="EN">Strengthening care for the most vulnerable older people through palliative care provision and COVID-19 mitigation in Addis Ababa, Ethiopia</narrative>
  </title>
  <description type="1">
   <narrative xml:lang="EN">To contribute for the improvement of quality of life of older people living with life-threatening illnesses through Palliative care and protect them from COVID-19 infection.</narrative>
  </description>
  <description type="2">
   <narrative xml:lang="EN">To create awareness about the special needs of elderly people in COVID-19 prevention and Palliative care among the community, care givers</narrative>
  </description>
  <description type="2">
   <narrative xml:lang="EN">To improve access to quality, culturally appropriate and holistic palliative care for older people with life-threatening illnesses</narrative>
  </description>
