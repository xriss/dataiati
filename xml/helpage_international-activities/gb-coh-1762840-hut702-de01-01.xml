  <title>
   <narrative xml:lang="EN">DEC Afghanistan Phase 2</narrative>
  </title>
  <description type="1">
   <narrative xml:lang="EN">This project will boost the resilience of vulnerable people, with a specific focus on marginalised and displacement-affected men and women of all ages with and without disabilities, ensuring inclusive sustainable livelihoods complementing emergency comprehensive rehabilitation services and explosive ordnance risk education and prevention across Herat Province Afghanistan</narrative>
  </description>
  <description type="3">
   <narrative xml:lang="EN">This project will target the most vulnerable and marginalised &#x2013; including displacement-affected people, persons with disabilities and/or older people</narrative>
  </description>
