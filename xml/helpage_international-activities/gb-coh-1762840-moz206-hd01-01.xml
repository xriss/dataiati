  <title>
   <narrative xml:lang="EN">Inclusive Humanitarian Response to Older People Affected by Covid-19 in Gaza Province</narrative>
  </title>
  <description type="1">
   <narrative xml:lang="EN">The project aims at contributing in the efforts of national, provincial and district government in taking
preventive measures at the household and community levels against the spread of Coronavirus (Covid19) in the rural areas of Chokwe District, Gaza Province, Mozambique</narrative>
  </description>
  <description type="2">
   <narrative xml:lang="EN">increased access to information about Covid-19</narrative>
  </description>
  <description type="2">
   <narrative xml:lang="EN">increased access to relief food items for targeted older people headed households</narrative>
  </description>
  <description type="2">
   <narrative xml:lang="EN">increased access to vaccines and PPE materials</narrative>
  </description>
