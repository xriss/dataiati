   <narrative xml:lang="EN">HelpAge International</narrative>
  </reporting-org>
  <title>
   <narrative xml:lang="EN">Promoting integrated and inclusive social protection and care for older persons in responding to population ageing</narrative>
  </title>
  <description type="2">
   <narrative xml:lang="EN">Assess local needs and commitment to implement a community based model of integrated care for older people</narrative>
  </description>
  <description type="2">
   <narrative xml:lang="EN">Development of assessment tools and training materials that will be used for training courses on integrated care for older people</narrative>
  </description>
  <description type="2">
   <narrative xml:lang="EN">Development of communication products (video, posters) on community based care model</narrative>
  </description>
  <description type="1">
   <narrative xml:lang="EN">Strengthening the integrated, inclusive, life-cycle, and gender-transformative social protection system to population ageing and meet the individual needs of the most vulnerable groups</narrative>
  </description>
  <description type="2">
   <narrative xml:lang="EN">Support cost for project management, to ensure the full implementation of all project activities in a short period of time</narrative>
  </description>
  <description type="2">
   <narrative xml:lang="EN">Support for case managers, assistant case managers and caregivers during the implementation of model of integrated care for older people in the community</narrative>
  </description>
  <description type="2">
   <narrative xml:lang="EN">Technical monitoring by HAI and stakeholders to improve the quality of care services for older people</narrative>
  </description>
  <description type="2">
   <narrative xml:lang="EN">To equip caregivers with necessary care knowledge and skills to provide care services in the pilot integrated care model for older persons in the project sites</narrative>
  </description>
  <description type="2">
   <narrative xml:lang="EN">To introduce the inclusive &amp; integrated community based long term care model and its operation; to identify the relevant stakeholders and their role in implementing the model</narrative>
  </description>
  <description type="2">
   <narrative xml:lang="EN">To provide training for case managers on how to manage and support caregivers when providing care services under the pilot integrated care model to older people in the project sites</narrative>
  </description>
  <description type="2">
   <narrative xml:lang="EN">To review what has been achieved, what are the issues and concerns that need to be addressed to improve the quality of care services for older people</narrative>
  </description>
  <description type="2">
   <narrative xml:lang="EN">To share the project model, its achievements and challenges, lesson learnt and recommendation for improvement</narrative>
  </description>
