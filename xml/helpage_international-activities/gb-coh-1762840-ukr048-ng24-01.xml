  <title>
   <narrative xml:lang="EN">ACCESS VI: Provision of multi-sectoral humanitarian assistance to conflict-affected populations in Ukraine and Moldova</narrative>
  </title>
  <description type="1">
   <narrative xml:lang="EN">This project aims to contribute to enhancing safe, dignified and timely humanitarian assistance for internally displaced persons, returnees and other conflict-affected populations in Ukraine and Moldova</narrative>
  </description>
  <description type="2">
   <narrative xml:lang="EN">To protect lives, promote wellbeing and reinforce the coping capacities of vulnerable communities through multi-sectoral humanitarian assistance and enhanced access to essential services</narrative>
  </description>
