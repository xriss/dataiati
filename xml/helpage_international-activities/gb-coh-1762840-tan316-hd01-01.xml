  <title>
   <narrative xml:lang="EN">Sustainable Farming Practices and Improvement of Food Storage</narrative>
  </title>
  <description type="1">
   <narrative xml:lang="EN">Improving food security trough sustainable farming practices and aligned food storage</narrative>
  </description>
  <description type="2">
   <narrative xml:lang="EN">&#x2022;	To create a sense of awareness to older women, men, and youth towards sustainable agriculture production</narrative>
  </description>
  <description type="2">
   <narrative xml:lang="EN">&#x2022;	To create linkages and collaboration with governmental structures and CSOs best practices and sustainable farming</narrative>
  </description>
  <description type="2">
   <narrative xml:lang="EN">&#x2022;	To improve crops/ food storage systems before, during and after harvests of products.</narrative>
  </description>
  <description type="2">
   <narrative xml:lang="EN">&#x2022;	To increase production of food crops among older men and women to a standard level</narrative>
  </description>
