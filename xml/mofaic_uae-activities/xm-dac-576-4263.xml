  <description type="1">
   <narrative xml:lang="EN">Support for Small and Medium Enterprises</narrative>
   <narrative xml:lang="AR">&#x64A;&#x634;&#x645;&#x644; &#x627;&#x644;&#x645;&#x634;&#x631;&#x648;&#x639; &#x627;&#x644;&#x645;&#x642;&#x62A;&#x631;&#x62D; &#x627;&#x644;&#x62F;&#x639;&#x645; &#x627;&#x644;&#x641;&#x646;&#x64A; &#x648;&#x628;&#x646;&#x627;&#x621; &#x627;&#x644;&#x642;&#x62F;&#x631;&#x627;&#x62A; &#x644;&#x644;&#x634;&#x631;&#x643;&#x627;&#x62A; &#x627;&#x644;&#x645;&#x634;&#x627;&#x631;&#x643;&#x629; &#x645;&#x646; &#x642;&#x628;&#x644; &#x645;&#x624;&#x633;&#x633;&#x629; &#x628;&#x631;&#x648;&#x628;&#x627;&#x64A;&#x633; PROPAIS &#x648;&#x647;&#x64A; &#x627;&#x644;&#x62C;&#x647;&#x629; &#x627;&#x644;&#x645;&#x633;&#x624;&#x648;&#x644;&#x629; &#x641;&#x64A; &#x643;&#x648;&#x644;&#x648;&#x645;&#x628;&#x64A;&#x627; &#x644;&#x62F;&#x639;&#x645; &#x648;&#x62A;&#x62D;&#x633;&#x64A;&#x646; &#x628;&#x64A;&#x626;&#x629; &#x627;&#x644;&#x639;&#x645;&#x644; &#x644;&#x644;&#x634;&#x631;&#x643;&#x627;&#x62A; &#x627;&#x644;&#x635;&#x63A;&#x64A;&#x631;&#x629; &#x648;&#x627;&#x644;&#x645;&#x62A;&#x648;&#x633;&#x637;&#x629;&#x60C; &#x648;&#x62F;&#x639;&#x645; &#x645;&#x627;&#x644;&#x64A; (&#x63A;&#x64A;&#x631; &#x645;&#x628;&#x627;&#x634;&#x631;) &#x639;&#x646; &#x637;&#x631;&#x64A;&#x642; &#x628;&#x646;&#x643; &#x627;&#x644;&#x62A;&#x646;&#x645;&#x64A;&#x629; &#x627;&#x644;&#x643;&#x648;&#x644;&#x648;&#x645;&#x628;&#x64A; BANCOLDEX &#x648;&#x627;&#x644;&#x630;&#x64A; &#x633;&#x64A;&#x643;&#x648;&#x646; &#x645;&#x633;&#x624;&#x648;&#x644;&#x627;&#x64B; &#x639;&#x646; &#x625;&#x64A;&#x62C;&#x627;&#x62F; &#x627;&#x644;&#x62D;&#x644;&#x648;&#x644; &#x627;&#x644;&#x645;&#x627;&#x644;&#x64A;&#x629; &#x628;&#x634;&#x643;&#x644; &#x623;&#x641;&#x636;&#x644; &#x648;&#x623;&#x633;&#x647;&#x644; &#x644;&#x644;&#x634;&#x631;&#x643;&#x627;&#x62A; &#x627;&#x644;&#x645;&#x634;&#x627;&#x631;&#x643;&#x629;. &#x643;&#x645;&#x627; &#x633;&#x62A;&#x642;&#x648;&#x645; &#x648;&#x632;&#x627;&#x631;&#x629; &#x627;&#x644;&#x62A;&#x62C;&#x627;&#x631;&#x629; &#x648;&#x627;&#x644;&#x635;&#x646;&#x627;&#x639;&#x629; &#x648;&#x627;&#x644;&#x633;&#x64A;&#x627;&#x62D;&#x629; &#x627;&#x644;&#x643;&#x648;&#x644;&#x648;&#x645;&#x628;&#x64A;&#x629; &#x628;&#x627;&#x644;&#x62A;&#x646;&#x633;&#x64A;&#x642; &#x648;&#x627;&#x644;&#x625;&#x634;&#x631;&#x627;&#x641; &#x627;&#x644;&#x639;&#x627;&#x645; &#x639;&#x644;&#x649; &#x627;&#x644;&#x645;&#x634;&#x631;&#x648;&#x639; &#x628;&#x645;&#x633;&#x627;&#x639;&#x62F;&#x629; &#x627;&#x644;&#x648;&#x643;&#x627;&#x644;&#x629; &#x627;&#x644;&#x631;&#x626;&#x627;&#x633;&#x64A;&#x629; &#x627;&#x644;&#x643;&#x648;&#x644;&#x648;&#x645;&#x628;&#x64A;&#x629; &#x644;&#x644;&#x62A;&#x639;&#x627;&#x648;&#x646; &#x627;&#x644;&#x62F;&#x648;&#x644;&#x64A;. &#x648;&#x64A;&#x62A;&#x636;&#x645;&#x646; &#x627;&#x644;&#x645;&#x634;&#x631;&#x648;&#x639; &#x627;&#x644;&#x639;&#x645;&#x644; &#x645;&#x639; &#x645;&#x627; &#x64A;&#x642;&#x627;&#x631;&#x628; 1600 &#x634;&#x631;&#x643;&#x629; &#x643;&#x648;&#x644;&#x648;&#x645;&#x628;&#x64A;&#x629;. &#x645;&#x62D;&#x627;&#x648;&#x631; &#x627;&#x644;&#x645;&#x634;&#x631;&#x648;&#x639; &#x647;&#x64A; &#x643;&#x627;&#x644;&#x62A;&#x627;&#x644;&#x64A;:  i. &#x627;&#x644;&#x62F;&#x639;&#x645; &#x627;&#x644;&#x641;&#x646;&#x64A; &#x648;&#x628;&#x646;&#x627;&#x621; &#x627;&#x644;&#x642;&#x62F;&#x631;&#x627;&#x62A; (5 &#x645;&#x644;&#x627;&#x64A;&#x64A;&#x646; &#x62F;&#x648;&#x644;&#x627;&#x631;): &#x648;&#x64A;&#x634;&#x645;&#x644; &#x647;&#x630;&#x627; &#x627;&#x644;&#x645;&#x62D;&#x648;&#x631; &#x627;&#x644;&#x645;&#x643;&#x648;&#x646;&#x627;&#x62A; &#x627;&#x644;&#x62A;&#x627;&#x644;&#x64A;&#x629;  1. &#x62A;&#x62D;&#x644;&#x64A;&#x644; &#x627;&#x644;&#x648;&#x636;&#x639; &#x648;&#x62A;&#x62D;&#x62F;&#x64A;&#x62F; &#x627;&#x644;&#x623;&#x648;&#x644;&#x648;&#x64A;&#x627;&#x62A; &#x648;&#x631;&#x633;&#x645; &#x62E;&#x637;&#x637; &#x627;&#x644;&#x639;&#x645;&#x644; (1.25 &#x645;&#x644;&#x64A;&#x648;&#x646; &#x62F;&#x648;&#x644;&#x627;&#x631; &#x623;&#x645;&#x631;&#x64A;&#x643;&#x64A;). 2. &#x645;&#x639;&#x627;&#x631;&#x636; &#x627;&#x644;&#x62A;&#x648;&#x641;&#x64A;&#x642; &#x648;&#x627;&#x644;&#x631;&#x628;&#x637; &#x628;&#x64A;&#x646; &#x627;&#x644;&#x634;&#x631;&#x643;&#x627;&#x62A; -8 &#x645;&#x639;&#x627;&#x631;&#x636;- (0.8 &#x645;&#x644;&#x64A;&#x648;&#x646; &#x62F;&#x648;&#x644;&#x627;&#x631; &#x623;&#x645;&#x631;&#x64A;&#x643;&#x64A;). 3. &#x62A;&#x637;&#x628;&#x64A;&#x642; &#x62E;&#x637;&#x637; &#x627;&#x644;&#x639;&#x645;&#x644; &#x648;&#x62A;&#x642;&#x62F;&#x64A;&#x645; &#x627;&#x644;&#x62F;&#x639;&#x645; &#x627;&#x644;&#x641;&#x646;&#x64A; (2.45 &#x645;&#x644;&#x64A;&#x648;&#x646; &#x62F;&#x648;&#x644;&#x627;&#x631; &#x623;&#x645;&#x631;&#x64A;&#x643;&#x64A;). 4. &#x625;&#x646;&#x634;&#x627;&#x621; &#x645;&#x646;&#x635;&#x629; &#x625;&#x644;&#x643;&#x62A;&#x631;&#x648;&#x646;&#x64A;&#x629; &#x62A;&#x631;&#x628;&#x637; &#x627;&#x644;&#x645;&#x648;&#x631;&#x62F;&#x64A;&#x646; (&#x627;&#x644;&#x645;&#x646;&#x62A;&#x62C;&#x64A;&#x646;) &#x628;&#x627;&#x644;&#x645;&#x633;&#x62A;&#x647;&#x644;&#x643;&#x64A;&#x646; (&#x627;&#x644;&#x645;&#x634;&#x62A;&#x631;&#x64A;&#x646;) (0.5 &#x645;&#x644;&#x64A;&#x648;&#x646; &#x62F;&#x648;&#x644;&#x627;&#x631; &#x623;&#x645;&#x631;&#x64A;&#x643;&#x64A;). ii. &#x627;&#x644;&#x62F;&#x639;&#x645; &#x627;&#x644;&#x645;&#x627;&#x644;&#x64A; (5 &#x645;&#x644;&#x627;&#x64A;&#x64A;&#x646; &#x62F;&#x648;&#x644;&#x627;&#x631;): &#x641;&#x64A; &#x647;&#x630;&#x627; &#x627;&#x644;&#x645;&#x62D;&#x648;&#x631;&#x60C; &#x62A;&#x642;&#x648;&#x645; &#x627;&#x644;&#x634;&#x631;&#x643;&#x627;&#x62A; &#x627;&#x644;&#x645;&#x633;&#x62A;&#x641;&#x64A;&#x62F;&#x629; &#x645;&#x646; &#x627;&#x644;&#x625;&#x642;&#x62A;&#x631;&#x627;&#x636; &#x645;&#x646; &#x627;&#x644;&#x628;&#x646;&#x648;&#x643; &#x627;&#x644;&#x62A;&#x62C;&#x627;&#x631;&#x64A;&#x629; &#x648;&#x627;&#x644;&#x62A;&#x64A; &#x628;&#x62F;&#x648;&#x631;&#x647;&#x627; &#x62A;&#x642;&#x648;&#x645; &#x628;&#x625;&#x639;&#x627;&#x62F;&#x629; &#x62E;&#x635;&#x645; (rediscount) &#x647;&#x630;&#x647; &#x627;&#x644;&#x642;&#x631;&#x648;&#x636; &#x644;&#x628;&#x646;&#x643; &#x627;&#x644;&#x62A;&#x646;&#x645;&#x64A;&#x629; (BANCOLDEX)&#x60C; &#x62D;&#x64A;&#x62B; &#x62A;&#x647;&#x62F;&#x641; &#x647;&#x630;&#x647; &#x627;&#x644;&#x639;&#x645;&#x644;&#x64A;&#x629; &#x644;&#x62A;&#x648;&#x644;&#x64A;&#x62F; &#x645;&#x62C;&#x645;&#x648;&#x639; &#x642;&#x631;&#x648;&#x636; &#x628;&#x642;&#x64A;&#x645;&#x629; 100 &#x645;&#x644;&#x64A;&#x648;&#x646; &#x62F;&#x648;&#x644;&#x627;&#x631; &#x645;&#x646; &#x627;&#x644;&#x640; 5 &#x645;&#x644;&#x64A;&#x648;&#x646; &#x62F;&#x648;&#x644;&#x627;&#x631; &#x627;&#x644;&#x645;&#x642;&#x62F;&#x645;&#x629;&#x60C; &#x628;&#x62D;&#x64A;&#x62B; &#x64A;&#x62A;&#x645; &#x627;&#x633;&#x62A;&#x62E;&#x62F;&#x627;&#x645; &#x627;&#x644;&#x645;&#x628;&#x644;&#x63A; &#x627;&#x644;&#x645;&#x62E;&#x635;&#x635; &#x645;&#x646; &#x642;&#x628;&#x644; &#x627;&#x644;&#x635;&#x646;&#x62F;&#x648;&#x642; &#x644;&#x62A;&#x63A;&#x637;&#x64A;&#x629; &#x627;&#x644;&#x641;&#x631;&#x642; &#x628;&#x64A;&#x646; &#x634;&#x631;&#x648;&#x637; &#x627;&#x644;&#x625;&#x642;&#x631;&#x627;&#x636; &#x641;&#x64A; &#x627;&#x644;&#x633;&#x648;&#x642; &#x648;&#x627;&#x644;&#x634;&#x631;&#x648;&#x637; &#x627;&#x644;&#x62E;&#x627;&#x635;&#x629; &#x644;&#x644;&#x634;&#x631;&#x643;&#x627;&#x62A; &#x627;&#x644;&#x645;&#x633;&#x62A;&#x641;&#x64A;&#x62F;&#x629; &#x639;&#x646; &#x637;&#x631;&#x64A;&#x642; &#x641;&#x62A;&#x631;&#x627;&#x62A; &#x623;&#x637;&#x648;&#x644; &#x648;&#x641;&#x62A;&#x631;&#x629; &#x633;&#x645;&#x627;&#x62D; &#x648;&#x623;&#x633;&#x639;&#x627;&#x631; &#x641;&#x627;&#x626;&#x62F;&#x629; &#x645;&#x646;&#x62E;&#x641;&#x636;&#x629; &#x644;&#x644;&#x634;&#x631;&#x643;&#x627;&#x62A; &#x627;&#x644;&#x643;&#x648;&#x644;&#x648;&#x645;&#x628;&#x64A;&#x629;.</narrative>
