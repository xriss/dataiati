  <title>
   <narrative xml:lang="EN">Nuno - Modogashe road project</narrative>
   <narrative xml:lang="AR">&#x645;&#x634;&#x631;&#x648;&#x639; &#x637;&#x631;&#x64A;&#x642; &#x645;&#x648;&#x642;&#x62F;&#x627;&#x634;&#x64A; - &#x646;&#x627;&#x646;&#x648;</narrative>
