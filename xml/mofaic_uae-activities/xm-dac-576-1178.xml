  <title>
   <narrative xml:lang="EN">High speed train Tangir- Casablanca</narrative>
   <narrative xml:lang="AR">&#x642;&#x637;&#x627;&#x631; &#x641;&#x627;&#x626;&#x642; &#x627;&#x644;&#x633;&#x631;&#x639;&#x629; &#x628;&#x64a;&#x646; &#x637;&#x646;&#x62c;&#x629; - &#x627;&#x644;&#x62f;&#x627;&#x631; &#x627;&#x644;&#x628;&#x64a;&#x636;&#x627;&#x621;</narrative>
  </title>
  <description type="1">
   <narrative xml:lang="EN">The project includes the construction of the first phase (200 km long) of the High-Speed Train (320 km/h) between Tangier and Kenitra cities, and linking it to the existing network lines. The project includes providing the railways equipment and civil wo</narrative>
   <narrative xml:lang="AR">&#x64a;&#x62a;&#x636;&#x645;&#x646; &#x627;&#x644;&#x645;&#x634;&#x631;&#x648;&#x639; &#x625;&#x646;&#x634;&#x627;&#x621; &#x648;&#x62a;&#x634;&#x64a;&#x64a;&#x62f; &#x627;&#x644;&#x645;&#x631;&#x62d;&#x644;&#x629; &#x627;&#x644;&#x623;&#x648;&#x644;&#x649; &#x644;&#x62e;&#x637; &#x627;&#x644;&#x642;&#x637;&#x627;&#x631;&#x627;&#x62a; &#x641;&#x627;&#x626;&#x642;&#x629; &#x627;&#x644;&#x633;&#x631;&#x639;&#x629; (320 &#x643;&#x645;/&#x633;&#x627;&#x639;&#x629;) &#x645;&#x627;&#x628;&#x64a;&#x646; &#x645;&#x62f;&#x64a;&#x646;&#x62a;&#x64a; &#x637;&#x646;&#x62c;&#x629; &#x648;&#x627;&#x644;&#x642;&#x646;&#x64a;&#x637;&#x631;&#x629; &#x628;&#x637;&#x648;&#x644; &#x62d;&#x648;&#x627;&#x644;&#x64a; 200 &#x643;&#x64a;&#x644;&#x648;&#x645;&#x62a;&#x631; &#x648;&#x631;&#x628;&#x637;&#x647;&#x627; &#x628;&#x634;&#x628;&#x643;&#x629; &#x627;&#x644;&#x62e;&#x637;&#x648;&#x637; &#x627;&#x644;&#x62d;&#x627;&#x644;&#x64a;&#x629;. &#x64a;&#x62a;&#x643;&#x648;&#x646; &#x627;&#x644;&#x645;&#x634;&#x631;&#x648;&#x639; &#x645;&#x646; &#x627;&#x642;&#x62a;&#x646;&#x627;&#x621; &#x627;&#x644;&#x645;&#x639;&#x62f;&#x627;&#x62a; &#x627;&#x644;&#x633;&#x643;&#x643; &#x627;&#x644;&#x62d;&#x62f;&#x64a;&#x62f;&#x64a;&#x629; &#x648;&#x627;&#x644;&#x623;&#x639;&#x645;&#x627;&#x644; &#x627;&#x644;&#x645;&#x62f;&#x646;&#x64a;&#x629; &#x644;&#x62a;&#x647;&#x64a;&#x626;&#x629; &#x627;&#x644;&#x645;&#x62f;&#x627;&#x62e;&#x644; &#x627;&#x644;&#x633;&#x643;&#x643; &#x627;&#x644;&#x62d;&#x62f;&#x64a;&#x62f;&#x64a;&#x629; &#x627;&#x644;&#x62d;&#x627;&#x644;&#x64a;&#x629; &#x648;&#x627;&#x644;&#x645;&#x646;&#x634;&#x622;&#x62a; &#x628;&#x645;&#x62d;&#x637;&#x62a;&#x64a; &#x637;&#x646;&#x62c;&#x629; &#x648;&#x627;&#x644;&#x642;&#x646;&#x64a;&#x637;&#x631;&#x629; &#x648;&#x627;&#x642;&#x62a;&#x646;&#x627;&#x621; &#x639;&#x631;&#x628;&#x627;&#x62a; &#x630;&#x627;&#x62a;&#x64a;&#x629; &#x627;&#x644;&#x62f;&#x641;&#x639; &#x644;&#x644;&#x642;&#x637;&#x627;&#x631;&#x627;&#x62a; &#x641;&#x627;&#x626;&#x642;&#x629; &#x627;&#x644;&#x633;&#x631;&#x639;&#x629; (500 &#x645;&#x642;&#x639;&#x62f; &#x644;&#x643;&#x644; &#x639;&#x631;&#x628;&#x629;) &#x648;&#x628;&#x646;&#x627;&#x621; &#x648;&#x62a;&#x62c;&#x647;&#x64a;&#x632; &#x648;&#x631;&#x634;&#x629; &#x644;&#x635;&#x64a;&#x627;&#x646;&#x629; &#x627;&#x644;&#x642;&#x637;&#x627;&#x631;&#x627;&#x62a; &#x628;&#x637;&#x646;&#x62c;&#x629;. &#x625;&#x645;&#x627; &#x628;&#x62e;&#x635;&#x648;&#x635; &#x627;&#x644;&#x623;&#x639;&#x645;&#x627;&#x644; &#x627;&#x644;&#x645;&#x62f;&#x646;&#x64a;&#x629; &#x644;&#x62a;&#x62c;&#x62f;&#x64a;&#x62f; &#x627;&#x644;&#x645;&#x62d;&#x637;&#x627;&#x62a; &#x627;&#x644;&#x633;&#x643;&#x643;&#x64a;&#x629; &#x641;&#x633;&#x648;&#x641; &#x64a;&#x62a;&#x645; &#x62a;&#x645;&#x648;&#x64a;&#x644;&#x647;&#x627; &#x628;&#x646;&#x638;&#x627;&#x645; &#x62d;&#x642; &#x627;&#x644;&#x627;&#x645;&#x62a;&#x64a;&#x627;&#x632; &#x648;&#x645;&#x628;&#x62f;&#x623; BOT.</narrative>
