  <title>
   <narrative xml:lang="EN">Maize Processing and Expansion</narrative>
  </title>
  <description type="1">
   <narrative xml:lang="EN">The project funds will be used to construct a new factory and purchase approved equipment and to expand marshland cultivation to another 130 hectares which will directly contribute to an increase of income for over 2;000 persons and promote food security in the area.</narrative>
  </description>
