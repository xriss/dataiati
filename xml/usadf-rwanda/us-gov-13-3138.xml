  <title>
   <narrative xml:lang="EN">Maize Production and Processing Project</narrative>
  </title>
  <description type="1">
   <narrative xml:lang="EN">The project funds will be used to acquire 3-phase electricity for the maize flour factory; post-harvest processing equipment; constructing 5 modern drying hangars; transportation rental; and working capital to establish a rotating maize purchase fund.</narrative>
  </description>
