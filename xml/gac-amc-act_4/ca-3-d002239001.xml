  <iati-identifier>CA-3-D002239001</iati-identifier>
  <reporting-org ref="CA-3" type="10">
   <narrative xml:lang="FR">Affaires &#xe9;trang&#xe8;res, Commerce et D&#xe9;veloppement Canada (MAECD)</narrative>
