  <title>
   <narrative xml:lang="EN">Creating a Blended Finance-Based Impact Ecosystem and Scale-Up Investment in Southeast Asia</narrative>
  </title>
  <description type="1">
   <narrative xml:lang="EN">Discover and invest in impact startups above Series A, Develop and operate leadership programs for entrepreneurs, Hold workshops to create a virtuous cycle culture in the local startup ecosystem, Support collective impact projects, Participate in global conferences to spread project performance and cases</narrative>
  </description>
  <description type="2">
