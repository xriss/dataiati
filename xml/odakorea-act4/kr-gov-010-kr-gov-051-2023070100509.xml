  <title>
   <narrative xml:lang="EN">Easy to Learn Project in Chhloung District   Phase 2</narrative>
  </title>
  <description type="1">
   <narrative xml:lang="EN">1. To establish child friendly school environment for vulnerable children to continue education 2. To improve student&apos;s reading ability  3. To strengthen school based management by school governance and local education department</narrative>
  </description>
  <description type="2">
