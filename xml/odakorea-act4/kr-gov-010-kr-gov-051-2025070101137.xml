  <title>
   <narrative xml:lang="EN">Improving the Environment through Establishment of Textile and Plastic Waste Recycling System in Bangladesh</narrative>
  </title>
  <description type="1">
   <narrative xml:lang="EN">1. Establishment of survey and collection system for the construction of a textile and vinyl waste recycling system , 2. Construction and operation of textile and vinyl waste recycling plants, 3. Training on textile and vinyl waste recycling technology</narrative>
  </description>
  <description type="2">
