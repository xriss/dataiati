  <title>
   <narrative xml:lang="EN">Promoting Health and Nutrition through School Feeding in Northern Cote d Ivoire(WFP)</narrative>
  </title>
  <description type="1">
   <narrative xml:lang="EN">Providing Nutritious Food to the Students, Supporting Women Farmers in order to boost Productivity and Food Nutrition ,Enhancing the Nutrition and Health Situation within the Schools, Digitalizing the School Food Service</narrative>
  </description>
  <description type="2">
