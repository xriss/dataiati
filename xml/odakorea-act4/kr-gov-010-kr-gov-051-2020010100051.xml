3. &#xc8fc;&#xc7ac;&#xad6d; &#xc815;&#xbd80;&#xc758; MNCH &#xd504;&#xb85c;&#xadf8;&#xb7a8; &#xc8fc;&#xc778;&#xc758;&#xc2dd; &#xbc0f; &#xc99d;&#xac70;&#xae30;&#xbc18;&#xc758; &#xac70;&#xbc84;&#xb10c;&#xc2a4; &#xc99d;&#xc9c4;</narrative>
