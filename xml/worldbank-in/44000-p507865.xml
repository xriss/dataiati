  <title xml:lang="EN">
   <narrative xml:lang="EN">Assam: School Education and Adolescent Wellbeing Project (ASAP)</narrative>
  </title>
  <description type="1" xml:lang="EN">
   <narrative xml:lang="EN">The project will support early childhood care and education for improved school readiness and foundational learning outcomes; enhance school capabilities to improve quality and access to school education; and strengthen the delivery of measures for adolescent well-being.</narrative>
  </description>
  <description type="2" xml:lang="EN">
   <narrative xml:lang="EN">To improve students foundational learning and school-to-work transition of adolescents.</narrative>
  </description>
