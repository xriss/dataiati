   <narrative xml:lang="EN">Assoc of Schools of Public health in Africa ASPHA - Assic of Schools of Public health in Africa ASPHA</narrative>
   <narrative xml:lang="SV">F&#xf6;rening folkh&#xe4;lsovetenskapsskolor i Afrika ASPHA</narrative>
