  <title>
   <narrative xml:lang="EN">National Expert - EEAS, FAC CODEV - National Expert - EEAS, FAC CODEV, EJ</narrative>
   <narrative xml:lang="SV">Nationell Expert - EEAS, FAC CODEV</narrative>
  </title>
  <description type="1">
   <narrative xml:lang="SV">Bidra till utrikestj&#xe4;nstens samordning av utvecklingspolitiska fr&#xe5;gor, inklusive att vara utrikestj&#xe4;nstens f&#xf6;retr&#xe4;dare i r&#xe5;dets arbetsgrupp CODEV</narrative>
   <narrative xml:lang="EN">Contribute to the EEAS coordination of development policy issues, including being the EEAS representative in the Council Working Party CODEV</narrative>
  </description>
