   <indicator aggregation-status="1" ascending="0" measure="1">
    <title>
     <narrative xml:lang="EN">Multisectorial and Multistakeholder Youth Employment Platform Created and operational</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">A collaborative platform active, bringing together government, private sector, civil society, academia, and youth organizations to jointly address youth employment. It enables coordination, knowledge sharing, and joint planning to create inclusive, practical, and scalable solutions for youth job creation and skills development.</narrative>
