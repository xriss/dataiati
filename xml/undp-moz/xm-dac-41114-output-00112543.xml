  <result aggregation-status="1" type="1">
   <title>
    <narrative xml:lang="EN">Annual Output Results</narrative>
   </title>
   <indicator aggregation-status="1" ascending="0" measure="1">
    <title>
     <narrative xml:lang="EN">Number of meetings of the inter-sectorial coordination mechanism led by MTA, promoting coherence of planning frameworks, legislation and regulations.</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">This indicator refers main to all meetings promoted by MTA, in other to plan, assess and report on Paris Agreement by Mozambique. It includes preparatory meetings to COP, Consultation meetings to produce strategic documents such as NAP, progress report on NDC.</narrative>
    </description>
    <baseline value="0" year="2019"></baseline>
    <period>
     <period-start iso-date="2023-01-01"></period-start>
     <period-end iso-date="2023-12-31"></period-end>
     <target value="6"></target>
     <actual value="8"></actual>
    </period>
   </indicator>
   <indicator aggregation-status="1" ascending="0" measure="1">
    <title>
     <narrative xml:lang="EN">Number of guidelines produced to enhance public investments in sustainable natural resource management.</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">This indicator refers to the products relevant to promote inclusive and transparent management of natural resources for poverty eradication.</narrative>
    </description>
    <baseline value="0" year="2019"></baseline>
    <period>
     <period-start iso-date="2023-01-01"></period-start>
     <period-end iso-date="2023-12-31"></period-end>
     <target value="3"></target>
     <actual value="2"></actual>
    </period>
   </indicator>
   <indicator aggregation-status="1" ascending="0" measure="1">
    <title>
     <narrative xml:lang="EN">Number of SDG reports which clearly monitor the environmental dimension of Agenda 2030</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">To measure this indicator, we have considered as SDG reports, all documents produced under country obligation to comply with the Paris Agreement, such as NDC- National Determined Contribution, NAP - National Adaptation Plan, BUR - Bi-annual Report on CC, and the National Communication on Green House Emissions under the leadership of Ministry of Environment.</narrative>
    </description>
    <baseline value="0" year="2019"></baseline>
    <period>
     <period-start iso-date="2023-01-01"></period-start>
     <period-end iso-date="2023-12-31"></period-end>
     <target value="2"></target>
     <actual value="1"></actual>
    </period>
   </indicator>
  </result>
