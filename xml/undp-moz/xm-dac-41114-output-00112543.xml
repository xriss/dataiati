  <conditions attached="1">
   <condition type="1">
    <narrative xml:lang="EN">Consistent with the Article III of the SBAA [or the Supplemental Provisions to the Project Document], the responsibility for the safety and security of the Implementing Partner and its personnel and property, and of UNDP&#x2019;s property in the Implementing Partner&#x2019;s custody, rests with the Implementing Partner.  To this end, the Implementing Partner shall: a)	put in place an appropriate security plan and maintain the security plan, taking into account the security situation in the country where the project is being carried; b)	assume all risks and liabilities related to the Implementing Partner&#x2019;s security, and the full implementation of the security plan.</narrative>
   </condition>
   <condition type="1">
    <narrative xml:lang="EN">Social and environmental sustainability will be enhanced through application of the UNDP Social and Environmental Standards (http://www.undp.org/ses) and related Accountability Mechanism (http://www.undp.org/secu-srm).</narrative>
   </condition>
  </conditions>
  <result aggregation-status="1" type="1">
   <title>
    <narrative xml:lang="EN">Annual Output Results</narrative>
   </title>
   <indicator ascending="0" measure="5">
    <title>
     <narrative xml:lang="EN">Output Indicator</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">Output 2: Public investments in natural resource management support poverty reduction and environmentally sustainable economic growth 
2.1 Increased annual budget allocation for climate resilience and environmental sustainability  
2.2 Number of UGB  (sectors and provinces) that use environment and climate budget codes
2.3 Number of &#x201c;Budget for citizens&#x201d; which includes analysis of environmental and climate budget allocation
2.4 % of revenues from natural resources (extractives industries and forestry) which are canalized to communities.
2.5 Number of guidelines produced to enhance public investments in sustainable natural resource management</narrative>
    </description>
    <baseline year="2019">
     <comment>
      <narrative xml:lang="EN">2.1 Increased annual budget allocation for climate resilience and environmental sustainability  	Budget Execution Report (REO): 0,458%
2.2 Number of UGB  (sectors and provinces) that use environment and climate budget codes:	23
2.3 Number of &#x201c;Budget for citizens&#x201d; which includes analysis of environmental and climate budget allocation	Budget for citizens (Or&#xe7;amento Cidad&#xe3;o) : 0
2.4 % of revenues from natural resources (extractives industries and forestry) which are canalized to communities: 25%
2.5 Number of guidelines produced to enhance public investments in sustainable natural resource management: 0</narrative>
     </comment>
    </baseline>
    <period>
     <period-start iso-date="2021-01-01"></period-start>
     <period-end iso-date="2021-12-31"></period-end>
     <target>
      <comment>
       <narrative xml:lang="EN">1.1 Number of poverty-environment and climate mainstreaming tools into the SPO: 1
1.3 Number of studies on revenue sharing mechanism (2.7%):</narrative>
      </comment>
     </target>
     <actual>
      <comment>
       <narrative xml:lang="EN">1.1 A guide manual for the use of environmental code 005 by government departments was produced.
1.1 A study mapping the 58 government projects using code 005 was elaborated.</narrative>
      </comment>
     </actual>
    </period>
    <period>
     <period-start iso-date="2020-01-01"></period-start>
     <period-end iso-date="2020-12-31"></period-end>
     <target>
      <comment>
       <narrative xml:lang="EN">1.1 Number of poverty-environment and climate mainstreaming tools into the SPO: 1
1.2 Number of SDG reports which clearly monitor the environmental dimension of Agenda 2030: 1
1.3 Number of studies on revenue sharing mechanism (2.7%):</narrative>
      </comment>
     </target>
     <actual>
      <comment>
       <narrative xml:lang="EN">1.1 SPO designed and trained 80 government staff members for its implementation.
1.2 SUNRED II no longer focused on studies related to SDG, since there is a specific SDG projects.
1.3 Study postponed to 2021, due to delays in procurement process.</narrative>
      </comment>
     </actual>
    </period>
    <period>
     <period-start iso-date="2022-01-01"></period-start>
     <period-end iso-date="2022-12-31"></period-end>
     <target>
      <comment>
       <narrative xml:lang="EN">1.1 Number of poverty-environment and climate mainstreaming tools into the SPO: 1 (massification of code 005)
1.2 Number of SDG reports which clearly monitor the environmental dimension of Agenda 2030: 1 (Macro-economic study)
1.3 Number of studies on revenue sharing mechanism (2.7%):</narrative>
      </comment>
     </target>
    </period>
   </indicator>
