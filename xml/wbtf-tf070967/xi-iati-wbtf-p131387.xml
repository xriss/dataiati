   <indicator ascending="1" measure="1">
    <title>
     <narrative xml:lang="EN">Retention of barefoot engineer program graduates by PNPM Rural in Papua and West Papua.</narrative>
    </title>
    <baseline iso-date="2012-10-16" value="0.00" year="2012">
     <comment>
      <narrative xml:lang="EN"></narrative>
     </comment>
    </baseline>
    <period>
     <period-start iso-date="2012-10-16"></period-start>
     <period-end iso-date="2014-12-31"></period-end>
     <target value="200.00"></target>
     <actual value="249.00">
      <comment>
       <narrative xml:lang="EN">Retention rates were measured in May 2014 and will be measured again in Nov 2014. The discrepancy between 243 in the prev ISR and249 now results from an error in PNPM provincial reporting that has since been corrected.</narrative>
      </comment>
     </actual>
    </period>
   </indicator>
  </result>
