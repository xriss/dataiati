     <period-end iso-date="2014-03-31"></period-end>
     <target value="240.00"></target>
     <actual value="246.00">
      <comment>
       <narrative xml:lang="EN">The last refresher training was completed in Oct 2014 in Papua and will be completed in Nov 2014 in Papua Barat. This numberreflects both actual participants in Papua and registered participants in Papua Barat. A variance of maximum -5% may occurparticular to Papua Barat if there are flight delays that prevent attendees from reaching the training venue.</narrative>
      </comment>
     </actual>
    </period>
   </indicator>
  </result>
