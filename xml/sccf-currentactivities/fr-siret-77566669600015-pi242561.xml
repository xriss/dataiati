  <title>
   <narrative xml:lang="FR">Renforcer l&apos;attention aux urgences, le plaidoyer et l&apos;&#xe9;cologie int&#xe9;grale</narrative>
  </title>
  <description type="3">
   <narrative xml:lang="FR">Partenaires</narrative>
