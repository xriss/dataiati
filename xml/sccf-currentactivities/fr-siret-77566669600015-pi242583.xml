  <title>
   <narrative xml:lang="FR">Renforcement des r&#xE9;seaux des pastorales sociales pour transformations sociales.</narrative>
  </title>
  <description type="3">
   <narrative xml:lang="FR">Femmes;Peuples autochtones</narrative>
