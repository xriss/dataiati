  <title>
   <narrative xml:lang="EN">Mission Zero &#x2013; Working together for zero leprosy in Mozambique</narrative>
  </title>
  <description type="1">
   <narrative xml:lang="EN">Mission Zero will enable communities to work towards ending leprosy in Mozambique. The UK public will be asked to partner Mozambican communities to fight leprosy and poverty. Donors will champion people affected by leprosy, empowering them to influence change. Mission Zero&#x2019;s financial &#x2018;ask&#x2019; is to build and equip Community Hubs. The Hubs will be the centre of services including leprosy awareness, case-finding, medical provision, weather preparedness, education, livelihood development and wellbeing.</narrative>
  </description>
  <participating-org role="4" type="21">
   <narrative xml:lang="PT">The Leprosy Mission International - Mozambique</narrative>
  </participating-org>
  <activity-status code="2"></activity-status>
  <activity-date iso-date="2022-04-01" type="2">
   <narrative xml:lang="EN">Project Implementation period is 1st April 2022 to 31st March 2025, although , FCDO agreed for Grant Holder to use Match fund t start project from 1st January 2022</narrative>
  </activity-date>
