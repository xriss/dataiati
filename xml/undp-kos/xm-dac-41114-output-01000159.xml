  <result aggregation-status="1" type="1">
   <title>
    <narrative xml:lang="EN">Annual Output Results</narrative>
   </title>
   <indicator aggregation-status="1" ascending="0" measure="5">
    <title>
     <narrative xml:lang="EN">Families and family associations regularly attending meeting and feel safe to discuss and challenge narratives</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">At least 450 members (youth, women) from all communities benefit from dialogue initiatives aiming at empowering them as agents of social cohesion. Participant feedback  from forums, exchanges and workshops shows participants better understand each others perspectives. Grantees have created a public discussion on differing narratives about the past - assessed through media analysis. Quarterly/Annual evaluation of project interventions.</narrative>
    </description>
    <baseline year="2023">
     <comment>
      <narrative xml:lang="EN">Kosovo CPD - Output 3.1: Engagement and trust between ethnic communities, strengthened</narrative>
     </comment>
    </baseline>
    <period>
     <period-start iso-date="2024-01-01"></period-start>
     <period-end iso-date="2024-12-31"></period-end>
     <target>
      <comment>
       <narrative xml:lang="EN">1 youth forum organized by March 2024 
1 youth exchange to be organized by November 2023. 1 skills building workshop for women and youth to be held by February 2024. Assessment of role of women in transitional justice discussions, and the challenges they face, completed by December 2023.
Design call for Grants by May 2023
By End August 2023 grantees selected and grants distributed by September 2023
An assessment study of the Memorial conducted by November 2023.</narrative>
      </comment>
     </target>
     <actual>
