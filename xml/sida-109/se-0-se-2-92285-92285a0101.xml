  <title>
   <narrative xml:lang="EN">Support to IPPF for SHRH NEXUS 2025-2027</narrative>
   <narrative xml:lang="SV">Verksamhetsst&#xf6;d till IPPF f&#xf6;r SRHR NEXUS 2025-2027</narrative>
  </title>
  <description type="1">
   <narrative xml:lang="EN">Support to IPPF for SRHR NEXUS to strengthen and broaden the support for SRHR amongst UN member countries</narrative>
   <narrative xml:lang="SV">Verksamhetsst&#xf6;d till IPPF f&#xf6;r SRHR NEXUS sekretariatet f&#xf6;r att bidra till att st&#xe4;rka och bredda st&#xf6;det f&#xf6;r SRHR bland FN:s medlemsl&#xe4;nder</narrative>
  </description>
