    <title>
     <narrative xml:lang="EN">EXPORT PROMOTION PLATFORM AT IDAL</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">The indicator aims at assessing the development of a matchmaking platform for IDAL and supporting through IDAL the implementation of trade fairs</narrative>
