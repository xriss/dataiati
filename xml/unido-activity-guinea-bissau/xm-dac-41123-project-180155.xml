  <iati-identifier>XM-DAC-41123-PROJECT-180155</iati-identifier>
  <reporting-org ref="XM-DAC-41123" type="40">
   <narrative xml:lang="EN">United Nations Industrial Development Organization</narrative>
  </reporting-org>
  <title>
   <narrative xml:lang="EN">HCFC phase-out management plan (stage II)</narrative>
  </title>
  <description type="1">
   <narrative xml:lang="EN">The project supports Guinea-Bissau in implementing stage II of its HCFC Phase-out Management Plan (HPMP) to eliminate its remaining HCFC consumption by 2030, aligning with the Montreal Protocol targets. The total cost of stage II is US $578,800, including US $300,000 for UNEP (plus US $39,000 in support costs) and US $220,000 for UNIDO (plus US $19,800 in support costs). The first tranche, amounting to US $306,445, covers activities from UNEP (US $126,500 plus US $16,445 in support costs) and UNIDO (US $150,000 plus US $13,500 in support costs). Key activities include regulatory and policy measures, capacity building for stakeholders, technical assistance for adopting alternatives with low-global-warming potential (GWP), and project management to ensure compliance and sustainability.</narrative>
  </description>
  <participating-org role="1">
   <narrative xml:lang="EN">Montreal Protocol</narrative>
  </participating-org>
