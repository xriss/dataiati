  <result aggregation-status="1" type="1">
   <title>
    <narrative xml:lang="EN">Annual Output Results</narrative>
   </title>
   <indicator ascending="0" measure="5">
    <title>
     <narrative xml:lang="EN">Output Indicator</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">- DRR strategy endorsed
- Capacity building  training courses on DRR conducted
- Awareness materials developed</narrative>
    </description>
    <baseline year="2018">
     <comment>
      <narrative xml:lang="EN">DRR principles are not mainstreamed in policies related to Environment and water sectors
lack of knowledge of DRR principles</narrative>
     </comment>
    </baseline>
    <period>
     <period-start iso-date="2021-01-01"></period-start>
     <period-end iso-date="2021-12-31"></period-end>
     <target>
      <comment>
       <narrative xml:lang="EN">-	To contribute to awareness raising of DRR related issues
-	To celebrate the International DRR day and its theme for 2021 that focuses on fostering international cooperation.
-	To help advancing the DRR agenda in Jordan through enhancing the understanding of disasters and the concept of DRR 
   and DRM among all stakeholders.
-	To contribute to educate the members of the national DRR platform on the different elements of Sendai framework.</narrative>
      </comment>
     </target>
     <actual>
      <comment>
       <narrative xml:lang="EN">-	Contribution to the celebration event of the International day of Disaster Risk Reduction 
-.	Prepare promotional and educational materials on DRR management in Jordan
-	Conduct field mission for the NCSCM top management with participation from DRR platform, SDC and UNDP to Aqaba &amp; Petra to visit the early warning system established by SDC &amp; UNDP at PETRA and the Aqaba flash flood mitigation and Early Warning system for the purpose of exchange inputs related to risk management, and provide better understanding for the previous efforts made jointly by the international cooperation representative in the DRM in Jordan.</narrative>
      </comment>
     </actual>
    </period>
    <period>
     <period-start iso-date="2020-01-01"></period-start>
     <period-end iso-date="2020-12-31"></period-end>
     <target>
      <comment>
       <narrative xml:lang="EN">Expediting the process of resource mobilization.</narrative>
      </comment>
     </target>
     <actual>
      <comment>
       <narrative xml:lang="EN">Resource mobilization from different UN agencies to review the institutional and legal framework of the DRR department in Jordan in collaboration with WFP.</narrative>
      </comment>
     </actual>
    </period>
    <period>
     <period-start iso-date="2022-01-01"></period-start>
     <period-end iso-date="2022-12-31"></period-end>
     <target>
      <comment>
       <narrative xml:lang="EN">- Review the institutional and legal framework of the DRR in Jordan 
- Finalize the updating of DRR strategy
- Celebrate the International DRR day</narrative>
      </comment>
     </target>
    </period>
   </indicator>
