   <indicator aggregation-status="1" ascending="0" measure="1">
    <title>
     <narrative xml:lang="FR">Nombre de plateformes (ONG) subventionn&#xe9;es pour guider les processus de mise en &#x153;uvre des CDN et l&apos;action climatique &#xe0; long terme.</narrative>
    </title>
    <description>
     <narrative xml:lang="FR">Cet indicateur mesure le nombre de plateformes non gouvernementales (ONG) qui b&#xe9;n&#xe9;ficient de subventions pour superviser et guider la mise en &#x153;uvre des Contributions D&#xe9;termin&#xe9;es au niveau National (CDN) ainsi que les actions climatiques &#xe0; long terme. Il &#xe9;value le soutien financier accord&#xe9; aux organisations de la soci&#xe9;t&#xe9; civile engag&#xe9;es dans la conduite et la coordination de processus cruciaux li&#xe9;s &#xe0; la r&#xe9;duction des &#xe9;missions de gaz &#xe0; effet de serre et &#xe0; d&apos;autres initiatives en faveur du climat.</narrative>
    </description>
    <baseline value="0" year="2022"></baseline>
    <period>
     <period-start iso-date="2024-01-01"></period-start>
     <period-end iso-date="2024-12-31"></period-end>
     <target value="2"></target>
     <actual value="2"></actual>
    </period>
   </indicator>
   <indicator aggregation-status="1" ascending="0" measure="3">
    <title>
     <narrative xml:lang="FR">Existence d&apos;une strat&#xe9;gie pour des voies nettes z&#xe9;ro et r&#xe9;silientes au climat &#xe0; long terme</narrative>
    </title>
    <description>
     <narrative xml:lang="FR">Cet indicateur &#xe9;value si une strat&#xe9;gie est en place pour &#xe9;laborer des politiques durables et r&#xe9;silientes au changement climatique, avec pour objectif ultime d&apos;atteindre des &#xe9;missions nettes nulles &#xe0; long terme. Il mesure l&apos;engagement et les actions entreprises pour instaurer des approches respectueuses de l&apos;environnement, capables de relever les d&#xe9;fis climatiques, et contribuant ainsi &#xe0; la durabilit&#xe9; et &#xe0; la r&#xe9;silience &#xe0; long terme.</narrative>
    </description>
    <baseline value="0" year="2022"></baseline>
    <period>
     <period-start iso-date="2024-01-01"></period-start>
     <period-end iso-date="2024-12-31"></period-end>
     <target value="1"></target>
     <actual value="0"></actual>
    </period>
   </indicator>
   <indicator aggregation-status="1" ascending="0" measure="3">
    <title>
     <narrative xml:lang="FR">Existence de la CDN efficace, sensible au genre et inclusif actualis&#xe9;e</narrative>
    </title>
    <description>
     <narrative xml:lang="FR">L&apos;indicateur &quot;Existence de la CDN efficace, sensible au genre et inclusif actualis&#xe9;e&quot; mesure la mise en place et la mise &#xe0; jour d&apos;une CDN nationale qui soit non seulement efficace dans la r&#xe9;duction des &#xe9;missions de gaz &#xe0; effet de serre, mais aussi attentive aux questions de genre et inclusive, int&#xe9;grant les perspectives et besoins de tous les acteurs, hommes et femmes, pour une approche plus &#xe9;quitable et durable dans la lutte contre le changement climatique.</narrative>
    </description>
    <baseline value="0" year="2022"></baseline>
    <period>
