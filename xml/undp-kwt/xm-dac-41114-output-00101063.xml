  <conditions attached="1">
   <condition type="1">
    <narrative xml:lang="EN">Consistent with the Article III of the SBAA [or the Supplemental Provisions to the Project Document], the responsibility for the safety and security of the Implementing Partner and its personnel and property, and of UNDP&#x2019;s property in the Implementing Partner&#x2019;s custody, rests with the Implementing Partner.  To this end, the Implementing Partner shall: a)	put in place an appropriate security plan and maintain the security plan, taking into account the security situation in the country where the project is being carried; b)	assume all risks and liabilities related to the Implementing Partner&#x2019;s security, and the full implementation of the security plan.</narrative>
   </condition>
   <condition type="1">
    <narrative xml:lang="EN">Social and environmental sustainability will be enhanced through application of the UNDP Social and Environmental Standards (http://www.undp.org/ses) and related Accountability Mechanism (http://www.undp.org/secu-srm).</narrative>
   </condition>
  </conditions>
  <result aggregation-status="1" type="1">
   <title>
    <narrative xml:lang="EN">Annual Output Results</narrative>
   </title>
   <indicator ascending="0" measure="5">
    <title>
     <narrative xml:lang="EN">Output Indicator</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">1) Third and subsequent batch(s) of Kuwaiti JPOs effectively recruited, with necessary institutional arrangements in place
2) Number of effective communications and advocacy strategy implemented
3) Percentage of completion of comprehensive reinsertion Tool-kit drafted</narrative>
    </description>
    <baseline year="2016">
     <comment>
      <narrative xml:lang="EN">1) 0
2) 0
3) 0</narrative>
     </comment>
    </baseline>
    <period>
     <period-start iso-date="2021-01-01"></period-start>
     <period-end iso-date="2021-12-31"></period-end>
     <target>
      <comment>
       <narrative xml:lang="EN">1) Follow up on 3rd years JPO completion of JPO assignment
2) Extend 4th JPO batch for 3rd year extension
3) Ensure all JPOs are well and safe during COVID pandemic
4) Assist in Kuwait hosting JPO bi-annual meeting</narrative>
      </comment>
     </target>
     <actual>
      <comment>
       <narrative xml:lang="EN">1) All 3rd year JPO had completed their extension of the JPO assignment
2) 4th batch JPOs had granted extension beyond their 2 year assignment 
3) Closely monitored all JPOS during COVID pandemic 
4) Kuwait will host the virtual JPO bi-annual meeting from (2-4 Nov-2021)
5) 100% tasks completion</narrative>
      </comment>
     </actual>
    </period>
    <period>
     <period-start iso-date="2020-01-01"></period-start>
     <period-end iso-date="2020-12-31"></period-end>
     <target>
      <comment>
       <narrative xml:lang="EN">1) Extend the 3rd batch JPOs to a 3rd year extension (based on 50/50 cost sharing)
2) Started the 2nd year JPO programme for the 4th batch Kuwaiti JPOs
3) Conduct 2020 Kuwait JPO brief annual report as per AWP
4) Finalize the JPO project evaluations as per the AWP plan
5) Ensure all JPOs are well and safe during COVID pandemic</narrative>
      </comment>
     </target>
     <actual>
      <comment>
       <narrative xml:lang="EN">1) Four JPOs of the 3rd batch had successfully extended their 3rd year contract (based on 50/50 cost sharing)
2) Eight JPOs of the 4th batch had started their 2nd year JPO programme
3) Completed 2020 Kuwait JPO brief annual report
4) Completed JPO project evaluations as per the AWP plan
5) Closely monitored all JPOS during COVID pandemic 
6) Completed 90%</narrative>
      </comment>
     </actual>
    </period>
   </indicator>
  </result>
