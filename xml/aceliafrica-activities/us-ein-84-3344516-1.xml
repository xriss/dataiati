  <result type="2">
   <title>
    <narrative xml:lang="EN">Financial incentives to lenders increase the amount of private finance flowing to high-impact agri-SMEs.</narrative>
   </title>
   <description>
    <narrative xml:lang="EN">Amount of mobilized private finance.</narrative>
   </description>
   <indicator measure="1">
    <title>
     <narrative xml:lang="EN">$130M private finance mobilized</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">61% of finance to MSMEs providing economic opportunities for women, 39% providing economic opportunities for youth, 25% climate-smart, 55% promoting food security</narrative>
    </description>
    <period>
     <period-start iso-date="2024-01-01"></period-start>
     <period-end iso-date="2024-12-31"></period-end>
    </period>
   </indicator>
   <indicator measure="1">
    <title>
     <narrative xml:lang="EN">$70M total capital mobilized.</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">Of that, 56% is gender inclusive, 30% is youth inclusive, 26% is climate-smart, and 64% is promoting food security.</narrative>
    </description>
    <period>
     <period-start iso-date="2021-11-22"></period-start>
     <period-end iso-date="2023-12-31"></period-end>
    </period>
   </indicator>
  </result>
  <result type="2">
   <title>
    <narrative xml:lang="EN">Financial incentives to lenders increase the number of agri-MSMEs receiving loans</narrative>
