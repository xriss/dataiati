   <indicator aggregation-status="1" ascending="0" measure="2">
    <title>
     <narrative xml:lang="ES">% de mujeres que participan en los comit&#xe9;s CTIM y desarrollan un proyecto escolar</narrative>
    </title>
    <description>
     <narrative xml:lang="ES">% de estudiantes mujeres que participan en los comit&#xe9;s CTIM y desarrollan un proyecto escolar a partir de la metodolog&#xed;a propuesta por PNUD del total de mujeres que integran los comit&#xe9;s escolares reportados por los planteles</narrative>
