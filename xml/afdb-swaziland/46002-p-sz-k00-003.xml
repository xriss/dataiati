     <period-start iso-date="2012-01-01"></period-start>
     <period-end iso-date="2018-12-31"></period-end>
     <target value="Improved analytical capacity to analyze agriculture, infrastructure, environment &amp; climate change data to better monitor SDGs, Agenda 2063 and the Bank&#x2019;s High5s."></target>
     <actual value="2012/2013 - CSO conducted an agricultural census;
2017/2018 &#x2013; CSO conducted the most recent annual agriculture survey;"></actual>
    </period>
   </indicator>
  </result>
