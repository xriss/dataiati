  <title>
   <narrative xml:lang="FR">Swaziland - Projet t&#xe9;l&#xe9;communication</narrative>
   <narrative xml:lang="EN">Swaziland - Telecommunications Project</narrative>
  </title>
  <description type="1">
   <narrative xml:lang="EN">The project consists of:  a) the extension and modernization of the urban networks in large    centres such as Mbabane and Manzini.  b) the conversion to automatic operation and extension of the telex system at Mbabane ;  c) the conversion to automatic operation of the main trunk links    which are also to be equipped to meet telegraph and telex    requirements; and  d) the conversion to automatic operation of shared lines.</narrative>
   <narrative xml:lang="FR"></narrative>
  </description>
