  <result type="1">
   <title>
    <narrative xml:lang="EN"># of people receiving direct assistance via humanitarian programmes, disaggregated by region/country</narrative>
   </title>
   <description>
    <narrative xml:lang="EN">The indicator documents the number of people directly reached via humanitarian programmes. This includes people provided with tangible goods and materials, services and supported through activities designed to raise knowledge, awareness and skills. The indicator does not count people reached indirectly, such as those benefiting from enhanced capacity of institutions, or those affected by policy changes.</narrative>
   </description>
   <indicator ascending="1" measure="3">
    <title>
     <narrative xml:lang="EN"># of people receiving direct assistance via humanitarian programmes, disaggregated by region/country</narrative>
