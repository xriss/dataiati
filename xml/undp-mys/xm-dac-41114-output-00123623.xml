   <indicator aggregation-status="1" ascending="0" measure="1">
    <title>
     <narrative xml:lang="EN">M&amp;E framework of SDG Roadmap</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">An initial framework for country led evaluations that will evolve in parallel with refinements to the overall SDG follow-up and review mechanism adapted to the priorities and capacities in the current system. The evaluation design and approach combines the collection of a basic set of quantitative indicators (SDG indicators) with more in-depth qualitative measures that reflect the complex, multi-dimensional and context of the country.</narrative>
    </description>
    <baseline value="0" year="2020"></baseline>
