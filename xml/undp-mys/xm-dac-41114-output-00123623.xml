   <indicator aggregation-status="1" ascending="0" measure="1">
    <title>
     <narrative xml:lang="EN">National SDG Profile</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">Advancing Malaysia&#x2019;s SDG agenda by identifying linkages across &#x2018;priority areas&#x2019; and &#x2018;critical enablers&#x2019;, providing synergistic benefits and SDG target setting. Executed via NIM with EPU as the main beneficiary with funding from the Joint SDG Trust Fund and Government Cost Sharing.</narrative>
    </description>
