  <result aggregation-status="1" type="1">
   <title>
    <narrative xml:lang="EN">Annual Output Results</narrative>
   </title>
   <indicator ascending="0" measure="5">
    <title>
     <narrative xml:lang="EN">Output Indicator</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">1. Connections between youth environmental movers and advocates across the nation and region 
2. Advocacy on issues of concern, youth empowerment, climate and environmental futures, and SDG localisation
3. Action learning projects in collaboration with youth organizations, institutions of learning and other partners
4. Documentation of learnings, wins and losses, successes and failures</narrative>
    </description>
    <baseline year="2021">
     <comment>
      <narrative xml:lang="EN">1. Youth environmental movers and advocates are not adequately connected
2. Youth advocacy on issues of concern regarding the environment is weak
3. Action learning projects on the environment are done in isolation
4. Absence of documentation that can feed into additional learning</narrative>
     </comment>
    </baseline>
    <period>
     <period-start iso-date="2021-01-01"></period-start>
     <period-end iso-date="2021-12-31"></period-end>
     <target>
      <comment>
       <narrative xml:lang="EN">1. Framework for YELL Phase II (2022 onwards) developed and validated with partners onboard
2. Resources for youth-led action developed: public competition on local environmental stories, registry of youth movers with stories to inspire, youth starter kit, registry of local solutions</narrative>
      </comment>
     </target>
     <actual>
      <comment>
       <narrative xml:lang="EN">1. Framework for YELL Phase II (2022 onwards) developed and validated with partners onboard - completed
2. Resources for youth-led action developed: public competition on local environmental stories, registry of youth movers with stories to inspire, youth starter kit, registry of local solutions - completed</narrative>
      </comment>
     </actual>
    </period>
    <period>
     <period-start iso-date="2022-01-01"></period-start>
     <period-end iso-date="2022-12-31"></period-end>
     <target>
      <comment>
       <narrative xml:lang="EN">No targets for 2022 as the project is slated to be Operationally Closed by 31 Mar 22.</narrative>
      </comment>
     </target>
    </period>
   </indicator>
