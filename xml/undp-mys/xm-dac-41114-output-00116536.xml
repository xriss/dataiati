   <indicator ascending="0" measure="5">
    <title>
     <narrative xml:lang="EN">Output Indicator</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">one digital solution developed for each thematic area: sustainable tourism; ethical fashion; smart cities</narrative>
    </description>
    <baseline year="2019">
     <comment>
      <narrative xml:lang="EN">no UN TIL-supported digital solution developed in each thematic area: sustainable tourism; ethical fashion; smart cities</narrative>
     </comment>
    </baseline>
    <period>
     <period-start iso-date="2020-01-01"></period-start>
     <period-end iso-date="2020-12-31"></period-end>
     <target>
      <comment>
       <narrative xml:lang="EN">Developing a digital solution per thematic area: 
1) eco-friendly tourism solutions inside the Iskandar region;
2) portal for ethical fashion Malaysian designer brands; 
3) integrating Smart Cities indicators in new urban developments.</narrative>
      </comment>
     </target>
     <actual>
      <comment>
       <narrative xml:lang="EN">1) Exploration to develop a tourism platform rating system of the eco-friendliness of local tour operators and sites in the Iskandar region
2) Prototype portal was developed
3) Partnership development with interested stakeholders is ongoing</narrative>
      </comment>
     </actual>
    </period>
    <period>
     <period-start iso-date="2021-01-01"></period-start>
     <period-end iso-date="2021-12-31"></period-end>
     <target>
      <comment>
       <narrative xml:lang="EN">Subjected to UN Secretariats decision by the DSG on the potential merger of UNTIL with GlobalLabs, this project will remain until a decision is received and to acquit or transfer the funds as necessary.</narrative>
      </comment>
     </target>
     <actual>
      <comment>
       <narrative xml:lang="EN">Based on decision of the DSG for GlobalLabs to absorb UNTIL, this project will be closed in 2021 after clearing payments of residual contracts and obligations</narrative>
      </comment>
     </actual>
    </period>
   </indicator>
  </result>
