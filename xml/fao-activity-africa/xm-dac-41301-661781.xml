  <reporting-org ref="XM-DAC-41301" type="40">
   <narrative xml:lang="EN">Food and Agriculture Organization (FAO)</narrative>
  </reporting-org>
  <title>
   <narrative xml:lang="EN">FAO AgrInvest initiative in support to the Uganda Development Bank (UDB)</narrative>
  </title>
  <description type="2">
   <narrative xml:lang="EN">The project aims to increase private investments in the agriculture and agribusiness sectors of Uganda through an enhanced capacity of the Uganda Development Bank (UDB) and public-private policy dialogue. This support will aim at (i) de-risking UDB agricultural lending; (ii) enhancing UDB portfolio in terms of quality and scope; (iii) making some of UDB operations and processes more efficient and, (iv) enhance the policy environment to enable responsible private investments in agriculture and agribusiness.</narrative>
  </description>
