  <reporting-org ref="XM-DAC-41301" type="40">
   <narrative xml:lang="EN">Food and Agriculture Organization (FAO)</narrative>
  </reporting-org>
  <title>
   <narrative xml:lang="EN">Rollout of AgrInvest and HiHi initiatives for increased Private Investment and sustainable employment  in Eswatini</narrative>
  </title>
  <description type="2">
   <narrative xml:lang="EN">To increase private investment in the agricultural and food sectors (production, aggregation, processing, and distribution) and in associated services industries (e.g., logistics, inputs, testing services) through roll out of AgrInvest and mainstreaming of HiHi initiative that facilitates  risk reduction mechanisms, the adaptation of investment financial products, and improvement in the effectiveness of investment support measures in the national agricultural investment process in Eswatini</narrative>
  </description>
