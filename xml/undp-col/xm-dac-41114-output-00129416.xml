   <indicator aggregation-status="1" ascending="0" measure="1">
    <title>
     <narrative xml:lang="ES">N&#xfa;mero de candidatos a elecci&#xf3;n popular de entidades territoriales que incorporan en sus propuestas de gobierno pol&#xed;ticas y acciones orientadas a implementar el acuerdo final de paz</narrative>
