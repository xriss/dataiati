  <result aggregation-status="1" type="1">
   <title>
    <narrative xml:lang="ES">Annual Output Results</narrative>
   </title>
   <indicator aggregation-status="1" ascending="0" measure="1">
    <title>
     <narrative xml:lang="ES">N&#xfa;mero de mujeres en proceso de reincorporaci&#xf3;n que se benefician de acciones de protecci&#xf3;n dentro de la implementaci&#xf3;n de la ruta de g&#xe9;nero</narrative>
    </title>
    <description>
     <narrative xml:lang="ES">Las acciones de protecci&#xf3;n corresponden a i. la definici&#xf3;n y adopci&#xf3;n de medidas de autoprotecci&#xf3;n; ii. Incidencia pol&#xed;tica mediante la presentaci&#xf3;n de recomendaciones a instancias relevantes; iii. La reconfiguraci&#xf3;n de la estrategia de seguridad; iv. fortalecimiento de capacidades de an&#xe1;lisis en la gesti&#xf3;n de riesgos individuales y colectivos.</narrative>
    </description>
    <baseline value="0" year="2022"></baseline>
