     <target value="316"></target>
     <actual value="450"></actual>
    </period>
   </indicator>
   <indicator aggregation-status="1" ascending="0" measure="1">
    <title>
     <narrative xml:lang="ES">N&#xfa;mero de proyectos productivos que incorporan acciones de econom&#xed;a del cuidado y/o empoderamiento</narrative>
    </title>
    <description>
     <narrative xml:lang="ES">Se entiende por acciones de econom&#xed;a del cuidado y /o empoderamiento:
Empoderamiento: iniciativas econ&#xf3;micas lideradas por mujeres.
Acciones de econom&#xed;a del cuidado: espacios de cuidado y acciones afirmativas que se definen a nivel de protocolos 8 corresponden a compras, transporte, participaci&#xf3;n en comit&#xe9;s, giras, espacios de capacitaci&#xf3;n, condiciones para el cuidado de ni&#xf1;os, kits).</narrative>
    </description>
