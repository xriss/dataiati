    <baseline year="2021">
     <comment>
      <narrative xml:lang="ES">0</narrative>
     </comment>
    </baseline>
    <period>
     <period-start iso-date="2022-01-01"></period-start>
     <period-end iso-date="2022-12-31"></period-end>
     <target>
      <comment>
       <narrative xml:lang="ES">2022: 1.700.000 tarjetas impresas</narrative>
      </comment>
     </target>
     <actual>
      <comment>
       <narrative xml:lang="ES">A la fecha, la operaci&#xf3;n es completamente estable y se est&#xe1; cumpliendo con la meta planteada de parte de Migraci&#xf3;n Colombia. El dato oficial de impresiones a 9 de noviembre de 2022 es de 1.660.321 tarjetas.</narrative>
      </comment>
     </actual>
    </period>
    <period>
     <period-start iso-date="2021-01-01"></period-start>
     <period-end iso-date="2021-12-31"></period-end>
     <target>
      <comment>
       <narrative xml:lang="ES">2021: 800.000 tarjetas impresas</narrative>
      </comment>
     </target>
     <actual>
      <comment>
       <narrative xml:lang="ES">Migraci&#xf3;n Colombia cambi&#xf3; la meta de impresiones teniendo en cuenta adem&#xe1;s del proceso de instalaci&#xf3;n y configuraci&#xf3;n de las impresoras, el proceso de implementaci&#xf3;n de nuevos procedimientos operativos en la entidad. Para cierre del 2021 se imprimieron 230124 tarjetas.</narrative>
      </comment>
     </actual>
    </period>
   </indicator>
