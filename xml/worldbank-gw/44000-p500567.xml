  <result aggregation-status="0" type="1">
   <title>
    <narrative xml:lang="EN">Intermediate Results Indicator</narrative>
   </title>
   <indicator ascending="1" measure="2">
    <title>
     <narrative xml:lang="EN">Tax revenue as a percentage of GDP</narrative>
    </title>
    <baseline iso-date="2023-12-15" value="8.7" year="2023"></baseline>
    <period>
     <period-start iso-date="2023-12-15"></period-start>
     <period-end iso-date="2026-12-15"></period-end>
     <target value="9.4">
      <comment>
       <narrative xml:lang="EN">Tax revenue are projected to slightly increase to 8.9 percent of GDP in 2025, reflecting higher cashew nuts revenue. However this progress has been partly offset by lower income taxes, due mainly to deduction claimed by a telecom company.</narrative>
      </comment>
     </target>
     <actual value="8.9"></actual>
    </period>
   </indicator>
  </result>
  <result aggregation-status="0" type="1">
   <title>
    <narrative xml:lang="EN">Intermediate Results Indicator</narrative>
   </title>
   <indicator ascending="1" measure="1">
    <title>
     <narrative xml:lang="EN">GW of renewable energy capacity enabled</narrative>
    </title>
    <baseline iso-date="2024-06-15" value="0" year="2024"></baseline>
    <period>
     <period-start iso-date="2024-06-15"></period-start>
     <period-end iso-date="2026-12-15"></period-end>
     <target value="20">
      <comment>
       <narrative xml:lang="EN">The target has been achieved. The energy generation mix shifted from heavy fuel oil (HFO) to 100% hydropower supplied through OMVG, marking a complete transition to cleaner energy.</narrative>
      </comment>
     </target>
     <actual value="20"></actual>
    </period>
   </indicator>
  </result>
  <result aggregation-status="0" type="1">
   <title>
    <narrative xml:lang="EN">Intermediate Results Indicator</narrative>
   </title>
   <indicator ascending="1" measure="1">
    <title>
     <narrative xml:lang="EN">Average cost of electricity per kWh</narrative>
    </title>
    <baseline iso-date="2024-06-15" value="24 cents USD/ kWh" year="2024"></baseline>
    <period>
     <period-start iso-date="2024-06-15"></period-start>
     <period-end iso-date="2026-12-15"></period-end>
     <target value="18 cents USD/ kWh">
      <comment>
       <narrative xml:lang="EN">The target has been exceeded. Energy generation costs declined following the transition from Karpower to OMVG, as Guinea&apos;s hydropower offers a significantly cheaper source of electricity.</narrative>
      </comment>
     </target>
     <actual value="11 cents USD/kWh"></actual>
    </period>
   </indicator>
  </result>
  <result aggregation-status="0" type="1">
   <title>
    <narrative xml:lang="EN">Intermediate Results Indicator</narrative>
   </title>
   <indicator ascending="1" measure="2">
    <title>
     <narrative xml:lang="EN">Operating deficit of the national utility company Electricity and Water of Guinea-Bissau (EAGB) as a percentage of revenue.</narrative>
    </title>
    <baseline iso-date="2024-06-15" value="50 percent" year="2024"></baseline>
    <period>
     <period-start iso-date="2024-06-15"></period-start>
     <period-end iso-date="2026-12-15"></period-end>
     <target value="40 percent">
      <comment>
       <narrative xml:lang="EN">The target has been exceeded. Through the SESAP project, international experts were hired to manage the utility. The SESAP project team reported that effective management performance and initiatives, including successful client debt recovery and the implementation of pre-paid meters have led to increased revenue and reduced commercial losses. Combined with a reduction in generation costs, the utility shifted from a deficit of approximately 50% to achieving a positive monthly balance (starting June 2025).</narrative>
      </comment>
     </target>
     <actual value="0"></actual>
    </period>
   </indicator>
  </result>
  <result aggregation-status="0" type="1">
   <title>
    <narrative xml:lang="EN">Intermediate Results Indicator</narrative>
   </title>
   <indicator ascending="1" measure="5">
    <title>
     <narrative xml:lang="EN">Share of civil servants and pensioners with biometric identification included in the SIGRHAP database</narrative>
    </title>
    <baseline iso-date="2024-06-15" value="7.6" year="2024"></baseline>
    <period>
     <period-start iso-date="2024-06-15"></period-start>
     <period-end iso-date="2026-12-15"></period-end>
     <target value="&amp;gt;90 percent">
      <comment>
       <narrative xml:lang="EN">There are 33,207 records of civil servants and pensioners in SIGRHAP, of which 11,123 have a biometric national ID registered.</narrative>
      </comment>
     </target>
     <actual value="33.49"></actual>
    </period>
   </indicator>
  </result>
  <result aggregation-status="0" type="1">
   <title>
    <narrative xml:lang="EN">Intermediate Results Indicator</narrative>
   </title>
   <indicator ascending="1" measure="2">
    <title>
     <narrative xml:lang="EN">Price of a data-only 2GB mobile-broadband basket (% of monthly GNI per capita)</narrative>
    </title>
    <baseline iso-date="2024-06-15" value="9.8" year="2024"></baseline>
    <period>
     <period-start iso-date="2024-06-15"></period-start>
     <period-end iso-date="2026-12-15"></period-end>
     <target value="8.8">
      <comment>
       <narrative xml:lang="EN">The target has been exceeded. The publication of Decree No. 06/2025 on March 12, 2025, signaled the Government&apos;s commitment to a competitive and efficiently managed wholesale market. This clear policy direction helped foster expectations of future cost reductions, encouraged operators to optimize existing network capacity, and stimulated early competition and negotiations on wholesale access leading to a decrease of the price.</narrative>
      </comment>
     </target>
     <actual value="8.54"></actual>
    </period>
   </indicator>
  </result>
  <result aggregation-status="0" type="1">
   <title>
    <narrative xml:lang="EN">Intermediate Results Indicator</narrative>
   </title>
   <indicator ascending="1" measure="5">
    <title>
     <narrative xml:lang="EN">The frequency the of online publication of consolidated and audited fiscal reports</narrative>
    </title>
    <baseline iso-date="2024-06-15" value="Ad hoc" year="2024"></baseline>
    <period>
     <period-start iso-date="2024-06-15"></period-start>
     <period-end iso-date="2026-12-15"></period-end>
     <target value="Semi-annual">
      <comment>
       <narrative xml:lang="EN">A semi-annual report on budget execution, fiscal and non-fiscal revenues, and cash flow forecasts, covering the first half of 2025 has been validated by the treasury committee on November, 5 2025, and is yet to be published.</narrative>
      </comment>
     </target>
     <actual value="0"></actual>
    </period>
   </indicator>
  </result>
