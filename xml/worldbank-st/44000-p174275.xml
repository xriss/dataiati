    </title>
    <baseline iso-date="2019-12-15" value="20" year="2019">
     <comment>
      <narrative xml:lang="EN"></narrative>
     </comment>
    </baseline>
    <period>
     <period-start iso-date="2019-12-15"></period-start>
     <period-end iso-date="2023-12-15"></period-end>
     <target value="100">
      <comment>
       <narrative xml:lang="EN">Met. Compliance has been sustained, with the percentage of banks complying with the regulations still at a 100 percent by October 2024.</narrative>
      </comment>
     </target>
     <actual value="100"></actual>
    </period>
