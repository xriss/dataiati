   <indicator ascending="1" measure="2">
    <title>
     <narrative xml:lang="EN">Reduction in the dropout rate of girls in secondary school</narrative>
    </title>
    <baseline iso-date="2018-12-14" value="13.2" year="2018">
     <comment>
      <narrative xml:lang="EN"></narrative>
     </comment>
    </baseline>
    <period>
     <period-start iso-date="2018-12-14"></period-start>
     <period-end iso-date="2023-12-14"></period-end>
     <target value="8.5">
      <comment>
       <narrative xml:lang="EN">Not met. But significant results achieved. However, the baseline for 2018 was revised to 25.5 percent. Hence the reduction in the dropout rate of girls in secondary education by 11.4 percentage points is a significant result, more ambitious that the reduction by 4.7 percentage points envisaged under this Results Framework.</narrative>
      </comment>
     </target>
     <actual value="14.1"></actual>
    </period>
   </indicator>
  </result>
