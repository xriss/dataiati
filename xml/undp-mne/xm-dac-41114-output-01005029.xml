  <result aggregation-status="1" type="1">
   <title>
    <narrative xml:lang="EN">Annual Output Results</narrative>
   </title>
   <indicator aggregation-status="1" ascending="0" measure="5">
    <title>
     <narrative xml:lang="EN">Amendments to the existing bylaw that defines the requirements for police uniforms (Rulebook) in accordance with operational requirements and international standards endorsed</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">This indicator measures whether the existing bylaw that defines the requirements for police uniforms (Rulebook on the appearance, technical specifications, type of material, manner of wearing, and service life of police officers&apos; uniforms, and the Rulebook on the appearance, technical specifications, type of material, manner of wearing, and service life of uniforms for police officers performing special duties) has been officially amended and formally approved by the relevant authorities. It reflects progress in establishing a regulatory framework that supports standardization, operational effectiveness, and alignment with international best practices in police uniform provision and management.</narrative>
    </description>
    <baseline year="2025">
     <comment>
      <narrative xml:lang="EN">0</narrative>
     </comment>
    </baseline>
    <period>
     <period-start iso-date="2026-01-01"></period-start>
     <period-end iso-date="2026-12-31"></period-end>
     <target>
      <comment>
       <narrative xml:lang="EN">1</narrative>
      </comment>
     </target>
    </period>
   </indicator>
   <indicator aggregation-status="1" ascending="0" measure="5">
    <title>
     <narrative xml:lang="EN">Police uniform design finalized and approved</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">This indicator tracks whether a standardized, modern police uniform design has been developed by a qualified designer and formally approved by the Ministry of the Interior and Police Directorate. It ensures that uniforms procured align with professional and functional requirements.</narrative>
    </description>
    <baseline year="2025">
