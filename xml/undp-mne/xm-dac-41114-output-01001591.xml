   <indicator aggregation-status="1" ascending="0" measure="5">
    <title>
     <narrative xml:lang="EN">Set of recommendations developed</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">Developed set of recommendations for the improvement of the merit-based performance management and protection of whistleblowers in public administration</narrative>
    </description>
    <baseline year="2023">
     <comment>
      <narrative xml:lang="EN">Currently, the system of performance management is underdeveloped and the topic whistleblowers protection in public sector is not being addressed.</narrative>
     </comment>
    </baseline>
