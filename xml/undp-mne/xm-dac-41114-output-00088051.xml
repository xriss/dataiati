  <result aggregation-status="1" type="1">
   <title>
    <narrative xml:lang="EN">Annual Output Results</narrative>
   </title>
   <indicator ascending="0" measure="5">
    <title>
     <narrative xml:lang="EN">Output Indicator</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">1. Number of legal acts/documents or amendments to the legal documents/acts in the field of regional and rural development drafted; 
2. Number of  Action plans for the implementation of the Municipal Development Strategies drafted;
3. Number of  project fiches developed (in line with the national and local priorities and having strong emphasis on regional and rural development, Inter-municipal cooperation); 
4. Number of trainings, exchange of experiences, regional conferences,  study tours, mentoring organized in strengthening national and local capacities for strategic and project development; 
5. Number of municipalities supported in populating Electronic database of development projects.</narrative>
    </description>
    <baseline year="2013">
     <comment>
      <narrative xml:lang="EN">Limited general strategic and project development capacities within the municipalities (some trainings and mentoring were organized by international organisations). None of the municipalities prepared Action plan for the implementation of the Municipal Development Strategies (Ministry of Economy). The   Electronic database of development projects  has just been launched, therefore none of the municipalities have started populating it (Ministry of Economy).</narrative>
     </comment>
    </baseline>
    <period>
     <period-start iso-date="2021-01-01"></period-start>
     <period-end iso-date="2021-12-31"></period-end>
     <target>
      <comment>
       <narrative xml:lang="EN">1. Provide expert assistance to the Ministry of Economic Development in the preparation of strategic and policy documents; 2. Provide further consultancy support to the selected Montenegrin municipalities in the preparation of strategic development plans; 3. Provide assistance to the Ministry of Economic Development in the preparation, promotion and implementation of technical and financial support to entrepreneurs and MSMEs, inclusive of the support to clusters; 4. Support the Ministry in the implementation and promotion of the concept of national brand; 5. Raise professional capacities of the Ministrys staff in the relevant sector fields.</narrative>
      </comment>
     </target>
     <actual>
      <comment>
       <narrative xml:lang="EN">1. Expert assistance provided to the Ministry of Economic Development in the preparation of legal and policy documents in the area of regional development; 2. Further consultancy support provided to the selected Montenegrin municipalities in the preparation of strategic development plans - two new municipalities involved in the process and three plans finalized in 2021; 3. Assistance provided to the Ministry of Economic Development in the preparation, promotion and implementation of technical and financial support to entrepreneurs and MSMEs through the creation of online platform for application and accompanying brochure.</narrative>
      </comment>
     </actual>
    </period>
    <period>
     <period-start iso-date="2022-01-01"></period-start>
     <period-end iso-date="2022-12-31"></period-end>
     <target>
      <comment>
       <narrative xml:lang="EN">1. Provide expert assistance to the Ministry of Economic Development in the preparation of strategic and policy documents; 2. Provide further consultancy support to the selected Montenegrin municipalities in the preparation of strategic development plans and calculation of competitiveness index; 3. Provide assistance to the Ministry of Economic Development in the preparation, promotion and implementation of technical and financial support to entrepreneurs and MSMEs, inclusive of the support to clusters; 4. Provide support the Ministry in the implementation and promotion of the concept of national brand.</narrative>
      </comment>
     </target>
     <actual>
      <comment>
       <narrative xml:lang="EN">1. Expert assistance provided to the Ministry of Economic Development in the preparation of strategic and policy documents related to revitalization and development of processing industry and development of craftsmanship in Montenegro; 2. Further consultancy support provided to the selected Montenegrin municipalities in the preparation of strategic development plans (six ongoing) and calculation of competitiveness index; 3. Assistance provided to the Ministry of Economic Development in the preparation, promotion and implementation of technical and financial support to entrepreneurs and MSMEs, through upgrade of online platform; 4. Support provided to the Ministry in the implementation and promotion of the concept of national brand through the initiation of the process of establishing Montenegrin house.</narrative>
      </comment>
     </actual>
    </period>
    <period>
     <period-start iso-date="2020-01-01"></period-start>
     <period-end iso-date="2020-12-31"></period-end>
     <target>
      <comment>
       <narrative xml:lang="EN">1. Support provided to the Ministry of Economy in the preparation of strategic documents in the area of entrepreneurship; 
2. Further support provided to selected municipalities in preparation of strategic development plans; 
3. Support provided to the Ministry of Economy in the implementation of the concept of national brand.</narrative>
      </comment>
     </target>
     <actual>
      <comment>
       <narrative xml:lang="EN">1. Expert support provided to the Ministry of Economy in the preparation of strategic documents in the area of womens entrepreneurship, entrepreneurial learning and assistance to MSMEs; 
2. Further support provided to selected municipalities in preparation of strategic development plans (two new municipalities involved in the process in 2020); 
3. Support provided to the Ministry of Economy in the implementation of the concept of national brand through assistance in the preparation and implementation of public opinion survey on national brand.</narrative>
      </comment>
     </actual>
    </period>
   </indicator>
