   <title>
    <narrative xml:lang="EN">Annual Output Results</narrative>
   </title>
   <indicator aggregation-status="1" ascending="0" measure="5">
    <title>
     <narrative xml:lang="EN">FDA received equipment for collaborative forest monitoring including remote sensing technologies and carbon monitoring tool to promote biodiversity and forest monitoring in Protected Areas</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">Reforestation processes will start within FDA-Communities  by planting targeted hectares of indigenous trees in degraded of forest landscapes in PAs.</narrative>
    </description>
    <baseline year="2022">
     <comment>
      <narrative xml:lang="EN">0</narrative>
     </comment>
    </baseline>
    <period>
     <period-start iso-date="2024-01-01"></period-start>
     <period-end iso-date="2024-12-31"></period-end>
     <target>
      <comment>
       <narrative xml:lang="EN">In the short run, the CBFM project will ensure that the capacities of the communities and FDA staff are strengthened through the provision of 25 motor bikes, GPS, Cameras, 15 tablets, rain gear sets, camp beds, remote sensing technologies and carbon monitoring tool to promote biodiversity and forest monitoring in Protected Areas.</narrative>
      </comment>
     </target>
     <actual>
      <comment>
       <narrative xml:lang="EN">100%</narrative>
      </comment>
     </actual>
    </period>
   </indicator>
   <indicator aggregation-status="1" ascending="0" measure="5">
    <title>
     <narrative xml:lang="EN">Climate-resilient livelihoods initiatives implemented in targeted forest communities (at least 1 per Forest community engaged).  3.1b: Number of persons with increased income through sustainable alternative livelihood activities</narrative>
