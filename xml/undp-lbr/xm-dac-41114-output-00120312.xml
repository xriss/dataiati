  <result aggregation-status="1" type="1">
   <title>
    <narrative xml:lang="EN">Annual Output Results</narrative>
   </title>
   <indicator ascending="0" measure="5">
    <title>
     <narrative xml:lang="EN">Output Indicator</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">Number of approved policies and action plans developed for oil palm production</narrative>
    </description>
    <baseline year="2020">
     <comment>
      <narrative xml:lang="EN">0</narrative>
     </comment>
    </baseline>
    <period>
     <period-start iso-date="2022-01-01"></period-start>
     <period-end iso-date="2022-12-31"></period-end>
     <target>
      <comment>
       <narrative xml:lang="EN">-Conduct training of community structures for Biodiversity Conservation at 2 protected areas

- Support the consolidation of studies on Liberia&#x2019;s Biodiversity and create a National Biodiversity Repository.

- Hire CSO/firm to develop 2 County and District Environmental Action Plans for Lofa, and
Grand Gedeh counties</narrative>
      </comment>
     </target>
     <actual>
      <comment>
       <narrative xml:lang="EN">- Training for community structures for biodiversity conservation conducted at Kpatawee and Lake Piso Nature Reserves, resulting to improvement in tourist satisfaction and wildlife conservation.
- One stop-shop for biodiversity information established
- County and District environmental action plans developed resulting to identification of environmental issues in the counties and appropriate actions to be taken known.</narrative>
      </comment>
     </actual>
    </period>
    <period>
     <period-start iso-date="2020-01-01"></period-start>
     <period-end iso-date="2020-12-31"></period-end>
     <target>
      <comment>
       <narrative xml:lang="EN">One approved policy and action plan developed for oil palm production</narrative>
      </comment>
     </target>
     <actual>
      <comment>
       <narrative xml:lang="EN">National Strategy and Action Plan for Oil Palm, Roundtable for Sustainable Palm Oil National Interpretation and Conservation Agreement Regulations developed.</narrative>
      </comment>
     </actual>
    </period>
    <period>
     <period-start iso-date="2021-01-01"></period-start>
     <period-end iso-date="2021-12-31"></period-end>
     <target>
      <comment>
       <narrative xml:lang="EN">Approval and implementation of the National Strategy and Action Plan for Oil Palm, Roundtable for Sustainable Palm Oil National Interpretation and Conservation Agreement Regulations.

A standard curriculum for tourism developed for use by tourism institutions</narrative>
      </comment>
     </target>
     <actual>
      <comment>
       <narrative xml:lang="EN">There is now an approved National Strategy and Action Plan for Oil Palm and RSPO, National Interpretation and Conservation Agreements were developed and endorsed. The implementation of these national documents are expected to enhance sustainable oil palm production and reduce deforestation from oil palm production.

The standard curriculum for tourism for use by institutions was abandoned.</narrative>
      </comment>
     </actual>
    </period>
   </indicator>
