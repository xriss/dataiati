  <result aggregation-status="1" type="1">
   <title>
    <narrative xml:lang="EN">Annual Output Results</narrative>
   </title>
   <indicator aggregation-status="1" ascending="0" measure="5">
    <title>
     <narrative xml:lang="EN">1.2: No of hectares of forest set aside for conservation through the CCA 1.3: Percent increase in revenue for forest-based processed products</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">The main objective of this outcome is to pilot a Community Conservation Agreement (CCA) as an incentive-based model that can promote sustainable, and nature based (forest friendly and climate resilient) livelihoods through which communities are able to establish conservation areas within community forest and promote sustainable forestry practices that are ecologically sound and economically viable.</narrative>
    </description>
    <baseline year="2024">
     <comment>
