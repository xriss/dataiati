   <title>
    <narrative xml:lang="EN">InteIntermediate Results Indicator</narrative>
   </title>
   <indicator ascending="1" measure="2">
    <title>
     <narrative xml:lang="EN">7: Share of urban municipalities covered by planning instruments integrating climate and disaster risk management considerations (percentage)</narrative>
    </title>
    <baseline iso-date="2022-12-01" value="0" year="2022">
     <comment>
      <narrative xml:lang="EN"></narrative>
     </comment>
    </baseline>
    <period>
     <period-start iso-date="2022-12-01"></period-start>
     <period-end iso-date="2027-06-15"></period-end>
     <target value="&amp;gt;25">
      <comment>
       <narrative xml:lang="EN">Implementation is progressing, though slightly behind schedule. Ten major urban centers are currently developing Urban Development Master Plans (SDAUS/SDAU) that integrate climate and disaster risk considerations. Diagnostic phases have been validated and first drafts transmitted. Public consultations are expected by April 2026. While the current coverage of 10% is below the &amp;gt;25% end target, the pipeline of plans under development is sufficient for the target to be achieved by program close in 2027, provided momentum is maintained.</narrative>
      </comment>
     </target>
     <actual value="10"></actual>
    </period>
   </indicator>
  </result>
