  <iati-identifier>XM-DAC-41123-PROJECT-230313</iati-identifier>
  <reporting-org ref="XM-DAC-41123" type="40">
   <narrative xml:lang="EN">United Nations Industrial Development Organization</narrative>
  </reporting-org>
  <title>
   <narrative xml:lang="EN">National inventory of banks of used or unwanted controlled substances and a plan</narrative>
  </title>
  <description type="1">
   <narrative xml:lang="EN">The project will build on previous efforts under the HCFC Phase-out Management Plan to establish an inventory of unwanted refrigerants. The project activities include: conducting surveys across manufacturing, firefighting and foam sectors to quantify unwanted controlled substances; analyzing the data collected; preparing an inventory report; defining national priorities for managing unwanted substances; and developing a comprehensive action plan including activities for collection, transport and disposal along with required policy and institutional measures.</narrative>
  </description>
