  <title xml:lang="EN">
   <narrative xml:lang="EN">Enhanced Financial Intermediation for Jobs</narrative>
  </title>
  <description type="1" xml:lang="EN">
   <narrative xml:lang="EN">The project aims to support the PDO by enhancing BANDESAL&apos;s: 1) tier-2 lending to financial institutions to on-lend to MSMEs;  2) partial credit guarantees for financial institutions for their MSME loans; 3) technical assistance to strengthen MSMEs capabilities and market linkages; and 4) project management.</narrative>
  </description>
  <description type="2" xml:lang="EN">
   <narrative xml:lang="EN">To enhance micro, small, and medium enterprises lending in support of job growth</narrative>
  </description>
