  </tag>
  <tag code="11.4" vocabulary="3">
   <narrative xml:lang="EN">11.4 - Strengthen efforts to protect and safeguard the world&#x2019;s cultural and natural heritage.</narrative>
   <narrative xml:lang="SV">11.4 - St&#xe4;rka insatserna f&#xf6;r att skydda och trygga v&#xe4;rldens kultur- och naturarv.</narrative>
  </tag>
  <tag code="16.1" vocabulary="3">
