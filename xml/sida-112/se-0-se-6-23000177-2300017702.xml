  <title>
   <narrative xml:lang="SV">St&#xf6;d  till Administra&#xe7;&#xe3;o Nacional de Estradas     (ANE), 2006 - 2014.</narrative>
   <narrative xml:lang="EN">Support to Administra&#xe7;&#xe3;o Nacional de Estradas     (ANE), 2006 - 2014. - Monitoring</narrative>
