  <reporting-org ref="NZ-1" type="10">
   <narrative xml:lang="EN">New Zealand Ministry of Foreign Affairs and Trade</narrative>
  </reporting-org>
  <title>
   <narrative xml:lang="EN">Timor-Leste Individual Short Term Training Scholarships Allocations for 2024/25 - 2026/27 Triennium</narrative>
  </title>
  <description type="1">
   <narrative xml:lang="EN">This Activity aims to increase the knowledge and skills of individuals so that they can contribute to the development of Timor-Leste, and to positively impact the bilateral relationship by providing short term scholarships (for no less than one week up to a maximum of 12 months in length) to scholars from Timor-Leste. These short-term scholarships can take the form of vocational training, an apprenticeship, or other workplace experience.</narrative>
  </description>
