   <document-link format="APPLICATION/PDF" url="https://www.adb.org/sites/default/files/project-documents/38176/38176-015-pcr-en.pdf">
    <title>
     <narrative xml:lang="EN">Project/Program Completion Report</narrative>
    </title>
    <category code="A08"></category>
    <language code="EN"></language>
