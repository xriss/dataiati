 <iati-activity default-currency="USD" hierarchy="1" humanitarian="0" iati-activities:linked-data-default="http://data-service.theglobalfund.org/api" iati-activities:version="2.03" xml:lang="EN" xmlns:iati-activities="http://d-portal.org/xmlns/iati-activities" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
