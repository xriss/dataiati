   <title>
    <narrative xml:lang="EN">Project Outcome</narrative>
   </title>
   <description>
    <narrative xml:lang="EN">Priority populations of Sri Lanka vaccinated against COVID-19 as per the NDVP without compromising routine vaccine service and other health services.</narrative>
   </description>
   <indicator measure="2">
    <title>
     <narrative xml:lang="EN">Indicator 1</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">At least 18.2% of population fully vaccinated against COVID-19 
Achievement: 40 
Progress/Status: a) 33.85% of the population were fully vaccinated. Target
exceeded. Sex, age, province, and district disaggregated data is available. 
Data Source: Routine data from the Epidemiology Unit of the Ministry of Health and the newly introduced VIMS for COVID-19</narrative>
    </description>
    <baseline value="0" year="2021"></baseline>
    <period>
     <period-start iso-date="2024-01-01"></period-start>
     <period-end iso-date="2024-12-31"></period-end>
     <target value="18.2"></target>
     <actual value="40"></actual>
    </period>
   </indicator>
   <indicator measure="2">
    <title>
     <narrative xml:lang="EN">Indicator 2</narrative>
    </title>
    <description>
