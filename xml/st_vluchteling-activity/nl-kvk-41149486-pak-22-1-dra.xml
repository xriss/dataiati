  <result aggregation-status="1" type="1">
   <title>
    <narrative xml:lang="EN">HEA-R7: Number of children who received community based treatment for malaria, diarrhoea and/or acute respiratory infections</narrative>
   </title>
   <indicator aggregation-status="1" ascending="1" measure="1">
    <title>
     <narrative xml:lang="EN">HEA-I7: Number of children who received community based treatment for malaria, diarrhoea and/or acute respiratory infections</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">Hiring and training of community health workers on ICCM, Protection mainstreaming (health sector checklist)
- Screening and community based treatment of 4.000 children under 5 according to Integrated Community Case Management (ICCM) guidelines and principles
- Provision of long-lasting insecticidal nets (LLIN), diarrheal disease kits, and acute respiratory kits
- Community based session on precautions, prevention and treatment of malaria, diarrhoea and/or acute respiratory infections</narrative>
    </description>
