  <result aggregation-status="1" type="1">
   <title>
    <narrative xml:lang="EN">R2-Children have a safe and secure space were seeking refuge during the alerts threat</narrative>
   </title>
   <indicator aggregation-status="1" ascending="1" measure="1">
    <title>
     <narrative xml:lang="EN"># of basements rehabilitated</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">Rehabilitation of a basement serving as bomb shelter for all patients (up to 390 evacuated children), their families and staff during air alarms; incl. electrical, ventilation, floor, plastering, painting and cleaning works.</narrative>
    </description>
    <baseline iso-date="2022-03-21" value="0" year="2022"></baseline>
    <period>
     <period-start iso-date="2022-03-21"></period-start>
     <period-end iso-date="2022-09-20"></period-end>
     <target value="1"></target>
     <actual value="1"></actual>
    </period>
   </indicator>
  </result>
  <result aggregation-status="1" type="1">
   <title>
    <narrative xml:lang="EN">R1- IDPs fleeing Central and Eastern Ukraine receiving shelter and lifesaving support (NFI, food, information and advice) when transiting in 2 reception points in the city of Lviv and having access to a holistic and integrated package of high-quality health care and protection monitoring and information.</narrative>
   </title>
   <indicator aggregation-status="1" ascending="1" measure="1">
    <title>
     <narrative xml:lang="EN">Indicator 1.3: number of various services provided to IDPs hosted in the transit shelters</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">-Food distribution (service of 3 meals a day/pers)-PSS -PFA Consultation -Medical Consultation / screening-Recreational sessions for Children -Legal Consultations</narrative>
    </description>
    <baseline iso-date="2022-03-21" value="0" year="2022"></baseline>
    <period>
     <period-start iso-date="2022-03-21"></period-start>
     <period-end iso-date="2022-09-20"></period-end>
     <target value="8400"></target>
     <actual value="13545"></actual>
    </period>
   </indicator>
   <indicator aggregation-status="1" ascending="1" measure="1">
    <title>
     <narrative xml:lang="EN">Indicator 1.4: number of people benefitting from MMT services</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">Mobile Multidisciplinary Team: Supporting most underserved shelters in Lviv, Ternopil, and Ivano-Frankivsk with services in PSS/PFA activities, health screening, TB screening, referral pathways, and legal consultations.</narrative>
    </description>
    <baseline iso-date="2022-03-21" value="0" year="2022"></baseline>
    <period>
     <period-start iso-date="2022-03-21"></period-start>
     <period-end iso-date="2022-09-20"></period-end>
     <target value="5600"></target>
     <actual value="5733"></actual>
    </period>
   </indicator>
   <indicator aggregation-status="1" ascending="1" measure="1">
    <title>
     <narrative xml:lang="EN">Indicator 1.6: number of people receiving tailored hygiene kits</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">NFI &amp; Hygiene Kits distributions: Distributions in the targeted shelters in the regions &#x2013; providing IDPs with basic NFIs and hygiene kits (Family and Individual).</narrative>
    </description>
    <baseline iso-date="2022-03-21" value="0" year="2022"></baseline>
