     <period-end iso-date="2022-09-20"></period-end>
     <target value="11200"></target>
     <actual value="11219"></actual>
    </period>
   </indicator>
   <indicator aggregation-status="1" ascending="1" measure="1">
    <title>
     <narrative xml:lang="EN">Indicator 1.1: number of beneficiaries having access to a holistic and integrated package of high quality health care, protection monitoring and information in transit centers</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">Supporting 2 shelters to accommodate IDPs for an average 14-21 days, including provision of cooked meals, PSS activities, health screening, legal consultations, and recreational activities for children</narrative>
    </description>
