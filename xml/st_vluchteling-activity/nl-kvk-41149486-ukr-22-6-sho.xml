     <period-start iso-date="2022-03-21"></period-start>
     <period-end iso-date="2022-09-20"></period-end>
     <target value="4000"></target>
     <actual value="4530"></actual>
    </period>
   </indicator>
   <indicator aggregation-status="1" ascending="1" measure="1">
    <title>
     <narrative xml:lang="EN">Indicator 1.5: number of MMT services provided to IDPs hosted in collective shelters/centers</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">PSS/PFA, Medical Consultations and Legal Consultations are provided through the Mobile Multidisciplinary team in Lviv, Ternopil and Ivano-Frankivsk oblasts to IDPs hosted in collective centers.</narrative>
    </description>
    <baseline iso-date="2022-03-21" value="0" year="2022"></baseline>
