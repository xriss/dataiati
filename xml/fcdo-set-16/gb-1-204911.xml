  <title>
   <narrative xml:lang="EN">Zimbabwe Youth Empowerment Programme (ZYEP)</narrative>
  </title>
  <description type="1">
   <narrative xml:lang="EN">To improve the employment and self-employment status of young Zimbabweans, particularly young women, through increasing access to financial and business development services, expansion of vocational training and internship programmes, and strengthening gender mainstreaming in organisations that serve young people in Zimbabwe by June 2018.</narrative>
  </description>
