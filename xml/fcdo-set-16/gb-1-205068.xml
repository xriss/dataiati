  <title>
   <narrative xml:lang="EN">Somalia Stability Fund II</narrative>
  </title>
  <description type="1">
   <narrative xml:lang="EN">The purpose of this project is to promote stability across Somalia. This is a flexible adaptable instrument that will develop a portfolio of projects aimed at strengthening local governance and reducing conflict in Somalia.</narrative>
  </description>
