  <title>
   <narrative xml:lang="EN">Defending Land, Food, and Human Rights in Guatemala</narrative>
  </title>
  <description type="3">
   <narrative xml:lang="EN">Human rights&apos; defenders, indigenous and peasant communities, women</narrative>
  </description>
  <description type="2">
