  <result aggregation-status="0" type="2">
   <title>
    <narrative xml:lang="EN">PDO Indicator</narrative>
   </title>
   <indicator ascending="1" measure="5">
    <title>
     <narrative xml:lang="EN">Improvement of case-related statistics</narrative>
    </title>
    <baseline iso-date="2012-01-31" value="No" year="2012">
     <comment>
      <narrative xml:lang="EN">Currently, statistical reports are generated manually and pertain to basiccaseload statistics</narrative>
     </comment>
    </baseline>
    <period>
     <period-start iso-date="2012-01-31"></period-start>
     <period-end iso-date="2015-09-06"></period-end>
     <target value="Yes">
      <comment>
       <narrative xml:lang="EN">ACC produces enhanced statistics - including case type, investigationduration, investigation outcome, agency involved incomplaint,investigator assigned to the complaint, and percent of complaintsaccepted, investigated and forwarded for prosecution,which are mademore publicly available and utilized in the enhanced monitoring reports.</narrative>
      </comment>
     </target>
     <actual value="No"></actual>
    </period>
   </indicator>
  </result>
  <result aggregation-status="0" type="2">
   <title>
    <narrative xml:lang="EN">PDO Indicator</narrative>
   </title>
   <indicator ascending="1" measure="5">
    <title>
     <narrative xml:lang="EN">Enhanced management reports</narrative>
    </title>
    <baseline iso-date="2012-01-31" value="No" year="2012">
     <comment>
      <narrative xml:lang="EN">Management reports do not contain quality data, are not used formonitoring and evaluation purposes and are not madewidely-accesible.</narrative>
     </comment>
    </baseline>
    <period>
     <period-start iso-date="2012-01-31"></period-start>
     <period-end iso-date="2015-09-06"></period-end>
     <target value="Yes">
      <comment>
       <narrative xml:lang="EN">Management reports include enhanced statistics and analysis, are used tomonitor and evaluate the performance of the institutionand individualstaff, and are more easily accessible to the public in line with relevantlegislative frameworks.</narrative>
      </comment>
     </target>
     <actual value="No"></actual>
    </period>
   </indicator>
  </result>
  <result aggregation-status="0" type="2">
   <title>
    <narrative xml:lang="EN">PDO Indicator</narrative>
   </title>
   <indicator ascending="1" measure="5">
    <title>
     <narrative xml:lang="EN">Improved management of cases/complaints</narrative>
    </title>
    <baseline iso-date="2012-01-31" value="No" year="2012">
     <comment>
      <narrative xml:lang="EN">The ACC has no means to effectively track cases, making monitoring and evaluation difficult</narrative>
     </comment>
    </baseline>
    <period>
     <period-start iso-date="2012-01-31"></period-start>
     <period-end iso-date="2015-09-06"></period-end>
     <target value="Yes">
      <comment>
       <narrative xml:lang="EN">All cases are entered, tracked and monitored through the CMS</narrative>
      </comment>
     </target>
     <actual value="No">
      <comment>
       <narrative xml:lang="EN">Technical evaluation for the 8 proposals for the Case Management System (CMS) is completed. Pending evaluation report, financialoffers will be analyzed (before April 15). The contract with the selected company will be signed before April 15 and thedevelopment +implementation should start by no later than end of April.</narrative>
      </comment>
     </actual>
    </period>
   </indicator>
  </result>
