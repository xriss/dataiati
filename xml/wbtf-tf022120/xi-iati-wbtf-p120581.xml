  <result aggregation-status="0" type="2">
   <title>
    <narrative xml:lang="EN">PDO Indicator</narrative>
   </title>
   <indicator ascending="1" measure="5">
    <title>
     <narrative xml:lang="EN">Private sector organizations, the media and non-governmental organizations in selected COMESA Member States are aware of MTSP outcomes at the national level</narrative>
    </title>
    <baseline iso-date="2010-07-01" value="No" year="2010">
     <comment>
      <narrative xml:lang="EN">Little awareness as reported by Member States</narrative>
     </comment>
    </baseline>
    <period>
     <period-start iso-date="2010-07-01"></period-start>
     <period-end iso-date="2014-05-11"></period-end>
     <target value="Yes"></target>
     <actual value="Yes">
      <comment>
       <narrative xml:lang="EN">Status of the indicator is difficult to assess given the large target beneficiaries and difficult data collection (e.g. how toassess sensitization by media?). It is assessed that the indicator has been partly met.Sensitization of the public and privatesectorsfrom COMESA Member Countries as well as COMESA institutions were integrated into the consultative workshops held to developthe Medium-term Strategic Plan and results framework. Participants in these workshops included private sector, NGOs and media.</narrative>
      </comment>
     </actual>
    </period>
   </indicator>
  </result>
