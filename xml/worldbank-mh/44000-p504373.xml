   <indicator ascending="1" measure="5">
    <title>
     <narrative xml:lang="EN">5. Number of people with enhanced resilience to climate risks.</narrative>
    </title>
    <baseline iso-date="2024-04-14" value="0 people (FY24)" year="2024">
     <comment>
      <narrative xml:lang="EN"></narrative>
     </comment>
    </baseline>
    <period>
     <period-start iso-date="2024-04-14"></period-start>
     <period-end iso-date="2027-09-14"></period-end>
     <target value="5,000 people (FY27)">
      <comment>
       <narrative xml:lang="EN">The Sea Level Rise Policy has been adopted and is being implemented under coastal protection infrastructure projects in RMI. MPWIU is implementing seawalls in Ebeye (financed by PREPII-RMI) and Majuro (financed by the RMI Urban Resilience Project &#xe2;&#x20ac;&#x201c; URP), with construction for all infrastructure expected to be completed by the end of 2026. At least 9,000 people are expected to be protected by coastal infrastructure meeting updated design standards to mitigate sea level rise impacts in Ebeye and at least 1,400 people are expected to be protected in Majuro. The target is on track to be exceeded by the end of FY27.</narrative>
      </comment>
     </target>
     <actual value="0 people"></actual>
    </period>
   </indicator>
  </result>
