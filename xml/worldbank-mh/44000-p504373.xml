   <indicator ascending="1" measure="5">
    <title>
     <narrative xml:lang="EN">1. The percentage of public sector budget preparation captured in Financial Management Information System (FMIS).</narrative>
    </title>
    <baseline iso-date="2024-04-01" value="0 percent (FY24)" year="2024">
     <comment>
      <narrative xml:lang="EN"></narrative>
     </comment>
    </baseline>
    <period>
     <period-start iso-date="2024-04-01"></period-start>
     <period-end iso-date="2027-09-01"></period-end>
     <target value="55 percent (FY27)">
      <comment>
       <narrative xml:lang="EN">The current FMIS has been in use since 1 October 2023. The annual budget for government ministries and departments is captured in the FMIS. These are prepared by line ministries and entered into the FMIS centrally by MOFBPS. The FMIS functionality is in the process of being decentralized to line ministries and FMIS configurations are underway to simplify budget data entry. Five line ministries are planned to enter budget proposals through the system by September 2026, and all line ministries by September 2027.</narrative>
      </comment>
     </target>
     <actual value="0 percent"></actual>
    </period>
   </indicator>
  </result>
