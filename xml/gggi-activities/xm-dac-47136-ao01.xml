  <iati-identifier>XM-DAC-47136-AO01</iati-identifier>
  <reporting-org ref="XM-DAC-47136" type="40">
   <narrative xml:lang="EN">Global Green Growth Institute</narrative>
  </reporting-org>
  <title>
   <narrative xml:lang="EN">Enhancing Angola&#x2019;s Access to Climate Finance on Sustainable Transport and Sustainable Landscape (AFOLU) Sectors</narrative>
  </title>
  <description type="1">
   <narrative xml:lang="EN">The proposed project will support the nomination of a potential national direct access entity - the Environmental Fund - by undertaking institutional gap analysis and developing action plan for its accreditation; build the capacity of staff of NDA, key ministries and potential national DAEs on climate change project development and evaluation; identify and transform the areas of underperformance into opportunities for high-impact green growth interventions by undertaking a rapid Green Growth Potential Assessment; develop a Prioritization Roadmap for Climate Change and Green Growth actions and Climate Finance Strategy that identifies and outlines options and opportunities to fund Angola&amp;rsquo;s climate change initiatives; and develop project concept notes for GCF funding.</narrative>
  </description>
