  <reporting-org ref="XM-DAC-47136" type="40">
   <narrative xml:lang="EN">Global Green Growth Institute (GGGI)</narrative>
  </reporting-org>
  <title>
   <narrative xml:lang="EN">Environmental, Social, and Governance Advisory Support in the UAE</narrative>
  </title>
  <description type="4">
   <narrative xml:lang="EN">Active</narrative>
  </description>
  <description type="1">
   <narrative xml:lang="EN">Support the Government of the UAE in the design and implementation of the UAE Leadership in ESG Advancement Framework (UAE-LEAF) program. The proposed program will focus on equipping private sector professionals with the tools to mainstream ESG into their corporate practices. The support provided to the UAE will include activities, such as: - identification of ESG recommendations for target economic sectors (including sectors integral to the UAE&#x2019;s green energy transition) as part of an ESG Advancement Framework action plan - review of the UAE&#x2019;s industry value chains, company practices and readiness for scope 1, 2 and 3 reporting of GHG emissions, including in relation to national and sub-national MRV systems - Stakeholder engagement of professionals, executives and academia, including awareness raising and capacity building workshops on key ESG topics</narrative>
  </description>
