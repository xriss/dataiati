  <reporting-org ref="XM-DAC-47136" type="40">
   <narrative xml:lang="EN">Global Green Growth Institute (GGGI)</narrative>
  </reporting-org>
  <title>
   <narrative xml:lang="EN">Enhancing Net-Zero Readiness of Viet Nam Through Mobilizing Investments for Climate-Tech Start-ups and SMEs</narrative>
  </title>
  <description type="4">
   <narrative xml:lang="EN">Active</narrative>
  </description>
  <description type="1">
   <narrative xml:lang="EN">The objective of the project is to create an enabling environment for mobilizing financial resources to support Vietnam&#x2019;s goal of net-zero emissions by 2050. To achieve the objective, the project will have 3 main outputs: &#xb7; Output 1. A shortlist of local Joint Venture candidates ready for climate technology uptake &#xb7; Output 2. Development of a project pipeline along with 2 investment memorandums and 1 GCF concept note. &#xb7; Output 3. Development of climate and green growth policies focused on green investment mobilization</narrative>
  </description>
