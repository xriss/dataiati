  <title>
   <narrative xml:lang="FR">Soutenir une &#xe9;conomie rurale durable et diversifi&#xe9;e dans le gouvernorat de J&#xe9;nin</narrative>
  </title>
  <description type="3">
   <narrative xml:lang="FR">Agriculteurs</narrative>
