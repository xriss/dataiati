  <title>
   <narrative xml:lang="FR">Promotion de l&apos;agro&#xe9;cologie et du d&#xe9;veloppement durable dans le dioc&#xe8;se de Dapao</narrative>
  </title>
  <description type="3">
   <narrative xml:lang="FR">Agriculteurs</narrative>
