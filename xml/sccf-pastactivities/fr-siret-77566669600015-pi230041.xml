  <title>
   <narrative xml:lang="FR">Nirapad Nagar : promotion de villes s&#xfb;res, inclusives et durables au Bangladesh</narrative>
  </title>
  <description type="3">
   <narrative xml:lang="FR">Collectifs</narrative>
