   <indicator ascending="1" measure="2">
    <title>
     <narrative xml:lang="EN">Domestic gasoline and diesel prices relative to international benchmark</narrative>
    </title>
    <baseline iso-date="2022-11-27" value="35 percent for gasoline and 22 percent for diesel in 2022 compared to international benchmark" year="2022">
     <comment>
      <narrative xml:lang="EN"></narrative>
     </comment>
    </baseline>
    <period>
     <period-start iso-date="2022-11-27"></period-start>
     <period-end iso-date="2026-12-15"></period-end>
     <target value="50 percent relative to international benchmark for both fuel in 2026">
      <comment>
       <narrative xml:lang="EN">The Government increased the price of gasoline by 87.5 percent in 2023. The Government also increased the price of diesel by 196.3 percent&#x2014;roughly threefold&#x2014;since 2024. The absence of strong compensation measures and of an effective communication strategy has triggered social unrest. As a result, the authorities are tying future price adjustments with credible mitigation measures.</narrative>
      </comment>
     </target>
     <actual value="41 percent for gasoline and 44 percent for diesel"></actual>
    </period>
   </indicator>
  </result>
