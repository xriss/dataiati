  <title xml:lang="EN">
   <narrative xml:lang="EN">Angola Youth Employment Opportunities Project</narrative>
  </title>
  <description type="1" xml:lang="EN">
   <narrative xml:lang="EN">The Project aims to increase productivity and access to employment opportunities among targeted youth, thereby contributing to Angola&apos;s economic transformation and diversification efforts. Building on global evidence, the project will employ an integrated approach (with a set of differentiated interventions) to address the diverse constraints faced by youth. The integrated approach will combine supply and demand-side interventions, as well as employment and intermediation services, with a view to leverage the comprehensive approach required to address the youth employment challenge for Angola&apos;s economic transformation.</narrative>
  </description>
  <description type="2" xml:lang="EN">
   <narrative xml:lang="EN">To increase productivity and access to employment opportunities among targeted youth in Angola.</narrative>
  </description>
