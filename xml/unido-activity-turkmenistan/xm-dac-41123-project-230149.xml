   <narrative xml:lang="EN">United Nations Industrial Development Organization</narrative>
  </reporting-org>
  <title>
   <narrative xml:lang="EN">Kigali HFC Implementation Plan</narrative>
  </title>
  <description type="1">
   <narrative xml:lang="EN">It includes the strategy for the phase-down of HFCs and plan of actions aimed at the refrigeration servicing sector that would enable  Turkmenistan to meet MP targets, while enhancing the sectoral energy efficiency and reaching possibly minimal   impact to the climate, policy development and its implementation; upgrade of RAC training programs and manuals; training of technicians and customs officers; taking preventing measures on illegal trade of HFCs; improving servicing tools; recycling and recovery of HFCs; reduce the safety risks associated with low-GWP alternative refrigerants through training of trainers.</narrative>
  </description>
  <participating-org role="1">
   <narrative xml:lang="EN">Montreal Protocol</narrative>
  </participating-org>
