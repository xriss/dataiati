  <iati-identifier>XI-PID-860007386-BUDGET_PREPARING THE PUBLIC AND FINANCIAL SECTOR FOR CLIMATE TRANSITION RISK: CAPACITY  BUILDING AND CALL TO ACTION</iati-identifier>
  <reporting-org ref="XI-PID-860007386" type="70">
   <narrative xml:lang="EN">Universidad de los Andes</narrative>
