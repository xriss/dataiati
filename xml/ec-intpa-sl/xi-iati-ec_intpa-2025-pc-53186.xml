 <iati-activity default-currency="EUR" hierarchy="2" humanitarian="0" iati-activities:version="2.03" xml:lang="EN" xmlns:iati-activities="http://d-portal.org/xmlns/iati-activities">
  <iati-identifier>XI-IATI-EC_INTPA-2025-PC-53186</iati-identifier>
  <reporting-org ref="XI-IATI-EC_INTPA" secondary-reporter="0" type="15">
   <narrative xml:lang="EN">European Commission - Directorate-General for International Partnerships</narrative>
  </reporting-org>
  <title>
   <narrative xml:lang="EN">Energy Policies  Review</narrative>
  </title>
  <description type="1">
   <narrative xml:lang="EN">&lt;p&gt;&lt;strong&gt;Objective of the contract is: &lt;/strong&gt;&lt;/p&gt;&lt;p&gt;To review and enhance the existing policies, strategies and actions plan ensuring that identified gaps are addressed, and the policies are updated to reflect current best practices and requirements.&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Specific objective(s):&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;Support the Ministry of Energy of the Sierra Leone in the review, updating and approval process of the following &lt;strong&gt;3 Policies, with related strategies and actions plans&lt;/strong&gt;:&lt;/p&gt;&lt;ol&gt;&lt;li data-list=&quot;bullet&quot; class=&quot;ql-align-justify&quot;&gt;&lt;span class=&quot;ql-ui&quot; contenteditable=&quot;false&quot;&gt;&lt;/span&gt;The National Energy Policy and Strategic Plan 2008;&lt;/li&gt;&lt;li data-list=&quot;bullet&quot; class=&quot;ql-align-justify&quot;&gt;&lt;span class=&quot;ql-ui&quot; contenteditable=&quot;false&quot;&gt;&lt;/span&gt;Renewable Energy Policy and Action Plan of Sierra Leone, May 2016;&lt;/li&gt;&lt;li data-list=&quot;bullet&quot; class=&quot;ql-align-justify&quot;&gt;&lt;span class=&quot;ql-ui&quot; contenteditable=&quot;false&quot;&gt;&lt;/span&gt;The Energy Efficiency Policy, Strategy and Action Plan of Sierra Leone, May 2016.&lt;/li&gt;&lt;/ol&gt;&lt;p&gt;&lt;strong&gt;Scope of Work:&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;The consultant will be responsible:&lt;/p&gt;&lt;ol&gt;&lt;li data-list=&quot;bullet&quot;&gt;&lt;span class=&quot;ql-ui&quot; contenteditable=&quot;false&quot;&gt;&lt;/span&gt;To conduct a comprehensive review of the 3 existing Policies: Energy policy and strategic plan, Energy efficiency policy, strategy and Action Plan and Renewable energy policy and Action Plan;&lt;/li&gt;&lt;li data-list=&quot;bullet&quot;&gt;&lt;span class=&quot;ql-ui&quot; contenteditable=&quot;false&quot;&gt;&lt;/span&gt;To identify, analyse, and articulate gaps within the current policies, strategies and implementing regulatory frameworks and areas of improvements;&lt;/li&gt;&lt;li data-list=&quot;bullet&quot;&gt;&lt;span class=&quot;ql-ui&quot; contenteditable=&quot;false&quot;&gt;&lt;/span&gt;To develop enhanced draft policies and related strategies and plans that will address all identified gaps and take into accounts stakeholders inputs;&lt;/li&gt;&lt;li data-list=&quot;bullet&quot;&gt;&lt;span class=&quot;ql-ui&quot; contenteditable=&quot;false&quot;&gt;&lt;/span&gt;To ensure the updated policies and related strategies and plans align with current best practices and legislative requirements;&lt;/li&gt;&lt;li data-list=&quot;bullet&quot;&gt;&lt;span class=&quot;ql-ui&quot; contenteditable=&quot;false&quot;&gt;&lt;/span&gt;Align the reviewed policies, action plans and strategies with the ECOWAS Centre for Renewable Energy and Energy Efficiency policies, strategies and Action Plans;&lt;/li&gt;&lt;li data-list=&quot;bullet&quot;&gt;&lt;span class=&quot;ql-ui&quot; contenteditable=&quot;false&quot;&gt;&lt;/span&gt;Provide a detailed report outlining the review and update process, findings, and recommendations.&lt;/li&gt;&lt;/ol&gt;&lt;p&gt;The outputs of this contract are as follows:&lt;/p&gt;&lt;ol&gt;&lt;li data-list=&quot;bullet&quot;&gt;&lt;span class=&quot;ql-ui&quot; contenteditable=&quot;false&quot;&gt;&lt;/span&gt;Initial Policies, Strategies and Action Plans Review Report;&lt;/li&gt;&lt;li data-list=&quot;bullet&quot;&gt;&lt;span class=&quot;ql-ui&quot; contenteditable=&quot;false&quot;&gt;&lt;/span&gt;Draft Enhanced Policies, Strategies and Action Plans for review;&lt;/li&gt;&lt;li data-list=&quot;bullet&quot;&gt;&lt;span class=&quot;ql-ui&quot; contenteditable=&quot;false&quot;&gt;&lt;/span&gt;Finalsied draft Enhanced Policies, Strategies and Action Plans incorporating stakeholder review and feedback;&lt;/li&gt;&lt;li data-list=&quot;bullet&quot;&gt;&lt;span class=&quot;ql-ui&quot; contenteditable=&quot;false&quot;&gt;&lt;/span&gt;Stakeholders Engagement/Validation Workshops;&lt;/li&gt;&lt;li data-list=&quot;bullet&quot;&gt;&lt;span class=&quot;ql-ui&quot; contenteditable=&quot;false&quot;&gt;&lt;/span&gt;Comprehensive Final Policy Strategies and Action Plans review report.&lt;/li&gt;&lt;/ol&gt;</narrative>
  </description>
