  <result aggregation-status="0" type="2">
   <title>
    <narrative xml:lang="EN">Indicator</narrative>
   </title>
   <indicator ascending="1" measure="2">
    <title>
     <narrative xml:lang="EN">Share of payments processed through the Budget and Treasury Management System (BTMS) increased</narrative>
    </title>
    <baseline iso-date="2017-12-31" value="0.00" year="2017"></baseline>
    <period>
     <period-start iso-date="2017-12-31"></period-start>
     <period-end iso-date="2019-12-31"></period-end>
     <target value="10.00">
      <comment>
       <narrative xml:lang="EN">&lt;p&amp;gt;On January 14, 2019, the Secretary of DBM issued a Circular Letter requiring all national government agencies to use BTMS for high-value transactions (PHP 1 million or more) by July 1, 2019. Those transactions represented only 5 percent of the number of total transactions in 2018 but approximately 30 percent of expenditures of all spending units in terms of value in 2019. They are executedthrough the Treasury Single Account (TSA). Based on this estimate, the target of at least 10 percent of payments (by value) to be processed through BTMS by end 2019 has been &lt;u&amp;gt;achieved.&lt;/u&amp;gt;&lt;/p&amp;gt;</narrative>
      </comment>
     </target>
     <actual value="30.00"></actual>
    </period>
   </indicator>
  </result>
  <result aggregation-status="0" type="2">
   <title>
    <narrative xml:lang="EN">Indicator</narrative>
   </title>
   <indicator ascending="1" measure="1">
    <title>
     <narrative xml:lang="EN">Number of departments / national government agencies, with data captured in the National Asset Registry and covered by the indemnity insurance program</narrative>
    </title>
    <baseline iso-date="2017-12-31" value="0.00" year="2017"></baseline>
    <period>
     <period-start iso-date="2017-12-31"></period-start>
     <period-end iso-date="2019-12-31"></period-end>
