   </title>
   <indicator ascending="1" measure="1">
    <title>
     <narrative xml:lang="EN">Number of LGUs that have developed and integrated resilient urban design strategies in their land use plans (CLUPs).</narrative>
    </title>
    <baseline iso-date="2023-08-12" value="0" year="2023">
