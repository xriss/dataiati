  <result aggregation-status="0" type="1">
   <title>
    <narrative xml:lang="EN">Intermediate Results Indicator</narrative>
   </title>
   <indicator ascending="1" measure="1">
    <title>
     <narrative xml:lang="EN">Number of LGUs that implement zoning regulations based on disaster and climate risk-informed CLUPs.</narrative>
    </title>
    <baseline iso-date="2023-08-12" value="0" year="2023">
     <comment>
      <narrative xml:lang="EN"></narrative>
     </comment>
    </baseline>
    <period>
     <period-start iso-date="2023-08-12"></period-start>
     <period-end iso-date="2026-12-12"></period-end>
     <target value="200">
      <comment>
       <narrative xml:lang="EN">In progress. DHSUD, with support from the Bank and in partnership with DOST, is developing the PlanSmart for Sustainable Human Settlements, a risk-informed and evidence-based platform that will facilitate the formulation of Comprehensive Land Use Plans (CLUPs) of local governments. Main features of this platform are the climate and disaster risk assessment and the CLUP formulation. DHSUD is updating its CDRA and CLUP guidebooks, for integration in the platform. Consultants were hired to support DHSUD carry out the planned activities. 
Information source: DHSUD</narrative>
      </comment>
     </target>
     <actual value="0"></actual>
    </period>
   </indicator>
  </result>
  <result aggregation-status="0" type="1">
   <title>
    <narrative xml:lang="EN">Intermediate Results Indicator</narrative>
   </title>
   <indicator ascending="1" measure="1">
    <title>
     <narrative xml:lang="EN">Number of LGUs that have developed plans for green and open spaces using DHSUD&#xe2;&#x20ac;&#x2122;s guidelines</narrative>
    </title>
    <baseline iso-date="2023-08-12" value="0" year="2023">
     <comment>
      <narrative xml:lang="EN"></narrative>
     </comment>
    </baseline>
    <period>
     <period-start iso-date="2023-08-12"></period-start>
     <period-end iso-date="2026-12-12"></period-end>
     <target value="30">
      <comment>
       <narrative xml:lang="EN">In progress. DHSUD, with support from the Bank is developing its Guidelines on Green and Open Spaces Development for local governments. The PlanSmart for Sustainable Human Settlements under development will integrate green and open spaces in the CLUP of local governments. Consultants were hired to support DHSUD carry out the planned activities.
Information source: DHSUD</narrative>
      </comment>
     </target>
     <actual value="0"></actual>
    </period>
   </indicator>
  </result>
