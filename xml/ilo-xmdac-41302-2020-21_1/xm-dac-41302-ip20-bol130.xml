  </sector>
  <sector code="8.8" percentage="34" vocabulary="8">
   <narrative xml:lang="ES">8.8 Protect labour rights and promote safe and secure working environments for all workers, including migrant workers, in particular women migrants, and those in precarious employment</narrative>
  </sector>
