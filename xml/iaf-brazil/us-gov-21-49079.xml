  <title>
   <narrative xml:lang="EN">Agriculture/Food Production Grant</narrative>
  </title>
  <description type="1">
   <narrative xml:lang="EN">Associao Etnoambiental Beija-Flor (AEBF) will improve the biodiversity of its indigenous land by planting native fruit species and developing a native honey (melipona) production system in Rio Preto da Eva, state of Amazonas. Activities will increase food security and create employment opportunities for the indigenous population in Rio Preto da Eva. Approximately 640 indigenous people will benefit directly from this project, and 1,000 residents indirectly.</narrative>
  </description>
