  <title>
   <narrative xml:lang="EN">Honey production in Bangui Motaba village near Nouabale Ndoki National Parc</narrative>
   <narrative xml:lang="DE">Honigproduktion im Dorf Bangui-Motaba nahe dem Nationalpark Nouabale Ndoki im Nordkongo</narrative>
