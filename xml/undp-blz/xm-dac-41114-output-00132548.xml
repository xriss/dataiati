  <result aggregation-status="1" type="1">
   <title>
    <narrative xml:lang="ES">Annual Output Results</narrative>
   </title>
   <indicator aggregation-status="1" ascending="0" measure="1">
    <title>
     <narrative xml:lang="ES">Number of persons  trained in Digital Literacy</narrative>
    </title>
    <description>
     <narrative xml:lang="ES">Digital Literacy training for the elderly (persons over 55 years old) will be executed in 9 rural locations nationwide (all municipalities along with Caye Caulker Village). This will be done in partnership with the Ministry of Human Development through the National Council of Aging and the E-Governance and Digitization Unit. This will be executed in 2 cohorts, each with an estimated 300 student each. The program will also include a youth buddy to provide individualized support to the trainees.</narrative>
    </description>
