  <result type="1">
   <title>
    <narrative xml:lang="EN">UPR stakeholders are trained on how to engage effectively in the UPR process.</narrative>
   </title>
   <reference code="268711" vocabulary="99"></reference>
   <indicator aggregation-status="0" ascending="1" measure="1">
    <title>
     <narrative xml:lang="EN">Number of UPR stakeholders trained on the UPR process.</narrative>
    </title>
    <period>
     <period-start iso-date="2018-01-01"></period-start>
     <period-end iso-date="2018-12-31"></period-end>
     <target value="Over twenty UPR training sessions are organized for UPR stakeholders, who are trained on the UPR process."></target>
     <actual value="UPR Info delivered 31 training sessions for approximately 500 among CSOs members, HRDs. diplomats, members of government and international organizations, students and professors."></actual>
    </period>
    <period>
     <period-start iso-date="2019-01-01"></period-start>
     <period-end iso-date="2019-12-31"></period-end>
     <target value="Over 20 UPR training sessions are organized for UPR stakeholders, who are trained on the UPR process."></target>
     <actual value="Up to July 2019, UPR Info delivered 21 training sessions and 468 among CSOs members, HRDs, diplomats, members of government and international organizations, students and professors."></actual>
    </period>
   </indicator>
  </result>
  <result type="2">
   <title>
    <narrative xml:lang="EN">Stakeholders involved in UPR process (including CSOs, NHRIs, and diplomats) are better equipped with necessary knowledge and knowhow to participate effectively in the UPR 3rd cycle.</narrative>
   </title>
   <reference code="268710" vocabulary="99"></reference>
   <indicator aggregation-status="0" ascending="1" measure="1">
    <title>
     <narrative xml:lang="EN">Number of stakeholders involved in the UPR Process (including CSOs, NHRIs, and diplomats), who are better equipped with the necessary knowledge and knowhow to participate effectively in the 3rd cycle of the UPR.</narrative>
    </title>
    <period>
     <period-start iso-date="2019-01-01"></period-start>
     <period-end iso-date="2019-12-31"></period-end>
     <target value="An increased number of stakeholders are engaging in the UPR process through training sessions, access to news articles, tools and databases."></target>
     <actual value="UPR Info has delivered over 60 training sessions for over 1000 UPR stakeholders on how to engage effectively in the UPR process."></actual>
    </period>
   </indicator>
  </result>
