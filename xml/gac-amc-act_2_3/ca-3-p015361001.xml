   <indicator measure="5">
    <title>
     <narrative xml:lang="EN">Results expected</narrative>
     <narrative xml:lang="FR">R&#xE9;sultats escompt&#xE9;s</narrative>
    </title>
    <description>
     <narrative xml:lang="FR">Les r&#xE9;sultats escompt&#xE9;s de ce projet comprennent : 1) l&#x2019;am&#xE9;lioration de l&apos;environnement de formation permettant aux jeunes femmes de participer &#xE0; la croissance &#xE9;conomique au Ghana; 2) l&#x2019;am&#xE9;lioration de la transition de la formation &#xE0; l&apos;emploi et &#xE0; l&apos;entreprenariat pour les jeunes femmes au Ghana; 3) la participation accrue et durable des jeunes femmes dans les secteurs &#xE9;conomiques les plus r&#xE9;mun&#xE9;rateurs au Ghana.</narrative>
     <narrative xml:lang="EN">The expected outcomes of this project include: (1) improved training environment enabling young women&#x2019;s participation in economic growth in Ghana; (2) enhanced transition from skills training to employment and entrepreneurship for young women in Ghana; and (3) increased sustained participation of young women in high paying economic sectors in Ghana.</narrative>
    </description>
   </indicator>
  </result>
