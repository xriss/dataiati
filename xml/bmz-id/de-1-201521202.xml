  <title>
   <narrative xml:lang="DE">1000 Inseln - L&#xe4;ndliche Elektrifizierung durch Erneuerbare Energien (REEP)</narrative>
   <narrative xml:lang="EN">1000 Islands - Renewable energy for electrifikation Programme - REEP</narrative>
