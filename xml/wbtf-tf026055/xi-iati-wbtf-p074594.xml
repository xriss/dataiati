   <indicator ascending="1" measure="5">
    <title>
     <narrative xml:lang="EN">Number of person days of temporary employment created through the Emergency Employment Generation Component of the Project</narrative>
    </title>
    <baseline iso-date="2006-12-31" value="0 person days" year="2006">
     <comment>
      <narrative xml:lang="EN"></narrative>
     </comment>
    </baseline>
    <period>
     <period-start iso-date="2006-12-31"></period-start>
     <period-end iso-date="2009-12-31"></period-end>
     <target value="140,000 person days complied with"></target>
     <actual value="142,283 person-days">
      <comment>
       <narrative xml:lang="EN">Indicator complied with. Average income of about US$12.64 per person per day, which represents about 58% labor content as comparedwith &amp;gt;50% set at appraisal. Additional generation of indirect temporary employment was 2720 person-day and average earning of US$15per person-day.</narrative>
      </comment>
     </actual>
    </period>
   </indicator>
  </result>
