  <result aggregation-status="0" type="1">
   <title>
    <narrative xml:lang="EN">Intermediate Results Indicator</narrative>
   </title>
   <indicator ascending="1" measure="5">
    <title>
     <narrative xml:lang="EN">Improvements to annual gross revenue collection</narrative>
    </title>
    <baseline iso-date="2005-07-31" value="40%" year="2005">
     <comment>
      <narrative xml:lang="EN"></narrative>
     </comment>
    </baseline>
    <period>
     <period-start iso-date="2005-07-31"></period-start>
     <period-end iso-date="2012-01-31"></period-end>
     <target value="50%"></target>
     <actual value="35-55% in different municipalities">
      <comment>
       <narrative xml:lang="EN">CMWU conducted sucessful campaigns to improve collection. Yet collection is low due to prevailing poverty and unemployment</narrative>
      </comment>
     </actual>
    </period>
   </indicator>
  </result>
  <result aggregation-status="0" type="1">
   <title>
    <narrative xml:lang="EN">Intermediate Results Indicator</narrative>
   </title>
   <indicator ascending="1" measure="5">
    <title>
     <narrative xml:lang="EN">Number of hours all customers receive water each day.</narrative>
    </title>
    <baseline iso-date="2005-07-31" value="6 hrs." year="2005">
     <comment>
      <narrative xml:lang="EN"></narrative>
     </comment>
    </baseline>
    <period>
     <period-start iso-date="2005-07-31"></period-start>
     <period-end iso-date="2012-01-31"></period-end>
     <target value="8 hours"></target>
     <actual value="6-8 hrs.">
      <comment>
       <narrative xml:lang="EN">the power deficit in Gaza is the constraint. Customers are adapting to less hours by having in-house storage capacity to ensurecontinuous access</narrative>
      </comment>
     </actual>
    </period>
   </indicator>
  </result>
