  <title>
   <narrative xml:lang="EN">African Youth Empowerment and Development Initiative (AYEDI)</narrative>
  </title>
  <description type="1">
   <narrative xml:lang="EN">To implement a project that addresses exploitative labor among youth under the age of 18 in Uganda. The project will provide training to youth to help them develop marketable skills and serve as civic leaders in their communities.</narrative>
  </description>
