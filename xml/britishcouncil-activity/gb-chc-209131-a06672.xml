  <title>
   <narrative xml:lang="EN">ILMpact programme in Pakistan</narrative>
  </title>
  <description type="2">
   <narrative xml:lang="EN">Project will address Learning Poverty through Accelerated and Remedial Learning Initatives with special focus on Girls and Out Of School Children as well as Religious Minorities and Children with Disabilities.</narrative>
  </description>
  <description type="1">
   <narrative xml:lang="EN">Project will empower over 250,000 vulnerable children in Pakistan with access to quality education</narrative>
  </description>
  <description type="3">
   <narrative xml:lang="EN">The target population is girls and marginalised children aged 5 to 16 years</narrative>
  </description>
