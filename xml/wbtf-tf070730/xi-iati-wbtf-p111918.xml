   <indicator ascending="1" measure="1">
    <title>
     <narrative xml:lang="EN">22 small-and medium -scale landholders are receiving economic benefits through the project on an annual basis and at harvest.</narrative>
    </title>
    <baseline value="000000" year="1900">
     <comment>
      <narrative xml:lang="EN"></narrative>
     </comment>
    </baseline>
    <period>
     <period-start iso-date="2010-07-07"></period-start>
     <period-end iso-date="2018-12-31"></period-end>
     <target value="22.00"></target>
     <actual value="22.00">
      <comment>
       <narrative xml:lang="EN">12 small- and medium-scale landholders are still receiving annual economic benefits through the project on an annual basis, otherproperties have finished the project cycle, received 10% of the profits and are graduated out of the project, and one property wascompletely destroyed by fire and the contract will be closed.</narrative>
      </comment>
     </actual>
    </period>
   </indicator>
  </result>
