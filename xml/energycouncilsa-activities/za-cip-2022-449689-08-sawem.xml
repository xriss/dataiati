  <document-link format="APPLICATION/PDF" url="https://iatipublisher-prod.s3.amazonaws.com/document-link/537/Draft%20Balancing%20Markets_290420251757925863.pdf">
   <title>
    <narrative xml:lang="EN">Balancing Markets</narrative>
   </title>
   <description>
    <narrative xml:lang="EN">System Operators (SO) balance supply and demand for electricity to maintain a stable supply of electricity. The proposed development of an explicit Balancing Mechanism (BM) under SAWEM will require the Market Code to be developed to specify the balancing products to be procured.</narrative>
   </description>
   <category code="A08"></category>
   <language code="EN"></language>
   <document-date iso-date="2025-04-29"></document-date>
