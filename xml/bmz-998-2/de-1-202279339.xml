  <title>
   <narrative xml:lang="EN">Supporting the World Secretariat of ICLEI to strengthen climate-friendly and sustainable urban development globally</narrative>
   <narrative xml:lang="DE">Unterst&#xfc;tzung des Weltsekretariats von ICLEI zur globalen St&#xe4;rkung klimafreundlicher und nachhaltiger Stadtentwicklung</narrative>
