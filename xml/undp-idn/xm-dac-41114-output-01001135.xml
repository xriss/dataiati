   <indicator aggregation-status="1" ascending="0" measure="5">
    <title>
     <narrative xml:lang="EN">Project Document and CEO Endorsement Request (CER) for INET ZERO developed for submission to the GEF</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">PPG INET ZERO is expected to produce a Project Document and CER as required for getting full size funding from the Global Environment Facility (GEF). The INET ZERO project will support the Government of Indonesia in enhancing programme for achieving Net Zero Nature Positive in the energy and forestry sectors.</narrative>
    </description>
    <baseline year="2023">
     <comment>
      <narrative xml:lang="EN">INET ZERO concept note has been approved by the GEF.</narrative>
     </comment>
    </baseline>
    <period>
     <period-start iso-date="2024-01-01"></period-start>
     <period-end iso-date="2024-12-31"></period-end>
     <target>
      <comment>
       <narrative xml:lang="EN">Project Document and CER for INET ZERO project developed for submission to GEF.</narrative>
      </comment>
     </target>
     <actual>
      <comment>
       <narrative xml:lang="EN">DoA for INET ZERO PPG has been signed by RR UNDP Indonesia. Procurement of PPG consultants have been conducted. Stakeholders meeting conducted led by the MEMR and MoEF to reconfirm the scope of the project.</narrative>
      </comment>
     </actual>
    </period>
   </indicator>
