  <result aggregation-status="1" type="1">
   <title>
    <narrative xml:lang="EN">Annual Output Results</narrative>
   </title>
   <indicator aggregation-status="1" ascending="0" measure="5">
    <title>
     <narrative xml:lang="EN">Concept Note Developed for UNDP&apos;s support in the implementation of Just Transition Framework.</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">A proposal of UNDP&#x2019;s offer for the I-JETP Secretariat for implementation of Indonesia Just Energy Transition Programme as part of I-JETP CIPP.</narrative>
    </description>
    <baseline year="2023">
     <comment>
      <narrative xml:lang="EN">Concept note for UNDP&apos;s support JETP Secretariat is unavailable.</narrative>
     </comment>
    </baseline>
    <period>
     <period-start iso-date="2024-01-01"></period-start>
     <period-end iso-date="2024-12-31"></period-end>
     <target>
      <comment>
       <narrative xml:lang="EN">A concept note developed as a proposal to the JETP Secretariat/Government of Indonesia.</narrative>
      </comment>
     </target>
     <actual>
      <comment>
       <narrative xml:lang="EN">Draft of concept note on UNDP&apos;s support for implementation of JT Framework is developed.</narrative>
      </comment>
     </actual>
    </period>
   </indicator>
   <indicator aggregation-status="1" ascending="0" measure="5">
    <title>
     <narrative xml:lang="EN">Just Transition Framework developed and integrated into JETP Comprehensive Investment and Policy Plan (CIPP)</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">The Integration of &#x201c;Just&#x201d; principles, impact analysis, and costing of a &#x201c;Just&#x201d; transition included in Indonesia JETP Comprehensive Investment and Policy Plan (CIPP). UNDP leads JETP Indonesia Just Transition WG to produce Just Transition Framework document as part of JETP CIPP.</narrative>
    </description>
    <baseline year="2023">
     <comment>
      <narrative xml:lang="EN">No Just Transition Framework is available for JETP Indonesia.</narrative>
     </comment>
    </baseline>
    <period>
     <period-start iso-date="2023-01-01"></period-start>
     <period-end iso-date="2023-12-31"></period-end>
     <target>
      <comment>
       <narrative xml:lang="EN">UNDP lead JT WG and successfully submitted Just Transition Framework for inclusion in the JETP Indonesia CIPP.</narrative>
      </comment>
     </target>
     <actual>
      <comment>
       <narrative xml:lang="EN">Just Transition Framework has been developed and included into Chapter 6 of the JETP Indonesia CIPP.</narrative>
      </comment>
     </actual>
    </period>
   </indicator>
  </result>
