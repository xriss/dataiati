  <result aggregation-status="1" type="1">
   <title>
    <narrative xml:lang="EN">Annual Output Results</narrative>
   </title>
   <indicator ascending="0" measure="5">
    <title>
     <narrative xml:lang="EN">Output Indicator</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">1) Number of health care facilities provided doctors through the introduction of International United Nation Volunteers (IUNV);

2) Number of bio-medical engineers provided;

3) Number of psychometric assessments of CEOs and senior management of Regional Health Authorities (RHAs) conducted;

4) Number of RHA personnel sensitized to SUPREM;

5) Number of RHA board members and senior management sensitized on the provisions of the Public Procurement and Disposal of Public Property Act;

6) Number of EDs assessed to determine barriers to improve health care delivery;

7) Number of medical equipment acquired by UNDP and delivered to Ministry of Health in response to COVID-19 pandemic;

8) Number of personal protective equipment (PPE) acquired by UNDP and delivered to Ministry of Health in response to COVID-19 pandemic;

9) Number of COVID-19 test kits acquired by UNDP and delivered to Ministry of Health in response to COVID-19 pandemic;</narrative>
    </description>
    <baseline year="2014">
     <comment>
      <narrative xml:lang="EN">1) Shortages of doctors at a number of primary health care facilities;

2) Shortage of bio-medical engineers in the health sector;

