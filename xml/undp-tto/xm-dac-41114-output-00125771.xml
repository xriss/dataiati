   <indicator aggregation-status="0" ascending="0" measure="1">
    <title>
     <narrative xml:lang="EN">HCFC Reduction of Consumption (imports minus exports)</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">Reduction in HCFCs imported by the RAC Servicing Sector (by ODP tonnes). The country needs to keep within or below the set limit of 28.3 ODP tonnes of HCFC per year for the period 2020-2024. Thereafter from 2025-2028 the country must stay within or below the new limit of 15 ODP tonnes of HCFC per year.</narrative>
    </description>
    <baseline value="28.3" year="2021"></baseline>
    <period>
     <period-start iso-date="2024-01-01"></period-start>
     <period-end iso-date="2024-12-31"></period-end>
     <target value="28.3"></target>
     <actual value="10.1"></actual>
    </period>
