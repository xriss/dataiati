  <result aggregation-status="0" type="1">
   <title>
    <narrative xml:lang="EN">Tier 2 Results</narrative>
   </title>
   <indicator aggregation-status="0" ascending="0" measure="1">
    <title>
     <narrative xml:lang="EN">Improved governance</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">Australia partnered with Aceh&#x2019;s Women and Children agencies to develop 33 service Standard Operation Procedures (SOPs) to combat violence against women and children. This included advocating for a Governor&#x2019;s Decree, establishing a legal framework for the SOPs&#x2019; implementation. The SOPs comply with national regulations and local laws, promoting better practices to protect women and children in Aceh.</narrative>
    </description>
    <period>
     <period-start iso-date="2023-07-01"></period-start>
     <period-end iso-date="2024-06-30"></period-end>
    </period>
   </indicator>
  </result>
  <result aggregation-status="0" type="1">
   <title>
    <narrative xml:lang="EN">Tier 2 Results</narrative>
   </title>
   <indicator aggregation-status="0" ascending="0" measure="1">
    <title>
     <narrative xml:lang="EN">Disability equity</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">Australia provided critical support for inclusive access to justice for persons with disabilities (PWD). AIPJ2 has empowered two organisations of persons with disabilities: SIGAB and SAPDA to implement initiatives aligned with Government Regulation 39/2020. These include improved accessibility through infrastructure adjustments like ramps and accessible restrooms in courts and prosecutors&#x2019; office, enhanced training for law enforcement personnel on handling cases involving PWD, referral system to connect disabled individuals with legal aid and paralegal training to provide better legal support for PWD. These efforts have significantly improved access to justice and legal equity for PWD in Indonesia.</narrative>
    </description>
    <period>
     <period-start iso-date="2023-07-01"></period-start>
     <period-end iso-date="2024-06-30"></period-end>
    </period>
   </indicator>
  </result>
  <result aggregation-status="0" type="1">
   <title>
    <narrative xml:lang="EN">Tier 2 Results</narrative>
   </title>
   <indicator aggregation-status="0" ascending="0" measure="1">
    <title>
     <narrative xml:lang="EN">Gender equality</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">Australia&apos;s support empowered Indonesia&#x2019;s Supreme Court to establish the Indonesian Women&#x2019;s Judges Association (BPPHI) in January 2024. This initiative, inspired by Indonesia&#x2019;s participation at the Women Judges Conference in Marrakesh facilitated by Australia, fosters knowledge sharing and mentorship among female judges in Indonesia and abroad. Aligning with the UN&#x2019;s SDG goals, this initiative supports the Supreme Court&#x2019;s commitment to increasing women&#x2019;s representation in judicial leadership to 50% by 2030</narrative>
    </description>
    <period>
     <period-start iso-date="2023-07-01"></period-start>
     <period-end iso-date="2024-06-30"></period-end>
    </period>
   </indicator>
  </result>
