    <title>
     <narrative xml:lang="EN">Gender equality</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">In Fiji, Australia&apos;s support has had a significant gender emphasis through (i) the inclusion of a gender statement in the fiscal strategy, (ii) ensuring a more equitable distribution of resources to strengthen women&apos;s resilience, and expansion of the gender responsive budgeting initiative to an additional ten Ministries/offices/agencies, and (iii) establishment of a Secretariat to oversee the development of Fiji&#x2019;s Women Economic Empowerment National Action Plan.</narrative>
    </description>
    <period>
     <period-start iso-date="2023-07-01"></period-start>
     <period-end iso-date="2024-06-30"></period-end>
    </period>
   </indicator>
