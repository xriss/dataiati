  <result aggregation-status="0" type="1">
   <title>
    <narrative xml:lang="EN">Tier 2 Results</narrative>
   </title>
   <indicator aggregation-status="0" ascending="0" measure="1">
    <title>
     <narrative xml:lang="EN">Health</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">STRIVE PNG project has strengthened sentinel surveillance for rapid identification of Vector-borne diseases and emerging outbreaks, resurgent and resistant pathogens and use of data for decision-making. In 2022 key achievements included the detection of a malaria outbreak in the highlands fringe of Karimui enabling Chimbu Public Health Authority and the National Malaria Control Program to lead a coordinated response.</narrative>
    </description>
    <period>
     <period-start iso-date="2022-07-01"></period-start>
     <period-end iso-date="2023-06-30"></period-end>
    </period>
   </indicator>
  </result>
  <result aggregation-status="0" type="1">
   <title>
    <narrative xml:lang="EN">Tier 2 Results</narrative>
   </title>
   <indicator aggregation-status="0" ascending="0" measure="1">
    <title>
     <narrative xml:lang="EN">Health</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">WISH Fiji supported community and health systems capacity building in water and sanitation across 5 watersheds by: strengthening 29 Village Water Committees; linking water and sanitation safety plans with Village Development Plans; legal establishment of a cross-sectoral National Drinking Water Quality Committee to assess drinking water safety; training 10 Fiji National University (FNU) staff and the National Centre for Communicable Disease Control to monitor water quality and pathogens, including new DNA extraction methods; and training 15 sub-divisional health inspectors and 4 FNU Master&#x2019;s degree students in water quality monitoring. The over 5,000 residents of these watersheds now access cleaner water.</narrative>
    </description>
    <period>
     <period-start iso-date="2022-07-01"></period-start>
     <period-end iso-date="2023-06-30"></period-end>
    </period>
   </indicator>
  </result>
