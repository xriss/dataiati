  <result aggregation-status="0" type="1">
   <title>
    <narrative xml:lang="EN">Tier 2 Results</narrative>
   </title>
   <indicator aggregation-status="0" ascending="0" measure="1">
    <title>
     <narrative xml:lang="EN">Climate adaptation, mitigation, environment and biodiversity</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">3 investments, including two renewable energy development investments , one disaster resilience investment provided to Tonga in the 23/24 financial year to support low emission development pathways and to improve climate change adaption and/or disaster resilience.</narrative>
    </description>
    <period>
     <period-start iso-date="2023-07-01"></period-start>
     <period-end iso-date="2024-06-30"></period-end>
    </period>
   </indicator>
  </result>
  <result aggregation-status="0" type="1">
   <title>
    <narrative xml:lang="EN">Tier 2 Results</narrative>
   </title>
   <indicator aggregation-status="0" ascending="0" measure="1">
    <title>
     <narrative xml:lang="EN">Emergency assistance</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">Live and Learn worked closely with communities and schools to strengthen and improved access to water.  The actual number of beneficiaries exceeded the targeted number.  The budget support component of this investment will be reported in the next reporting period.</narrative>
    </description>
    <period>
     <period-start iso-date="2022-07-01"></period-start>
     <period-end iso-date="2023-06-30"></period-end>
    </period>
   </indicator>
  </result>
  <result aggregation-status="0" type="1">
   <title>
    <narrative xml:lang="EN">Tier 2 Results</narrative>
   </title>
   <indicator aggregation-status="0" ascending="0" measure="1">
    <title>
     <narrative xml:lang="EN">Improved governance</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">Participation of women and person with disability at decision making level such as the Village Emergency Management Committee highlighted the importance of inclusion in communities.</narrative>
    </description>
    <period>
     <period-start iso-date="2023-07-01"></period-start>
     <period-end iso-date="2024-06-30"></period-end>
    </period>
   </indicator>
  </result>
  <result aggregation-status="0" type="1">
   <title>
    <narrative xml:lang="EN">Tier 2 Results</narrative>
   </title>
   <indicator aggregation-status="0" ascending="0" measure="1">
    <title>
     <narrative xml:lang="EN">Climate adaptation, mitigation, environment and biodiversity</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">The AHP activation project was undertaken in the wake of Hunga-Tonga Hunga Ha&apos;api to ensure that the people of Tonga, with a specific focus on the most vulnerable are well prepared for and more resilient to future disasters and climate change. Australian funding was provided to a collective group of ANGO&apos;s, who have so far reached 2,188 people across Tonga through five adaptation and or resilience projects- these projects include training for psychosocial support, providing water tanks across remote communities, increasing the resilience of women and girls through income generation programs, and providing first aid training to at-risk groups. As Australia is the sole donor, Australia&apos;s share of the result is 2,188 people (1153 women, 108 children with disability, 165 adults with disability).</narrative>
    </description>
    <period>
     <period-start iso-date="2023-07-01"></period-start>
     <period-end iso-date="2024-06-30"></period-end>
    </period>
   </indicator>
  </result>
