   <title>
    <narrative xml:lang="EN">Strategic Review: Australia-Indonesia Partnership for Rural Incomes through Support for Markets in Agriculture, Phase 2 (PRISMA-2)</narrative>
   </title>
   <category code="A07"></category>
   <language code="EN"></language>
   <document-date iso-date="2023-01-12"></document-date>
   <dfat:recipient-country code="ID"></dfat:recipient-country>
