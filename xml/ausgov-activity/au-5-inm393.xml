  <result aggregation-status="0" type="1">
   <title>
    <narrative xml:lang="EN">Tier 2 Results</narrative>
   </title>
   <indicator aggregation-status="0" ascending="0" measure="1">
    <title>
     <narrative xml:lang="EN">Economic policy reform and management and private sector development</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">Australia is supporting the ongoing expansion of Vanuatu&#x2019;s online trade facilitation portal - the first of its kind in the Pacific. The portal is making trade faster, easier, and more reliable by digitising paper-based processes. This has eased the barriers to doing business in Vanuatu by streamlining processes for importers and exporters, helping to keep supply chains open in support of local business. The Vanuatu Government has recently started co-funding the Portal, indicating its value and improving its financial sustainability.</narrative>
    </description>
    <period>
     <period-start iso-date="2022-07-01"></period-start>
     <period-end iso-date="2023-06-30"></period-end>
    </period>
   </indicator>
  </result>
  <result aggregation-status="0" type="1">
   <title>
    <narrative xml:lang="EN">Tier 2 Results</narrative>
   </title>
   <indicator aggregation-status="0" ascending="0" measure="1">
    <title>
     <narrative xml:lang="EN">Economic empowerment</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">Australia supported Vanuatu&apos;s Department of Women&#x2019;s Affairs (DWA) to review legislation in relation to the Employment Act to improve women&#x2019;s economic empowerment (WEE) in Vanuatu. Based on the recommendations of this review, DWA is currently advocating for a reform of the Employment Act to enhance WEE.</narrative>
    </description>
    <period>
     <period-start iso-date="2022-07-01"></period-start>
     <period-end iso-date="2023-06-30"></period-end>
    </period>
   </indicator>
  </result>
  <result aggregation-status="0" type="1">
   <title>
    <narrative xml:lang="EN">Tier 2 Results</narrative>
   </title>
   <indicator aggregation-status="0" ascending="0" measure="1">
    <title>
     <narrative xml:lang="EN">Improved governance</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">Australia&apos;s Governance for Growth program has supported a number of reforms at the Vanuatu Broadcasting and Television Cooperation (VTBC), Vanuatu&apos;s National Broadcaster and SOE. These reforms have strengthened VBTC&apos;s editorial autonomy, its performance and its financial sustainability.</narrative>
    </description>
    <period>
     <period-start iso-date="2022-07-01"></period-start>
     <period-end iso-date="2023-06-30"></period-end>
    </period>
   </indicator>
  </result>
  <result aggregation-status="0" type="1">
   <title>
    <narrative xml:lang="EN">Tier 2 Results</narrative>
   </title>
   <indicator aggregation-status="0" ascending="0" measure="1">
    <title>
     <narrative xml:lang="EN">Economic policy reform and management and private sector development</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">Australia&#x2019;s Governance for Growth (GFG) program is providing ongoing critical technical support to the Vanuatu Government to strengthen its Public Financial Management and Government procurement systems, legislation and regulations. In FY22/23, GFG supported the Vanuatu Government to prepare and present audited government financial statements to the Vanuatu Parliament for 2017 - 2021. This has assisted the Vanuatu Government to meet financial reporting obligations and has improved the transparency and accountability on the spending of public money, including how public funds are contributing to Vanuatu&apos;s economic recovery post-COVID.</narrative>
    </description>
    <period>
     <period-start iso-date="2022-07-01"></period-start>
     <period-end iso-date="2023-06-30"></period-end>
    </period>
   </indicator>
  </result>
  <result aggregation-status="0" type="1">
   <title>
    <narrative xml:lang="EN">Tier 2 Results</narrative>
   </title>
   <indicator aggregation-status="0" ascending="0" measure="1">
    <title>
     <narrative xml:lang="EN">Food security</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">In response to the impacts of Tropical Cyclones Judy and Kevin (both Category 4) on Vanuatu in March 2023, Australia&apos;s Governance for Growth (GFG) program played a key role in the Vanuatu Government&apos;s Food Security and Agriculture Cluster, supporting government response priorities including the planning, procurement and delivery of food supplies to cyclone-affected communities across Vanuatu&apos;s southern provinces.</narrative>
    </description>
    <period>
     <period-start iso-date="2022-07-01"></period-start>
     <period-end iso-date="2023-06-30"></period-end>
    </period>
   </indicator>
  </result>
