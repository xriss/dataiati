  <result aggregation-status="0" type="1">
   <title>
    <narrative xml:lang="EN">Tier 2 Results</narrative>
   </title>
   <indicator aggregation-status="0" ascending="0" measure="1">
    <title>
     <narrative xml:lang="EN">Health</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">UNFPA is the global lead organisation for advancing universal sexual and reproductive health and rights. The Australian government has been a long term supporter of UNFPA&apos;s work including through the provision of flexible core funding which is essential to UNFPA&apos;s ability to respond to country level needs across more than 150 countries. In 2024, Australia&apos;s funding to UNFPA enabled an estimated 2.4 million couple years of protection from unintended pregnancies in developing countries, through the provision of contraceptive commodities as well as providing technical assistance and training to partner governments to improve quality family planning services and counselling.</narrative>
    </description>
    <period>
     <period-start iso-date="2024-07-01"></period-start>
     <period-end iso-date="2025-06-30"></period-end>
    </period>
