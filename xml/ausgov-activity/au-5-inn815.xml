   <indicator aggregation-status="0" ascending="0" measure="1">
    <title>
     <narrative xml:lang="EN">Health</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">Australia&#x2019;s core funding support for UNFPA and UNFPA Supplies contributed to achieving significant results. This included the provision of family planning commodities that generated 2.3 million couple years of protection (CYP) attributable to our funding, averting 975 maternal deaths and preventing 515,116 unintended pregnancies, in addition to facilitating longer-lasting changes by guiding policy development, strengthening systems and promoting positive social norms.</narrative>
    </description>
