  <document-link format="TEXT/HTML" url="https://www.dfat.gov.au/publications/development/evaluating-development-and-diplomacy-outcomes-through-awp-partnerships-mekong">
   <title>
    <narrative xml:lang="EN">Evaluating development and diplomacy outcomes through Australian Water Partnership partnerships in the Mekong</narrative>
   </title>
   <category code="A07"></category>
   <language code="EN"></language>
   <document-date iso-date="2024-07-01"></document-date>
   <dfat:recipient-region code="789"></dfat:recipient-region>
