  <result aggregation-status="0" type="1">
   <title>
    <narrative xml:lang="EN">Tier 2 Results</narrative>
   </title>
   <indicator aggregation-status="0" ascending="0" measure="1">
    <title>
     <narrative xml:lang="EN">Economic policy reform and management and private sector development</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">ASEAN-Australia Digital Trade Standards Initiative was announced during ASEAN-Australia Special Summit in 2018. It was established to support ASEAN Member States (AMS) to leverage digital trade standards for increased interoperability to support regional integration, supporting AMS to secure benefits from digital transformation, focussing on building awareness, research, and capacity building in Digital Trade Standards. In 2023-2024, Australia provided technical assistance to develop a Roadmap on Digital Trade Standards in ASEAN (a priority economic deliverable under the Lao PDR ASEAN Chair Year in 2024) which feeds into ASEAN&#x2019;s Digital Economy Framework Agreement negotiations. The Initiative will facilitate economic policy reform and build awareness among policymakers and national standards bodies. In line with the Southeast Asia Economic Strategy to 2040 (rec 65), the Initiative advances harmonised standards and frameworks to promote a fair and inclusive digital trade environment, ensuring economic growth, and increased global connectivity for the region.</narrative>
    </description>
    <period>
     <period-start iso-date="2023-07-01"></period-start>
     <period-end iso-date="2024-06-30"></period-end>
    </period>
   </indicator>
  </result>
  <result aggregation-status="0" type="1">
   <title>
    <narrative xml:lang="EN">Tier 2 Results</narrative>
   </title>
   <indicator aggregation-status="0" ascending="0" measure="1">
    <title>
     <narrative xml:lang="EN">Economic policy reform and management and private sector development</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">The Digital Trade Standards (DTS) Initiative is working to support ASEAN in developing strong standards to build trust around digital trade and boost digital trade flows. Activities in 2022&#x2013;2023 increased ASEAN participants&#x2019; knowledge of DTS including through capacity-building and research. This continues to support ASEAN Member States (AMS) to establish harmonised standards and frameworks to promote a fair and inclusive digital trade environment, ensuring economic growth, and increased global connectivity for the region and its respective countries. The Initiative successfully developed an accessible website for AMS to access relevant DTS information.</narrative>
    </description>
    <period>
     <period-start iso-date="2022-07-01"></period-start>
     <period-end iso-date="2023-06-30"></period-end>
    </period>
   </indicator>
  </result>
