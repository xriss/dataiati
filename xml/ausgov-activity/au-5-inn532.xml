  <result aggregation-status="0" type="1">
   <title>
    <narrative xml:lang="EN">Tier 2 Results</narrative>
   </title>
   <indicator aggregation-status="0" ascending="0" measure="1">
    <title>
     <narrative xml:lang="EN">Improved governance</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">Australia through UNICEF helped Government of Indonesia in implementing guidelines for safe return to schools and learning recovery efforts in Papua province and West Papua province. Program advocacy led to a high coverage of teachers and education personnel vaccinated against COVID-19 (91% in West Papua and 71% in Papua), resulting in safe reopening of schools and zero incidence of high-risk infections. For learning recovery, strong collaboration with national government led to the development of an Early Grade Literacy practical guidebook for teachers available online to all teachers nationwide. Printed copies were distributed to teachers in 927 schools in the provinces.</narrative>
    </description>
    <period>
     <period-start iso-date="2022-07-01"></period-start>
     <period-end iso-date="2023-06-30"></period-end>
    </period>
   </indicator>
  </result>
