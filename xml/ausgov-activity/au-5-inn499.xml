  <result aggregation-status="0" type="1">
   <title>
    <narrative xml:lang="EN">Tier 2 Results</narrative>
   </title>
   <indicator aggregation-status="0" ascending="0" measure="1">
    <title>
     <narrative xml:lang="EN">Maritime security</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">Australia&#x2019;s Southeast Asia Law of the Sea Training, conducted by the Australian National Centre for Ocean Resources and Security, contributes to a peaceful, stable and prosperous region where international law is respected, and waterways are open for trade.  In 2023, seven Law of the Sea training courses were held with Indonesia, Malaysia, the Philippines, Vietnam, Cambodia and Laos. These were attended by 215 participants from across maritime security policy and operational agencies with representation ranging from junior officers to senior officials. Each course was tailored to the recipient country&#x2019;s needs to ensure content was relevant and applicable to each context. Responses in post training surveys found that participants were more confident to manage their maritime domains lawfully and effectively in line with international law, particularly the United Nations Convention on the Law of the Sea.</narrative>
    </description>
    <period>
     <period-start iso-date="2023-07-01"></period-start>
     <period-end iso-date="2024-06-30"></period-end>
    </period>
   </indicator>
  </result>
  <result aggregation-status="0" type="1">
   <title>
    <narrative xml:lang="EN">Tier 2 Results</narrative>
   </title>
   <indicator aggregation-status="0" ascending="0" measure="1">
    <title>
     <narrative xml:lang="EN">Maritime security</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">DFAT continued its longstanding partnership with the Australian National Centre for Ocean Resources and Security (ANCORS) to deliver 3 short courses and 2 masterclasses in international law of the sea to 129 participants (including 35 women) from Malaysia, the Philippines, Vietnam, and Indonesia during the reporting period. These courses increased partner agencies&#x2019; knowledge of the United Nations Convention on the Law of the Sea (UNCLOS) and domestic maritime policy and legislation issues, to help build legal capability to effectively and lawfully manage their maritime domain. The courses were delivered to government officials with a focus on civil maritime agencies, including foreign affairs, maritime law enforcement, fisheries and security and justice agencies. Courses were delivered as foundational training and small group masterclass courses on specific topics requested by partner governments.</narrative>
    </description>
    <period>
     <period-start iso-date="2024-07-01"></period-start>
     <period-end iso-date="2025-06-30"></period-end>
    </period>
   </indicator>
  </result>
