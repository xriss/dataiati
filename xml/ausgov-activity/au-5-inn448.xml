  <result aggregation-status="0" type="1">
   <title>
    <narrative xml:lang="EN">Tier 2 Results</narrative>
   </title>
   <indicator aggregation-status="0" ascending="0" measure="1">
    <title>
     <narrative xml:lang="EN">Emergency assistance</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">Under this investment, the AHP is working with local partners to address the impacts of the current La Nina drought and related hygiene needs in Kiribati. In the first six months of the project, household hygiene kits and water storage containers were distributed to 800 households across Betio. These containers improve water collection practices and ensure water quality at household level by using a tap instead of dipping cups to prevent any potential water contamination. AHP partners also implemented a digital media campaign raising awareness of the drought and encouraging good hygiene and equitable access to water.</narrative>
    </description>
    <period>
     <period-start iso-date="2022-07-01"></period-start>
     <period-end iso-date="2023-06-30"></period-end>
    </period>
   </indicator>
  </result>
