  <result aggregation-status="0" type="1">
   <title>
    <narrative xml:lang="EN">Tier 2 Results</narrative>
   </title>
   <indicator aggregation-status="0" ascending="0" measure="1">
    <title>
     <narrative xml:lang="EN">Economic policy reform and management and private sector development</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">The Aus4ASEAN Futures Initiative is the flagship $204 million investment (2022-2032) under the ASEAN-Australia Comprehensive Strategic Partnership. It supported development of the Study on the ASEAN Digital Economy Framework Agreement (DEFA), which identifies necessary steps to accelerate growth in the regional digital economy from around USD 300 billion to USD 1 trillion by 2030. The study found that improvements in the digital economy would also bring social benefits, such as climate resilience, job creation, social mobility, inclusivity and improved access to services. The study enabled ASEAN to commence negotiations towards a DEFA two years earlier than anticipated. Aus4ASEAN Futures is also providing demand-driven, targeted capacity building support for ASEAN Member States to participate in DEFA&#xa0;negotiations.</narrative>
    </description>
    <period>
     <period-start iso-date="2024-07-01"></period-start>
     <period-end iso-date="2025-06-30"></period-end>
    </period>
   </indicator>
  </result>
  <result aggregation-status="0" type="1">
   <title>
    <narrative xml:lang="EN">Tier 2 Results</narrative>
   </title>
   <indicator aggregation-status="0" ascending="0" measure="1">
    <title>
     <narrative xml:lang="EN">Climate adaptation, mitigation, environment and biodiversity</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">The Aus4ASEAN Futures Initiative is the flagship investment under the ASEAN-Australia Comprehensive Strategic Partnership. Demand-driven, agile and responsive to ASEAN priorities, Aus4ASEAN Futures provides targeted support through ASEAN systems to ASEAN Member States across ASEAN&#x2019;s three community pillars (Economic; Socio-Cultural; Political Security). It supported development of the ASEAN Strategy for Carbon Neutrality outlining eight thematic areas and 16 practical initiatives to accelerate ASEAN&#x2019;s transition to a green economy. By fostering a coordinated and phased regional approach to carbon neutrality, ASEAN could generate USD5.3 trillion in additional value add, attract USD6.7 trillion in green finance, and create 66 million additional jobs by 2050. The Strategy is now moving to implementation to unlock significant economic and social benefits for ASEAN Member States and the region.</narrative>
    </description>
    <period>
     <period-start iso-date="2023-07-01"></period-start>
     <period-end iso-date="2024-06-30"></period-end>
    </period>
   </indicator>
