  <result aggregation-status="0" type="1">
   <title>
    <narrative xml:lang="EN">Tier 2 Results</narrative>
   </title>
   <indicator aggregation-status="0" ascending="0" measure="1">
    <title>
     <narrative xml:lang="EN">Trade</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">Aus4ASEAN Futures is the flagship investment under the ASEAN Australia Comprehensive Strategic Partnership. Demand-driven, agile and responsive to ASEAN priorities, Aus4ASEAN Futures provides targeted support through ASEAN systems to ASEAN Member States (AMS) across ASEAN&#x2019;s community pillars (Economic; Socio-Cultural; Political-Security). It developed the &#x201c;New ASEAN Tariff Finder&#x201d; for AMS, providing an online platform to support traders to navigate export conditions of concluded or upgraded Free Trade Agreements (FTAs) agreed by ASEANs across 160 countries aimed at increasing uptake of tariff reductions available in FTAs. A separate project &quot;Capacity Building on Remanufactured Goods&quot; equipped AMS trade negotiators with knowledge about the opportunities for ASEANs in remanufactured goods, and relevant regulatory frameworks. It supported ASEAN to promote sustainable economic practices and integrate remanufacturing into trade agreements, enhancing regional economic resilience and ensuring alignment with relevant regional and international trade standards.</narrative>
    </description>
    <period>
     <period-start iso-date="2023-07-01"></period-start>
     <period-end iso-date="2024-06-30"></period-end>
    </period>
   </indicator>
  </result>
  <result aggregation-status="0" type="1">
   <title>
    <narrative xml:lang="EN">Tier 2 Results</narrative>
   </title>
   <indicator aggregation-status="0" ascending="0" measure="1">
    <title>
     <narrative xml:lang="EN">Trade</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">Aus4ASEAN Futures is the flagship investment under the ASEAN Australia Comprehensive Strategic Partnership. Demand-driven, agile and responsive to ASEAN priorities, Aus4ASEAN Futures provides targeted support through ASEAN systems to ASEAN Member States across ASEAN&#x2019;s community pillars (Economic; Socio-Cultural; Political-Security). It conducted a study on the Digital Economy Framework Agreement (DEFA) complementing the work Australia had supported under the Digital Standards Initiative. The study reviewed individual member states capacity, policy settings and international best practice to identify nine core areas to be included in a region-wide draft agreement that has the potential to unlock a digital economy worth USD 2 trillion. The study provided the technical foundation for ASEAN DEFA negotiations to commence two years ahead of schedule.</narrative>
    </description>
    <period>
     <period-start iso-date="2023-07-01"></period-start>
     <period-end iso-date="2024-06-30"></period-end>
    </period>
   </indicator>
