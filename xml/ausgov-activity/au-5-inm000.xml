   <title>
    <narrative xml:lang="EN">Health Portfolio Plan Mid-Term Review (2022): Final Report</narrative>
   </title>
   <category code="A07"></category>
   <language code="EN"></language>
   <document-date iso-date="2022-12-01"></document-date>
