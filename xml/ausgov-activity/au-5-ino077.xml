  <result aggregation-status="0" type="1">
   <title>
    <narrative xml:lang="EN">Tier 2 Results</narrative>
   </title>
   <indicator aggregation-status="0" ascending="0" measure="1">
    <title>
     <narrative xml:lang="EN">Health</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">With Australia&apos;s support, IPPF provided contraceptive information, counselling and commodities that enabled over 555,000 couple years of protection from unwanted pregnancy (CYP) globally, averting an estimated 447 maternal deaths.</narrative>
    </description>
    <period>
     <period-start iso-date="2023-07-01"></period-start>
