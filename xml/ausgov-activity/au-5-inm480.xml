  <result aggregation-status="0" type="1">
   <title>
    <narrative xml:lang="EN">Tier 2 Results</narrative>
   </title>
   <indicator aggregation-status="0" ascending="0" measure="1">
    <title>
     <narrative xml:lang="EN">Health</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">In 2022, the Intermediate Field Epidemiology training program trained 17 fellows to perform disease surveillance, data collection and epidemiological analysis to improve PNG&#x2019;s ability to respond to disease outbreaks.  The fellows undertook an intervention project that identified and analysed one public health problem. These field epidemiologists piloted interventions to real problems, such as investigating a malaria outbreak and assessing effective use of bed nets in Wanikipa Village, Hela Province. The 2022 training marked a change in approach where 95 percent of the training was delivered by the University of PNG and included fellows from Solomon Islands.</narrative>
    </description>
    <period>
     <period-start iso-date="2022-07-01"></period-start>
     <period-end iso-date="2023-06-30"></period-end>
    </period>
   </indicator>
  </result>
  <result aggregation-status="0" type="1">
   <title>
    <narrative xml:lang="EN">Tier 2 Results</narrative>
   </title>
   <indicator aggregation-status="0" ascending="0" measure="1">
    <title>
     <narrative xml:lang="EN">Health</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">WHO provides technical assistance to PNG&#x2019;s National Department of Health, including to strengthen management of multi-drug-resistant tuberculosis (MDR-TB). In October 2022, WHO assisted PNG&#x2019;s National TB Program to facilitate the annual mission of the WHO Regional Green Light Committee, which assesses management of MDR-TB. The Committee recommended improved management of laboratory sample transportation, decentralisation of testing, new treatment regimens and improved electronic records management. WHO has assisted PNG to incorporate these recommendations in the revised National TB strategy and include funding needs in PNG&#x2019;s recent grant proposal to the Global Fund for tuberculosis.</narrative>
    </description>
    <period>
     <period-start iso-date="2022-07-01"></period-start>
     <period-end iso-date="2023-06-30"></period-end>
    </period>
   </indicator>
  </result>
