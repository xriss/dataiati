  <result aggregation-status="0" type="1">
   <title>
    <narrative xml:lang="EN">Tier 2 Results</narrative>
   </title>
   <indicator aggregation-status="0" ascending="0" measure="1">
    <title>
     <narrative xml:lang="EN">Climate adaptation, mitigation, environment and biodiversity</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">Drawing on the El Nino Response Fund, World Vision has delivered critical water resources to communities facing severe drought in Gaua, Vanuatu. El Ni&#xf1;o weather conditions caused traditional rainwater harvesting systems and wells to dry up and community members were facing significant water scarcity, having to walk long distances or use contaminated water sources. In collaboration with other agencies, World Vision supported the Area Council Emergency Operation Centre to implement water trucking and water boating services to address immediate needs, as well as distributing essential resources such as water storage containers and hygiene kits. The initiative supported 22 drought-affected communities in Gaua and the early recovery of approximately 2,573 individuals, meeting immediate needs.</narrative>
    </description>
    <period>
     <period-start iso-date="2024-07-01"></period-start>
     <period-end iso-date="2025-06-30"></period-end>
    </period>
   </indicator>
  </result>
