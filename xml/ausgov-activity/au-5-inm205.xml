  <result aggregation-status="0" type="1">
   <title>
    <narrative xml:lang="EN">Tier 2 Results</narrative>
   </title>
   <indicator aggregation-status="0" ascending="0" measure="1">
    <title>
     <narrative xml:lang="EN">Food security</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">An applied research project through the Australian National University is exploring the viability of carbon sequestration and trading for increasing income for smallholder coffee and cocoa farmers in Papua New Guinea. The project is measuring the baseline rates of carbon sequestration in coffee and cocoa production systems in PNG. This measurement work forms the basis for farmers to be able to receive payments for carbon sequestration. The project is also looking at the required legislative frameworks and how carbon certification and accreditation can be implemented with smallholder farmers.</narrative>
    </description>
    <period>
     <period-start iso-date="2022-07-01"></period-start>
     <period-end iso-date="2023-06-30"></period-end>
    </period>
   </indicator>
  </result>
  <result aggregation-status="0" type="1">
   <title>
    <narrative xml:lang="EN">Tier 2 Results</narrative>
   </title>
   <indicator aggregation-status="0" ascending="0" measure="1">
    <title>
     <narrative xml:lang="EN">Food security</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">Australia is supporting the Centre for Pacific Crops and Trees (CePaCT) to conserve, characterise and distribute plant genetic resources important for food and nutrition security in the face of climate change. CePaCT&#x2019;s collections consist of plant accessions originating from 16 Pacific countries: Cook Islands, Fiji, French Polynesia, Kiribati, FSM, Marshall Islands, Niue, Palau, PNG, Samoa, Solomon Islands, Tokelau, Tonga, Tuvalu, Vanuatu, and New Caledonia. CePaCT is continuing to expand its collection and work with Pacific countries to distribute plant material for research and use via research institutions and extension services.</narrative>
    </description>
    <period>
     <period-start iso-date="2023-07-01"></period-start>
     <period-end iso-date="2024-06-30"></period-end>
    </period>
   </indicator>
  </result>
  <result aggregation-status="0" type="1">
   <title>
    <narrative xml:lang="EN">Tier 2 Results</narrative>
   </title>
   <indicator aggregation-status="0" ascending="0" measure="1">
    <title>
     <narrative xml:lang="EN">Food security</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">DFAT is supporting the Centre for Pacific Crops and Trees (CePaCT) to conserve, characterise and distribute plant genetic resources important for food and nutrition security in the face of climate change. By the end of 2022 there were 2,374 accessions of 18 crops, 40 tree species and 16 vegetable crops species conserved in the CePaCT collection. Of these, 92 percent were in tissue culture, 7 percent seeds and 1 percent in the field. CePaCT continued its work on germplasm distributions to different countries for research and training purposes, as well as support to local farmers for growing climate resilient crops.</narrative>
    </description>
    <period>
     <period-start iso-date="2022-07-01"></period-start>
     <period-end iso-date="2023-06-30"></period-end>
    </period>
   </indicator>
  </result>
