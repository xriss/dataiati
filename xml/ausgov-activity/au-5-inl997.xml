  <result aggregation-status="0" type="1">
   <title>
    <narrative xml:lang="EN">Tier 2 Results</narrative>
   </title>
   <indicator aggregation-status="0" ascending="0" measure="1">
    <title>
     <narrative xml:lang="EN">Gender equality</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">Australia is enhancing policing and justice services in Vanuatu, with an emphasis on improving access for women, children, and people with disabilities affected by sexual and gender-based violence. A key component of this partnership with the Government of Vanuatu is the Authorised Persons (AP) Program. Appointed APs are community members in remote areas empowered to issue Temporary Protection Orders (TPOs) for individuals affected by violence, especially those who cannot easily access formal justice services. These TPOs are crucial for safeguarding victim survivors of sexual and gender-based violence, offering immediate protection and legal recourse. To date, 28 APs have been appointed, and these APs have supported 158 individuals affected by violence with 41 issued TPOs in 2024, protecting women from domestic violence. At the same time, the program works closely with traditional justice systems, supporting chiefs to better understand and support women seeking protection from domestic violence. Following a successful pilot of the AP Program in Shefa Province, it is now being expanded to Samna Province and Malampa Province.</narrative>
    </description>
    <period>
     <period-start iso-date="2024-07-01"></period-start>
     <period-end iso-date="2025-06-30"></period-end>
    </period>
   </indicator>
  </result>
  <result aggregation-status="0" type="1">
   <title>
    <narrative xml:lang="EN">Tier 2 Results</narrative>
   </title>
   <indicator aggregation-status="0" ascending="0" measure="1">
    <title>
     <narrative xml:lang="EN">Improved governance</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">In 2022, Australia strengthened the skills of 713 Vanuatu police, law and justice officials through training and mentoring support. This included training 47 new police recruits, of which 34 per cent were women, up from 25 per cent in 2021, and exceeding the Vanuatu Police Force&apos;s and Australia&apos;s 30 per cent target. Australian-supported training programs have increased the capacity and reach of the sector in delivering and improving access to justice and policing services for women, children, youth, and vulnerable groups.</narrative>
    </description>
    <period>
     <period-start iso-date="2022-07-01"></period-start>
     <period-end iso-date="2023-06-30"></period-end>
    </period>
   </indicator>
  </result>
