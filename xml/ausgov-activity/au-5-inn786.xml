  <result aggregation-status="0" type="1">
   <title>
    <narrative xml:lang="EN">Tier 2 Results</narrative>
   </title>
   <indicator aggregation-status="0" ascending="0" measure="1">
    <title>
     <narrative xml:lang="EN">Improved governance</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">As part of the Health Social Accountability (SA) Initiative in Papua New Guinea, Australia&#x2019;s technical support provided to Care PNG, has brought together local communities and government stakeholders in Morobe District to develop social accountability tools such as a citizen&apos;s charter and community scorecards at local health facilities. Both the charter and the scorecards have provided the community with a platform to raise concerns with local authorities about the delivery of health services such as lack of medicines, improper attitude of the health workers, lack of electricity and sanitation issues. Care categorised the complaints and worked with the Public Health Authority to facilitate discussions about community needs and to implement solutions. Since these measures were introduced, expectant mothers have reported feeling more confident and safer attending the health clinics.</narrative>
    </description>
    <period>
     <period-start iso-date="2023-07-01"></period-start>
     <period-end iso-date="2024-06-30"></period-end>
    </period>
   </indicator>
  </result>
  <result aggregation-status="0" type="1">
   <title>
    <narrative xml:lang="EN">Tier 2 Results</narrative>
   </title>
   <indicator aggregation-status="0" ascending="0" measure="1">
    <title>
     <narrative xml:lang="EN">Improved governance</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">Through technical assistance provided by a Papua New Guinean organisational development specialist, Australia has supported the PNG Department for Community Development and Religion (DfCDR) to design a decentralised organisational re-structure plan with 19,526 positions, placing community development personnel at the forefront of service delivery in rural communities across 96 districts and 6,375 wards. The restructure plan was approved on 7 December 2022 by the PNG Department of Personnel Management, with recruitment of the initial cohort of subnational positions underway in 2023. Inputs provided include technical assistance for drafting of the restructure proposal submission, consultations and workshops.</narrative>
    </description>
    <period>
     <period-start iso-date="2022-07-01"></period-start>
     <period-end iso-date="2023-06-30"></period-end>
    </period>
   </indicator>
  </result>
