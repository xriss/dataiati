  <result aggregation-status="0" type="1">
   <title>
    <narrative xml:lang="EN">Tier 2 Results</narrative>
   </title>
   <indicator aggregation-status="0" ascending="0" measure="1">
    <title>
     <narrative xml:lang="EN">Improved governance</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">Australia supported PNG to develop its Capital Markets through our partnership with the International Finance Corporation. This included design and launch of a modern Central Securities Depository System, which enabled the Bank of PNG to effectively facilitate secure transactions in primary and secondary bond markets. The Partnership also assisted PNG&apos;s Securities Commission with the new Securities Commission (Wholesale Corporate Bonds) Order. Approved in June 2023, this regulation allows businesses listed on the PNG Stock Exchange to raise funds through bonds using a simplified process and ensures significant transparency before and after the bonds are issued to limit risks to investors.</narrative>
    </description>
    <period>
     <period-start iso-date="2022-07-01"></period-start>
     <period-end iso-date="2023-06-30"></period-end>
    </period>
   </indicator>
  </result>
