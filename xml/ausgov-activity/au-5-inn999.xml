  <result aggregation-status="0" type="1">
   <title>
    <narrative xml:lang="EN">Tier 2 Results</narrative>
   </title>
   <indicator aggregation-status="0" ascending="0" measure="1">
    <title>
     <narrative xml:lang="EN">Climate adaptation, mitigation, environment and biodiversity</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">Australia has supported ethnic communities in Phongsaly Province, the most northern province in Laos, improve access to climate resilient water, sanitation and hygiene (WASH) services through the Climate Resilient WASH program with UNICEF. The program constructed a new gravity-fed water system benefiting 437 residents across 64 households. The system serves as a model for sustainable development that enhances community well-being and climate resilience. The project also used a community-led total sanitation approach to improve sanitation and hygiene practices in the communities, allowing the village to achieve &quot;Open Defecation Free&quot; status. Clean water and handwashing stations were built in a school to create a healthier learning environment. Australia&apos;s support has been instrumental in contributing to a healthier and more sustainable future for communities in Phongsaly Province.</narrative>
    </description>
    <period>
     <period-start iso-date="2023-07-01"></period-start>
     <period-end iso-date="2024-06-30"></period-end>
    </period>
   </indicator>
  </result>
