   <title>
    <narrative xml:lang="EN">Tier 2 Results</narrative>
   </title>
   <indicator aggregation-status="0" ascending="0" measure="1">
    <title>
     <narrative xml:lang="EN">Climate adaptation, mitigation, environment and biodiversity</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">In 2025 Lao PDR achieved Open Defecation Free (ODF) status with all 18 provinces declared ODF free. This milestone acknowledges the work done to improve health outcomes, including reducing the spread of diseases, protecting children from malnutrition and stunting and enhancing dignity and safety for women and girls.  Australia supported this effort through a partnership with UNICEF and NGO, SNV. This program is now transitioning to support the &#x201c;last mile&#x201d; households, ensuring that most vulnerable and remote communities have access to safe sanitation.</narrative>
    </description>
    <period>
     <period-start iso-date="2024-07-01"></period-start>
