  <result aggregation-status="0" type="1">
   <title>
    <narrative xml:lang="EN">Tier 2 Results</narrative>
   </title>
   <indicator aggregation-status="0" ascending="0" measure="1">
    <title>
     <narrative xml:lang="EN">Strengthening leadership</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">Australia Awards scholarship recipient Aleesha Kalulu returned to Vanuatu to work at the Ministry of Health as a Senior Vaccine Safety Officer after completing a Bachelor of Public Health at University of Canberra.  Aleesha used her newly acquired skills and established Vanuatu&#x2019;s inaugural Adverse Events Following Immunization (AEFI) surveillance system. This system ensures all vaccines are monitored and administered to enable early detection of potential adverse effects. Aleesha maintains a close working relationship with the Australian National Centre for Immunization and continues to tap into her professional networks in Australia to strengthen Vanuatu&#x2019;s healthcare system. Aleesha is one of more than 500 Australia Award Alumni in Vanuatu. In 2023 Aleesha was awarded Vanuatu&#x2019;s Alumni of the Year Award for her outstanding contribution to the health sector in Vanuatu.</narrative>
    </description>
    <period>
     <period-start iso-date="2023-07-01"></period-start>
     <period-end iso-date="2024-06-30"></period-end>
    </period>
   </indicator>
  </result>
  <result aggregation-status="0" type="1">
   <title>
    <narrative xml:lang="EN">Tier 2 Results</narrative>
   </title>
   <indicator aggregation-status="0" ascending="0" measure="1">
    <title>
     <narrative xml:lang="EN">Improved governance</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">Australia supported Vanuatu&#x2019;s Ministry of Education and Training to reclassify schools as essential services, ensuring children are still able to education during emergencies and following natural hazards such as cyclones.</narrative>
    </description>
