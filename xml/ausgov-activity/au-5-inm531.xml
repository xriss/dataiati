  <result aggregation-status="0" type="1">
   <title>
    <narrative xml:lang="EN">Tier 2 Results</narrative>
   </title>
   <indicator aggregation-status="0" ascending="0" measure="1">
    <title>
     <narrative xml:lang="EN">Climate adaptation, mitigation, environment and biodiversity</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">The Pacific Blue Carbon Regional Initiative has assisted 1041 people, including 543 women, to adapt to the impacts of climate change through the restoration and conservation of mangrove ecosystems in Fiji. Project activities have enhanced community resilience to climate change by improving coastal protection, reducing vulnerability to storm surges and improving fishery productivity, supporting sustainable income sources for communities.</narrative>
    </description>
    <period>
     <period-start iso-date="2023-07-01"></period-start>
     <period-end iso-date="2024-06-30"></period-end>
    </period>
   </indicator>
  </result>
  <result aggregation-status="0" type="1">
   <title>
    <narrative xml:lang="EN">Tier 2 Results</narrative>
   </title>
   <indicator aggregation-status="0" ascending="0" measure="1">
    <title>
     <narrative xml:lang="EN">Climate adaptation, mitigation, environment and biodiversity</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">The Pacific Blue Carbon Regional Initiative is assisting communities in Fiji to adapt to the impacts of climate change through the restoration and conservation of mangrove ecosystems. Approximately 20 hectares of mangroves have been restored in partnership with 5 communities. The community-led restoration activities have led to improvements in coastal protection and fishery productivity. They have also fostered community environmental stewardship capacity. Through a knowledge exchange program with Australian First Nation communities, the five partner communities also developed understanding of new adaptive practices.</narrative>
    </description>
    <period>
     <period-start iso-date="2023-07-01"></period-start>
     <period-end iso-date="2024-06-30"></period-end>
    </period>
   </indicator>
  </result>
  <result aggregation-status="0" type="1">
   <title>
    <narrative xml:lang="EN">Tier 2 Results</narrative>
   </title>
   <indicator aggregation-status="0" ascending="0" measure="1">
    <title>
     <narrative xml:lang="EN">Climate adaptation, mitigation, environment and biodiversity</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">The Pacific Blue Carbon Regional Initiative is assisting communities in Fiji to adapt to the impacts of climate change through the restoration and conservation of mangrove ecosystems. Approximately 20 hectares of mangroves have been restored in partnership with 5 communities. 
&#x200d;
In collaboration with the Fijian Ministry of Forestry and WWF, Conservation International conducted a survey across 4 Provinces, involving over 600 households, to understand mangrove use and conservation needs. This led to the identification of priority areas for restoration. In Navitilevu, for example, restoration plans are focused on enhancing ecosystem services, like strengthening shoreline stability and protecting fisheries habitats. 
&#x200d;
Through the establishment of in-situ and community nurseries, the initiative has propagated over 50,000 mangrove seedlings. These nurseries are now registered for commercial operations, contributing to global carbon reduction efforts and community livelihoods.</narrative>
    </description>
    <period>
     <period-start iso-date="2023-07-01"></period-start>
     <period-end iso-date="2024-06-30"></period-end>
    </period>
   </indicator>
  </result>
