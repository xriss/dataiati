  <result aggregation-status="0" type="1">
   <title>
    <narrative xml:lang="EN">Tier 2 Results</narrative>
   </title>
   <indicator aggregation-status="0" ascending="0" measure="1">
    <title>
     <narrative xml:lang="EN">Disability equity</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">The Responsible AI (RAI) project under Aus4Innovation program helps provide Vietnam&#x2019;s Ministry of Science and Technology with international best practices and recommendations for effective AI regulations. The RAI team introduced an AI-powered mobile app to support 20 visually impaired students at Nguyen Dinh Chieu School in Hanoi to read textbooks, to improve the accessibility of learning materials and improve their learning experience.  The student participants in this pilot initiative provided the RAI team with valuable insights to improve the functionality of the app and refine the RAI Guidelines</narrative>
    </description>
    <period>
     <period-start iso-date="2024-07-01"></period-start>
     <period-end iso-date="2025-06-30"></period-end>
    </period>
   </indicator>
  </result>
  <result aggregation-status="0" type="1">
   <title>
    <narrative xml:lang="EN">Tier 2 Results</narrative>
   </title>
   <indicator aggregation-status="0" ascending="0" measure="1">
    <title>
     <narrative xml:lang="EN">Climate adaptation, mitigation, environment and biodiversity</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">Two projects under Aus4Innovation contributed to climate change mitigation. The first project supported a crop monitoring solution in the Mekong Delta. This used satellite and drone imagery to help smallholder farmers and government decision-makers in Vietnam identify potential issues in advance, such as pests, diseases, nutrient imbalances, water deficiencies, and salinisation. The project contributes to mitigating climate-related impacts and reducing income losses for the farmers. The second project focuses on developing a carbon farming solution. It established a system to help Thanh Hoa provincial authorities monitor carbon emissions from rice production, a foundation for farmers to refine their farming practices and join the carbon credit market in the future.</narrative>
    </description>
    <period>
     <period-start iso-date="2024-07-01"></period-start>
     <period-end iso-date="2025-06-30"></period-end>
    </period>
   </indicator>
  </result>
