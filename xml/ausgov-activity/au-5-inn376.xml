  <result aggregation-status="0" type="1">
   <title>
    <narrative xml:lang="EN">Tier 2 Results</narrative>
   </title>
   <indicator aggregation-status="0" ascending="0" measure="1">
    <title>
     <narrative xml:lang="EN">Economic policy reform and management and private sector development</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">The Australian Infrastructure Financing Facility for the Pacific (AIFFP) is providing AUD7 million to support the Government of Timor-Leste in delivering their first submarine cable.  The cable will connect Timor-Leste to Australia, with AIFFP funding including design, procurement and implementation advisory support to assist Timor-Leste to achieve a high quality, secure cable connection. Timor-Leste is one of a few nations in the world without an international undersea fibre optic connection and is currently relying on slow and costly satellite services. Faster, cheaper and more reliable internet access will enable significant economic and social benefits and assist with post-COVID economic recovery.</narrative>
    </description>
    <period>
     <period-start iso-date="2022-07-01"></period-start>
     <period-end iso-date="2023-06-30"></period-end>
    </period>
   </indicator>
  </result>
  <result aggregation-status="0" type="1">
   <title>
    <narrative xml:lang="EN">Tier 2 Results</narrative>
   </title>
   <indicator aggregation-status="0" ascending="0" measure="1">
    <title>
     <narrative xml:lang="EN">Infrastructure</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">The Australian Infrastructure Financing Facility for the Pacific (AIFFP) is supporting Timor-Leste Government to design and deliver an undersea telecommunications cable that will allow for faster, more affordable and reliable telecommunications in Timor-Leste. With Timor-Leste one of the few remaining countries not connected to an international submarine telecommunications cable, the project will enable ICT-driven economic growth and development. The completed cable will enable greater connections between people, business and governments across Timor-Leste and the wider Pacific, reflecting all G20 Principles for Quality Infrastructure Investments, but especially Principle 1: &apos;maximising the positive impact of infrastructure&apos;.</narrative>
    </description>
