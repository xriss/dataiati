  <result aggregation-status="0" type="1">
   <title>
    <narrative xml:lang="EN">Tier 2 Results</narrative>
   </title>
   <indicator aggregation-status="0" ascending="0" measure="1">
    <title>
     <narrative xml:lang="EN">Strengthening leadership</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">The Australia Awards scholarships provide an opportunity to strengthen the practical skills of alumni, resulting in improved quality of services across a range of critical public sectors, including health. Over financial year 2023-2024, Nauru celebrated the achievements of three Australia Awards Scholarship (AAS) recipients, who have successfully completed their studies and are now actively contributing to their respective fields within the health sector. Specifically, one alumna is advancing dentistry, another is enhancing midwifery services, and a third graduated in paramedicine and is pioneering as Nauru&apos;s first qualified paramedic in this field, poised to serve under Health/National Emergency Services. Their roles underscore the beneficial outcomes of the Australia Awards program, fostering ongoing collaborations and mutual advancements between Nauru and Australia in healthcare.</narrative>
    </description>
    <period>
     <period-start iso-date="2023-07-01"></period-start>
     <period-end iso-date="2024-06-30"></period-end>
    </period>
   </indicator>
  </result>
