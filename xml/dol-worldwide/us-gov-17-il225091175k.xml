  <title>
   <narrative xml:lang="EN">Global Action Program on Child Labor Issues</narrative>
  </title>
  <description type="1">
   <narrative xml:lang="EN">The project will provide assistance to targeted countries in promoting sustainable livelihoods for vulnerable populations; supporting innovative research and monitoring systems to aid with policy development and program design; and encouraging new efforts to protect children from exploitation in domestic work.</narrative>
  </description>
