 <iati-activity default-currency="EUR" hierarchy="1" humanitarian="0" iati-activities:version="2.03" xml:lang="EN" xmlns:iati-activities="http://d-portal.org/xmlns/iati-activities">
  <iati-identifier>XI-IATI-EC_INTPA-2023-ACT-61713</iati-identifier>
  <reporting-org ref="XI-IATI-EC_INTPA" secondary-reporter="0" type="15">
