  <result aggregation-status="1" type="1">
   <title>
    <narrative xml:lang="EN">Annual Output Results</narrative>
   </title>
   <indicator ascending="0" measure="5">
    <title>
     <narrative xml:lang="EN">Output Indicator</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">Total capacity of installed rooftop PV systems by the private sector and electricity generated by them. reaches 4 Mega Watt</narrative>
    </description>
    <baseline year="2017">
     <comment>
      <narrative xml:lang="EN"></narrative>
     </comment>
    </baseline>
    <period>
     <period-start iso-date="2020-01-01"></period-start>
     <period-end iso-date="2020-12-31"></period-end>
     <target>
      <comment>
       <narrative xml:lang="EN">Implement the third batch of pilot projects of 5 projects</narrative>
      </comment>
     </target>
     <actual>
      <comment>
       <narrative xml:lang="EN">Implemented the third batch of projects of more than 5 projects, thus the total installed solar power stations has reached 109 with a total capacity of 8.2 MW</narrative>
      </comment>
     </actual>
    </period>
    <period>
     <period-start iso-date="2021-01-01"></period-start>
     <period-end iso-date="2021-12-31"></period-end>
     <target>
      <comment>
       <narrative xml:lang="EN">Complete the fourth batch of pilot projects including 5 solar power stations</narrative>
      </comment>
     </target>
     <actual>
      <comment>
       <narrative xml:lang="EN">Supported implementation of more than 5 solar power stations including Housing and Building Research Center, two hotels in Cairo and Sharm, a community school, two factories, a University, etc..
Supported NGO implementing solar power stations through the GEF SGP</narrative>
      </comment>
     </actual>
    </period>
    <period>
     <period-start iso-date="2022-01-01"></period-start>
     <period-end iso-date="2022-12-31"></period-end>
     <target>
      <comment>
       <narrative xml:lang="EN">Focus efforts to implement a show case for use of solar power station in public and private facilities in the City of Sharm El-Sheikh that hosts the COP27 summit</narrative>
      </comment>
     </target>
     <actual>
      <comment>
       <narrative xml:lang="EN">The project supported implementation of the following solar power stations in Sharm El-Sheikh:
- A solar power station with a capacity of 1 MW in Sharm Convention Center that hosted COP27
- A solar carport with a capacity of 300 kW capacity in Sharm Airport
- Solar power stations in Sharm hotels with a capacity of approx 3 MW in at 10 hotels
-Initiated installation of 300 kW solar car park in Sharm Museum in addition to scattered solar power stations in protected areas and other locations around the City of Sharm El-Sheikh</narrative>
      </comment>
     </actual>
    </period>
   </indicator>
