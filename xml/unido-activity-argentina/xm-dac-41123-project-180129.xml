  <reporting-org ref="XM-DAC-41123" type="40">
   <narrative xml:lang="EN">United Nations Industrial Development Organization</narrative>
  </reporting-org>
  <title>
   <narrative xml:lang="EN">Promoting the production of energy efficient refrigerators in Argentina during the hydrofluorocarbons phase-down transition</narrative>
  </title>
  <description type="1">
   <narrative xml:lang="EN">In response to the call for proposals from the Kigali Cooling efficiency program (K-CEP), supported by 18 foundations and individual donors and on the request of the Government of Argentina, UNIDO suggests a project that is aiming to provide technical assistance for clean cooling and embedding energy efficiency (EE) into the refrigeration manufacturing sector (focus on self-contained units) during the F-gas transition.</narrative>
  </description>
