  </reporting-org>
  <title>
   <narrative xml:lang="EN">Locally-Led Adaptation Metrics (LAMA)</narrative>
  </title>
  <description type="1">
   <narrative xml:lang="EN">The Locally-Led Adaptation Metrics for Africa (LAMA) initiative supports community-driven climate adaptation across Africa by developing inclusive, bottom-up indicators that capture local resilience needs. Implemented by the Africa Research and Impact Network (ARIN), the project strengthens the science&#xe2;&#x20ac;&#x201c;policy interface by linking local adaptation metrics to national and global frameworks such as NAPs, NDCs, and the Global Goal on Adaptation. LAMA promotes equitable climate solutions by amplifying the voices of vulnerable communities, enhancing data-driven decision-making, and supporting evidence-based policy and investment in climate resilience.</narrative>
  </description>
  <participating-org activity-id="KE-KRA-P051915774Y" role="4" type="70">
   <narrative xml:lang="EN">AFRICA RESEARCH AND IMPACT NETWORK</narrative>
  </participating-org>
  <participating-org activity-id="XM-DAC-7-PPR-4000005910" role="1" type="21">
   <narrative xml:lang="EN">International Development Research Centre (IDRC)</narrative>
  </participating-org>
  <activity-status code="2"></activity-status>
  <activity-date iso-date="2023-09-01" type="2">
   <narrative xml:lang="EN">The Locally-Led Adaptation Metrics for Africa (LAMA) project addresses the lack of evidence and inclusive metrics for locally led climate adaptation across Africa. It develops bottom-up indicators that capture the effectiveness, equity, and inclusiveness of community-based adaptation strategies.

LAMA strengthens the capacity of vulnerable communities to design and monitor adaptation actions, fosters knowledge sharing across regions, and links local adaptation metrics to national and international frameworks such as National Adaptation Plans (NAPs), Nationally Determined Contributions (NDCs), and the Global Goal on Adaptation.

Through partnerships with research institutions, policymakers, and community networks, LAMA promotes data-driven decision-making, equitable climate solutions, and sustainable resilience across Africa.</narrative>
  </activity-date>
  <activity-scope code="2"></activity-scope>
  <recipient-country code="KE" percentage="100">
   <narrative xml:lang="EN">Kenya is listed as the recipient country as it serves as the primary implementation and coordination hub for the LAMA project. While activities and sub-grants support other African countries, project management and fund administration are conducted from Kenya.</narrative>
  </recipient-country>
  <sector code="41082" percentage="100" vocabulary="1">
   <narrative xml:lang="EN">This activity supports environmental policy and administrative management by strengthening locally led climate adaptation planning and monitoring systems. It develops and applies Locally-Led Adaptation Metrics (LAMA) to improve governance, decision-making, and accountability for climate resilience at national and sub-national levels in Kenya.</narrative>
  </sector>
  <tag code="13" vocabulary="2">
   <narrative xml:lang="EN">This activity contributes to SDG 13 (Climate Action) by strengthening locally led climate adaptation systems and resilience planning in Kenya through inclusive metrics and governance improvements.</narrative>
  </tag>
  <country-budget-items vocabulary="4">
   <budget-item code="4.2.1" percentage="100" vocabulary="4"></budget-item>
  </country-budget-items>
  <policy-marker code="7" significance="2" vocabulary="1">
   <narrative xml:lang="EN">The Locally Led Adaptation Metrics for Africa (LAMA) initiative strengthens climate change adaptation by developing inclusive, community-driven indicators that measure the effectiveness and equity of adaptation strategies. The project empowers vulnerable communities to lead adaptation planning, supports data-driven decision-making, and links local resilience metrics to national and global frameworks such as National Adaptation Plans (NAPs), Nationally Determined Contributions (NDCs), and the Global Goal on Adaptation. Through regional collaboration, knowledge sharing, and transparent tracking systems, LAMA enhances environmental governance, promotes equitable climate solutions, and improves resilience across African communities.</narrative>
  </policy-marker>
