   <narrative xml:lang="EN">FIDH International Federation for Human Rights 2025-2027 - FIDH International Federation for Human Rights 2025-2027 - ISK</narrative>
   <narrative xml:lang="SV">FIDH International Federation for Human Rights 2025-2027</narrative>
