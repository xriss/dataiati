  <title>
   <narrative xml:lang="SV">SELAM Cult f&#xf6;r Demo/MR f&#xf6;rstudie</narrative>
   <narrative xml:lang="EN">SELAM Culture for Democracy and Human Rights      Pre-study - SELAM Culture for Democracy and Human Rights</narrative>
