  <result aggregation-status="1" type="2">
   <title>
    <narrative xml:lang="EN">2. Improved productivity of Bangladeshi fish and shrimp breeders and farmers. &#x200B;</narrative>
   </title>
   <description>
    <narrative xml:lang="EN">2.1 Four commercially, technically and sustainably viable CoEs established.&#x200B;2.2 Demonstrations and workshops hosted at each CoE.&#x200B;2.3 Research and trials conducted.&#x200B;2.4 Farmer App for monitoring technical performance developed.&#x200B;</narrative>
   </description>
   <indicator aggregation-status="1" ascending="1" measure="1">
    <title>
     <narrative xml:lang="EN">2.1 Four commercially, technically and sustainably viable CoEs established.&#x200B;</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">2.1.1 Develop business cases for more intensive and controlled fish farming (incl. hatcheries) cultivation systems.&#x200B;2.1.2 Design and construction of demonstration farms in four CoEs in Cox&#x2019;s Bazar, Khulna, Mymensingh, Patuakhali, and the demonstration hatchery in Cox&#x2019;s Bazar.2.1.3 Identify and implement farm certification Best Aquaculture Practice (BAP) or equivalent.&#x200B;2.1.4 Introduce farm data collection systems.&#x200B;</narrative>
    </description>
    <period>
     <period-start iso-date="2022-09-01"></period-start>
     <period-end iso-date="2025-12-31"></period-end>
    </period>
   </indicator>
   <indicator aggregation-status="1" ascending="1" measure="1">
    <title>
     <narrative xml:lang="EN">2.2 Demonstrations and workshops hosted at each CoE.&#x200B;</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">2.2.1 Operate the four CoEs (Cox&#x2019;s Bazar, Khulna, Mymensingh, Patuakhali)2.2.2 Organise demonstration events and/or workshops for breeders and farmers (144 in total).&#x200B;</narrative>
    </description>
    <period>
     <period-start iso-date="2022-09-01"></period-start>
     <period-end iso-date="2027-02-28"></period-end>
    </period>
   </indicator>
   <indicator aggregation-status="1" ascending="1" measure="1">
    <title>
     <narrative xml:lang="EN">2.3 Research and trials conducted.&#x200B;</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">2.3.1 Data recording formats completed. &#x200B;2.3.2 Data recording of CoEs completed (vis-&#xE0;-vis baseline studies) and incorporated in business cases.&#x200B;2.3.3 Conduct at least 24 research and trials at the CoEs to assess the effect of improved breeding and cultivation techniques and on-farm products.</narrative>
    </description>
    <period>
     <period-start iso-date="2023-09-01"></period-start>
     <period-end iso-date="2027-02-28"></period-end>
    </period>
