  <result aggregation-status="1" type="2">
   <title>
    <narrative xml:lang="EN">3. Bangladeshi fish and shrimp breeders and farmers apply better commercial, technical and sustainable farming practices. &#x200B;</narrative>
   </title>
   <description>
