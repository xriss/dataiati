  <result aggregation-status="1" type="1">
   <title>
    <narrative xml:lang="EN">Annual Output Results</narrative>
   </title>
   <indicator aggregation-status="1" ascending="0" measure="5">
    <title>
     <narrative xml:lang="EN">Social norms and consumer behaviour in key target audiences move towards increased unacceptability of trafficking and purchasing illegal wildlife products.</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">Identified cases for further investigations and law enforcement actions of DNP through the WARPA framework by assessing through a systematic online wildlife trade monitoring using a standardized methodology.</narrative>
    </description>
    <baseline year="2018">
     <comment>
      <narrative xml:lang="EN">- 20 Facebook (FB) groups monitored

- 3 cases from 2019 monitoring submitted to DNP for further investigation and law enforcement actions</narrative>
     </comment>
    </baseline>
    <period>
     <period-start iso-date="2023-01-01"></period-start>
     <period-end iso-date="2023-12-31"></period-end>
     <target>
      <comment>
       <narrative xml:lang="EN">20 FB groups continue to be monitored 

- 5 additional (13 cumulative) selected cases submitted to DNP for further investigation and law enforcement actions.</narrative>
      </comment>
     </target>
     <actual>
      <comment>
       <narrative xml:lang="EN">More than 20 Facebook groups have been monitored to a lot larger extent. In this regard, the number of target indicator have been achieved. Evidence of % on-line monitor cases which enter to the law enforcement and prosecution is attached in the upload section.</narrative>
      </comment>
     </actual>
    </period>
   </indicator>
   <indicator aggregation-status="1" ascending="0" measure="5">
    <title>
     <narrative xml:lang="EN">Social norms and consumer behaviour in key target audiences move towards increased unacceptability of trafficking and purchasing illegal wildlife products</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">Change in social norms concerning the acceptability of trafficking, buying, possessing and using illegal wildlife products and derivatives as indicated by systematic assessments using a standardized methodology</narrative>
    </description>
    <baseline year="2018">
     <comment>
      <narrative xml:lang="EN">- Zero (0) existing campaigns targeting demand reduction for wildmeat consumption.

- 26% of consumers surveyed think eating wild meat is not socially acceptable (GlobeScan research commissioned by TRAFFIC and ZSL, 2021).</narrative>
     </comment>
    </baseline>
    <period>
     <period-start iso-date="2023-01-01"></period-start>
     <period-end iso-date="2023-12-31"></period-end>
     <target>
      <comment>
       <narrative xml:lang="EN">- One campaign targeting demand reduction for wildmeat consumption implemented and evaluated</narrative>
      </comment>
     </target>
     <actual>
      <comment>
       <narrative xml:lang="EN">37% achieved - the target is achieved since 2022.</narrative>
      </comment>
     </actual>
    </period>
   </indicator>
   <indicator aggregation-status="1" ascending="0" measure="5">
    <title>
     <narrative xml:lang="EN">Effective Detection and Deterrence of Illegal Wildlife Trafficking as a result of Enhanced Capacity in Enforcement and the Criminal Justice System</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">DNP wildlife forensic science laboratory accredited under IS017025 Quality Management System for components of its wildlife DNA forensic testing to align with International Standards and ensure legally admissible evidence for prosecutions in Thailand.</narrative>
    </description>
    <baseline year="2018">
     <comment>
      <narrative xml:lang="EN">DNP wildlife forensic science laboratory is not internationally accredited.</narrative>
     </comment>
    </baseline>
    <period>
     <period-start iso-date="2023-01-01"></period-start>
     <period-end iso-date="2023-12-31"></period-end>
     <target>
      <comment>
       <narrative xml:lang="EN">DNP wildlife forensic science laboratory is laboratory accredited under IS017025 Quality Management System for components of its wildlife DNA forensic testing</narrative>
      </comment>
     </target>
     <actual>
      <comment>
       <narrative xml:lang="EN">The project board on 3rd of February 2023 approved the replacement of standard compliance from the accreditation under ISO 17025 standard to the SWFS, as the end target achievement.</narrative>
      </comment>
     </actual>
    </period>
   </indicator>
   <indicator aggregation-status="1" ascending="0" measure="5">
    <title>
     <narrative xml:lang="EN">Effective Detection and Deterrence of Illegal Wildlife Trafficking as a result of Enhanced Capacity in Enforcement and the Criminal Justice System</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">Increase in number of successful cases (seizure-arrest-prosecution- conviction) involving wildlife criminals dealing in ivory, rhino horn, pangolins and tiger, and their parts and derivatives . (GWP TT)
i) annual number of seizures
ii) annual number of arrests
iii) ratio of seizures: arrests
iv) annual number of prosecutions
v) ratio of arrests: prosecutions</narrative>
    </description>
