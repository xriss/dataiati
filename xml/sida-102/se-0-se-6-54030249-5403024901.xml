  <title>
   <narrative xml:lang="SV">Svenska Afghanistankommitt&#xe9;n 2011-2014</narrative>
   <narrative xml:lang="EN">Swedish Afghanistan Committee 2011-2014 - Swe Afghanistan Committe Barn</narrative>
