 <iati-activity default-currency="USD" hierarchy="2" iati-activities:version="2.03" xml:lang="EN" xmlns:gavi="http://gavi.org/" xmlns:iati="https://iatistandard.org/en/iati-standard/" xmlns:iati-activities="http://d-portal.org/xmlns/iati-activities">
