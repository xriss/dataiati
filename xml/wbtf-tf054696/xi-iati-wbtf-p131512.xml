  <title>
   <narrative xml:lang="EN">Nairobi Sanitation Project</narrative>
  </title>
  <description type="1">
   <narrative xml:lang="EN">The Development Objective is to provide sustainable access to sanitation and water services in selected low-income communities of Nairobi, by applying one-off OBA subsidies in order to make pro-poor sewerage and water connections  financially viable.</narrative>
  </description>
