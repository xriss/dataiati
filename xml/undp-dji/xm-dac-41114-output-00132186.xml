   <indicator aggregation-status="1" ascending="0" measure="1">
    <title>
     <narrative xml:lang="FR">Rapid assessment of the impact of the crisis and adaptation mechanisms</narrative>
    </title>
    <description>
     <narrative xml:lang="FR">The project planned to carry out an assessment of the impact of the drought and rising prices with the support of the Disaster Risk Management Secretariat (SGERC). The results of the assessment will be communicated to all stakeholders involved in the process.</narrative>
    </description>
