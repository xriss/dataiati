  <result aggregation-status="1" type="1">
   <title>
    <narrative xml:lang="FR">Annual Output Results</narrative>
   </title>
   <indicator aggregation-status="1" ascending="0" measure="5">
    <title>
     <narrative xml:lang="FR">Compliance of Imported Solar Equipment with National Standards</narrative>
    </title>
    <description>
     <narrative xml:lang="FR">This indicator measures the extent to which imported solar products (panels, batteries, inverters, controllers, and ancillary components) comply with national safety, performance, and quality standards established or endorsed by the Government of Djibouti. It tracks the percentage of equipment entering the market that has been verified, certified, or approved through the national control system (standards, testing protocols, labeling and import requirements).</narrative>
    </description>
    <baseline year="2024">
     <comment>
      <narrative xml:lang="FR">No existing standards and no certification systems</narrative>
     </comment>
    </baseline>
    <period>
     <period-start iso-date="2025-01-01"></period-start>
     <period-end iso-date="2025-12-31"></period-end>
     <target>
      <comment>
       <narrative xml:lang="FR">Formations normalisations 
Elaboration des normes et des protocoles 
Mise en place d&apos;un systeme de certification</narrative>
      </comment>
     </target>
    </period>
   </indicator>
   <indicator aggregation-status="1" ascending="0" measure="1">
    <title>
     <narrative xml:lang="FR">Awareness of Affordable and Certified Solar Systems in Djibouti-ville</narrative>
    </title>
    <description>
     <narrative xml:lang="FR">This indicator measures the level of awareness and confidence among households, private sector actors, and development partners regarding the availability, quality, and affordability of certified individual solar energy systems in Djibouti-ville. It tracks the extent to which the approved distribution and after-sales service circuit (importers, verified distributors, technicians trained and certified, and standardized procedures) is known, understood, and used by the population.</narrative>
    </description>
    <baseline value="0" year="2024"></baseline>
    <period>
     <period-start iso-date="2025-01-01"></period-start>
     <period-end iso-date="2025-12-31"></period-end>
     <target value="1"></target>
    </period>
   </indicator>
   <indicator aggregation-status="1" ascending="0" measure="1">
    <title>
     <narrative xml:lang="FR">The Djiboutian regulatory framework allows the use of solar self-sufficient systems for private consumption to every household in Djibouti.</narrative>
    </title>
    <description>
     <narrative xml:lang="FR">This indicator assesses the extent to which national laws, policies, and ministerial orders effectively authorize and facilitate the deployment of individual solar self-sufficiency systems for all households in Djibouti. It tracks the existence, implementation, and enforcement of regulations that enable citizens to install and operate solar systems for their own energy needs without administrative barriers.</narrative>
    </description>
    <baseline value="2" year="2024"></baseline>
    <period>
     <period-start iso-date="2025-01-01"></period-start>
     <period-end iso-date="2025-12-31"></period-end>
     <target value="2"></target>
    </period>
   </indicator>
   <indicator aggregation-status="1" ascending="0" measure="1">
    <title>
     <narrative xml:lang="FR">Supportive regulations and policies are implemented to favour the growth of the solar energy ecosystem</narrative>
    </title>
    <description>
     <narrative xml:lang="FR">This indicator measures progress made by the Government of Djibouti in establishing, revising, or enforcing regulatory instruments that create an enabling environment for the expansion of the solar energy market. It tracks the adoption and implementation of key policies, decrees, and ministerial orders that strengthen quality control, standardization, consumer protection, private-sector participation, and rural electrification frameworks.</narrative>
    </description>
    <baseline value="2" year="2024"></baseline>
    <period>
     <period-start iso-date="2025-01-01"></period-start>
     <period-end iso-date="2025-12-31"></period-end>
     <target value="2"></target>
    </period>
   </indicator>
  </result>
