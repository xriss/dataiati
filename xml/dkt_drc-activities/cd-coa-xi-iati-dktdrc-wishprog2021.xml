  <title>
   <narrative xml:lang="EN">Women&apos;s Integrated Sexual Health Program</narrative>
  </title>
  <description type="1">
   <narrative xml:lang="EN">The Women&apos;s Integrated Sexual Health has been implemented in 11 Democratic Republic of Congo provinces which are Kinshasa, Haut-Katanga, Tshopo, Kwilu, Kwango, Mai-ndombe, Lualaba, Haut-Lomami, Lomami, Nord-Ubangi, and Sud-Ubangi. The program&apos;s primary aim is to provide access to SRHR services to women and youth living under the poverty line.</narrative>
  </description>
  <participating-org activity-id="WISHPROG2021" crs-channel-code="11000" role="1" type="10">
