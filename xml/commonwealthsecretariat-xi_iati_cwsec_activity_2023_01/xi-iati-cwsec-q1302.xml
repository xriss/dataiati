  <iati-identifier>XI-IATI-CWSEC-Q1302</iati-identifier>
  <reporting-org ref="XI-IATI-CWSEC" type="40">
   <narrative xml:lang="EN">The Commonwealth Secretariat</narrative>
  </reporting-org>
  <title>
   <narrative xml:lang="EN">Professionalisation of Youth Work</narrative>
  </title>
  <description type="1">
   <narrative xml:lang="EN">This project promotes the recognition of youth work. In doing so, professional associations will be established, ethical standards developed, competency standards and certified qualification pathways built, and professional quality assurance promoted. The project will strengthen the capacity of High Education Institutions (HEIs) to deliver Open and Distance Learning degrees whilst leveraging technology and blended learning to build resilient education systems that are responsive to the needs of the learners. Through the professionalisation and upskilling of youth workers, the Secretariat will enable youth workers to better support young people in making healthy choices for their wellbeing.</narrative>
  </description>
