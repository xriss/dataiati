   <narrative xml:lang="EN">Fundaci&#xf3;n de Antropolog&#xed;a Forense de Guatemala</narrative>
  </reporting-org>
  <title>
   <narrative xml:lang="EN">Multidisciplinary Forensic Assistance for Mexican State Institutions</narrative>
  </title>
  <description type="2">
   <narrative xml:lang="EN">Develop procedures and technical tools for the investigation of disappeared persons in Nayarit and one other Mexican state.</narrative>
  </description>
  <description type="2">
   <narrative xml:lang="EN">Facilitate strategic coordination among the different institutions involved in the search and identification of disappeared persons in Nayarit and one other Mexican state.</narrative>
  </description>
  <description type="3">
   <narrative xml:lang="EN">Nayarit State Commission for the Search for Disappeared Persons (Comisi&#xf3;n Estatal de B&#xfa;squeda de Personas - CEB), Forensic Services, and the Special Prosecutor&#x2019;s Office for Disappeared Persons</narrative>
  </description>
  <description type="2">
   <narrative xml:lang="EN">Promote victims&#x2019; relatives&#x2019; inclusion throughout the search and identification process and increase cooperation between CSOs and Durango state authorities</narrative>
  </description>
  <description type="2">
   <narrative xml:lang="EN">Provide training to forensic personnel in Nayarit and one other Mexican state, in the 5 technical areas that make up the Multidisciplinary Human Identification System; victim investigation and documentation, forensic archaeology, forensic anthropology, forensic genetics, and confirmation of identifications.</narrative>
  </description>
  <description type="2">
   <narrative xml:lang="EN">Strengthen local Mexican State forensic capacity in the search for and identification of disappeared persons, in coordination with State Search Commissions (CEB), Forensic services, and the Special Prosecutor&#x2019;s Office for Disappeared Persons</narrative>
  </description>
  <description type="2">
   <narrative xml:lang="EN">Technical accompaniment of forensic interventions to ensure the implementation of the Multidisciplinary Human Identification System in Nayarit and one other Mexican state.</narrative>
  </description>
  <description type="1">
   <narrative xml:lang="EN">The Multidisciplinary Forensic Assistance for Mexican State Institutions project&#x2019;s primary objective is to strengthen the local forensic capacities of the Comisi&#xf3;n Estatal de Busqueda de Personas (State Search Commission - CEB), Forensic services, and the Special Prosecutor&#x2019;s Office for Disappeared Persons in Nayarit. Project activities will include forensic technical training of state institution personnel, the organization of the forensic information already in possession of state authorities, the technical accompaniment of forensic interventions, and the implementation of a multidisciplinary human identification system which will allow information generated in-state to be incorporated into national and regional search strategies.</narrative>
  </description>
