  <title>
   <narrative xml:lang="EN">Project to Promote Workplace-Based Training for Vulnerable Youth in Argentina</narrative>
  </title>
  <description type="1">
   <narrative xml:lang="EN">To help bridge the skills gap in Argentina by increasing the number and quality of on-the-job training programs, such as internships and apprenticeships, while ensuring these opportunities are accessible to the youth who need them the most.</narrative>
  </description>
