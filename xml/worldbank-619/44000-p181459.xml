  <title xml:lang="EN">
   <narrative xml:lang="EN">One Health for Pandemic Prevention, Food Systems Resilience, and Ecosystem Health in Central Asia</narrative>
  </title>
  <description type="1" xml:lang="EN">
   <narrative xml:lang="EN">The Program will support the coordinated implementation of the Central Asia One Health Framework for Action.</narrative>
  </description>
  <description type="2" xml:lang="EN">
   <narrative xml:lang="EN">To strengthen the capacity to prevent, detect, and respond to priority zoonotic diseases, antimicrobial resistance, and food safety issues in Central Asia through a regional One Health approach.</narrative>
  </description>
