  <title xml:lang="EN">
   <narrative xml:lang="EN">Regional Electricity Market Interconnectivity and Trade</narrative>
  </title>
  <description type="1" xml:lang="EN">
   <narrative xml:lang="EN">The REMIT Program aims to increase regional electricity trade, strengthen regional transmission capacity, and enable the integration of renewable energy in Central Asia through a multi-phase approach. It involves piloting and developing electricity trade, reinforcing interconnections, and enhancing regional institutional framework.</narrative>
  </description>
  <description type="2" xml:lang="EN">
