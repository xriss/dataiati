  <reporting-org ref="XI-IATI-EC_INTPA" secondary-reporter="0" type="15">
   <narrative xml:lang="EN">European Commission - Directorate-General for International Partnerships</narrative>
  </reporting-org>
  <title>
   <narrative xml:lang="EN">Evaluation of the EU cooperation with South Sudan 2011-2023</narrative>
  </title>
  <description type="1">
   <narrative xml:lang="EN">&lt;p&gt;The &lt;strong&gt;general objective&lt;/strong&gt; of this evaluation is twofold:&lt;/p&gt;&lt;ol&gt;&lt;li data-list=&quot;bullet&quot;&gt;&lt;span class=&quot;ql-ui&quot; contenteditable=&quot;false&quot;&gt;&lt;/span&gt;&lt;span style=&quot;color: black;&quot;&gt;to provide the relevant external co-operation services of the European Union (EU) and the wider public with an &lt;/span&gt;&lt;strong style=&quot;color: black;&quot;&gt;overall independent, evidence-assessment&lt;/strong&gt;&lt;span style=&quot;color: black;&quot;&gt; of the EU cooperation with the Republic of South Sudan between July 2011 (date of independence of South Sudan) and December 2023&lt;/span&gt;&lt;a href=&quot;#_ftn1&quot; rel=&quot;noopener noreferrer&quot; target=&quot;_blank&quot; style=&quot;color: black;&quot;&gt;[1]&lt;/a&gt;&lt;span style=&quot;color: black;&quot;&gt; (extent to which the objectives&lt;/span&gt;&lt;sup style=&quot;color: black;&quot;&gt;&lt;a href=&quot;#_ftn2&quot; rel=&quot;noopener noreferrer&quot; target=&quot;_blank&quot;&gt;[2]&lt;/a&gt;&lt;/sup&gt;&lt;span style=&quot;color: black;&quot;&gt; were achieved, impact on the ground), and&lt;/span&gt;&lt;/li&gt;&lt;li data-list=&quot;bullet&quot;&gt;&lt;span class=&quot;ql-ui&quot; contenteditable=&quot;false&quot;&gt;&lt;/span&gt;to identify &lt;strong style=&quot;color: black;&quot;&gt;key lessons and to produce recommendations&lt;/strong&gt;&lt;span style=&quot;color: black;&quot;&gt; in order to inform the decision makers, notably in the EU Delegation, in the EEAS and in DG INTPA, on how to improve the ongoing and future EU strategies, programmes and actions affecting &lt;/span&gt;&lt;span style=&quot;color: windowtext;&quot;&gt;South Sudan&lt;/span&gt;&lt;span style=&quot;color: black;&quot;&gt;.&lt;/span&gt;&lt;/li&gt;&lt;/ol&gt;</narrative>
  </description>
