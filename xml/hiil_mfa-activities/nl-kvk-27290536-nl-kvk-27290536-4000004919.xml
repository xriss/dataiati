     <narrative xml:lang="EN">HiiL indicator: # of people whose justice issues can be prevented or resolved by supported startups (m/f)</narrative>
    </description>
    <reference code="SRL027" indicator-uri="https://helpdesk-opendata-minbuza.nl/indicator-codelist/" vocabulary="99"></reference>
    <baseline iso-date="2021-09-01" value="0" year="2021"></baseline>
    <period>
     <period-start iso-date="2021-09-01"></period-start>
     <period-end iso-date="2025-08-31"></period-end>
     <target value="2400000">
      <comment>
       <narrative xml:lang="EN">The target is set based on HiiL&apos;s contribution, not attribution. We work with legal startups, and they help to deliver the impact. There are many factors coming into play in delivering impact, for example,  the competence of the entrepreneur, the local justice system, etc. hence HiiL can never claim to have fully solved/prevented the legal problems rather HiiL contributes to the process.</narrative>
      </comment>
     </target>
     <actual value="381098">
      <comment>
       <narrative xml:lang="EN">Progressive total at 31 December 2022. 
2022 = 184,160
2021 = 196,938</narrative>
      </comment>
     </actual>
    </period>
   </indicator>
