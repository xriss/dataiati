  <reporting-org ref="XM-DAC-41301" type="40">
   <narrative xml:lang="EN">Food and Agriculture Organization (FAO)</narrative>
  </reporting-org>
  <title>
   <narrative xml:lang="EN">Rebuilding agricultural livelihoods affected by multiple cyclones in Cagayan province</narrative>
  </title>
  <description type="2">
   <narrative xml:lang="EN">This project seeks to enhance the economic resilience of affected small-scale farmers and fisherfolks by rehabilitating and diversifying their agriculture and fishery-based livelihoods affected by the successive typhoons in 2024, and strengthen their disaster preparedness and adaptive capacities by integrating climate-smart agriculture practices, early warning systems and risk-informed livelihood strategies to mitigate the impact of climate-induced hazards.</narrative>
  </description>
