  <title>
   <narrative xml:lang="EN">Strengthening Agriculture and Allied Sector Contributions to India`s National Biodiversity Action Plan (NBAP) 2008 and the National Biodiversity Targets (NBTs)</narrative>
  </title>
  <description type="2">
