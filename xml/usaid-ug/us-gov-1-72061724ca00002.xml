  <title>
   <narrative xml:lang="EN">Ugandans for Peace</narrative>
  </title>
  <description>
   <narrative xml:lang="EN">This activity aims to prevent and mitigate the effects of violence, repression, and manipulation in Ugandan politics, particularly before, during, after and between elections, enhance accountability mechanisms and foster a democratic and inclusive political environment.</narrative>
  </description>
