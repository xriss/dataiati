   <indicator ascending="1" measure="1">
    <title>
     <narrative xml:lang="EN">Number of individuals having received hygiene kits</narrative>
    </title>
    <reference code="CARE-137" indicator-uri="https://promeva.carenederland.org/indicators.jsp/indicators.jsp?id=1" vocabulary="99"></reference>
    <baseline value="0" year="2017"></baseline>
    <period>
     <period-start iso-date="2017-03-06"></period-start>
     <period-end iso-date="2018-02-28"></period-end>
     <target value="1800"></target>
     <actual value="7302">
      <comment>
       <narrative xml:lang="EN">1,217 households (7,302 individuals) have received hygiene kits. The hygiene kits included 2 jerry cans, one basin, 5 pieces of bathing soap, 4 pieces of washing soap, 6 washable cloths and 3 strips of aqua tabs. In addition, 2,400 individuals have benefitted from hygiene promotion carried out by trained community hygeine promoters.</narrative>
      </comment>
     </actual>
    </period>
   </indicator>
   <indicator ascending="1" measure="1">
