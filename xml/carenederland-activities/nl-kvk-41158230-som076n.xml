     <target value="1080"></target>
     <actual value="2042">
      <comment>
       <narrative xml:lang="EN">100 toilets in two IDP camps are completed and in use. A total of 2,042 individuals, with an average of 20 individuals/3 households are using per functioning latrines.</narrative>
      </comment>
     </actual>
    </period>
   </indicator>
