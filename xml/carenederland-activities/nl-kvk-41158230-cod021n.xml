     <period-start iso-date="2018-03-01"></period-start>
     <period-end iso-date="2018-11-30"></period-end>
     <target value="0"></target>
     <actual value="131">
      <comment>
       <narrative xml:lang="EN">This number includes the health personnal and pychosocial assistant trained on GBV case management in Uvira. The training for the health providers and psychosocial assistant in Fizi is planned In august including the training of CHWs. October:</narrative>
      </comment>
     </actual>
