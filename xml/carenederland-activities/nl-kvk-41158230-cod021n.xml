   <indicator ascending="1" measure="1">
    <title>
     <narrative xml:lang="EN">Number of people who demonstrate awareness of protection risks and how to prevent them</narrative>
    </title>
    <reference code="CARE-109" indicator-uri="https://promeva.carenederland.org/indicators.jsp/indicators.jsp?id=1" vocabulary="99"></reference>
    <baseline value="0" year="2018"></baseline>
    <period>
     <period-start iso-date="2018-03-01"></period-start>
     <period-end iso-date="2018-11-30"></period-end>
     <target value="14400"></target>
     <actual value="41941">
      <comment>
       <narrative xml:lang="EN">This figures is refering to the people reached by the awarness message on GBV prevention in the targeted communities. The sensitization session will be intensified in July. October:</narrative>
      </comment>
     </actual>
    </period>
   </indicator>
   <indicator ascending="1" measure="1">
    <title>
     <narrative xml:lang="EN">Number of people provided with specialised protection services</narrative>
    </title>
    <reference code="CARE-105" indicator-uri="https://promeva.carenederland.org/indicators.jsp/indicators.jsp?id=1" vocabulary="99"></reference>
