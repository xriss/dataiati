     <target value="240"></target>
     <actual value="300">
      <comment>
       <narrative xml:lang="EN">This number include the GBV survivors who consulted the health facilities supported by the project in Fizi and Uvira. October:</narrative>
      </comment>
     </actual>
    </period>
   </indicator>
   <indicator ascending="1" measure="1">
    <title>
     <narrative xml:lang="EN">Number of people trained on protection topics to provide protection services</narrative>
    </title>
