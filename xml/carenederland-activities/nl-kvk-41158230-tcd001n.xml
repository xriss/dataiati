    <period>
     <period-start iso-date="2024-05-07"></period-start>
     <period-end iso-date="2025-01-31"></period-end>
     <target value="500"></target>
     <actual value="500">
      <comment>
       <narrative xml:lang="EN">In response to the needs expressed by beneficiaries for home gardens during the rainy season, okra, tomato, cucumber, chilli, rocket, turnip, watermelon and sorrel were distributed to 200 households (150 refugees and 50 locals).</narrative>
      </comment>
     </actual>
    </period>
   </indicator>
