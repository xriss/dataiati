   <title>
    <narrative xml:lang="EN">Annual Output Results</narrative>
   </title>
   <indicator aggregation-status="1" ascending="0" measure="5">
    <title>
     <narrative xml:lang="EN">The project document for the project &quot;Assistance in the implementation of a NIN, ID management and PKI systems in Turkmenistan&quot; has been prepared.</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">The project document for the project &quot;Assistance in the implementation of a NIN, ID management and PKI systems in Turkmenistan&quot; has been prepared.</narrative>
    </description>
    <baseline year="2023">
     <comment>
      <narrative xml:lang="EN">No project on development of NIN, ID management and/or PKI systems in Turkmenistan has been developed and/or implemented yet</narrative>
     </comment>
    </baseline>
    <period>
     <period-start iso-date="2023-01-01"></period-start>
     <period-end iso-date="2023-12-31"></period-end>
     <target>
      <comment>
       <narrative xml:lang="EN">To launch a full and national scale project on implementing NIN, ID management and PKI systems in Turkmenistan with the ultimate objective to improved public administration through e-government systems and digital services to the public, with a focus on providing services to vulnerable groups.</narrative>
      </comment>
     </target>
     <actual>
      <comment>
       <narrative xml:lang="EN">Partially achieved.</narrative>
      </comment>
     </actual>
    </period>
   </indicator>
   <indicator aggregation-status="1" ascending="0" measure="5">
    <title>
     <narrative xml:lang="EN">The roadmap for the development and deployment of the NIN, ID management and PKI systems has been prepared.</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">The roadmap for the development and deployment of the NIN, ID management and PKI systems has been prepared.</narrative>
    </description>
    <baseline year="2023">
     <comment>
      <narrative xml:lang="EN">No roadmap has been developed and accepted by the government of Turkmenistan yet</narrative>
     </comment>
    </baseline>
    <period>
     <period-start iso-date="2023-01-01"></period-start>
     <period-end iso-date="2023-12-31"></period-end>
     <target>
      <comment>
       <narrative xml:lang="EN">To advocate with the Turkmenistan government on all the prerequisites, resources need and main steps for development and deployment of NIN, ID management and PKI systems. To obtain political support and agreement in principle to launch this project.</narrative>
      </comment>
     </target>
     <actual>
      <comment>
       <narrative xml:lang="EN">Achieved.</narrative>
      </comment>
     </actual>
    </period>
   </indicator>
  </result>
