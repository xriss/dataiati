     </target>
     <actual>
      <comment>
       <narrative xml:lang="EN">Launching of the activities under UNEP Agreement Turkmenistan KIP preparation (TKM/KIP/87/PRP/18)</narrative>
      </comment>
     </actual>
    </period>
