   <title>
    <narrative xml:lang="EN">Annual Output Results</narrative>
   </title>
   <indicator aggregation-status="1" ascending="0" measure="5">
    <title>
     <narrative xml:lang="EN">The authorized agency for digital transformation, Agency &quot;Turkmenaragatnashyk&quot;, has a comprehensive roadmap for the creation of an IT park in Turkmenistan, outlining key strategies, regulatory frameworks, institutional setup, funding mechanism and capacity-building plan to foster innovation, attract investments, and support the growth of the digital economy.</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">The UNDP Country Office has its digital strategy to enhance understanding and engagement with Turkmenistan&apos;s digital landscape.</narrative>
    </description>
    <baseline year="2025">
     <comment>
      <narrative xml:lang="EN">Capacity of relevant national stakeholders on digital transformation is currently limited</narrative>
     </comment>
    </baseline>
    <period>
     <period-start iso-date="2025-01-01"></period-start>
     <period-end iso-date="2025-12-31"></period-end>
