  <title>
   <narrative xml:lang="EN">PIMS 6692 Developing National Capacity of Turkmenistan through Improving Regulatory Environment towards Energy Efficient and Sustainable Building Sector (TEESB)</narrative>
  </title>
  <description type="1">
