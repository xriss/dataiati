     <target value="10.00">
      <comment>
       <narrative xml:lang="EN">&lt;p&amp;gt;The target was just met. Initially the government reported a result of 3.59 days average duration. Cross-checked with publicly available data as part of the evaluation of the program, an average duration of 9.9 days&amp;nbsp;for the emergency procurement processes for PPE was recorded.&amp;nbsp;&lt;/p&amp;gt;</narrative>
      </comment>
     </target>
     <actual value="9.90"></actual>
    </period>
   </indicator>
  </result>
