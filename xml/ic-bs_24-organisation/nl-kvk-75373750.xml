  <name>
   <narrative xml:lang="EN">Institute for Community Based Sociotherapy</narrative>
  </name>
  <reporting-org ref="NL-KVK-75373750" secondary-reporter="0" type="21">
   <narrative xml:lang="EN">The Institute for Community Based Sociotherapy (ICBS) is a non-profit organization, established in 2019 in the Netherlands, and officially registered to work as a global expertise network, uniting professionals from different parts of the world with a passion for community-based sociotherapy. Community-based sociotherapy has been implemented in different (post-conflict) regions in Sub-Sahara Africa since 2005. Practitioners who were involved in the different countries recognized the need to team up and find ways to come up with harmonized quality standards for the CBS methodology and exchange knowledge, which led to the establishment of ICBS.</narrative>
  </reporting-org>
