  <result aggregation-status="1" type="1">
   <title>
    <narrative xml:lang="EN">Annual Output Results</narrative>
   </title>
   <indicator ascending="0" measure="5">
    <title>
     <narrative xml:lang="EN">Output Indicator</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">1.) # of gender responsive DRRM School handbook validated                                                                                                                                                                              2.) Extent to which the National DRM policy is revised and finalised (1- outdated DRM Policy; 2-policy revision initiated; 3-policy revised; 4-DRM Policy finalized; 5-policy validated; 6-Policy popularized)                                          
3.) # of Instituions capacitated to provide early warnings to coastal communities.</narrative>
    </description>
    <baseline year="2021">
     <comment>
      <narrative xml:lang="EN">1.) Draft School Disaster Risk Management (DRM) hand book in place
2.) DRM policy revision initiated      
3.) 1 Agency capacitated to provide early warning information in coastal communities.</narrative>
     </comment>
    </baseline>
    <period>
     <period-start iso-date="2020-01-01"></period-start>
     <period-end iso-date="2020-12-31"></period-end>
     <target>
      <comment>
       <narrative xml:lang="EN">1.) At least 1 School DRM handbook validated;
2.) At least 1 gender responsive DRM policy finalized, validated and popularised;     
3.) At least 2 additional MDAs capacitated to dessiminate early warning information in targeted coastal communities;</narrative>
      </comment>
     </target>
     <actual>
      <comment>
       <narrative xml:lang="EN">1) Draft School DRM handbook was validated with school authorities;
2) DRM policy was finalized
3) Supported Office of National Security and trained project community members on identifying and disseminating Early warning information</narrative>
      </comment>
     </actual>
    </period>
    <period>
     <period-start iso-date="2021-01-01"></period-start>
     <period-end iso-date="2021-12-31"></period-end>
     <target>
      <comment>
       <narrative xml:lang="EN">1)16 Chiefdom Disaster Management Committees established &amp; trained on Disaster Risk Reduction techniques;
2) At least 20 persons in targeted Chiefdoms trained in disaster preparedness and response planning and management, disaggregated by sex;
3.) A Disaster terminology Dictionary in four local languages developed by end of 202`</narrative>
      </comment>
     </target>
     <actual>
      <comment>
       <narrative xml:lang="EN">1). 16 Chiefdom Disaster Management Committees were established in 2 Districts (8 Chiefdoms in Kambia &amp; 8 in Kaialahun);
2). The project trained 294 (M:192 ; F:102) Chiefdom stakeholders in Disaster preparedness and response planning.
3). 1 Disaster terminology dictionary in Four Local Languages was developed by UNDP and partners.</narrative>
      </comment>
     </actual>
    </period>
   </indicator>
  </result>
