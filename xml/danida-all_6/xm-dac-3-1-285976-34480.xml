  <result type="1">
   <title>
    <narrative xml:lang="EN">Buenos Aires has developed a climate adaptation plan based on natural solutions for flooding and water courses in Buenos Aires.</narrative>
   </title>
   <reference code="271141" vocabulary="99"></reference>
   <indicator aggregation-status="0" ascending="1" measure="1">
    <title>
     <narrative xml:lang="EN">Buenos Aires has developed climate adaptation plan with input from Copenhagen and a Green pilot project is under physical implementation.</narrative>
    </title>
    <period>
     <period-start iso-date="2023-01-01"></period-start>
     <period-end iso-date="2023-12-31"></period-end>
     <target value="Climate adaptation plan developed and a Green pilot project under implementation."></target>
     <actual value="A Climate Adaptation Plan based on nature based solutions developed. Implementation started on several green projects."></actual>
    </period>
    <period>
     <period-start iso-date="2020-01-01"></period-start>
     <period-end iso-date="2020-12-31"></period-end>
     <target value="Buenos Aires has developed climate adaptation plan with input from Copenhagen and a Green pilot project is under physical implementation."></target>
     <actual value="Activities has been implemented as planned with the exception of the knowledge exchange on warning systems. Since an advanced warning system is implemented in Buenos Aires the knowledge sharing on this has been postponed to the first workshop in BA. Other activities has been posponed due to COVID19 hereunder various workshops."></actual>
    </period>
    <period>
     <period-start iso-date="2021-01-01"></period-start>
     <period-end iso-date="2021-12-31"></period-end>
     <target value="Buenos Aires has developed climate adaptation plan with input from Copenhagen and a Green pilot project is under physical implementation."></target>
     <actual value="As a result of the cooperation and recommendations from Copenhagen experts, Buenos Aires at Mayors level has approved a hydraulic package to be implemented within the timeframe of the collaboration. This package includes all deliverables in the workplan (except collaboration on satellite warning systems), but it takes the ambitions of the collaboration to a much higher level than anticipated. A multi-disciplinary team is working with support from Copenhagen on various aspects of delivering this package of vision, strategy and physical projects."></actual>
    </period>
    <period>
     <period-start iso-date="2022-01-01"></period-start>
     <period-end iso-date="2022-12-31"></period-end>
     <target value="Implementation of Hydraulic package proceeding according to plan"></target>
     <actual value="Buenos Aires water plan developed"></actual>
    </period>
   </indicator>
  </result>
