     <target value="Develop GAP analysis."></target>
     <actual value="GAP analysis has been carried out, and input and feedback on the results has been gathered from partners and the Expert Panel."></actual>
    </period>
    <period>
     <period-start iso-date="2022-01-01"></period-start>
     <period-end iso-date="2022-12-31"></period-end>
