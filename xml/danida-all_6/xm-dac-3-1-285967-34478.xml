  <result type="1">
   <title>
    <narrative xml:lang="EN">Chinese policy recommendations developed using best practices from the Danish heating sector.</narrative>
   </title>
   <reference code="270945" vocabulary="99"></reference>
   <indicator aggregation-status="0" ascending="1" measure="1">
    <title>
     <narrative xml:lang="EN">Further develop and entrench existing policy recommendations for the 14th five year plan.</narrative>
    </title>
    <period>
     <period-start iso-date="2021-01-01"></period-start>
     <period-end iso-date="2021-12-31"></period-end>
     <target value="Further develop and entrench existing policy recommendations for the 14th five year plan"></target>
     <actual value="Areas of particular interest have be identified using Danish best practice, also in light of the transposing of the Chinese Action Plan for Carbon Dioxide Peaking Before 2030 and N+1 Policy Frameworks for district energy and energy efficiency"></actual>
    </period>
    <period>
     <period-start iso-date="2022-01-01"></period-start>
     <period-end iso-date="2022-12-31"></period-end>
     <target value="Develop policy recommendations to inform implementation of the 14th Five Year Plan related to energy"></target>
     <actual value="Building on the GAP analysis, particular areas for case study descriptions and capacity building have been identified. However, due to full lockdowns in China in 2022, developing policy exchange workshops, in conjunction with broader programme activities, has been hindered, and specific policy recommendations have not been developed."></actual>
    </period>
    <period>
     <period-start iso-date="2020-01-01"></period-start>
     <period-end iso-date="2020-12-31"></period-end>
     <target value="Further develop and entrench existing policy recommendations for the 14th five year plan."></target>
     <actual value="Relevant Danish experiences on heat storage, sector coupling and heat planning/mapping have been created, gathered and presented to our Chinese partners."></actual>
    </period>
   </indicator>
  </result>
  <result type="1">
   <title>
    <narrative xml:lang="EN">GAP Analysis developed to deepen mutual understanding of challenges for clean and efficient heating, including economic incentives for renewable energy and energy efficiency.</narrative>
   </title>
   <reference code="270944" vocabulary="99"></reference>
   <indicator aggregation-status="0" ascending="1" measure="1">
