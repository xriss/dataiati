  <result type="1">
   <title>
    <narrative xml:lang="EN">Capacities developed and system strengthened for energy efficiency measures in buildings.</narrative>
   </title>
   <reference code="273073" vocabulary="99"></reference>
   <indicator aggregation-status="0" ascending="1" measure="1">
    <title>
     <narrative xml:lang="EN">Energy efficiency standards and targets are defined and updated, e.g by the Danish Energy Agency  providing assistance on the evaluation of the sustainability plan for the new capital and airport, as well as the system for implementing energy management in large buildings.</narrative>
    </title>
    <period>
     <period-start iso-date="2023-01-01"></period-start>
     <period-end iso-date="2023-12-31"></period-end>
     <target value="Midt term review: Energy efficiency and sustainability targets are included in the plans for new buildings."></target>
     <actual value="Achieved. Support was given to the airport terminal including an audit report, capacity building workshops, roadmap for energy efficient, low-carbon buildings and construction sector."></actual>
    </period>
    <period>
     <period-start iso-date="2021-01-01"></period-start>
     <period-end iso-date="2021-12-31"></period-end>
     <target value="Progress in implementing annual activities towards the expected mid-term and final output target."></target>
     <actual value="Initial discussions of the next KEN update.
Plans for new capital is still very uncertain."></actual>
    </period>
    <period>
     <period-start iso-date="2022-01-01"></period-start>
     <period-end iso-date="2022-12-31"></period-end>
     <target value="Progress in implementing annual workplan"></target>
     <actual value="On track"></actual>
    </period>
    <period>
     <period-start iso-date="2024-01-01"></period-start>
     <period-end iso-date="2024-12-31"></period-end>
     <target value="Progress in implementing annual workplan"></target>
     <actual value="Pilot Project for Voluntary Agreement Scheme (VAS) incl. Energy Audits for 10 enterprises in Indonesia."></actual>
    </period>
    <period>
     <period-start iso-date="2020-01-01"></period-start>
     <period-end iso-date="2020-12-31"></period-end>
     <target value="Start of output implementation"></target>
     <actual></actual>
    </period>
    <period>
     <period-start iso-date="2025-01-01"></period-start>
     <period-end iso-date="2025-12-31"></period-end>
     <target value="A road map with specific suggestions for revision of the building energy code to include   nearly zero energy buildings and the implementation of the building codes on  municipal level."></target>
     <actual></actual>
    </period>
   </indicator>
  </result>
  <result type="2">
   <title>
    <narrative xml:lang="EN">Energy Efficiency in industry and power plants (up-dated)</narrative>
   </title>
   <reference code="273071" vocabulary="99"></reference>
   <indicator aggregation-status="0" ascending="1" measure="1">
    <title>
     <narrative xml:lang="EN">An enhanced national EE policy with specific strategies for EE in selected industries, power plants and selected types of commercial and public owned buildings - also including industrial development</narrative>
    </title>
    <period>
