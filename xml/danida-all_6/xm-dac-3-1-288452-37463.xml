  <title xml:lang="EN">
   <narrative xml:lang="EN">Rain for Life: Integrated Climate Adaptive Water and Agricultural Solution for Community and Ecosystem Resilience</narrative>
  </title>
  <description type="2" xml:lang="EN">
   <narrative xml:lang="EN">To improve community and ecosystem resilience in coastal area of Bangladesh by adopting integrated climate-adaptive water and agricultural solutions, nature-based solution along with risk minimization measures to cope with the impacts of climate change-induced extremes as well as maintain ecological integrity</narrative>
  </description>
