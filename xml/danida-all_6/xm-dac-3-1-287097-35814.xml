  <tag code="13.A" vocabulary="3">
   <narrative xml:lang="EN">Implement the commitment undertaken by developed-country parties to the United Nations Framework Convention on Climate Change to a goal of mobilizing jointly $100&#xa0;billion annually by 2020 from all sources to address the needs of developing countries in the context of meaningful mitigation actions and transparency on implementation and fully operationalize the Green Climate Fund through its capitalization as soon as possible</narrative>
  </tag>
  <tag code="13.2" vocabulary="3">
   <narrative xml:lang="EN">Integrate climate change measures into national policies, strategies and planning</narrative>
  </tag>
  <tag code="13.B" vocabulary="3">
   <narrative xml:lang="EN">Promote mechanisms for raising capacity for effective climate change-related planning and management in least developed countries and small island developing States, including focusing on women, youth and local and marginalized communities</narrative>
  </tag>
  <tag code="13.1" vocabulary="3">
   <narrative xml:lang="EN">Strengthen resilience and adaptive capacity to climate-related hazards and natural disasters in all countries</narrative>
  </tag>
