  <result type="1">
   <title>
    <narrative xml:lang="EN">Convening of briefings, public events, and roundtable discussions.</narrative>
   </title>
   <reference code="273769" vocabulary="99"></reference>
   <indicator aggregation-status="0" ascending="1" measure="1">
    <title>
     <narrative xml:lang="EN">Convene global experts for roundtable discussions to examine successful development policies, region-specific challenges, and brainstorm solutions, including key stakeholders geopolitically positioned to make a critical impact on the ground.</narrative>
    </title>
    <period>
     <period-start iso-date="2023-01-01"></period-start>
     <period-end iso-date="2023-12-31"></period-end>
     <target value="Continued from above."></target>
     <actual value="Brookings hosted several events, such as  &quot;The SDG second half: Ideas for doing things differently&quot; and &quot;American leaders advancing the SDGs: Multigenerational urgency and innovation at the midpoint&quot;"></actual>
    </period>
    <period>
     <period-start iso-date="2022-01-01"></period-start>
     <period-end iso-date="2022-12-31"></period-end>
     <target value="A minimum of 2 workshops or events that provide participants and viewers with evidence-based analysis and policy approaches for addressing challenges to achieving the SDGs, with special focus on climate change."></target>
     <actual value="Brookings hosted two events, respectively titled &quot;Net-zero commitments: What is needed from non-state entities to reach net-zero emissions?&quot; and &quot;Keys to climate action&quot;."></actual>
    </period>
    <period>
     <period-start iso-date="2024-01-01"></period-start>
     <period-end iso-date="2024-12-31"></period-end>
     <target value="Continued from above."></target>
     <actual value="Completed"></actual>
    </period>
   </indicator>
  </result>
