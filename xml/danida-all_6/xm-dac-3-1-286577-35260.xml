  <result type="1">
   <title>
    <narrative xml:lang="EN">Participation in international conferences, briefings, events, and key meetings and processes.</narrative>
   </title>
   <reference code="273767" vocabulary="99"></reference>
   <indicator aggregation-status="0" ascending="1" measure="1">
    <title>
     <narrative xml:lang="EN">Number of key convenings where Brookings scholars are asked to speak.</narrative>
    </title>
    <period>
     <period-start iso-date="2023-01-01"></period-start>
     <period-end iso-date="2023-12-31"></period-end>
     <target value="Through research, analysis and engagements, inform and build evidence base underpinning global investments and financing pledges at UN, World Bank, G20 and other international donor convenings."></target>
     <actual value="Brookings scholars from the Center for Sustainable Development CSD have also been deeply involved in
the SDG process, particularly through their engagement with the SDG Summit this past fall which took
place September 18-19th, 2023 at the midpoint between the SDG launch in 2015 and the deadline in 2030."></actual>
    </period>
    <period>
     <period-start iso-date="2024-01-01"></period-start>
     <period-end iso-date="2024-12-31"></period-end>
     <target value="Shift conversations from short term recovery efforts to decadal investment needs to drive the push to net zero and the LNOB agenda ahead of the 2030 SDG deadline."></target>
     <actual value="Completed"></actual>
    </period>
    <period>
     <period-start iso-date="2022-01-01"></period-start>
     <period-end iso-date="2022-12-31"></period-end>
     <target value="Brookings scholars provide key inputs to World Bank/IMF High Level Advisory Group, on which Amar Bhattacharya and Homi Kharas sit. Brookings prepares background report on a big push investment strategy for High-Level Advisory Group, summary serves as note to G20 sherpas. Drive key conversations around COP26."></target>
     <actual value="Kharas and Bhattacharya have continued to call for a big push in investments for climate and development through their participation in the High-Level Advisory Group on Sustainable and Inclusive Recovery and Growth HLAG established by the World Bank and IMF, which published a report in February, The Big Push for Transformation through Climate and Development."></actual>
    </period>
   </indicator>
