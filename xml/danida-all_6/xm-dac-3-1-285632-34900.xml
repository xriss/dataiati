  <result type="1">
   <title>
    <narrative xml:lang="EN">Output 3.2: Enhanced flexibility of the Indian power system for integration of RE, security of supply and cost through market development and operational improvements in integrating RE.</narrative>
   </title>
   <reference code="273067" vocabulary="99"></reference>
   <indicator aggregation-status="0" ascending="1" measure="1">
    <title>
     <narrative xml:lang="EN">Implementation of joint flexibility and integration measures that develop capacity within key Indian institutions to make continuous improvements in the cost-effective integration of RE that has an impact on curtailment (YES/NO updated and adjusted annually).</narrative>
    </title>
    <period>
     <period-start iso-date="2019-01-01"></period-start>
     <period-end iso-date="2019-12-31"></period-end>
     <target value="Baseline"></target>
     <actual value="0"></actual>
    </period>
    <period>
     <period-start iso-date="2024-01-01"></period-start>
     <period-end iso-date="2024-12-31"></period-end>
     <target value="A higher power market liquidity is achieved. Flexibility of thermal power plants is enhanced. Recommended transmission planning methodologies have been adopted and institutionalised."></target>
     <actual value="Achieved"></actual>
    </period>
    <period>
     <period-start iso-date="2020-01-01"></period-start>
     <period-end iso-date="2020-12-31"></period-end>
     <target value="Analysis of opportunities and constraints for enhancing cost effective integration of RE. Baseline established on flexibility and operation of thermal power plants. Working groups and plans identified for key areas, such as market design, market monitoring, and flexibility of thermal power plants."></target>
     <actual value="Achieved: Significant progress through a series of knowledge-sharing workshops focused on various aspects of electricity markets as well as thermal power flexibility. As an example, partners have stressed that the knowledge-sharing has been used in policy development regarding ancillary services."></actual>
    </period>
    <period>
     <period-start iso-date="2021-01-01"></period-start>
     <period-end iso-date="2021-12-31"></period-end>
     <target value="Task-specific working tracks have initiated work towards key challenges facing under the output. Targeted workshops and pilot projects are undertaken for each work track. Initial recommendations are given in draft form for increasing flexibility, transmission planning and market liquidity in order to increase power system flexibility."></target>
     <actual value="Activities on track and  in accordance with workplan 2021-22"></actual>
    </period>
    <period>
     <period-start iso-date="2023-01-01"></period-start>
     <period-end iso-date="2023-12-31"></period-end>
     <target value="Recommendations are implemented for how to move towards target of increasing flexibility in the system."></target>
     <actual value="On track but limited uptake"></actual>
    </period>
    <period>
     <period-start iso-date="2022-01-01"></period-start>
     <period-end iso-date="2022-12-31"></period-end>
     <target value="Recommendations are agreed on in terms of how to move towards target of increasing flexibility in the system."></target>
     <actual value="On track"></actual>
    </period>
   </indicator>
  </result>
