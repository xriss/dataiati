  <description type="2" xml:lang="EN">
   <narrative xml:lang="EN">This allocation contributes to meeting the objectives of the Humanitarian Response Plan (HRP) for Mali 2022 and UNFPA&#x2019;s Mali appeal 2022.</narrative>
