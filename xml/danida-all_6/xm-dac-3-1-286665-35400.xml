  <title xml:lang="EN">
   <narrative xml:lang="EN">Labuan Bajo Plastic Reduction SDG OW</narrative>
  </title>
  <description type="2" xml:lang="EN">
   <narrative xml:lang="EN">The objective of the project is to mitigate the negative effects on climate and environment of unmanageable non-organic household waste in Rural &amp; Remote Communities (RRC) in Indonesia by reducing the quantity of packaging materials which have no recycling properties in the currently available recycling technologies in Indonesia.</narrative>
  </description>
