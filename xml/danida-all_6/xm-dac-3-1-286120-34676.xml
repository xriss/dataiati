  <result type="1">
   <title>
    <narrative xml:lang="EN">Providing valuable water quality proxies to overcome the challenges and limitations associated with traditional ground-based water quality monitoring approach and thereby, assisting in better reporting and monitoring of SDG taget 6.3.2 on proportion of bodies of water with good ambient water quality</narrative>
   </title>
   <reference code="275581" vocabulary="99"></reference>
   <indicator aggregation-status="0" ascending="1" measure="1">
    <title>
     <narrative xml:lang="EN">Stakeholder(s) are considering satelite image-derived water quality monitoring data to monitor the status of the water quality in conjunction with existing traditional ground-based water quality monitoring data to overcome the individual challenges of both approaches</narrative>
    </title>
