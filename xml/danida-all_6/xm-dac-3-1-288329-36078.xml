  <result type="1">
   <title>
    <narrative xml:lang="EN">The framework of the OSH teams is in place: Each OSH team is under supervision by a JIG in DIFE and has a coordinator. Guidelines for responsibilities, tasks and way of working are devel-oped.</narrative>
   </title>
   <reference code="276604" vocabulary="99"></reference>
   <indicator aggregation-status="0" ascending="1" measure="1">
    <title>
     <narrative xml:lang="EN">An approved description of organization and function of the OSH teams are available.</narrative>
    </title>
    <period>
     <period-start iso-date="2023-01-01"></period-start>
     <period-end iso-date="2023-12-31"></period-end>
     <target value="An approved description of organization and function of the OSH teams are available."></target>
     <actual value="Achieved"></actual>
    </period>
   </indicator>
  </result>
  <result type="1">
   <title>
    <narrative xml:lang="EN">The OSH teams are:
- providing internal training and development of guidelines for inspections
- acting on orders from MoLE and bringing information of OSH issues 
 back to MoLE
- reacting on new OSH challenges 
- taking action on data from LIMA</narrative>
   </title>
   <reference code="276605" vocabulary="99"></reference>
   <indicator aggregation-status="0" ascending="1" measure="1">
    <title>
