  <tag code="2.2" vocabulary="3">
   <narrative xml:lang="EN">By 2030, end all forms of malnutrition, including achieving, by 2025, the internationally agreed targets on stunting and wasting in children under 5&#xA0;years of age, and address the nutritional needs of adolescent girls, pregnant and lactating women and older persons</narrative>
  </tag>
  <tag code="2.1" vocabulary="3">
   <narrative xml:lang="EN">By 2030, end hunger and ensure access by all people, in particular the poor and people in vulnerable situations, including infants, to safe, nutritious and sufficient food all year round</narrative>
  </tag>
  <tag code="2" vocabulary="2">
   <narrative xml:lang="EN">End hunger, achieve food security and improved nutrition and promote sustainable agriculture</narrative>
  </tag>
