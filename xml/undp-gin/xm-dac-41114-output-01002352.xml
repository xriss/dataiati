  <result aggregation-status="1" type="1">
   <title>
    <narrative xml:lang="FR">Annual Output Results</narrative>
   </title>
   <indicator aggregation-status="1" ascending="0" measure="1">
    <title>
     <narrative xml:lang="FR">Nombre de groupements offrant des produits  de qualit&#xE9; r&#xE9;pondant aux normes environnementales et ayant augment&#xE9; leur exportation de 25 &#xE0; 50% vers le march&#xE9; de la ZLECAF &#xE0; travers les appuis du projet</narrative>
    </title>
    <description>
     <narrative xml:lang="FR">Cet indicateur mesure le nombre de groupements de producteurs ou d&#x2019;entreprises collectives qui :

Offrent des produits respectant les normes de qualit&#xE9; (sanitaires, physiques, ou de durabilit&#xE9;) r&#xE9;pondant aux exigences environnementales et r&#xE9;glementaires.
B&#xE9;n&#xE9;ficient d&#x2019;un appui du projet et ont augment&#xE9; leurs exportations vers le march&#xE9; de la Zone de Libre-&#xC9;change Continentale Africaine (ZLECAF) d&#x2019;au moins 25 %, mais pas au-del&#xE0; de 50 %.</narrative>
    </description>
    <baseline value="0" year="2024"></baseline>
    <period>
     <period-start iso-date="2024-01-01"></period-start>
     <period-end iso-date="2024-12-31"></period-end>
     <target value="25"></target>
     <actual value="30"></actual>
    </period>
   </indicator>
   <indicator aggregation-status="1" ascending="0" measure="1">
    <title>
     <narrative xml:lang="FR">Nombre de groupements b&#xE9;n&#xE9;ficiaires des appuis techniques et manag&#xE9;riaux</narrative>
    </title>
    <description>
     <narrative xml:lang="FR">Cet indicateur mesure le nombre de groupements ou d&#x2019;organisations (tels que des coop&#xE9;ratives, des associations ou des collectifs) qui ont b&#xE9;n&#xE9;fici&#xE9; d&#x2019;un appui ou d&#x2019;une assistance dans le domaine de la ZLECAF.</narrative>
    </description>
    <baseline value="0" year="2024"></baseline>
    <period>
     <period-start iso-date="2024-01-01"></period-start>
     <period-end iso-date="2024-12-31"></period-end>
     <target value="25"></target>
     <actual value="30"></actual>
    </period>
   </indicator>
   <indicator aggregation-status="1" ascending="0" measure="1">
    <title>
     <narrative xml:lang="FR">nombre de PME b&#xE9;n&#xE9;ficiaires des appuis techniques et manag&#xE9;riaux</narrative>
    </title>
    <description>
     <narrative xml:lang="FR">Cet indicateur mesure le nombre de groupements ou d&#x2019;organisations (tels que des coop&#xE9;ratives, groupements, des associations ou des collectifs) qui ont b&#xE9;n&#xE9;fici&#xE9; d&#x2019;un appui ou d&#x2019;une assistance dans les domaines techniques ou manag&#xE9;riaux dans le cadre du cadre normatif en lien avec la ZLECAF</narrative>
    </description>
    <baseline value="0" year="2024"></baseline>
