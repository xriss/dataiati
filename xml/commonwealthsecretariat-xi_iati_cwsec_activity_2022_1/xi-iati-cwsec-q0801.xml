  <reporting-org ref="XI-IATI-CWSEC" type="40">
   <narrative xml:lang="EN">The Commonwealth Secretariat</narrative>
  </reporting-org>
  <title>
   <narrative xml:lang="EN">Promoting sport, quality of life and health</narrative>
  </title>
  <description type="1">
   <narrative xml:lang="EN">This project focuses on the intentional use of sport as a tool to advance health outcomes and socio-economic development. The project will support low and middle-income countries in the Commonwealth through the adoption of a multi-sectoral approach for policy development and implementation, identifying and addressing barriers to physical activity and a healthy diet. Specific attention will be given to the prevention of Non- Communicable Diseases (NCDs).</narrative>
  </description>
