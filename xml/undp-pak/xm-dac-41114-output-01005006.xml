  <result aggregation-status="1" type="1">
   <title>
    <narrative xml:lang="EN">Annual Output Results</narrative>
   </title>
   <indicator aggregation-status="1" ascending="0" measure="1">
    <title>
     <narrative xml:lang="EN">Rehabilitation of Climate-Resilient Community Infrastructure</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">Number of community physical infrastructure rehabilitated. Critical community infrastructure including rural roads, drainage systems, marketplaces, schools, and health facilities rehabilitated using climate-adaptive, disaster resilient and inclusive standards to improve access and resilience.</narrative>
    </description>
    <baseline value="0" year="2025"></baseline>
    <period>
     <period-start iso-date="2027-01-01"></period-start>
     <period-end iso-date="2027-12-31"></period-end>
     <target value="100"></target>
     <actual value="0"></actual>
    </period>
   </indicator>
   <indicator aggregation-status="1" ascending="0" measure="1">
    <title>
     <narrative xml:lang="EN">Enhanced community resilience by disaster risk reduction, climate adaptation, and access to clean energy solutions.</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">Number of flood protection and retaining walls constructed / rehabilitated. Institutions, communities, and service providers will be equipped with knowledge, tools, and technologies for risk-informed planning, disaster preparedness, climate change adaptation, and access to clean and efficient energy solutions, embedding resilience and gender inclusion into local development processes.</narrative>
    </description>
    <baseline value="0" year="2025"></baseline>
    <period>
     <period-start iso-date="2027-01-01"></period-start>
     <period-end iso-date="2027-12-31"></period-end>
     <target value="50"></target>
     <actual value="0"></actual>
    </period>
   </indicator>
   <indicator aggregation-status="1" ascending="0" measure="1">
    <title>
     <narrative xml:lang="EN">Livelihood Recovery and Economic Empowerment</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">Total number of individuals involved in immediate income generation through cash for work activities (disaggregated by sex, age and vulnerability). Output: productive assets restored, and small-scale livelihood activities supported through agricultural inputs, technical trainings, and enterprise development for women, youth, and vulnerable groups fostering sustainable recovery.</narrative>
    </description>
    <baseline value="0" year="2025"></baseline>
    <period>
     <period-start iso-date="2026-01-01"></period-start>
     <period-end iso-date="2026-12-31"></period-end>
     <target value="3000"></target>
     <actual value="0"></actual>
    </period>
   </indicator>
   <indicator aggregation-status="1" ascending="0" measure="1">
    <title>
     <narrative xml:lang="EN">Number of infrastructure facilities cleared from debris (including reuse in recovery).</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">Total number of infrastructure facilities cleared from debris (including reuse in recovery). That is, flood debris safely demolished, removed, recycled, and managed using eco-friendly methods to restore mobility, reduce environmental hazards, and enabling a smooth transition to recovery.</narrative>
    </description>
    <baseline value="0" year="2025"></baseline>
    <period>
     <period-start iso-date="2026-01-01"></period-start>
     <period-end iso-date="2026-12-31"></period-end>
     <target value="1500"></target>
     <actual value="0"></actual>
    </period>
   </indicator>
