  <reporting-org ref="XM-DAC-41123" type="40">
   <narrative xml:lang="EN">United Nations Industrial Development Organization</narrative>
  </reporting-org>
  <title>
   <narrative xml:lang="EN">National ODS Phase-Out Plan</narrative>
  </title>
  <description type="1">
   <narrative xml:lang="EN">The National ODS Phase-Out Plan for Yemen addresses the complete phase-out of CFCs in the Refrigeration sector, Methyl Chloroform and Halons between 2008 and 2010 as well as preparation of a transitional strategy for MDIs, training, technical assistance and investment activities. Methyl Bromide is not addressed in this Plan. The NPP will allow Yemen to phase-out its ODS consumption by January 2010 as well as maintaining zero consumption of ODS listed under Annex B groups II  &lt;(&gt;&amp;&lt;)&gt; III namely Carbon Tetrachloride (CTC)  &lt;(&gt;&amp;&lt;)&gt; Methyl Chloroform (TCA).</narrative>
  </description>
  <participating-org role="1">
   <narrative xml:lang="EN">Montreal Protocol</narrative>
  </participating-org>
