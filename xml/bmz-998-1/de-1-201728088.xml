  <title>
   <narrative xml:lang="DE">Beschaffung und Einf&#xfc;hrung eines Enterprise Resource Planning Systems</narrative>
   <narrative xml:lang="EN">Procurement and Implementation of an Enterprise Resource Planning System</narrative>
