  <title>
   <narrative xml:lang="EN">Expenditure Verification and Systems Audit for the Contracts Entitled &quot;Enhancement of Participatory Democracy in Turkey&quot;, &quot;Strengthening Representation and Participation of Youth in Turkey&quot;, &quot;Green Solar Network&quot; and &quot;Climate Network from Local to National&quot;</narrative>
