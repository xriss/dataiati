  <title>
   <narrative xml:lang="EN">Electric Interconnection between Guatemala and Mexico</narrative>
   <narrative xml:lang="ES">Interconexin Elctrica entre Guatemala y Mxico</narrative>
  </title>
  <description type="1">
   <narrative xml:lang="EN">The project seeks to integrate the electric systems of Guatemala and Mexico, through investments in the Guatemalan transmission system which are geared to interconnect this system to the Mexican system, allowing energy transactions among agents in both countries and contributing to economic integration and competitiveness of the Mesoamerican region.</narrative>
   <narrative xml:lang="ES"></narrative>
  </description>
