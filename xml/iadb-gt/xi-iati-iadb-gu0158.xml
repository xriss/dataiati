  <title>
   <narrative xml:lang="EN">Labor Market Program</narrative>
   <narrative xml:lang="ES">Programa Mercado Laboral</narrative>
  </title>
  <description type="1">
   <narrative xml:lang="EN">The program consists of three components with the following objectives: (i) to improve the technical abilities and skills of the poor rural population; (ii) to improve job opportunities for underemployed and unemployed workers in the urban sector; and (iii) to fortify the capacity of the Ministry of Labor (MINTRAB) to evaluate the labor market and program activities.</narrative>
   <narrative xml:lang="ES"></narrative>
  </description>
