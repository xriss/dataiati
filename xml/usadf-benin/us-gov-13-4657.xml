  <title>
   <narrative xml:lang="EN">GVTM WANGNINAN Capacity Building Project</narrative>
  </title>
  <description type="1">
   <narrative xml:lang="EN">The Wangninan cooperative will use grant funds to build production capacity and purchase equipment to transform cassava into gari while also investing in training for its members in financial management, marketing, improved production techniques, and hygiene and sanitation practices for production.,</narrative>
  </description>
