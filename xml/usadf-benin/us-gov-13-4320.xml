  <title>
   <narrative xml:lang="EN">Adja Plateau Cassava Promotion Project</narrative>
  </title>
  <description type="1">
   <narrative xml:lang="EN">The project will enable the Mialebouni members to improve and expand their cassava processing and storage capabilities. The project seeks to build the groups production capacity through training in improved production techniques and access to appropriate processing equipment and facilities.,</narrative>
  </description>
