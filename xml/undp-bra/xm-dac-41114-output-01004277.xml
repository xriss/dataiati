  <result aggregation-status="1" type="1">
   <title>
    <narrative xml:lang="PT">Annual Output Results</narrative>
   </title>
   <indicator aggregation-status="1" ascending="0" measure="1">
    <title>
     <narrative xml:lang="PT">Percentual de elabora&#xe7;&#xe3;o e dissemina&#xe7;&#xe3;o de informes de monitoramento sobre a implementa&#xe7;&#xe3;o das metas do Plano Pena Justa relacionadas &#xe0; porta de entrada e sa&#xed;da do sistema prisional.</narrative>
    </title>
    <description>
     <narrative xml:lang="PT">Este indicador mede o n&#xed;vel de sistematiza&#xe7;&#xe3;o e dissemina&#xe7;&#xe3;o de informa&#xe7;&#xf5;es peri&#xf3;dicas sobre a implementa&#xe7;&#xe3;o das a&#xe7;&#xf5;es do Plano Nacional Pena Justa que t&#xea;m como foco o controle e qualifica&#xe7;&#xe3;o do fluxo de ingresso (porta de entrada) e de egresso (porta de sa&#xed;da) do sistema prisional. Os informes devem conter an&#xe1;lises qualitativas e quantitativas, com base em dados coletados pelas inst&#xe2;ncias envolvidas (CNJ, SENAPPEN, sistemas estaduais, etc.) e t&#xea;m o objetivo de subsidiar a tomada de decis&#xe3;o, qualificar a governan&#xe7;a e fomentar o aprimoramento das pol&#xed;ticas p&#xfa;blicas no &#xe2;mbito do sistema de justi&#xe7;a criminal e do sistema prisional.</narrative>
    </description>
    <baseline value="0" year="2025"></baseline>
    <period>
     <period-start iso-date="2025-01-01"></period-start>
     <period-end iso-date="2025-12-31"></period-end>
     <target value="2"></target>
    </period>
    <period>
     <period-start iso-date="2026-01-01"></period-start>
     <period-end iso-date="2026-12-31"></period-end>
     <target value="2"></target>
    </period>
   </indicator>
   <indicator aggregation-status="1" ascending="0" measure="2">
    <title>
     <narrative xml:lang="PT">Percentual de implanta&#xe7;&#xe3;o e execu&#xe7;&#xe3;o do monitoramento do Plano Pena Justa Nacional, Estaduais e Distrital</narrative>
    </title>
    <description>
     <narrative xml:lang="PT">Este indicador mede o progresso da estrutura&#xe7;&#xe3;o e execu&#xe7;&#xe3;o do sistema de monitoramento integrado do Plano Pena Justa em n&#xed;vel nacional, estadual e distrital. A avalia&#xe7;&#xe3;o considera a implanta&#xe7;&#xe3;o de um painel de monitoramento digital, que dever&#xe1; ser operado por todas as unidades envolvidas no acompanhamento da execu&#xe7;&#xe3;o dos planos, conforme as diretrizes estabelecidas nas portarias e decis&#xf5;es relacionadas ao plano. A meta do indicador &#xe9; garantir que as ferramentas de monitoramento estejam totalmente operacionalizadas e que os dados de execu&#xe7;&#xe3;o do plano sejam atualizados em tempo real, permitindo a transpar&#xea;ncia, o acompanhamento cont&#xed;nuo e a implementa&#xe7;&#xe3;o colaborativa dos planos nos diferentes n&#xed;veis de governo.</narrative>
    </description>
    <baseline value="0" year="2025"></baseline>
    <period>
     <period-start iso-date="2025-01-01"></period-start>
     <period-end iso-date="2025-12-31"></period-end>
     <target value="20"></target>
    </period>
    <period>
     <period-start iso-date="2026-01-01"></period-start>
     <period-end iso-date="2026-12-31"></period-end>
     <target value="50"></target>
    </period>
   </indicator>
