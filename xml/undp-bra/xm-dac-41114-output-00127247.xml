  <result aggregation-status="1" type="1">
   <title>
    <narrative xml:lang="PT">Annual Output Results</narrative>
   </title>
   <indicator ascending="0" measure="5">
    <title>
     <narrative xml:lang="PT">Output Indicator</narrative>
    </title>
    <description>
     <narrative xml:lang="PT">1 - # Internal brainstorming session (FAO, ILO, IPC-IG) to decide the topics of the briefs; identify key issues on each topic and relevant case studies;
2 - Preliminary desk review to detail the list of possible topics and case studies to be discussed in each of them with contributions from IPC-IG; FAO and ILO;
3 - 3 (three) Policy Briefs and 3 (three) One Pagers;
4 - 1 (one) webinar.</narrative>
    </description>
    <baseline year="2021">
     <comment>
      <narrative xml:lang="PT">1 - Need to further discussions on policy options for the expansion of social insurance schemes for agricultural workers, highlighting the trade-offs that NENA countries face to expand their schemes;
2 - Need to produce spaces for dialogue between agencies and governments in the region;
3 - # series of policy-oriented briefs based on case studies of some pre-identified best practices to be documented through desk review;
4 - # webinar to disseminate the working paper and policy briefs, discuss the topics of the policy briefs.</narrative>
     </comment>
    </baseline>
    <period>
     <period-start iso-date="2021-01-01"></period-start>
     <period-end iso-date="2021-12-31"></period-end>
     <target>
      <comment>
       <narrative xml:lang="PT">1 - # Internal brainstorming session (FAO, ILO, IPC-IG) to decide the topics of the briefs; identify key issues on each topic and relevant case studies;
2 - Preliminary desk review to detail the list of possible topics and case studies to be discussed in each of them with contributions from IPC-IG; FAO and ILO.</narrative>
      </comment>
     </target>
     <actual>
      <comment>
       <narrative xml:lang="PT">1 - Internal brainstorming session performed throughout July, August, and September 2021. 2 (two) regional consultations and key informant interviews were concluded by November 2021;
2 - Preliminary desk review accomplished on July, August, and September 2021.</narrative>
      </comment>
     </actual>
    </period>
    <period>
     <period-start iso-date="2022-01-01"></period-start>
     <period-end iso-date="2022-12-31"></period-end>
     <target>
      <comment>
       <narrative xml:lang="PT">3 - 3 (three) Policy Briefs and 3 (three) One Pagers;
4 - 1 (one) webinar held on 28 July 2022.</narrative>
      </comment>
     </target>
     <actual>
      <comment>
       <narrative xml:lang="PT">3 - Policy Briefs already validate by the partners and under final copy-editing. Final delivery delivery scheduled to September 2022. 
4 - Webinar held successfully on 28 July 2022. ILO, FAO and IPC-IG agreed to use the webinar as an opportunity to promote policy debate and engage governments in discussions around the main findings of the project.</narrative>
      </comment>
     </actual>
    </period>
   </indicator>
