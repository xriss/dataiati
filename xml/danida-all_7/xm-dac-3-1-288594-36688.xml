  <result type="2">
   <title>
    <narrative xml:lang="EN">Outcome 1: Survivors of torture, war crimes, and related serious human rights violations in Ukraine have enhanced access to timely and quality mental health and psychosocial, medical, and legal support through survivor-centred, trauma- informed services.</narrative>
   </title>
   <reference code="278681" vocabulary="99"></reference>
   <indicator aggregation-status="0" ascending="1" measure="1">
    <title>
     <narrative xml:lang="EN">Number of survivors (disaggregated) who have received MHPSS and legal services and other types of support.</narrative>
