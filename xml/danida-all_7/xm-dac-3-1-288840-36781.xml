  <related-activity ref="XM-DAC-3-1-288840" type="1"></related-activity>
  <result type="1">
   <title>
    <narrative xml:lang="EN">Increased awareness and technical capacity on energy efficiency in Africa among energy efficiency policy makers and practitioners delivered through an energy efficiency training week in Nairobi, Kenya, in 2024.</narrative>
   </title>
   <reference code="278172" vocabulary="99"></reference>
   <indicator aggregation-status="0" ascending="1" measure="1">
    <title>
     <narrative xml:lang="EN">African policy makers and practitioners participate in the Energy Efficiency Training Week for Africa, of which at least 30% are intended to be women</narrative>
    </title>
    <period>
     <period-start iso-date="2024-01-01"></period-start>
     <period-end iso-date="2024-12-31"></period-end>
     <target value="150 participants in African. at training weeks, at least 30% women"></target>
     <actual value="200 participants"></actual>
    </period>
    <period>
     <period-start iso-date="2025-01-01"></period-start>
     <period-end iso-date="2025-12-31"></period-end>
     <target value="150 participants in African. at training weeks, at least 30% women"></target>
     <actual></actual>
    </period>
   </indicator>
  </result>
  <result type="2">
   <title>
    <narrative xml:lang="EN">Enhanced knowledge, capacity and ambition levels of high-level decision makers, policy makers and practitioners to design, implement and monitor robust energy efficiency policies and regulations in regional and country level energy transition and climate change action plans. Endorsement of strengthened action and accelerated progress on energy efficiency needed to ensure an inclusive, sustainable and low carbon energy transition in Africa, with outcomes also delivering towards global targets for doubling energy efficiency progress by the end of 2030.</narrative>
   </title>
   <reference code="278173" vocabulary="99"></reference>
   <indicator aggregation-status="0" ascending="0" measure="1">
    <title>
     <narrative xml:lang="EN">Increased high-level awareness buy-in and technical capacity on energy efficiency in Africa among energy efficiency policy makers and practitioners delivered through IEA conference, training weeks, policy analysis and recommendations.</narrative>
    </title>
    <period>
     <period-start iso-date="2024-01-01"></period-start>
     <period-end iso-date="2024-12-31"></period-end>
     <target value="Stakeholders from at least 5 African countries  that have participated in the project activities have applied related knowledge and skills to improve national energy efficiency policies, regulations and NDCs. Enhanced capacity in particular delivered in key countries such as Ghana, Nigeria, Kenya, Uganda and Rwanda."></target>
     <actual value="4 countries"></actual>
    </period>
    <period>
     <period-start iso-date="2025-01-01"></period-start>
     <period-end iso-date="2025-12-31"></period-end>
     <target value="Stakeholders from an additional 5 African countries have applied related knowledge and skills to improve national energy efficiency policies, regulations and NDCs."></target>
     <actual></actual>
    </period>
   </indicator>
  </result>
