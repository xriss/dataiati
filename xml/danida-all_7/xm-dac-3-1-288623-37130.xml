  <title xml:lang="EN">
   <narrative xml:lang="EN">Sensitise - Fostering youth voices for inclusive and meaningful engagement in decision making processes in Uganda</narrative>
  </title>
  <description type="2" xml:lang="EN">
   <narrative xml:lang="EN">The project will contribute to enhancing the capacity of the youths and their organizations to engage and influence policies and create and strengthen platforms where individual youth and youth structures meaningfully engage with different stakeholders for improved wellbeing and inclusion of youths in various decision making spaces.</narrative>
  </description>
