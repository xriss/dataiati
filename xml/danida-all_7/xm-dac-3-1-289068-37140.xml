   <title>
    <narrative xml:lang="EN">Distributed power generation equipment and capacity development provided to Zaporizhia</narrative>
   </title>
   <reference code="279814" vocabulary="99"></reference>
   <indicator aggregation-status="0" ascending="1" measure="1">
