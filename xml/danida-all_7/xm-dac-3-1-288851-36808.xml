  <related-activity ref="XM-DAC-3-1-288851" type="1"></related-activity>
  <result type="1">
   <title>
    <narrative xml:lang="EN">Support to country-level dialogues as well as the development and rollout of tools and resources for UN country level presence.</narrative>
   </title>
   <reference code="277032" vocabulary="99"></reference>
   <indicator aggregation-status="0" ascending="1" measure="1">
    <title>
     <narrative xml:lang="EN">UN leadership on the ground across regions have conducted and participated in country dialogues, and UN missions and UN Country Teams (UNCT) have benefitted from and used guidance and other tools and resources developed under the Call to Action to advance human rights at country level.</narrative>
    </title>
    <period>
     <period-start iso-date="2024-01-01"></period-start>
     <period-end iso-date="2024-12-31"></period-end>
     <target value="UN leadership in an increasing number of UN missions and UNCTs have received support on and conducted country dialogues on human rights as well as received the necessary C2A tools and resources, including the Country Dialogues Handbook in all official UN languages, to effectively advance human rights at country level."></target>
     <actual value="In 2024, UN leadership across an increasing number of UN missions and Country Teams received targeted support, including high-level dialogues, clinics, and capacity-building initiatives, to advance human rights. The Country Dialogue Handbook was translated into all six UN languages and widely disseminated, enabling more effective country-level engagement"></actual>
    </period>
    <period>
     <period-start iso-date="2025-01-01"></period-start>
     <period-end iso-date="2025-12-31"></period-end>
     <target value="UN leadership in an ever-increasing number of UN missions and UNCTs across regions have received support on and conducted country dialogues on human rights, drawing on C2A tools and resources, including the Country Dialogues Handbook, to effectively advance human rights at country level."></target>
     <actual></actual>
    </period>
    <period>
     <period-start iso-date="2026-01-01"></period-start>
     <period-end iso-date="2026-12-31"></period-end>
     <target value="UN leadership conduct country dialogues on human rights as a more common feature of UN missions and UNCTs and better equipped with tools and resources required to advance human rights at country level."></target>
     <actual></actual>
    </period>
   </indicator>
  </result>
  <result type="2">
   <title>
    <narrative xml:lang="EN">UN leadership (Special Representatives and Special Envoys of the Secretary- General, Resident Coordinators, Humanitarian Coordinators and Heads of UN entities) has strengthened human rights integration in UN strategic planning, programming, analysis and advocacy at country level.</narrative>
   </title>
   <reference code="277031" vocabulary="99"></reference>
   <indicator aggregation-status="0" ascending="1" measure="1">
    <title>
     <narrative xml:lang="EN">Human rights feature more centrally in UN strategic planning, programming and analysis documents and in activities and advocacy engagements at country level.</narrative>
    </title>
