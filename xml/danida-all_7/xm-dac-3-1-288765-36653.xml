  <title xml:lang="EN">
   <narrative xml:lang="EN">UN Joint Programme to Strengthen Urban and Rural Resilience and the Conditions for Recovery in Syria (UNJP 2.0)</narrative>
  </title>
  <description type="2" xml:lang="EN">
