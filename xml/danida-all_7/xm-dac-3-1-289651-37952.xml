  <tag code="15.1" vocabulary="3">
   <narrative xml:lang="EN">By 2020, ensure the conservation, restoration and sustainable use of terrestrial and inland freshwater ecosystems and their services, in particular forests, wetlands, mountains and drylands, in line with obligations under international agreements</narrative>
  </tag>
  <tag code="15.9" vocabulary="3">
   <narrative xml:lang="EN">By 2020, integrate ecosystem and biodiversity values into national and local planning, development processes, poverty reduction strategies and accounts</narrative>
  </tag>
  <tag code="15.A" vocabulary="3">
   <narrative xml:lang="EN">Mobilize and significantly increase financial resources from all sources to conserve and sustainably use biodiversity and ecosystems</narrative>
  </tag>
  <tag code="15.6" vocabulary="3">
   <narrative xml:lang="EN">Promote fair and equitable sharing of the benefits arising from the utilization of genetic resources and promote appropriate access to such resources, as internationally agreed</narrative>
  </tag>
  <tag code="15.5" vocabulary="3">
   <narrative xml:lang="EN">Take urgent and significant action to reduce the degradation of natural habitats, halt the loss of biodiversity and, by 2020, protect and prevent the extinction of threatened species</narrative>
  </tag>
