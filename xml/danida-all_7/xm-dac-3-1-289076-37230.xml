  <result type="1">
   <title>
    <narrative xml:lang="EN">IPIs work on revitalizing multilateral cooperation identifies and advances multilateral solutions to transnational challenges and works to promote a more inclusive multilateral system. For the 2024 to 2026 period, the program will focus specifically on the areas of UN reform, advancing negotiations on global health, and bolstering the role of small- and medium-sized states within the multilateral system.</narrative>
   </title>
   <reference code="278912" vocabulary="99"></reference>
   <indicator aggregation-status="0" ascending="1" measure="1">
    <title>
     <narrative xml:lang="EN">Lessons learned from outgoing E10 to support a more effective, legitimate, and democratic Council.</narrative>
    </title>
    <period>
     <period-start iso-date="2024-01-01"></period-start>
     <period-end iso-date="2024-12-31"></period-end>
     <target value="At least 2 new lessons identified and disseminated to members of the Security Council and the wider UN community."></target>
     <actual></actual>
    </period>
