  <result type="2">
   <title>
    <narrative xml:lang="EN">Confidence, trust and engagement in the multilateral system is strengthened among Member States. The UN and its member states are better informed though independent research, convening, and advice and therefore develop more precise, impact-driven, and accountable approaches, policies, guidelines, and training, which support a more inclusive and effective multilateral system that implements the Women, Peace, and Security Agenda, and builds the foundation for sustainable peace.</narrative>
   </title>
   <reference code="278913" vocabulary="99"></reference>
   <indicator aggregation-status="0" ascending="1" measure="1">
    <title>
     <narrative xml:lang="EN">Shared understanding among Member States, particularly those that are part of the E10 group of the UN Security Council, regarding key challenges in the areas of (1) multilateral cooperation, (2) Women, peace and security, and (3) peace operations and sustaining peace.</narrative>
    </title>
    <period>
     <period-start iso-date="2024-01-01"></period-start>
