  <result type="1">
   <title>
    <narrative xml:lang="EN">Conduct awareness campaigns and educational initiatives</narrative>
   </title>
   <reference code="277044" vocabulary="99"></reference>
   <indicator aggregation-status="0" ascending="1" measure="1">
    <title>
     <narrative xml:lang="EN">Awareness and Campaign: Impacting the perspective and behaviour of 40,000 people from 50 communities in 6 States toward human trafficking, its victims, risks and precautions. Also 40,000 people from 50 communities in 6 states are sensitized about the risks and signs of human trafficking, by watching the film and completing pre- and post- film and training questionnaires as well as Q&amp;A surveys to determine effectiveness and impact on perspective and future behaviour. Lastly, prevention by identifying trafficking and smuggling cases and reporting of suspicious activities or decrease in trafficking incidents in the 6 states</narrative>
    </title>
    <period>
     <period-start iso-date="2024-01-01"></period-start>
     <period-end iso-date="2024-12-31"></period-end>
     <target value="Conduct awareness campaigns and educational initiatives to sensitize 10,000 people from 50 communities in 6 states about the risks and signs of human trafficking, using pre- and post- training questionnaires as well as Q&amp;A surveys to determine effectiveness and impact on perspective and future behaviour"></target>
     <actual value="A groundbreaking awareness campaign reached 14,128 individuals through the impactful I Wish I Knew movie, highlighting survivors stories, traffickers tactics, and ways to identify and report trafficking cases. Pre and post questionnaires evaluated the campaigns effectiveness, revealing significant improvements in participants understanding and informing future initiatives.
The project has also reached 176 people directly through stakeholders engagement and movie premiere. 32 episodes of the I Wish I Knew radio program have been aired on Eagles FM which has a listenership of over 400,000 per hour."></actual>
    </period>
    <period>
     <period-start iso-date="2023-01-01"></period-start>
     <period-end iso-date="2023-12-31"></period-end>
     <target value="0"></target>
     <actual></actual>
    </period>
    <period>
     <period-start iso-date="2025-01-01"></period-start>
     <period-end iso-date="2025-12-31"></period-end>
     <target value="Conduct awareness campaigns and educational initiatives to sensitize an additional 10,000 (for composite total of 20,000) people from 50 communities in 6 states about the risks and signs of human trafficking, using pre- and post- training questionnaires as well as Q&amp;A surveys to determine effectiveness and impact on perspective and future behaviour."></target>
     <actual></actual>
    </period>
    <period>
     <period-start iso-date="2026-01-01"></period-start>
