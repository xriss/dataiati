  <title xml:lang="EN">
   <narrative xml:lang="EN">Integrated gender and climate-responsive education project in Ethiopia, 2023-2026</narrative>
  </title>
  <description type="2" xml:lang="EN">
   <narrative xml:lang="EN">Improve access to inclusive, equitable quality education in the Benishangul-Gumuz region of Ethiopia, targeting refugee and internally displaced children, alongside children in host communities, for holistic learning outcomes and resilience.</narrative>
