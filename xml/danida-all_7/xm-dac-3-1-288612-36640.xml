  <result type="2">
   <title>
    <narrative xml:lang="EN">Reduced opportunities for corruption (including high-level corruption) in the executive branch.</narrative>
   </title>
   <reference code="281197" vocabulary="99"></reference>
   <indicator aggregation-status="0" ascending="1" measure="1">
    <title>
     <narrative xml:lang="EN">Outcome 1: Draft law on improving the anti-corruption system of Georgia prepared by TI Georgia and submitted to the Parliament as a legislative proposal.
Number of alleged high level corruption cases identified, and submissions made to relevant investigative bodies.</narrative>
    </title>
    <period>
     <period-start iso-date="2024-01-01"></period-start>
     <period-end iso-date="2024-12-31"></period-end>
     <target value="At least 150 new high level corruption cases identified and referred to investigative bodies"></target>
     <actual value="- 1 draft law submitted to the Parliament
- 55 alleged cases of high-level corruption have been identified and referred to relevant investigative bodies (totaling a list of 206 cases)."></actual>
    </period>
