  <title>
   <narrative xml:lang="EN">Multesectoral Finance Global Program</narrative>
   <narrative xml:lang="ES">Programa Global Financiamiento Multisectorial</narrative>
  </title>
  <description type="1">
   <narrative xml:lang="EN">EL OBJETIVO PRINCIPAL DEL PROGRAMA ES APOYAR LA PROFUNDIZACION Y AMPLIACION DE LAS ACTIVIDADES DE LA VENTANILLA DE REDESCUENTO DE FINANCIAMIENTOS DE MEDIANO Y LARGO PLAZO PARA PROYECTOS PRODUCTIVOS DEL BANCO CENTRAL DEL URUGUAY. A TRAVES DE ESTE PROGRAMA SE PROCURARA AMPLIAR Y PROFUNDIZAR EL MERCADO DE FINANCIAMIENTO DE LARGO PLAZO EN EL PAIS. MEDIANTE EL APOYO DE ASISTENCIA TECNICA Y LIQUIDEZ PARA LA INTRODUCCION Y AMPLIACION DE COBERTURA DE DIVERSOS INSTRUMENTOS FINANC.</narrative>
   <narrative xml:lang="ES"></narrative>
  </description>
