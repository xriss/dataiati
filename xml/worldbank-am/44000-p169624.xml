   <indicator ascending="1" measure="5">
    <title>
     <narrative xml:lang="EN">3-1-b)-Percentage  of whistleblowers reports submitted through the electronic platform used for investigative purposes increased.</narrative>
    </title>
    <baseline iso-date="2019-10-31" value="0" year="2019">
     <comment>
