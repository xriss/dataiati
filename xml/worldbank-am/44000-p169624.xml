   </title>
   <indicator ascending="1" measure="5">
    <title>
     <narrative xml:lang="EN">3-1-a-Anti-corruption- Actions under Anti-Corruption strategy have commenced and are on track.</narrative>
    </title>
    <baseline iso-date="2019-10-31" value="0/0" year="2019">
     <comment>
      <narrative xml:lang="EN"></narrative>
     </comment>
    </baseline>
    <period>
