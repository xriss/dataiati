  <related-activity ref="XM-DAC-3-1-233407" type="1"></related-activity>
  <result type="1">
   <title>
    <narrative xml:lang="EN">C. Videreudvikling af DJUCO Student Forums</narrative>
   </title>
   <reference code="265105" vocabulary="99"></reference>
   <indicator aggregation-status="0" ascending="0" measure="1">
    <title>
     <narrative xml:lang="EN">C. Videreudvikling af DJUCO Student Forums dialogorienterende aktiviteter med henblik p&#xe5; at styrke det akademiske milj&#xf8; og reformprocesserne p&#xe5; de jordanske universiteter</narrative>
    </title>
    <period>
     <period-start iso-date="2017-01-01"></period-start>
     <period-end iso-date="2017-12-31"></period-end>
     <target value="Den overordnede m&#xe5;ls&#xe6;tning for denne projektkomponent er at arbejde for at bidrage til at l&#xf8;fte det jordanske vidensamfund generelt og det akademiske milj&#xf8; p&#xe5; universiteterne i s&#xe6;rdeleshed"></target>
     <actual value="Der blev afholdt 7 dialogm&#xf8;der. hvor jordanske studerende diskuterede forskellige problemstillinger. DJUCO Student Forum har udviklet sig til et netv&#xe6;rk af f&#xe5;. men dedikerede frivillige."></actual>
    </period>
   </indicator>
  </result>
  <result type="1">
   <title>
    <narrative xml:lang="EN">A. Videref&#xf8;relse af samarbejde om forskerkonferencer og workshops</narrative>
   </title>
   <reference code="265103" vocabulary="99"></reference>
   <indicator aggregation-status="0" ascending="0" measure="1">
    <title>
     <narrative xml:lang="EN">Videref&#xf8;relse af samarbejde om forskerkonferencer og workshops i Jordan samt forskningssamarbejdeom problemstillinger relateret til forholdet mellem Europa og Mellem&#xf8;sten.</narrative>
    </title>
    <period>
     <period-start iso-date="2017-01-01"></period-start>
     <period-end iso-date="2017-12-31"></period-end>
     <target value="Det var m&#xe5;ls&#xe6;tningen at bidrage til udviklingen af forskningsbaseret dialog i forholdet mellem jordanske (og mellem&#xf8;stlige) og danske (og vestlige) forskere. ph.d.- og andre studerende."></target>
     <actual value="Partnerskabet har afholdt 5 konferencer/workshops i indev&#xe6;rende projektperiode. Det gennemg&#xe5;ende tr&#xe6;k for alle aktiviteterne har v&#xe6;ret. at den akademiske dialog har v&#xe6;ret i centrum og. at der for majoriteten af aktiviterene har p&#xe5;g&#xe5;et arbejde med at f&#xe5; skabt publikationer p&#xe5; baggrund af konferenceaktiviteterne."></actual>
    </period>
   </indicator>
  </result>
  <result type="1">
   <title>
    <narrative xml:lang="EN">B. Videref&#xf8;relse af meritgivende kursus for jordanske og danske studerende p&#xe5; kandidatniveau</narrative>
   </title>
   <reference code="265104" vocabulary="99"></reference>
   <indicator aggregation-status="0" ascending="0" measure="1">
    <title>
     <narrative xml:lang="EN">Videref&#xf8;relse af meritgivende kursus for jodanske og danske studerende p&#xe5; kandidatniveau, &quot;Mediterranean Perspectives&quot;, i Jordan og Danmark</narrative>
    </title>
    <period>
     <period-start iso-date="2017-01-01"></period-start>
     <period-end iso-date="2017-12-31"></period-end>
     <target value="M&#xe5;ls&#xe6;tningen var at bidrage til reformering af en konservativ uddannelseskultur ved gennemf&#xf8;relsen af kurset i Mediterranean Perspectives. Endvidere var det ambitionen at give jordanske studerende med interesse i europ&#xe6;isk-mellem&#xf8;stlige relationer et uddannelsestilbud p&#xe5; internationalt niveau."></target>
     <actual value="Undervisningssamarbejde &quot;Mediterranean Perspectives&quot; blev gennemf&#xf8;rt i 2014 og 2015."></actual>
    </period>
   </indicator>
  </result>
