  <result type="1">
   <title>
    <narrative xml:lang="EN">ICW to sustain and increase media coverage</narrative>
   </title>
   <reference code="266269" vocabulary="99"></reference>
   <indicator aggregation-status="0" ascending="0" measure="1">
    <title>
     <narrative xml:lang="EN">ICW sustain and increase the media coverage of corruption and anti-corruption related issues raised by ICW</narrative>
    </title>
    <period>
     <period-start iso-date="2017-01-01"></period-start>
     <period-end iso-date="2017-12-31"></period-end>
     <target value="Increase and sustain media coverage"></target>
     <actual value="ICW is still considered favorably by the media. Almost all issues campaigned by ICW are still getting good coverage by national and local media. ICW also continue to be an influential media reference on anti-corruption issues."></actual>
    </period>
    <period>
     <period-start iso-date="2018-01-01"></period-start>
     <period-end iso-date="2018-12-31"></period-end>
     <target value="Increase and sustain media coverage"></target>
     <actual value="Progressed as planned"></actual>
    </period>
   </indicator>
  </result>
  <result type="1">
   <title>
    <narrative xml:lang="EN">ICW is strengthened as an organisation</narrative>
   </title>
   <reference code="266270" vocabulary="99"></reference>
   <indicator aggregation-status="0" ascending="0" measure="1">
    <title>
     <narrative xml:lang="EN">ICW is strengthened as an organization (programme management, skills and knowledge of staff and volunteers are improved e.g. investigative and research skills).</narrative>
    </title>
    <period>
     <period-start iso-date="2017-01-01"></period-start>
     <period-end iso-date="2017-12-31"></period-end>
     <target value="ICW strengthened as an organisation"></target>
     <actual value="New financial management system implemented.
reporting structure improved. technical capacity improved"></actual>
    </period>
    <period>
     <period-start iso-date="2018-01-01"></period-start>
     <period-end iso-date="2018-12-31"></period-end>
     <target value="ICW strengthened as an organisation"></target>
     <actual value="Progressed as planned"></actual>
    </period>
   </indicator>
  </result>
  <result type="2">
   <title>
    <narrative xml:lang="EN">ICW to strengthen public participation and public pressure to eradicate corruption</narrative>
   </title>
   <reference code="266267" vocabulary="99"></reference>
   <indicator aggregation-status="0" ascending="0" measure="1">
    <title>
     <narrative xml:lang="EN">To further strengthen public participation in and public pressure to eradicate corruption, through cross-sectorial networking and coalition building with like-minded NGOs and other champions of anti-corruption (KPK, selected policymakers and administrators), promotion of the exposure of corruption cases in the media, and advocacy of the anti-corruption awareness at local and national level.</narrative>
    </title>
    <period>
     <period-start iso-date="2018-01-01"></period-start>
     <period-end iso-date="2018-12-31"></period-end>
     <target value="To further strengthen public participation in and public pressure to eradicate corruption. through cross-sectorial networking and coalition building with like-minded NGOs and other champions of anti-corruption"></target>
     <actual value="On track."></actual>
    </period>
   </indicator>
  </result>
