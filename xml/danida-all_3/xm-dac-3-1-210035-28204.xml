  <related-activity ref="XM-DAC-3-1-210035" type="1"></related-activity>
  <result type="1">
   <title>
    <narrative xml:lang="EN">SWAp arrangement agreed between the Government of Ghana and Development Partners and operationalized.</narrative>
   </title>
   <reference code="264314" vocabulary="99"></reference>
   <indicator aggregation-status="0" ascending="0" measure="1">
    <title>
     <narrative xml:lang="EN">In 2015 discussions commenced between the Government of Ghana and development partners on the feasibility of a Sector Wide Approach modality to support decentralization together with the possibility of an EU joint programming for the sector. In order to improve upon the relevance, efficiency and effectiveness of development assistance in the sector the SWAp was agreed. The SWAp would require DPs to channel their resources under government leadership to implement an approved sector policy and adopt a common approach aimed at achieving the objectives of decentralization in Ghana</narrative>
    </title>
    <period>
     <period-start iso-date="2017-01-01"></period-start>
     <period-end iso-date="2017-12-31"></period-end>
     <target value="A roadmap developed to implement the SWAp. A performance assessment framework (PAF) and a medium term expenditure framework (MTEF) developed."></target>
     <actual value="A roadmap for the SWAp was developed together with a PAF and an MTEF."></actual>
    </period>
    <period>
     <period-start iso-date="2016-01-01"></period-start>
     <period-end iso-date="2016-12-31"></period-end>
     <target value="SWAp formulated through consultancy assignment and agreed between Government of Ghana and DPs."></target>
     <actual value="Consultants submitted their final report on the SWAp in May 2016. This was well received by both GoG and DPs"></actual>
    </period>
    <period>
     <period-start iso-date="2018-01-01"></period-start>
     <period-end iso-date="2018-12-31"></period-end>
     <target value="Full integration of the DDF into the DACF. Performance assessments conducted and funds disbursed through DACF."></target>
     <actual value="N/A"></actual>
    </period>
    <period>
     <period-start iso-date="2015-01-01"></period-start>
     <period-end iso-date="2015-12-31"></period-end>
     <target value="EU joint programming agreed with government"></target>
     <actual value="Sector Wide Approach modality agreed with government."></actual>
    </period>
   </indicator>
  </result>
  <result type="1">
   <title>
    <narrative xml:lang="EN">An increasing number of districts with adequate capacity to meet the minimum standards for support. Minimum standards will be continuously revised as an incentive to ensure continuous improvement.</narrative>
   </title>
