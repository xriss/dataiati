   <indicator aggregation-status="0" ascending="0" measure="1">
    <title>
     <narrative xml:lang="EN">This output indicator seeks to measure the number of districts passing the set of minimum conditions to become eligible to access both the investment and capacity building grant of the District Development Facility.</narrative>
    </title>
    <period>
     <period-start iso-date="2016-01-01"></period-start>
     <period-end iso-date="2016-12-31"></period-end>
