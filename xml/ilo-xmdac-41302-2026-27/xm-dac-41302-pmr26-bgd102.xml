  <sector code="1.3" percentage="16" vocabulary="8">
   <narrative xml:lang="EN">1.3 Implement nationally appropriate social protection systems and measures for all, including floors, and by 2030 achieve substantial coverage of the poor and the vulnerable</narrative>
  </sector>
  <sector code="3.2" percentage="16" vocabulary="8">
   <narrative xml:lang="EN">3.2 By 2030, end preventable deaths of newborns and children under 5 years of age, with all countries aiming to reduce neonatal mortality to at least as low as 12 per 1,000 live births and under-5 mortality to at least as low as 25 per 1,000 live births</narrative>
  </sector>
  <sector code="5.5" percentage="16" vocabulary="8">
   <narrative xml:lang="EN">5.5 Ensure women&#x2019;s full and effective participation and equal opportunities for leadership at all levels of decision-making in political, economic and publiclife</narrative>
