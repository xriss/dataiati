    </period>
   </indicator>
   <indicator measure="1">
    <title>
     <narrative xml:lang="EN">Output 3  Indicator 1</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">Output: Transmission coverage expanded from Chimtala to South West Kabul 
Indicator: New 30 kms 220 kV lines from Chimtala to Kabul Southwest (Kabul) by 2016 
Progress/Status: Contract was awarded to KEC International India in June 2013 and construction of approximate 28 km of 220 kV transmission line has  completed in August 2015. 
Data Source: ICE quarterly report
DABS annual report 
Actual value:</narrative>
    </description>
    <baseline value="0" year="2009"></baseline>
