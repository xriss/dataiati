   <title>
    <narrative xml:lang="EN">Design and Monitoring Framework</narrative>
   </title>
   <document-link format="APPLICATION/PDF" url="https://www.adb.org/sites/default/files/project-documents/58003/58003-001-rrp-en.pdf">
    <title>
     <narrative xml:lang="EN">Reports and Recommendations of the President</narrative>
