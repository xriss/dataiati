  <iati-identifier>XM-DAC-7-PPR-4000004372</iati-identifier>
  <reporting-org ref="XM-DAC-7" type="10">
   <narrative xml:lang="EN">Ministry of Foreign Affairs of the Netherlands</narrative>
  </reporting-org>
  <title>
   <narrative xml:lang="EN">Education and empowerment women and girls</narrative>
  </title>
  <description type="1">
   <narrative xml:lang="EN">Promotion of education and empowerment of girls in primary school in Benguela, Cunene and Cuando Cubango and to illiterate women in Cunene and Cuando Cubango. This project aims to changing the inferior role of women in the patriarchal Angolan society, by striving for equal access to education. Being educated and becoming literate will give girls and women more self-esteem and self-confidence and is a necessary condition for improving their economic empowerment.</narrative>
  </description>
