     <period-end iso-date="2025-12-31"></period-end>
     <target value="300"></target>
     <actual value="600"></actual>
    </period>
   </indicator>
   <indicator aggregation-status="1" ascending="0" measure="1">
    <title>
     <narrative xml:lang="ES">N&#xFA;mero de mecanismos y herramientas dise&#xF1;adas con acompa&#xF1;amiento del proyecto, que mejoran el acceso a la justicia constitucional para mujeres ind&#xED;genas.</narrative>
    </title>
    <description>
     <narrative xml:lang="ES">Este indicador hace referencia a los mecanismos y herramientas en las que se brinde acompa&#xF1;amiento a la Corte de Constitucionalidad para mejorar el acceso a la justicia constitucional para mujeres ind&#xED;genas. Estos mecanismos pueden ser lineamientos, gu&#xED;as, manuales, pol&#xED;ticas u otros que contribuyan a fortalecer la impartici&#xF3;n de justicia a grupos en situaci&#xF3;n de vulnerabilidad, incluidas las mujeres ind&#xED;genas.</narrative>
    </description>
