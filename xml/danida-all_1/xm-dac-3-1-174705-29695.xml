   </title>
   <reference code="264837" vocabulary="99"></reference>
   <indicator aggregation-status="0" ascending="0" measure="1">
    <title>
     <narrative xml:lang="EN">The MOPAN 3.0 is a new operational and methodological iteration of how the Network will assess organisations. The Network will increase the number of organisations assessed during the coming 4 year period. In 2015-16, 12 organisations will be assessed and in 2017-18 14 organisations will be assessed.</narrative>
    </title>
    <period>
     <period-start iso-date="2018-01-01"></period-start>
     <period-end iso-date="2018-12-31"></period-end>
     <target value="26 multilateral organisations have been assessed using the MOPAN 3.0 methodology"></target>
     <actual value="Assessment of 26 organisations completed"></actual>
    </period>
   </indicator>
