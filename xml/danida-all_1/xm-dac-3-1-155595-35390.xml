  <result type="2">
   <title>
    <narrative xml:lang="EN">The Danish Ministry of Foreign Affairs is well informed on multilateral affairs and the UN, and produces well-founded, up-to-date policy that strengthens and improves its engagement on multilateral cooperation; women, peace, and security; peace operations and sustaining peace.</narrative>
   </title>
   <reference code="274217" vocabulary="99"></reference>
   <indicator aggregation-status="0" ascending="1" measure="1">
    <title>
     <narrative xml:lang="EN">The Danish Ministry of Foreign Affairs formulates well-founded operational policy on multilateral cooperation, women, peace, and security and peace operations and sustaining peace.</narrative>
    </title>
    <period>
     <period-start iso-date="2023-01-01"></period-start>
     <period-end iso-date="2023-12-31"></period-end>
     <target value="Based on IPI&#x2019;s advice, the Danish Ministry of Foreign Affairs has reviewed, prioritized and produced up-to-date policy within the three areas."></target>
     <actual value="Denmark has with the support from IPI formulated well-founded operational policies on multilateral cooperation, women, peace,  security and peace operations. and sustaining peace."></actual>
    </period>
   </indicator>
  </result>
  <result type="1">
   <title>
    <narrative xml:lang="EN">IPI provides the Danish Ministry of Foreign Affairs well-founded and well-documented advice and policy recommendations within the three areas of revitalizing multilateral cooperation; women, peace, and security; peace operations and sustaining peace, incl. climate-security.</narrative>
   </title>
   <reference code="274218" vocabulary="99"></reference>
