  <reporting-org ref="NZ-1" type="10">
   <narrative xml:lang="EN">New Zealand Ministry of Foreign Affairs and Trade</narrative>
  </reporting-org>
  <title>
   <narrative xml:lang="EN">Remittances Transparency - Empowering Remitters to Choose</narrative>
  </title>
  <description type="1">
   <narrative xml:lang="EN">This activity focuses on addressing challenges facing remitters when engaging with the remittances market. These challenges include information asymmetries about the prices charged by different remittance providers, and a lack of trust in different remittances products (particularly online-only products).</narrative>
  </description>
