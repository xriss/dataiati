  <iati-identifier>XM-DAC-41123-PROJECT-230084</iati-identifier>
  <reporting-org ref="XM-DAC-41123" type="40">
   <narrative xml:lang="EN">United Nations Industrial Development Organization</narrative>
  </reporting-org>
  <title>
   <narrative xml:lang="EN">Implementing food safety to support a sustainable supply chain of farmed yellow croaker in China</narrative>
  </title>
  <description type="1">
   <narrative xml:lang="EN">The project intends to address the problems of food safety and environmental risks in the whole supply chain of large yellow croaker and develop technologies by pushing the key common technology research and the upgrading of management mode to carry out technical and managerial activities, evaluate and demonstrate models, and develop a Chinese practice of large yellow croaker farming that includes Best Available Technology (BAT) and Best Management Practices (BMP).  Through capacity building, experience promotion and knowledge sharing, the project will also guide the transformation and improvement of production safety of China&apos;s large yellow croaker, promote the green and sustainable development of aquaculture in China and strengthen women&apos;s empowerment, while disseminating and promoting project knowledge globally and facilitating international cooperation projects.</narrative>
  </description>
  <participating-org role="1">
   <narrative xml:lang="EN">CHINA</narrative>
  </participating-org>
