  <title>
   <narrative xml:lang="ES">Programa Mejoramiento Urbano Ro Janeiro</narrative>
   <narrative xml:lang="EN">Rio de Janeiro Urban Upgrading Program</narrative>
  </title>
  <description type="1">
   <narrative xml:lang="EN">THIS PROJECT WILL UPGRADE LIVING CONDITIONS IN RIO&apos;S SLUMS AND ILLEGAL SUBDIVISIONS, BY PROVIDING WATER AND SANITARY SERVICES, IMPROVING STREETS, STORM DRAINAGE, REFORESTATION, GARBAGE COLLECTION SERVICES AND INCREASING THE SUPPLY OF SOCIAL SERVICES, PARTICULARLY CHILD CARE CENTERS.</narrative>
   <narrative xml:lang="ES"></narrative>
  </description>
