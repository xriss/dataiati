  <reporting-org ref="XM-DAC-41301" type="40">
   <narrative xml:lang="EN">Food and Agriculture Organization (FAO)</narrative>
  </reporting-org>
  <title>
   <narrative xml:lang="EN">Capacity development and experience sharing for rice value chains through south-south and triangular cooperation (SSTC)</narrative>
  </title>
  <description type="2">
   <narrative xml:lang="EN">To improve capacity of the participating countries to develop competitive and inclusive rice value chains. Through the project, host countries will receive assistance to strengthen the capacities to develop national research/training institutes and experts in order to disseminate knowledge and experience to local stakeholders, also have a chance to exchange technology and experience in terms of rice cultivation, good seed, mechanization, post-harvest, and policy among Africa and Asia.</narrative>
  </description>
