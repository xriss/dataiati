  <reporting-org ref="XM-DAC-41301" type="40">
   <narrative xml:lang="EN">Food and Agriculture Organization (FAO)</narrative>
  </reporting-org>
  <title>
   <narrative xml:lang="EN">Sustainable Fisheries Management And Biodiversity Conservation Of Deep-Sea living marine resources and ecosystems in the Areas Beyound National Jurisdiction (ABNJ) (FSP)</narrative>
  </title>
  <description type="2">
   <narrative xml:lang="EN">To achieve efficiency and sustainability in the use of deep-sea living resources and biodiversity conservation in the ABNJ, through the systematic application of an ecosystem approach for:  i) improving sustainable management practices for deep-sea fisheries, taking into account the impacts on related ecosystems, ii) protecting vulnerable marine ecosystems (VMEs) and Ecologically or Biologically Significant Areas (EBSAs) and iii) practicing improved area-based planning for deep sea ecosystems.</narrative>
  </description>
