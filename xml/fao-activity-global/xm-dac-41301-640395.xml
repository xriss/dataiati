  <reporting-org ref="XM-DAC-41301" type="40">
   <narrative xml:lang="EN">Food and Agriculture Organization (FAO)</narrative>
  </reporting-org>
  <title>
   <narrative xml:lang="EN">Assisting SIDS to integrate agriculture sectors into climate change priorities and NDCs to UNFCCC</narrative>
  </title>
  <description type="2">
   <narrative xml:lang="EN">1) improve country capacities to use analytical techniques to assess risks, vulnerabilities and impacts of climate change in the agricultural sectors;
2) improve country capacities to create enabling policy environments to mainstream climate change, resilience  food security concerns and undertake climate actions; and
3) contribute to international and regional mechanisms for climate change planning and action
4) integrate climate change and resilience planning into FAO technical cooperation projects</narrative>
  </description>
