  <result aggregation-status="0" type="2">
   <title>
    <narrative xml:lang="EN">Indicator</narrative>
   </title>
   <indicator ascending="1" measure="5">
    <title>
     <narrative xml:lang="EN">Submission to the WAEMU Council of Minister a decision committing all member countries to apply WAEMU living conditions survey standards with respect to methodology, contents and periodicity.</narrative>
    </title>
    <baseline iso-date="2016-04-17" value="N" year="2016">
     <comment>
      <narrative xml:lang="EN"></narrative>
     </comment>
    </baseline>
    <period>
     <period-start iso-date="2016-04-17"></period-start>
     <period-end iso-date="1900-01-01"></period-end>
     <target>
      <comment>
       <narrative xml:lang="EN">&lt;p&amp;gt;Target almost achieved. The Decision has been prepared and endorsed by the 8 countries. It has to be revised by the legal department of the WAEMU Commission and to be submitted to the June or September 2024 Council of Ministers. the eight countries are ready to start the preparation of the third episode of the survey as agreed in early March 2024 by the WAEMU DGs Steering Committee.&lt;/p&amp;gt;</narrative>
      </comment>
     </target>
     <actual value="N"></actual>
    </period>
   </indicator>
  </result>
