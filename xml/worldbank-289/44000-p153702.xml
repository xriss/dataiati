     <period-end iso-date="1900-01-01"></period-end>
     <target>
      <comment>
       <narrative xml:lang="EN">&lt;p&amp;gt;Target achieved and exceeded: All the eight (8)&amp;nbsp;countries conducted successively the two episodes of the survey.&lt;/p&amp;gt;</narrative>
      </comment>
     </target>
     <actual value="8.00"></actual>
    </period>
