   </title>
   <indicator ascending="1" measure="1">
    <title>
     <narrative xml:lang="EN">Draft standardized questionnaires, disaggregated by gender are reviewed by data users</narrative>
    </title>
    <baseline iso-date="2017-04-14" value="0.00" year="2017">
     <comment>
      <narrative xml:lang="EN"></narrative>
     </comment>
    </baseline>
