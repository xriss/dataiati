     <period-start iso-date="2017-04-14"></period-start>
     <period-end iso-date="1900-01-01"></period-end>
     <target>
      <comment>
       <narrative xml:lang="EN">&lt;p&amp;gt;Target fully achieved. Other World Bank GPs (Education, Social Protection, Gender, Environment, ...) reviewed the questionnaires, as well as UN Women, AfDB,&amp;nbsp; FAO that also reviewed it. At country level, the questionnaires were reviewed by sectoral ministries, including Agriculture, Education, Health, etc.&lt;/p&amp;gt;</narrative>
      </comment>
     </target>
     <actual value="2.00"></actual>
    </period>
   </indicator>
