  <result aggregation-status="1" type="1">
   <title>
    <narrative xml:lang="EN">Annual Output Results</narrative>
   </title>
   <indicator aggregation-status="1" ascending="0" measure="5">
    <title>
     <narrative xml:lang="EN">Status of PFM e-governance integrated systems and services (non-existent, created/new, needs improvement, consolidated).</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">Assesses the level of development and maturity of integrated digital systems supporting PFM processes (e.g. budget preparation, execution, reporting, transparency portals), using a qualitative scale ranging from non-existent to fully consolidated and operational.</narrative>
    </description>
    <baseline year="2024">
     <comment>
      <narrative xml:lang="EN">All 6 PALOP-TL countries are at or below the level &quot;needs improvement&quot; and 2 of them do not have PFM e-governance integrated systems and services.</narrative>
     </comment>
    </baseline>
    <period>
     <period-start iso-date="2025-01-01"></period-start>
     <period-end iso-date="2025-12-31"></period-end>
     <target>
      <comment>
       <narrative xml:lang="EN">Significant change documented. All six PALOP-TL countries have implemented some form of Public Financial Management Information System (PFMIS / IFMIS) or digital PFM</narrative>
      </comment>
     </target>
     <actual>
      <comment>
       <narrative xml:lang="EN">Significant change documented. All six PALOP-TL countries have implemented some form of Public Financial Management Information System (PFMIS / IFMIS) or digital PFM platform, although the level of integration, coverage and maturity varies significantly.</narrative>
      </comment>
     </actual>
    </period>
    <period>
     <period-start iso-date="2024-01-01"></period-start>
     <period-end iso-date="2024-12-31"></period-end>
     <target>
      <comment>
       <narrative xml:lang="EN">The 2 PALOP-TL countries that do not have PFM eGovernance integrated systems and services now have created such systems. 2 PALOP-TL countries have improved the</narrative>
      </comment>
     </target>
     <actual>
      <comment>
       <narrative xml:lang="EN">The 2 PALOP-TL countries that do not have PFM eGovernance integrated systems and services now have created such systems. 2 PALOP-TL countries have improved the services of such systems and should be now considered as having consolidated PFM eGovernance integrated systems.</narrative>
      </comment>
     </actual>
    </period>
    <period>
     <period-start iso-date="2026-01-01"></period-start>
     <period-end iso-date="2026-12-31"></period-end>
     <target>
      <comment>
       <narrative xml:lang="EN">All 6 PALOP-TL countries are at or above the level &quot;needs improvement&quot; and 4 of them have consolidated PFM e-governance integrated systems and services.</narrative>
      </comment>
     </target>
    </period>
   </indicator>
   <indicator aggregation-status="1" ascending="0" measure="5">
    <title>
     <narrative xml:lang="EN">Status of integrated IFMIS (non-existent, created/new, needs improvement, consolidated).</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">Assesses the level of development, integration, and maturity of Integrated Financial Management Information Systems (IFMIS) within participating countries, using a qualitative scale ranging from non-existent to fully consolidated systems. It reflects progress in digitalization, system interoperability, coverage across PFM functions, and effective use for decision-making and transparency.</narrative>
    </description>
    <baseline year="2024">
     <comment>
      <narrative xml:lang="EN">Only 1 PALOP-TL has IFMIS both in parliament and SAI. 2 PALOP-TL do not</narrative>
     </comment>
    </baseline>
    <period>
     <period-start iso-date="2025-01-01"></period-start>
     <period-end iso-date="2025-12-31"></period-end>
     <target>
      <comment>
       <narrative xml:lang="EN">All PALOP-TL parliaments and SAIs have some level of ICT use, but fully integrated oversight information systems remain rare.</narrative>
      </comment>
     </target>
     <actual>
      <comment>
       <narrative xml:lang="EN">All PALOP-TL parliaments and SAIs have some level of ICT use, but fully integrated oversight information systems remain rare.
The biggest gap is audit management systems and digital tracking of oversight recommendations.
Strengthening interoperability between IFMIS, parliament oversight tools, and SAI audit systems is a key reform priority.</narrative>
      </comment>
     </actual>
    </period>
    <period>
     <period-start iso-date="2024-01-01"></period-start>
     <period-end iso-date="2024-12-31"></period-end>
     <target>
      <comment>
       <narrative xml:lang="EN">Progress is mitigated in seting up integrated ICT systems in legislatures and SAIs in all six PALOP-TL countries.</narrative>
      </comment>
     </target>
     <actual>
      <comment>
       <narrative xml:lang="EN">Progress has been made in establishing integrated ICT systems in legislatures and Supreme Audit Institutions (SAIs) across all six PALOP-TL countries, strengthening institutional capacity for oversight and accountability.</narrative>
      </comment>
     </actual>
    </period>
    <period>
     <period-start iso-date="2026-01-01"></period-start>
     <period-end iso-date="2026-12-31"></period-end>
     <target>
      <comment>
       <narrative xml:lang="EN">All 6 PALOP-TL countries have integrated IMS in parliaments and SAIs that need improvement or are consolidated.</narrative>
      </comment>
     </target>
    </period>
   </indicator>
