   <indicator ascending="1" measure="2">
    <title>
     <narrative xml:lang="FR">Pourcentage de m&#xe9;nages b&#xe9;n&#xe9;ficiaires en situation de s&#xe9;curit&#xe9; alimentaire</narrative>
    </title>
    <description>
     <narrative xml:lang="FR">Les m&#xe9;nages qui ont les capacit&#xe9;s (terre et moyens de production) de produire une quantit&#xe9; de vivres leur permettant de couvrir 6 mois de l&#x2019;ann&#xe9;e sont consid&#xe9;r&#xe9;s en s&#xe9;curit&#xe9; alimentaire</narrative>
    </description>
