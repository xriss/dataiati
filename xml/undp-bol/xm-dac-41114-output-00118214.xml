  <result aggregation-status="1" type="1">
   <title>
    <narrative xml:lang="ES">Annual Output Results</narrative>
   </title>
   <indicator ascending="0" measure="5">
    <title>
     <narrative xml:lang="ES">Output Indicator</narrative>
    </title>
    <description>
     <narrative xml:lang="ES">Incidencia de Tuberculosis (TB) medida por n&#xfa;mero de casos nuevos por cada cien mil habitantes que reporta el Sistema Nacional de Informaci&#xf3;n en Salud.</narrative>
    </description>
    <baseline year="2020">
     <comment>
      <narrative xml:lang="ES">67.2 casos por cada cien mil habitantes en la gesti&#xf3;n 2018 tomada del reporte de la Organizaci&#xf3;n Panamericana de Salud (OPS/OMS)</narrative>
     </comment>
    </baseline>
    <period>
     <period-start iso-date="2021-01-01"></period-start>
     <period-end iso-date="2021-12-31"></period-end>
     <target>
      <comment>
       <narrative xml:lang="ES">71 casos por cada 100.000 habitantes incrementando la cobertura al 85%.</narrative>
      </comment>
     </target>
     <actual>
      <comment>
       <narrative xml:lang="ES">67.2 casos por cada 100.000 habitantes</narrative>
      </comment>
     </actual>
    </period>
    <period>
     <period-start iso-date="2020-01-01"></period-start>
     <period-end iso-date="2020-12-31"></period-end>
     <target>
      <comment>
       <narrative xml:lang="ES">70.33 casos por cada 100.000 habitantes incrementando la cobertura al 80% (En relaci&#xf3;n al 60% en 2018)</narrative>
      </comment>
     </target>
     <actual>
      <comment>
       <narrative xml:lang="ES">An&#xe1;lisis: Se tiene una tasa de incidencia estimada de 50 casos por cada 100,000 habitantes y no se logr&#xf3; la meta prevista de 70.33. La principal raz&#xf3;n es por el impacto negativo de la Covid 19 que limito el trabajo de diagn&#xf3;stico en campo donde se recolecta la informaci&#xf3;n de los casos nuevos.</narrative>
      </comment>
     </actual>
    </period>
   </indicator>
  </result>
