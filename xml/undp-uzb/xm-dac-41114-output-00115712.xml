   <indicator aggregation-status="1" ascending="0" measure="5">
    <title>
     <narrative xml:lang="EN">National mechanism/strategy in place for quantity determination, demand forecasting, transparent and efficient procurement of medicines, medical supplies and equipment with central storage and logistics</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">National mechanism/strategy in place for quantity determination, demand forecasting, transparent and efficient procurement of medicines, medical supplies and equipment with central storage and logistics</narrative>
    </description>
    <baseline year="2019">
     <comment>
      <narrative xml:lang="EN">Operationalization of the National Health Supply Chain Management Center (NHSCMC), an institutional anchor for centralized public health procurement and logistics.</narrative>
     </comment>
    </baseline>
    <period>
     <period-start iso-date="2025-01-01"></period-start>
     <period-end iso-date="2025-12-31"></period-end>
     <target>
      <comment>
       <narrative xml:lang="EN">In 2025, the project will continue to build upon the established national mechanisms within Uzbekistan&apos;s AIDS services, focusing on enhancing the capacity for accurate quantification, demand forecasting, and transparent procurement of medicines and medical supplies. Efforts will be directed towards further strengthening the centralized storage and logistics systems to ensure efficient distribution and availability of essential health commodities. This includes ongoing training for healthcare professionals, refinement of standard operating procedures, and the integration of advanced digital tools to support real-time data monitoring and decision-making processes. By reinforcing these systems, the project aims to sustain and improve the quality and reliability of HIV-related healthcare services across the country.</narrative>
      </comment>
     </target>
    </period>
    <period>
     <period-start iso-date="2026-01-01"></period-start>
     <period-end iso-date="2026-12-31"></period-end>
     <target>
      <comment>
       <narrative xml:lang="EN">Mobilize resources for the initial phase of Supply Chain Managment reforms implementation in the whole sector</narrative>
      </comment>
     </target>
    </period>
   </indicator>
