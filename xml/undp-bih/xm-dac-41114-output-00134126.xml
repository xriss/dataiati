   <title>
    <narrative xml:lang="EN">Annual Output Results</narrative>
   </title>
   <indicator ascending="0" measure="5">
    <title>
     <narrative xml:lang="EN">Output Indicator</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">1.1.a: Availability of comprehensive gap analysis on harmonization of environmental legislation and criminal codes with the EU acquis;
1.1.b: Number of representatives of governments, CSOs, judiciary (men and women), contributing to the preparation and design of the Gap Analysis;      
Indicator 
1.2.a: Level of institutional capacity and understanding of environmental crimes including SOPs for police and border officers;
1.3.a: Level of public understanding and visibility of environmental human rights violations in BiH;
1.4.a: Availability of assessment of capacities of judges and prosecutors as well as law students at public universities in BiH regarding countering environmental crimes.</narrative>
    </description>
    <baseline year="2022">
     <comment>
      <narrative xml:lang="EN">1.1.a No
1.1.b 0
1.2 Low institutional capacity and understanding of environmental crimes; Absence of codified SOPs for police and border officers on response to environmental accidents or emergencies
1.3a Low public understanding and visibility of environmental human rights violations in BiH
1.4a No</narrative>
     </comment>
    </baseline>
