   <indicator aggregation-status="1" ascending="0" measure="5">
    <title>
     <narrative xml:lang="EN">Progress in reporting on NDC implementation, climate change impacts and adaptation and support needed and received in complicane with MPG requirements.</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">The indicator will assess on what extent is the information on the status NDC implementation, climate change impacts and adaptation and support needed and received reported in compliance with Decions 18/CMA.1 and 5/CMA.3.</narrative>
    </description>
    <baseline year="2023">
     <comment>
      <narrative xml:lang="EN">The preparations of previous NCs and BURs have not followed the MPGs and the common reporting tables and tabular formats of Decision 5/CMA.3</narrative>
     </comment>
    </baseline>
