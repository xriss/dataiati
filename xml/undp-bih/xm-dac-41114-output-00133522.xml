  <result aggregation-status="1" type="1">
   <title>
    <narrative xml:lang="EN">Annual Output Results</narrative>
   </title>
   <indicator aggregation-status="1" ascending="0" measure="5">
    <title>
     <narrative xml:lang="EN">Legislation on gender equality and supporting bylaws and policies harmonized and implemented</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">Availability of legislation on gender equality and supporting bylaws and policies harmonized and implemented granting adherence to employment rights within public institutions; adequate gender seal certificate awarded to participating institutions.</narrative>
    </description>
    <baseline year="2022">
     <comment>
      <narrative xml:lang="EN">Regulatory frameworks for gender equality and related policies are not harmonized with relevant national and international labor frameworks and are applied consistently in the justice and security sectors at the level of BiH.</narrative>
     </comment>
    </baseline>
    <period>
     <period-start iso-date="2024-01-01"></period-start>
     <period-end iso-date="2024-12-31"></period-end>
     <target>
      <comment>
       <narrative xml:lang="EN">Gender equality laws, by-laws, strategies, and policies are harmonized, aligned with international standards, and  implemented ensuring full adherence to employment rights;  
             
Gender Seal Draft documents are prepared, endorsed by the relevant institution, and ready for submission to the relevant government for final adoption and approval. Gender Seal for public institutions process completed and relevant certificate awarded to participating institutions</narrative>
      </comment>
     </target>
     <actual>
      <comment>
       <narrative xml:lang="EN">Following the practices of the High Judicial and Prosecutorial Council of BiH, the Ministry of Security initiated the Gender Equality Seal (GES) process in 2024</narrative>
      </comment>
     </actual>
    </period>
    <period>
     <period-start iso-date="2023-01-01"></period-start>
     <period-end iso-date="2023-12-31"></period-end>
     <target>
      <comment>
       <narrative xml:lang="EN">Gender equality laws, by-laws, strategies, and policies are harmonized, aligned with international standards, and  implemented ensuring full adherence to employment rights;  
             
Gender Seal Draft documents are prepared, endorsed by the relevant institution, and ready for submission to the relevant government for final adoption and approval. Gender Seal for public institutions process completed and relevant certificate awarded to participating institutions</narrative>
      </comment>
     </target>
     <actual>
      <comment>
       <narrative xml:lang="EN">The High Judicial Prosecutorial Council of Bosnia and Herzegovina is recognized to be the first public institution in Bosnia Herzegovina and in the Central Europe region to be awarded and globally recognized as a gender equality champion.</narrative>
      </comment>
     </actual>
    </period>
   </indicator>
  </result>
