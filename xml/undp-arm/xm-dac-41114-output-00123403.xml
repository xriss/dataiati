   <indicator aggregation-status="0" ascending="0" measure="5">
    <title>
     <narrative xml:lang="EN">CHDE is equipped with modern and up-to-date EOD and detection equipment to operate safely according to IMAS (transportation, detection and protective equipment, communication tools, etc.)</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">By 2023, CHDE is equipped with modern and up-to-date EOD and detection equipment to operate safely according to IMAS (transportation, detection and protective equipment, communication tools, etc.)</narrative>
    </description>
    <baseline year="2022">
     <comment>
      <narrative xml:lang="EN">Basic EOD and detection equipment</narrative>
     </comment>
    </baseline>
    <period>
     <period-start iso-date="2023-01-01"></period-start>
     <period-end iso-date="2023-12-31"></period-end>
     <target>
      <comment>
       <narrative xml:lang="EN">CHDE is equipped with modern and up-to-date EOD and detection equipment</narrative>
      </comment>
     </target>
     <actual>
      <comment>
       <narrative xml:lang="EN">CHDE is equipped with 10 magnetic locator probe for EO subsurface search, 8 metal detectors, 13 mine detectors, 4 medical trauma kits, 6 laser rangefinders, 6 lensatic/prismatic compass, 6 GPS-s, 4 vegetation trimmers, 410 batteries, 8 chargers to operate safely in the field in compliance with IMAS.
CHDE was equipped also with 14 laptops, 14 PC displays, 11 printers, 4 projectors with screens, 3 smart TV-s.</narrative>
      </comment>
     </actual>
    </period>
   </indicator>
