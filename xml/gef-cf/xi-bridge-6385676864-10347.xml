  <title>
   <narrative xml:lang="EN">Scaling up ecological corridors and transboundary connectivity through integrated natural resources management in the Ngotto Forest landscape and Mba&#xc3;&#xa9;r&#xc3;&#xa9;-Bodingu&#xc3;&#xa9; National Park</narrative>
  </title>
  <description type="4">
