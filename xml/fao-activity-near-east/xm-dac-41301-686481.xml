  <reporting-org ref="XM-DAC-41301" type="40">
   <narrative xml:lang="EN">Food and Agriculture Organization (FAO)</narrative>
  </reporting-org>
  <title>
   <narrative xml:lang="EN">Strengthening the resilience of vulnerable smallholder  farm families affected by the economic crisis and COVID-19 pandemic</narrative>
  </title>
  <description type="2">
   <narrative xml:lang="EN">The Project will work towards sustainably and equitably enhancing the livelihoods and food security of 4,600 smallholder men and women farmers and farm families most affected by the economic crisis and COVID-19 pandemic across rural areas of all governorates of Lebanon. The Project aims to foster the development of more sustainable small-scale and integrated homestead farming systems with stronger linkages to agricultural input and animal feed supply chains for men and women.</narrative>
  </description>
