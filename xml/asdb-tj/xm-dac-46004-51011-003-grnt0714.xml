  <iati-identifier>XM-DAC-46004-51011-003-GRNT0714</iati-identifier>
  <reporting-org ref="XM-DAC-46004" type="40">
   <narrative xml:lang="EN">Asian Development Bank</narrative>
  </reporting-org>
  <title>
   <narrative xml:lang="EN">Skills and Employability Enhancement Project</narrative>
  </title>
  <description>
   <narrative xml:lang="EN">The project aims to promote inclusive growth in Tajikistan by improving the vocational, technical and soft skills and employability of youth (ages 15 - 29), women, and labor migrants. It will support (i) the construction of migration service centers (MSCs) to provide more comprehensive services to labor migrants; (ii) the construction of model &quot;Job Centers&quot; that will provide market-responsive training and employment services for youth and women; and (iii) the capacity development of migration and employment agencies.</narrative>
  </description>
