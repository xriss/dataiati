  <title>
   <narrative xml:lang="EN">Occupied palestinian Territory 2012 CAP           Islamic Relief Sweden</narrative>
   <narrative xml:lang="SV">Via FNs &#xe5;rliga humanit&#xe4;ra appell ges st&#xf6;d till    Islamic Reliefs svenska del</narrative>
