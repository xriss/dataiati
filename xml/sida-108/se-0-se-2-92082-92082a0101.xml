  <title>
   <narrative xml:lang="EN">Support to Minority Rights Group Europe for Civic Solidarity Platform 2024</narrative>
   <narrative xml:lang="SV">Verksamhetsst&#xf6;d Minority Rights Group Europe f&#xf6;r Civic Solidarity Platform 2024</narrative>
