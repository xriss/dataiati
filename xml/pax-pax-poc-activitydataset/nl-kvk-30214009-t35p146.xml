  <document-link format="TEXT/HTML" url="https://protectionofcivilians.org/infographic/hss-iraq-dashboard/">
   <title>
    <narrative xml:lang="EN">Dashboard of Human Security Survey Iraq survey data (English)</narrative>
   </title>
   <description>
    <narrative xml:lang="EN">This interactive dashboard shows the results of the Human Security Survey (HSS) in Iraq. Results are presented per survey round and governorate, and can furthermore be disaggregated by gender. The dashboard consists of five thematic pages, namely demographics, security context &amp; threats, vulnerability, security actors, and future expectations, and a sixth page on methodology.</narrative>
   </description>
   <category code="A12"></category>
   <language code="EN"></language>
  </document-link>
