  <description type="1">
   <narrative xml:lang="EN">Contribute to the implementation of the national response plan to COVID-19 disease in the Central African Republic i.e. to reduce the risk of further spread of COVID-19 through risk communication and community engagement (RCCE) and health and hygiene promotion activities at epicentres of infection as prioritized by the Ministry of Health.</narrative>
  </description>
  <description type="1">
   <narrative xml:lang="EN">Covid-19 response activities in Bangui, CAR.</narrative>
  </description>
  <description type="2">
