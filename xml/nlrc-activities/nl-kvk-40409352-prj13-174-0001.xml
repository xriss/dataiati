  <title>
   <narrative xml:lang="EN">Digital Transformation of the IFRC Network</narrative>
  </title>
  <description type="2">
   <narrative xml:lang="EN">By facilitating the digital maturity assessments, develop digital roadmaps with national societies, and provide technical advise on the use of data &amp; digital to support the implementation of the digital roadmaps.</narrative>
  </description>
  <description type="1">
   <narrative xml:lang="EN">Globally</narrative>
  </description>
  <description type="1">
   <narrative xml:lang="EN">This project supports the IFRC Network with increasing the digital maturity of national societies</narrative>
  </description>
  <description type="1">
   <narrative xml:lang="EN">To improve the speed, quality, effectiveness and accountability of the humanitarian services by national societies</narrative>
  </description>
