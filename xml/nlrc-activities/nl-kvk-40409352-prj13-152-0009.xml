  <title>
   <narrative xml:lang="EN">Supporting Solarization programming and NS WASH assessments (2024-2026)</narrative>
  </title>
  <description type="1">
   <narrative xml:lang="EN">N/A</narrative>
  </description>
  <description type="2">
   <narrative xml:lang="EN">Providing (technical) support to partner RC National Societies on the topic of solarization and NS WASH assessments</narrative>
  </description>
  <description type="3">
   <narrative xml:lang="EN">RC National Societies and related (technical) staff</narrative>
  </description>
  <description type="1">
   <narrative xml:lang="EN">This project is covering advisory support to solarization programmes and NS WASH assessment, linked (but not limited) to MoFA Comp. 7. This will include providing support to organising trainings, workshops and solar linked programmes / projects</narrative>
  </description>
  <description type="1">
   <narrative xml:lang="EN">To increase local capacity in solarized water systems / strengthening capacity to build solar powered water systems and to support National Society WASH assessments</narrative>
  </description>
