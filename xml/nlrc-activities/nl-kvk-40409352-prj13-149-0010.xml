  <iati-identifier>NL-KVK-40409352-PRJ13-149-0010</iati-identifier>
  <reporting-org ref="NL-KVK-40409352" type="21">
   <narrative xml:lang="EN">The Netherlands Red Cross</narrative>
  </reporting-org>
  <title>
   <narrative xml:lang="EN">Sudan Conflict Response: Providing WASH services to Sudanese IDPs and host communities in Kassala and Gedaref</narrative>
  </title>
  <description type="2">
   <narrative xml:lang="EN">Communities will be reached through targeting health centres, schools (i.e. gathering points for IDPs), and surrounding communities. Project outcomes, outputs and activities have been designed in line with the Federation-wide Movement plan for the Sudan Complex Emergency Response (MDRSD033).</narrative>
  </description>
  <description type="1">
   <narrative xml:lang="EN">Gedaref and Kassala states, Eastern Sudan.</narrative>
  </description>
  <description type="1">
   <narrative xml:lang="EN">In April 2023, Sudan plunged into a dire humanitarian crisis as a result of an armed conflict. As a long-term partner to Sudanese Red Crescent Society (SRCS), NLRC is committed to support its local partner in responding to the nation-wide crisis.</narrative>
  </description>
  <description type="1">
   <narrative xml:lang="EN">In this project, Netherlands Red Cross supports the Sudanese Red Crescent Society (SRCS) in reducing the risk of waterborne diseases, increasing access to water, and mainstreaming protection, community engagement and National Society capacity development.</narrative>
  </description>
  <description type="3">
   <narrative xml:lang="EN">The project aims to reach 189,665 IDPs and host communities.</narrative>
  </description>
