   <narrative xml:lang="AR">&#x645;&#x648;&#x627;&#x637;&#x646;&#x629; &#x644;&#x62D;&#x642;&#x648;&#x642; &#x627;&#x644;&#x627;&#x646;&#x633;&#x627;&#x646;</narrative>
