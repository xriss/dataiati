  <result aggregation-status="1" type="1">
   <title>
    <narrative xml:lang="EN">Annual Output Results</narrative>
   </title>
   <indicator aggregation-status="1" ascending="0" measure="5">
    <title>
     <narrative xml:lang="EN">Percentage of finance solutions with gender integration</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">Measures the extent to which gender considerations are integrated into the design and implementation of finance solutions, with at least one finance solution at the country level having a Gender Marker of 2-3</narrative>
    </description>
    <baseline year="2024">
     <comment>
      <narrative xml:lang="EN">Less integration of gender in current  proposal of financial solutions</narrative>
     </comment>
    </baseline>
    <period>
     <period-start iso-date="2030-01-01"></period-start>
     <period-end iso-date="2030-12-31"></period-end>
     <target>
      <comment>
       <narrative xml:lang="EN">Fully integration of gender into all 13 financial solution designed in BFP for Zanzibar</narrative>
      </comment>
     </target>
     <actual>
      <comment>
       <narrative xml:lang="EN">Less Integration of Gender issues in the financial solutions that are being implemented in Zanzibar</narrative>
      </comment>
     </actual>
    </period>
   </indicator>
   <indicator aggregation-status="1" ascending="0" measure="1">
    <title>
     <narrative xml:lang="EN">Development of BFP with Key documents which are PER,FNA and BER</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">Development of BFP for Tanzania Mainland with other key documents which are Biodiversity Finance Policy and Institutional Review (PIR): Measures whether the comprehensive review of current biodiversity finance policies, institutions, and drivers of biodiversity change, Biodiversity Expenditure Review (BER): Assesses whether the review of historical spending on biodiversity-positive actions across sectors, Financial Needs Assessment (FNA): Measures whether the assessment of financing required to deliver national biodiversity targets is completed and lastly the Biodiversity Finance Plan (BFP): Tracks the completion of the finance plan, outlining prioritized solutions and implementation steps</narrative>
    </description>
    <baseline value="0" year="2024"></baseline>
    <period>
     <period-start iso-date="2025-01-01"></period-start>
     <period-end iso-date="2025-12-31"></period-end>
     <target value="1"></target>
     <actual value="0"></actual>
    </period>
   </indicator>
   <indicator aggregation-status="1" ascending="0" measure="1">
    <title>
     <narrative xml:lang="EN">Number of countries initiating the BIOFIN proces</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">Tracks the number of new countries that implement the first steps of the BIOFIN methodology, based on the 2018 BIOFIN Workbook.</narrative>
    </description>
    <baseline value="1" year="2024"></baseline>
    <period>
     <period-start iso-date="2030-01-01"></period-start>
     <period-end iso-date="2030-12-31"></period-end>
     <target value="2"></target>
     <actual value="2"></actual>
    </period>
   </indicator>
   <indicator aggregation-status="1" ascending="0" measure="1">
    <title>
     <narrative xml:lang="EN">Number of Financial solution implemented</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">Number of finance solutions selected in the biodiversity finance plans that are fully designed and implemented, with a particular focus on solutions with high potential for positive impacts on sustainable livelihoods, gender equality, and national climate change goals.</narrative>
    </description>
    <baseline value="2" year="2024"></baseline>
