  <title>
   <narrative xml:lang="EN">Securing equipment for the kidney dialysis center in Al-Khokha city, Al-Hudaydah Governorate</narrative>
  </title>
  <description type="1">
   <narrative xml:lang="EN">Providing medical equipment and furniture to the dialysis center in Al-Khawkhah City, Al-Hudaydah Governorate, Republic of Yemen.</narrative>
  </description>
