  <title>
   <narrative xml:lang="EN">Support for the treatment of moderate acute malnutrition programme for vulnerable children under five and pregnant and lactating women in Yemen</narrative>
  </title>
  <description type="1">
   <narrative xml:lang="EN">Maintain and improve the nutritional status of the most vulnerable population in Yemen and support the treatment programme for moderate acute malnutrition for vulnerable children under five years of age and pregnant and lactating women through the purchase and provision of nutritional supplements in targeted areas.</narrative>
  </description>
  <description type="3">
   <narrative xml:lang="EN">Providing nutritional supplements to 86,985 beneficiaries.</narrative>
  </description>
  <description type="2">
