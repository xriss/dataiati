   <indicator ascending="1" measure="1">
    <title>
     <narrative xml:lang="EN">Annual Certified Emission Reductions (CERs) in tCO2e delivered</narrative>
    </title>
    <baseline iso-date="2009-06-01" value="0.00" year="2009">
     <comment>
      <narrative xml:lang="EN">CDM Certified Emission Reductions (CERs) in tCO2 equivalent.</narrative>
     </comment>
    </baseline>
    <period>
     <period-start iso-date="2009-06-01"></period-start>
     <period-end iso-date="2013-12-31"></period-end>
     <target value="125000.00">
      <comment>
       <narrative xml:lang="EN">125,000 annually during January 1, 2010 to December 31, 2013</narrative>
      </comment>
     </target>
     <actual value="0.00">
      <comment>
       <narrative xml:lang="EN">Some emission reductions have been generated but were not monitored/measured or certified.  CERs can be realized only afterregistration of the CDM and after positive verification by a DOE.  Due to the delay in CDM validation and registration processes,no CER has been delivered yet.</narrative>
      </comment>
     </actual>
    </period>
   </indicator>
  </result>
