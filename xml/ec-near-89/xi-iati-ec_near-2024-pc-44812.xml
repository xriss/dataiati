  <title>
   <narrative xml:lang="EN">SMS Facility - Small Media Support in Western Balkans</narrative>
  </title>
  <description type="1">
   <narrative xml:lang="EN">&lt;p&gt;The main objective of the Action is to provide supportive environment and structure for professional media and contribute to strengthening capacities of local media, media organizations and journalists to exercise the right to freedom of expression and access to information and to promote media pluralism.&lt;/p&gt;</narrative>
  </description>
