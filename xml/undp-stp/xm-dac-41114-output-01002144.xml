    </period>
   </indicator>
   <indicator aggregation-status="0" ascending="0" measure="1">
    <title>
     <narrative xml:lang="FR">Number of countries with a report on nature-positive and nature-harmful subsidies</narrative>
    </title>
    <description>
     <narrative xml:lang="FR">Countries will assess nature-positive and nature-harmful subsidies through an intersectoral process.</narrative>
    </description>
    <baseline value="0" year="2024"></baseline>
    <period>
     <period-start iso-date="2025-01-01"></period-start>
     <period-end iso-date="2025-12-31"></period-end>
     <target value="40"></target>
    </period>
   </indicator>
   <indicator aggregation-status="0" ascending="0" measure="1">
    <title>
     <narrative xml:lang="FR">Number of countries with biodiversity-related policy and institutional framework analyses</narrative>
    </title>
    <description>
     <narrative xml:lang="FR">Countries will be undertaking a range of baseline analyses under the guidance of an intersectoral national steering committee</narrative>
    </description>
    <baseline value="0" year="2024"></baseline>
    <period>
     <period-start iso-date="2025-01-01"></period-start>
     <period-end iso-date="2025-12-31"></period-end>
     <target value="40"></target>
    </period>
   </indicator>
   <indicator aggregation-status="0" ascending="0" measure="1">
    <title>
     <narrative xml:lang="FR">Number of countries with a report on national financial needs assessment for biodiversity</narrative>
    </title>
    <description>
     <narrative xml:lang="FR">Countries will look at national policies, laws, programmes and GBF targets to define national biodiversity needs and cost them. Unmet financial needs to achieve national biodiversity targets and objectives will be estimated, and a national financial needs assessment report prepared.</narrative>
    </description>
    <baseline value="0" year="2024"></baseline>
    <period>
     <period-start iso-date="2025-01-01"></period-start>
     <period-end iso-date="2025-12-31"></period-end>
     <target value="40"></target>
    </period>
   </indicator>
   <indicator aggregation-status="0" ascending="0" measure="1">
    <title>
     <narrative xml:lang="FR">Number of countries with national biodiversity finance plans</narrative>
    </title>
    <description>
     <narrative xml:lang="FR">Countries will prepare comprehensive proposal of finance solutions, including actions to enhance existing finance flows. They will prioritize finance solutions and develop technical proposals and a national biodiversity finance plan.</narrative>
    </description>
    <baseline value="0" year="2024"></baseline>
