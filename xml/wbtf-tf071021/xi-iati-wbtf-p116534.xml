  <title>
   <narrative xml:lang="EN">IDP COMMUNITY DEVT PROJECT</narrative>
  </title>
  <description type="1">
   <narrative xml:lang="EN">The development objective of IDP-CDP is to enhance the social and economic reintegration of target IDP populations in Georgia by i) increased opportunities for IDPs in target communities to participate in community development activities, ii) increased access for IDPs in target communities to basic infrastructure, services, employment and livelihood opportunities, iii) enhancing national capacity to provide support to IDPs</narrative>
  </description>
