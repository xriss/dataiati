     <target value="50.00">
      <comment>
       <narrative xml:lang="EN">The target is given as a percentage.</narrative>
      </comment>
     </target>
     <actual value="13862.00">
      <comment>
       <narrative xml:lang="EN">13,862 persons, attended all 181 community meetings. The same people may have attended different community meetings and it was notpossible to verify the extent of double counting and therefore the percentage of attendance from the overall community populationisnot given.</narrative>
      </comment>
     </actual>
    </period>
   </indicator>
  </result>
