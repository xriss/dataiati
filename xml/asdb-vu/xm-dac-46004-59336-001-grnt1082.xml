    </period>
   </indicator>
   <indicator measure="1">
    <title>
     <narrative xml:lang="EN">Indicator 2</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">Number of passenger arrived via the cruise ship at Main Wharf annually increased to 110,000 (2025 baseline: 0) (DR3, DR7) 
Data Source: Project completion report, Department of Port and Harbor operations report 
Actual value:</narrative>
    </description>
