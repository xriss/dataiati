   <description>
    <narrative xml:lang="EN">Climate- and disaster-resilient access to critical wharves in Port Vila restored.</narrative>
   </description>
   <indicator measure="1">
    <title>
     <narrative xml:lang="EN">Indicator 1</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">Access to the Main Wharf in Port Vila, through climate and disaster resilient wharf road, maintained for at least 345 days annually under normal and adverse weather conditions (2025 baseline: 0) 
Data Source: Project completion report, Department of Port and Harbor operations report 
Actual value:</narrative>
    </description>
    <baseline value="0" year="2025"></baseline>
    <period>
     <period-start iso-date="2030-01-01"></period-start>
     <period-end iso-date="2030-12-31"></period-end>
