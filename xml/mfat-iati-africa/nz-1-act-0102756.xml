  <reporting-org ref="NZ-1" type="10">
   <narrative xml:lang="EN">New Zealand Ministry of Foreign Affairs and Trade</narrative>
  </reporting-org>
  <title>
   <narrative xml:lang="EN">Africa: Home Grown Solutions Agribusiness Accelerator (AUDA-NEPAD)</narrative>
  </title>
  <description type="1">
   <narrative xml:lang="EN">This Activity aims to increase the capacity of the private sector to engage and drive the implementation of the Africa&#xa0;Continental&#xa0;Free Trade Agreement through the development of a business accelerator in the agriculture sector.&#xa0;The accelerator will provide context-specific advisory support in investment readiness, forming strategic partnerships, seeking longer-term funding and capacity building for small businesses in the agricultural sector, with priority given to&#xa0;businesses operated by women.</narrative>
  </description>
