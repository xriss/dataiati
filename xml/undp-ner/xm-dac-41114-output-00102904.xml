    <narrative xml:lang="FR">Social and environmental sustainability will be enhanced through application of the UNDP Social and Environmental Standards (http://www.undp.org/ses) and related Accountability Mechanism (http://www.undp.org/secu-srm).</narrative>
   </condition>
  </conditions>
