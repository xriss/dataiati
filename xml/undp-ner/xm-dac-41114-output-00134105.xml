     <actual value="16"></actual>
    </period>
   </indicator>
   <indicator aggregation-status="1" ascending="0" measure="1">
    <title>
     <narrative xml:lang="FR">Nombre d&#x2019;EP respectant les normes en mati&#xE8;re de nombre de d&#xE9;tenu par latrine et douche</narrative>
    </title>
    <description>
     <narrative xml:lang="FR">Cet indicateur vise &#xE0; &#xE9;valuer la disponibilit&#xE9; des installations sanitaires dans les &#xE9;tablissements p&#xE9;nitentiaires, en mettant l&apos;accent sur la capacit&#xE9; des installations &#xE0; r&#xE9;pondre aux besoins de la population carc&#xE9;rale. Selon les normes nationales, le nombre moyen de d&#xE9;tenus par Latrine est de 30. Le nombre moyen de d&#xE9;tenus par douche est de 40.</narrative>
    </description>
