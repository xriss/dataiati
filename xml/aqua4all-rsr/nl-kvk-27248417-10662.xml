   <title>
    <narrative xml:lang="EN">1- Improved access to safe water, sanitation and IWRM services/products</narrative>
   </title>
   <indicator ascending="1" measure="1">
    <title>
     <narrative xml:lang="EN">1 - Total number of people reached with safe Water, sanitation and IWRM services/products</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">Fill in the total number of people reached with your initiative at this exact time of measurement (beneficiaries, customers, users etc) with all of the Water, sanitation and IWRM activities. number of users (Aggregate nr of beneficiaries under drinking water, sanitation and IWRM and Capacity building)</narrative>
    </description>
    <baseline value="0" year="2023">
