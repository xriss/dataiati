  <result aggregation-status="0" type="2">
   <title>
    <narrative xml:lang="EN">PDO Indicator</narrative>
   </title>
   <indicator ascending="1" measure="2">
    <title>
     <narrative xml:lang="EN">Increase in value of properties in targeted cities</narrative>
    </title>
    <baseline value="000000" year="1900">
     <comment>
      <narrative xml:lang="EN"></narrative>
     </comment>
    </baseline>
    <period>
     <period-start iso-date="2007-01-30"></period-start>
     <period-end iso-date="2014-03-31"></period-end>
     <target value="20.00">
      <comment>
       <narrative xml:lang="EN">Target surpassed</narrative>
      </comment>
     </target>
     <actual value="30.00">
      <comment>
       <narrative xml:lang="EN">In addition to positive externalities caused by the project, raise in property values is also due to housing shortage caused bytheinflux of Syrian refugees.</narrative>
      </comment>
     </actual>
    </period>
   </indicator>
  </result>
  <result aggregation-status="0" type="2">
   <title>
    <narrative xml:lang="EN">PDO Indicator</narrative>
   </title>
   <indicator ascending="1" measure="1">
    <title>
     <narrative xml:lang="EN">Increased Visitation and Stay in Targeted Cities</narrative>
    </title>
    <baseline value="000000" year="1900">
     <comment>
      <narrative xml:lang="EN"></narrative>
     </comment>
    </baseline>
    <period>
     <period-start iso-date="2007-01-30"></period-start>
     <period-end iso-date="2014-03-31"></period-end>
     <target value="2.17">
      <comment>
       <narrative xml:lang="EN">Target missed due to exogenous factors, though the infrastructure delivered through the project will help recovery as the politicalsituation in the region improves.</narrative>
      </comment>
     </target>
     <actual value="1.46">
      <comment>
       <narrative xml:lang="EN">The geopolitical situation determined by the conflict in Syria continues to impact the average length of stay in Jordan, althoughmuch less than in other countries in the region, showing a relative resilience of the tourism industry in the country, as it cancount on unique assets such as Petra and the Dead Sea.</narrative>
      </comment>
     </actual>
    </period>
   </indicator>
  </result>
