   <indicator ascending="1" measure="2">
    <title>
     <narrative xml:lang="EN">Percentage of coral reefs in project managed areas under effectively and collaboratively managed, fully protected no-take zones</narrative>
    </title>
    <baseline iso-date="2005-03-17" value="2.60" year="2005">
     <comment>
      <narrative xml:lang="EN">Baseline was no-take zones in protected areas under PHKA at start of Phase 2.</narrative>
     </comment>
    </baseline>
    <period>
     <period-start iso-date="2005-03-17"></period-start>
     <period-end iso-date="2011-12-31"></period-end>
     <target value="10.00"></target>
     <actual value="6.25">
      <comment>
       <narrative xml:lang="EN">Current status a combination of community no-take zones (DPL), core no-take zones within District marine conservation areas, andNational Parks</narrative>
      </comment>
     </actual>
    </period>
   </indicator>
  </result>
  <result aggregation-status="0" type="2">
   <title>
    <narrative xml:lang="EN">PDO Indicator</narrative>
   </title>
   <indicator ascending="1" measure="5">
    <title>
     <narrative xml:lang="EN">Improvements in catch per unit effort (CPUE) based on reports of fishers in COREMAP  managed sites using traditional reef fishing gear, or via visual census, compared to control outside project area.</narrative>
    </title>
    <baseline iso-date="2005-03-17" value="0" year="2005">
     <comment>
      <narrative xml:lang="EN">Baselines for treatment group established at different times in different sample sites and districts. Baselines for control sites(outside COREMAP managed sites) are still under development.</narrative>
     </comment>
    </baseline>
    <period>
     <period-start iso-date="2005-03-17"></period-start>
     <period-end iso-date="2011-12-31"></period-end>
     <target value="80% of sample sites in project have improved CPUE">
      <comment>
       <narrative xml:lang="EN">Although CPUE is expected to increase in the sample sites, a decrease could still represent improvement if CPUE at controldeclinesby a greater amount.</narrative>
      </comment>
     </target>
     <actual>
      <comment>
       <narrative xml:lang="EN">The results are mixed, with some districts showing average increases in CPUE between 2006 and 2008, and others showing a decrease(although a decrease may still reflect improved outcome over control area). Results are not clear and we will need disaggregateddatafor each district (that is, data from each community over time) to run statistical analysis.</narrative>
      </comment>
     </actual>
    </period>
   </indicator>
  </result>
