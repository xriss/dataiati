   <indicator ascending="1" measure="5">
    <title>
     <narrative xml:lang="EN">HIV prevalence among 15- 19 yearoldwomen</narrative>
    </title>
    <baseline value="000000" year="1900">
     <comment>
      <narrative xml:lang="EN"></narrative>
     </comment>
    </baseline>
    <period>
     <period-start iso-date="2004-04-20"></period-start>
     <period-end iso-date="2012-06-30"></period-end>
     <target value="1.4%"></target>
     <actual value="2.1%">
      <comment>
       <narrative xml:lang="EN">From the 2011 sentinel surveillance among pregnant women, the prevalence of HIV among women aged 15-19 years was 2.1% (which isnotstatistically different from the 1.96% prevalence rate among the same group of young women in 2006 Sentinel surveillance data).The1.4% at baseline in 2004 as derived from a household survey and is comparable to the 2009 household survey which showed aprevalence rate of 1.9% among young women aged 15-19 years. The objective of the project to keep this indicator at its baselinelevel was therefore achieved.</narrative>
      </comment>
     </actual>
    </period>
   </indicator>
