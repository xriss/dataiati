   <indicator ascending="1" measure="1">
    <title>
     <narrative xml:lang="EN">At least two testing laboratories accredited according to international standards ISO/IEC 17025</narrative>
    </title>
    <baseline iso-date="2007-01-16" value="0.00" year="2007">
     <comment>
      <narrative xml:lang="EN"></narrative>
     </comment>
    </baseline>
    <period>
     <period-start iso-date="2007-01-16"></period-start>
     <period-end iso-date="2013-03-31"></period-end>
     <target value="2.00"></target>
     <actual value="0.00">
      <comment>
       <narrative xml:lang="EN">Delays in the procurement and installation of microbiology testing equipment prevented the full accreditation process. Equipmentisfully installed and the laboratories will benefit from an international pre-audit that will produce a gap assessment andrecommendations for international accreditation to be completed after project closing.</narrative>
      </comment>
     </actual>
    </period>
   </indicator>
  </result>
  <result aggregation-status="0" type="1">
   <title>
    <narrative xml:lang="EN">Intermediate Results Indicator</narrative>
   </title>
   <indicator ascending="1" measure="1">
    <title>
     <narrative xml:lang="EN">At least 2 certifying bodies accredited according to the relevant standard</narrative>
    </title>
    <baseline iso-date="2007-01-16" value="0.00" year="2007">
     <comment>
      <narrative xml:lang="EN"></narrative>
     </comment>
    </baseline>
    <period>
     <period-start iso-date="2007-01-16"></period-start>
     <period-end iso-date="2013-03-31"></period-end>
     <target value="2.00"></target>
     <actual value="0.00">
      <comment>
       <narrative xml:lang="EN">Two certification bodies with approximate compliance have been identified. Nevertheless, the accreditation of two certificationbodies will not be achieved by project closing due to timing issues and linkages with the accreditation process of the testinglaboratories. Nevertheless, certification bodies will benefit from an international pre-audit that will produce a gap assessmentand recommendations.</narrative>
      </comment>
     </actual>
    </period>
   </indicator>
  </result>
