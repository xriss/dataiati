  <result aggregation-status="0" type="2">
   <title>
    <narrative xml:lang="EN">PDO Indicator</narrative>
   </title>
   <indicator ascending="1" measure="5">
    <title>
     <narrative xml:lang="EN">Client perception of Customs# performance</narrative>
    </title>
    <baseline iso-date="2005-04-20" value="33.9 %" year="2005">
     <comment>
      <narrative xml:lang="EN">Customs administration is considered slow, unresponsive, inconsistent, and vulnerable to corruption</narrative>
     </comment>
    </baseline>
    <period>
     <period-start iso-date="2005-04-20"></period-start>
     <period-end iso-date="2011-06-30"></period-end>
     <target value="55%">
      <comment>
       <narrative xml:lang="EN">Significant improvement in client perceptions</narrative>
      </comment>
     </target>
     <actual value="53.5%">
      <comment>
       <narrative xml:lang="EN">Majority of the clients surveyed in June 2010 agreed that: a) customs and import export rules and regulations are clear andtransparent; b) Implementation of customs procedures is clear and simple; c) Time for customs procedures completion is quick; d)Customs staff has adequate capacity to meet job requirements; and e) Customs staff attitude is reasonable; and costs arereasonable. However perceptions of widespread corruption are high and half of the companies surveyed in June 2010 indicated thatalways, often or sometimes had such experience during customs and export/import activities.</narrative>
      </comment>
     </actual>
    </period>
   </indicator>
  </result>
