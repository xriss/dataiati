  <title>
   <narrative xml:lang="EN">Irrigation and Watershed Management Project</narrative>
  </title>
  <description type="1">
   <narrative xml:lang="EN">To establish the basis for viable irrigated agriculture and natural resources management in four main irrigation sites and their surrounding watersheds: (i) Andapa (Sava Region), (ii) Marovoay (Boeny Region), (iii) Itasy Region, and (iv) Lac Alaotra (Alaotra Mangoro Region).</narrative>
  </description>
