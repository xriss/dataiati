   <indicator ascending="1" measure="5">
    <title>
     <narrative xml:lang="EN">% decrease in time spent on access to key infrastructure in beneficiary communities and % difference in time spent on access to keyinfrastructure between beneficiary communities &amp; control groups</narrative>
    </title>
    <baseline iso-date="2005-05-16" value="0%" year="2005">
     <comment>
      <narrative xml:lang="EN"></narrative>
     </comment>
    </baseline>
    <period>
     <period-start iso-date="2005-05-16"></period-start>
     <period-end iso-date="2012-03-31"></period-end>
     <target value="20%"></target>
     <actual value="42%">
      <comment>
       <narrative xml:lang="EN">For all key infrastructure facilities the time spent on access has significantly declined in the evaluation stage, as compared tothe baseline stage, due to the subprojects. The % change, on an overall basis, is as follows: paved access road (25% decline intime to access it), schools overall (49% decline), community center (20% decline), clinics (18% decline), village hospital (44%decline),central transportation point (51% decline), domestic water supply point (72% decline), parks (36% decline), and marketingpoint (59%decline in time).</narrative>
      </comment>
     </actual>
    </period>
   </indicator>
  </result>
