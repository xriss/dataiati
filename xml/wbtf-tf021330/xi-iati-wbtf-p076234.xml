    <narrative xml:lang="EN">PDO Indicator</narrative>
   </title>
   <indicator ascending="1" measure="5">
    <title>
     <narrative xml:lang="EN">Percentage change in the percentage of community members who report that they feel they have some influence in community decision-ma king processes.</narrative>
    </title>
    <baseline iso-date="2005-05-16" value="0%" year="2005">
     <comment>
      <narrative xml:lang="EN"></narrative>
     </comment>
    </baseline>
    <period>
     <period-start iso-date="2005-05-16"></period-start>
     <period-end iso-date="2012-03-31"></period-end>
     <target value="20%"></target>
     <actual value="26%">
      <comment>
       <narrative xml:lang="EN">Endline evaluation indicates strong influence from project participation in the community decision making. In project villages,there has been a very significant improvement in the community&#x2019;s influence in the decision making process at the evaluation stageas compared to the baseline stage. On an overall basis, 54% (baseline = 30%) of respondents attested to influence in the decisionmaking process. In control villages, on an overall basis, only 28% (baseline = 27%) said they had influence in the decision makingprocess.</narrative>
      </comment>
     </actual>
    </period>
   </indicator>
  </result>
