  <title>
   <narrative xml:lang="EN">Ho Chi Minh City Environmental Sanitation (Nhieu Loc-Thi Nghe Basin) Project</narrative>
  </title>
  <description type="1">
   <narrative xml:lang="EN">Reduce the incidence of flooding and increase the collection of wastewater in the Nhieu Loc Thi Nghe (NLTN) Basin in HCMC, in an environmentally and financially sustainable manner.</narrative>
