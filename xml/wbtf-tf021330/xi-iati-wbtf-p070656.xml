     <narrative xml:lang="EN">2. Prevent additional kilometres of illegal roads built in all parks and forest management units.</narrative>
    </title>
    <baseline iso-date="2004-12-30" value="1024 km" year="2004">
     <comment>
      <narrative xml:lang="EN">In 2009, WRI (formerly Global Forest Watch) were contracted to update previous baseline (prepared in 2004) which estimated thatthere were 357km of irregular roads. Using a more refined approach to analyze new data, the revised baseline was revised to 1024kmof irregular roads existing up to December 2005. This serves as a baseline for subsequent comparison.</narrative>
     </comment>
    </baseline>
    <period>
     <period-start iso-date="2004-12-30"></period-start>
     <period-end iso-date="2011-09-30"></period-end>
     <target>
      <comment>
       <narrative xml:lang="EN">WRI will be commissioned again in 2011 to update their measurement of irregular logging roads, using new imagery for the period2008-2011.  Results will be compared with previous trend.</narrative>
      </comment>
     </target>
     <actual></actual>
    </period>
   </indicator>
  </result>
