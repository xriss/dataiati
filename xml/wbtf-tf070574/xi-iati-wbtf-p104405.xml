  <result aggregation-status="0" type="2">
   <title>
    <narrative xml:lang="EN">PDO Indicator</narrative>
   </title>
   <indicator ascending="1" measure="5">
    <title>
     <narrative xml:lang="EN">Establishing and strictly enforcing standards of care in the private health sector</narrative>
    </title>
    <baseline iso-date="2009-05-15" value="0" year="2009">
     <comment>
      <narrative xml:lang="EN">At program inception, there was no baseline for standards of care.  This indicator will be measured by the adherence to standardsof care measured through the Safecare standards (50 criterias of implementation and adherence to clinical guidelines)</narrative>
     </comment>
    </baseline>
    <period>
     <period-start iso-date="2009-05-15"></period-start>
     <period-end iso-date="2014-04-30"></period-end>
     <target value="70%">
      <comment>
       <narrative xml:lang="EN">At the end of the project, the objective is to obtain 70% average score of adherence to the Safecare standards</narrative>
      </comment>
     </target>
     <actual value="65%">
      <comment>
       <narrative xml:lang="EN">Out of the clinics that were previously assessed, 2 have left the SPN (the Lagoon hospitals), the remaining clinics had an averagescore of 65% on adhering to clinical guidelines.  The other clinics were added to the network at a later stage and haven&#x2019;t hadadequate assessments to reflect the final score and compare them to the providers that have been on the program from the start ofthe program.</narrative>
      </comment>
     </actual>
    </period>
   </indicator>
  </result>
  <result aggregation-status="1" type="1">
   <title>
    <narrative xml:lang="EN">Intermediate Results Indicator</narrative>
   </title>
   <indicator ascending="1" measure="1">
    <title>
     <narrative xml:lang="EN">Health facilities constructed, renovated, and/or equipped (number)</narrative>
    </title>
    <baseline iso-date="2009-08-15" value="8.00" year="2009">
     <comment>
      <narrative xml:lang="EN">Number of service providers in the plan at inception</narrative>
     </comment>
    </baseline>
    <period>
     <period-start iso-date="2009-08-15"></period-start>
     <period-end iso-date="2014-04-30"></period-end>
     <target value="10.00">
      <comment>
       <narrative xml:lang="EN">total number of service providers in the network at the end of the project</narrative>
      </comment>
     </target>
     <actual value="10.00">
      <comment>
       <narrative xml:lang="EN">2 clinics were upgraded with WB/GPOBA funding: Lagoon Ikeja , Blue cross and Adefemi Hospital</narrative>
      </comment>
     </actual>
    </period>
   </indicator>
  </result>
  <result aggregation-status="0" type="2">
   <title>
    <narrative xml:lang="EN">PDO Indicator</narrative>
   </title>
   <indicator ascending="1" measure="2">
    <title>
     <narrative xml:lang="EN">Demonstrating viability and sustainability of community health plans</narrative>
    </title>
    <baseline iso-date="2010-11-24" value="37.00" year="2010">
     <comment>
      <narrative xml:lang="EN">The e-enrollement measured for the first time at the last reporting season</narrative>
     </comment>
    </baseline>
    <period>
     <period-start iso-date="2010-11-24"></period-start>
     <period-end iso-date="2014-04-30"></period-end>
     <target value="60.00">
      <comment>
       <narrative xml:lang="EN">Enrollment is on a voluntary basis, and this target compares with other voluntary health schemes in low income Sub-saharan countries</narrative>
      </comment>
     </target>
     <actual value="77.00">
      <comment>
       <narrative xml:lang="EN">Reached 77% in Oct&#x2019;13. After that, re-enrollment in CAPDAN product was not possible anymore.</narrative>
      </comment>
     </actual>
    </period>
   </indicator>
  </result>
  <result aggregation-status="0" type="2">
   <title>
    <narrative xml:lang="EN">PDO Indicator</narrative>
   </title>
   <indicator ascending="1" measure="2">
    <title>
     <narrative xml:lang="EN">Quality of service standards</narrative>
    </title>
    <baseline iso-date="2010-11-30" value="57.00" year="2010">
     <comment>
      <narrative xml:lang="EN">The indicator measurement represents the average score of 11 criteria measured every six months; 11 facilities were assessed atbaseline under the Safecare Quality Assessment process</narrative>
     </comment>
    </baseline>
    <period>
     <period-start iso-date="2010-11-30"></period-start>
     <period-end iso-date="2014-04-30"></period-end>
     <target value="82.00">
      <comment>
       <narrative xml:lang="EN">Applies to only 3   facilities were surveyed under Safecare quality Assessment process.</narrative>
      </comment>
     </target>
     <actual value="79.00">
      <comment>
       <narrative xml:lang="EN">For 5 clinics that have undergone 3 assessments the average score has increased from 57 (1st assessment), to 75 (2nd assessment) to79 (3rd assessment).</narrative>
      </comment>
     </actual>
    </period>
   </indicator>
  </result>
