  <reporting-org ref="XI-IATI-EC_NEAR" secondary-reporter="0" type="15">
   <narrative xml:lang="EN">European Commission - Directorate-General for Neighbourhood and Enlargement Negotiations</narrative>
  </reporting-org>
  <title>
   <narrative xml:lang="EN">Supervision of the works on the EU4SPORT - To foster positive social development through improvement of sports infrastructure in schools</narrative>
  </title>
  <description type="1">
   <narrative xml:lang="EN">&lt;p&gt;&lt;span style=&quot;color: windowtext;&quot;&gt;The contractor shall provide supervisory services to ensure execution and completion of renovation/modernisation works in accordance with the EC procedures, on time, within the budget available and in accordance with provisions of the Contract and Technical Specifications for execution of the respective works &lt;/span&gt;&lt;strong style=&quot;color: windowtext;&quot;&gt;within lots 2 and 3. &lt;/strong&gt;&lt;span style=&quot;color: windowtext;&quot;&gt; &lt;/span&gt;The specific objective(s) of this contract are as follows:&lt;/p&gt;&lt;p&gt;&#xB7;To facilitate implementation of all works stated in the Technical documentation and Tender Dossier of works for the Project &lt;strong&gt;EU4SPORT-To foster positive social development through improvement of sportsinfrastructure in schools;&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;&#xB7;To provide high quality works supervision services;&lt;/p&gt;&lt;p class=&quot;ql-align-justify&quot;&gt;&#xB7;To secure a sound implementation of the works contract(s) according to the stipulated works contract conditions for renovation/modernisation, &lt;strong&gt;per contracted lot(s),&lt;/strong&gt; in relevant primary schools and faculties of sport in Bosnia and Herzegovina&lt;/p&gt;</narrative>
  </description>
