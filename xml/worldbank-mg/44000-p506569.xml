  <title xml:lang="EN">
   <narrative xml:lang="EN">Transforming Access and Learning in Madagascar</narrative>
  </title>
  <description type="1" xml:lang="EN">
   <narrative xml:lang="EN">This operation aims to improve education outcomes for all children in Madagascar&apos;s public primary education with targeted interventions addressing key systemic shortcomings in three areas: (a) teaching quality and teacher management, (b) school infrastructure and learning environments, and (c) education sector governance.</narrative>
  </description>
  <description type="2" xml:lang="EN">
   <narrative xml:lang="EN">To increase the completion rate and improve learning outcomes in primary education.</narrative>
  </description>
