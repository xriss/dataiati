  <result aggregation-status="0" type="2">
   <title>
    <narrative xml:lang="EN">PDO Indicator</narrative>
   </title>
   <indicator ascending="1" measure="1">
    <title>
     <narrative xml:lang="EN">Annual Certified Emission reduction (CERs) in tCO2e deleivered</narrative>
    </title>
    <baseline iso-date="2009-06-05" value="0.00" year="2009">
     <comment>
      <narrative xml:lang="EN"></narrative>
     </comment>
    </baseline>
    <period>
     <period-start iso-date="2009-06-05"></period-start>
     <period-end iso-date="2013-12-31"></period-end>
     <target value="125000.00">
      <comment>
       <narrative xml:lang="EN">125,000 CERs annually during January 1, 2010 to December 31, 2012 - or a cumulative amount of 375,000 CERs (as per the originalERPA).</narrative>
      </comment>
     </target>
     <actual value="0.00">
      <comment>
       <narrative xml:lang="EN">Due to delays in CDM validation and registration, and finally ERPA termination, no CERs were delivered.</narrative>
      </comment>
     </actual>
    </period>
   </indicator>
  </result>
  <result aggregation-status="0" type="1">
   <title>
