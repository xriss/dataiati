      </comment>
     </target>
     <actual>
      <comment>
       <narrative xml:lang="EN">In progress on time</narrative>
      </comment>
     </actual>
    </period>
   </indicator>
   <indicator aggregation-status="1" ascending="0" measure="5">
    <title>
     <narrative xml:lang="EN">Technical support provided for implementation of the new enlargement methodology and the EU Accession Framework 2030</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">Based on inputs provided by MEI, best practice models for similar documents and tailor-made analyses of Serbian context vis a vis EU integration, the adequate methodology of the document and proposed structure will be developed.</narrative>
    </description>
    <baseline year="2024">
     <comment>
