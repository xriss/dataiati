   <title>
    <narrative xml:lang="EN">Annual Output Results</narrative>
   </title>
   <indicator aggregation-status="1" ascending="0" measure="5">
    <title>
     <narrative xml:lang="EN">Strengthened capacities of ITE to coordinate the Team for Creative industries and the overall policy in this area</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">Creative Industries are significant for the government of Serbia. Along with education and digitalization, the creative economy has been among the top priorities identified as key to building a dynamic, resilient, future-facing economy that provides quality jobs and reverses brain drain trends.</narrative>
    </description>
    <baseline year="2024">
     <comment>
      <narrative xml:lang="EN">No research papers on the impact of CI and communication materials</narrative>
     </comment>
    </baseline>
