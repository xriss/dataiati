      </comment>
     </target>
     <actual>
      <comment>
       <narrative xml:lang="EN">In progress</narrative>
      </comment>
     </actual>
    </period>
   </indicator>
   <indicator aggregation-status="1" ascending="0" measure="5">
    <title>
     <narrative xml:lang="EN">Supported networking and partnerships within different sectors in the area of CI</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">Support to networking and partnerships within different sectors in the area of creative industries such as film, gaming, music, createch, innovation, AI, education (support in cooperation with individuals in these sectors, research, event organization etc.)</narrative>
    </description>
