  <title>
   <narrative xml:lang="EN">Strengthening the transformation of gender dynamics for equitable decision-making processes &amp; econ. empowerment of women</narrative>
  </title>
  <description type="1">
   <narrative xml:lang="EN">Changing gender dynamics for equitable decision-making and economic empowerment of women in Teso and Karamoja</narrative>
  </description>
  <description type="2">
   <narrative xml:lang="EN">Project objective: Gender equality in the target regions of Karamoja and Teso has been sustainably improved. 2,400 women and 3,500 girls in Teso and Karamoja sustainably improve their living conditions, use better quality MH, SRHR and PSEAH services and participate in decision-making processes.</narrative>
  </description>
  <description type="3">
   <narrative xml:lang="EN">The direct target group is 8,863 people which consists of 2,400 women and 3,500 girls as well as 960 men and 500 boys in the project regions of Teso and Karamoja.</narrative>
  </description>
  <participating-org ref="DE-1" role="1" type="10">
