  <title>
   <narrative xml:lang="EN">Verbesserung des Lebensstandards der von Konflikten betroffenen Menschen in Nordwestsyrien</narrative>
  </title>
  <description type="3">
   <narrative xml:lang="EN">366750</narrative>
