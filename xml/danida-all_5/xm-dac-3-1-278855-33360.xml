  <result type="2">
   <title>
    <narrative xml:lang="EN">Increased empowerment and resilience of refugees and sex workers regarding 
SRHR in the project supported districts in northern and central Uganda</narrative>
   </title>
   <reference code="272662" vocabulary="99"></reference>
   <indicator aggregation-status="0" ascending="1" measure="1">
    <title>
     <narrative xml:lang="EN">Total number of people benefitting from the project interventions in terms of SRHR
(disaggregated by age, gender, occupation and refugee status) in relation to SRHR
information and services</narrative>
    </title>
    <period>
     <period-start iso-date="2021-01-01"></period-start>
     <period-end iso-date="2021-12-31"></period-end>
     <target value="[Intended situation by the end of engagement (phase)] TBD"></target>
     <actual value="Integrated SRH services were delivered to 84,634 beneficiaries, against the target of 57, 600. Target was achieved by 147%.
&#x2022; 362 outreaches were conducted in communities and refugee settlements
&#x2022; 438,129 SRH services enabled; 23% of the SRH were FP, 28% HIV services, 27% STIs, 5% SGBV and 17% for gynaecological services including cervical cancer screening, and comprehensive abortion care.
&#x2022; 31% of clients served were refugees, the remaining 69% were from other vulnerable populations including sex workers, teenage mothers, young people and urban poor.
&#x2022; 53% of services were through outreaches, 42% static clinic and 5% through information services by community resource persons."></actual>
    </period>
   </indicator>
