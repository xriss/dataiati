  <result type="1">
   <title>
    <narrative xml:lang="EN">Strengthened local capacity for planning, implementation and monitoring of policies and programmes to address sexual and reproductive health and rights for the target population in the selected project counties.</narrative>
   </title>
   <reference code="277676" vocabulary="99"></reference>
   <indicator aggregation-status="0" ascending="0" measure="1">
    <title>
     <narrative xml:lang="EN">Availability of data and information on knowledge, attitude and practices of SRHR among the target population.</narrative>
    </title>
    <period>
     <period-start iso-date="2020-01-01"></period-start>
     <period-end iso-date="2020-12-31"></period-end>
     <target value="Review report available on existing health information and manage-ment system (HIMS) data on SRH service utilization and provides concrete recommendations for data disaggregation by age, sex, location and ethnicity."></target>
     <actual value="A rapid review was conducted to assess the health information and manage-ment system (HIMS) data on SRH service utilization with observations and rec-ommendations on data collection and disaggregation. The report will be finalized in Q1 2021."></actual>
    </period>
    <period>
     <period-start iso-date="2019-01-01"></period-start>
     <period-end iso-date="2019-12-31"></period-end>
     <target value="Project baseline survey conducted and data available for
programming."></target>
     <actual value="A university was selected
for a baseline survey.
After a field visit to
four counties between
15 November and 4
December, the baseline
survey was completed
and data is available for
programming."></actual>
    </period>
    <period>
     <period-start iso-date="2022-01-01"></period-start>
     <period-end iso-date="2022-12-31"></period-end>
     <target value="Baseline survey and health information and manage-ment system (HIMS) review available. The advocacy activities conducted for availability and utilization of SRH service data."></target>
     <actual value="Baseline survey on SRHR knowledge and services conducted in 2019. Review of HIMS conducted in 2020. The review report was finalized and one seminar with local stakeholders was conducted to distribute the review results."></actual>
    </period>
    <period>
     <period-start iso-date="2021-01-01"></period-start>
     <period-end iso-date="2021-12-31"></period-end>
     <target value="The advocacy activities conducted for utilization of SRH service data"></target>
     <actual value="The review report was finalized and one seminar with local stakeholders was conducted to distribute the review results."></actual>
    </period>
    <period>
     <period-start iso-date="2018-01-01"></period-start>
     <period-end iso-date="2018-12-31"></period-end>
     <target></target>
     <actual></actual>
    </period>
   </indicator>
  </result>
