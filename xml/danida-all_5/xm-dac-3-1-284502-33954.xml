  <result type="2">
   <title>
    <narrative xml:lang="EN">To pilot a transitional program centered on providing individualized support to each eligible returnee from Denmark so that each beneficiary achieves a safe transition into Afghan society.</narrative>
   </title>
   <reference code="270015" vocabulary="99"></reference>
   <indicator aggregation-status="0" ascending="1" measure="1">
    <title>
     <narrative xml:lang="EN">100% of returnees referred from Denmark achieve successful reintegration or are on track to successful reintegration into Afghan society This includes PSN who are eligible for permanent residency and assistance from the Afghan government.</narrative>
    </title>
    <period>
     <period-start iso-date="2022-01-01"></period-start>
     <period-end iso-date="2022-12-31"></period-end>
     <target value="30"></target>
     <actual value="N/A"></actual>
    </period>
   </indicator>
  </result>
  <result type="1">
   <title>
    <narrative xml:lang="EN">To develop the requisite infrastructure to implement a pilot program.</narrative>
   </title>
   <reference code="270016" vocabulary="99"></reference>
   <indicator aggregation-status="0" ascending="1" measure="1">
    <title>
     <narrative xml:lang="EN">1.	Establish residences and training facilities at ARCS through renovation of existing sites.
2.	Develop the complete program and produce a manual for program implementation.
3.	Hire, induct and train staff and set up program reporting and management mechanisms.
4.	Set up training program for economic development and SME development including 6 functional small businesses on site and linkages to other vocational training facilities.</narrative>
    </title>
    <period>
     <period-start iso-date="2021-01-01"></period-start>
     <period-end iso-date="2021-12-31"></period-end>
