     <actual value="No result for year 2023."></actual>
    </period>
   </indicator>
  </result>
  <result type="2">
   <title>
    <narrative xml:lang="EN">Human rights are integrated in UN and non-UN peace operations through capacity building activities of PMSS contributing to the protection of civilians and better compliance with international human rights and humanitarian law frameworks.</narrative>
   </title>
   <reference code="276351" vocabulary="99"></reference>
   <indicator aggregation-status="0" ascending="1" measure="1">
    <title>
     <narrative xml:lang="EN">Human rights are integrated into the peace and security agenda of regional and subregional organizations, including by operationalizing Africa Union&apos;s Compliance Framework (AUCF).</narrative>
    </title>
    <period>
     <period-start iso-date="2024-01-01"></period-start>
     <period-end iso-date="2024-12-31"></period-end>
     <target value="Policies and practices developed and operationalised."></target>
     <actual value="Policies developed by PMSS, which provide concrete operational and tactical tools that integrate human rights and IHL standards into AU-led missions."></actual>
    </period>
