  <result type="1">
   <title>
    <narrative xml:lang="EN">OHCHR PMSS engagement and support enhances ownership by the AU Peace and Security Council and the AU Peace Support Operations Division of the AUCF.</narrative>
   </title>
   <reference code="276350" vocabulary="99"></reference>
   <indicator aggregation-status="0" ascending="1" measure="1">
    <title>
     <narrative xml:lang="EN">Number of policies developed or refined</narrative>
    </title>
    <period>
     <period-start iso-date="2024-01-01"></period-start>
     <period-end iso-date="2024-12-31"></period-end>
     <target value="OHCHR PMSS technical support and military advice to the AUCF Project Team results in at least 2 AU policies, operational and tactical guidance tools being refined or newly developed to include compliance framework elements."></target>
     <actual value="2 foundational policies developed with PMSS technical  support: one on the Protection of Civilians and another on the Selection and Screening of personnel for African Union Peace Supports Operations. The two policies were formally adopted by the AU."></actual>
    </period>
    <period>
     <period-start iso-date="2023-01-01"></period-start>
