   <title>
    <narrative xml:lang="EN">Sustainability of garden coffee value chain is secured</narrative>
   </title>
   <reference code="271944" vocabulary="99"></reference>
   <indicator aggregation-status="0" ascending="1" measure="1">
    <title>
     <narrative xml:lang="EN">Economic profitability of cooperatives</narrative>
    </title>
    <period>
     <period-start iso-date="2022-01-01"></period-start>
     <period-end iso-date="2022-12-31"></period-end>
     <target value="N/A"></target>
     <actual value="Annual profit of cooperatives is to be finalized; on cooperative member level, income increased by 43,5 % in 2022 (preliminary, average value from 2 cooperatives)"></actual>
    </period>
    <period>
     <period-start iso-date="2021-01-01"></period-start>
     <period-end iso-date="2021-12-31"></period-end>
     <target value="N/A"></target>
     <actual value="Annual profit of farmers increased by approximately 8.6%, based on anecdotal evidence. Farmers have an increased market access owing to formal set up of cooperatives."></actual>
    </period>
    <period>
     <period-start iso-date="2023-01-01"></period-start>
     <period-end iso-date="2023-12-31"></period-end>
     <target value="Annual profit of cooperatives has been increased by 150%, compared to baseline (2019)."></target>
     <actual value="Cooperative income increased by 233% (from 63.53 ETB/kg for Grade 5 coffee in 2019 to 211.76 ETB/kg for Grade 1-3 coffee in 2022)"></actual>
    </period>
    <period>
     <period-start iso-date="2020-01-01"></period-start>
     <period-end iso-date="2020-12-31"></period-end>
     <target value="N/A"></target>
     <actual value="Eight cooperatives were established in 2020. Their starting annual profit is 0 ETB."></actual>
    </period>
    <period>
     <period-start iso-date="2019-01-01"></period-start>
     <period-end iso-date="2019-12-31"></period-end>
     <target value="Annual profit of cooperatives has been X ETB (70 ETB/ kg green coffee"></target>
     <actual value="The annual profit of cooperatives has not been established yet."></actual>
    </period>
   </indicator>
  </result>
