  <title xml:lang="EN">
   <narrative xml:lang="EN">C40 Accelerating Climate Action in Large Cities in Africa and South Asia</narrative>
  </title>
  <description type="2" xml:lang="EN">
   <narrative xml:lang="EN">Contribute to resilient, low-carbon cities in developing countries through the reduction of greenhouse gas emissions and enhanced climate risk resilience in C40 member cities in the global South, with a particular attention to countries in Africa.</narrative>
  </description>
