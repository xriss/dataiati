  <related-activity ref="XM-DAC-3-1-273894" type="1"></related-activity>
  <result type="1">
   <title>
    <narrative xml:lang="EN">Output 1: A strong, growing and widely used Knowledge Management System and learning support program</narrative>
   </title>
   <reference code="277896" vocabulary="99"></reference>
   <indicator aggregation-status="0" ascending="0" measure="1">
    <title>
     <narrative xml:lang="EN">Reported and measurable increase in use and function of the Knowledge Management System including through number of records/number of unique visitors, and reported and measurable increase in reach of e-learning activities documented by number of webinars held/participant attendance levels</narrative>
    </title>
    <period>
     <period-start iso-date="2019-01-01"></period-start>
     <period-end iso-date="2019-12-31"></period-end>
     <target value="Increase in number of KMS records/unique visitors and webinars/number of participants"></target>
     <actual value="CCEE has delivered an inception report on future project implementation, developed a list of government and city activities, developed an online tool to collect building-level data, collected good practices in cities with a least 30 cases (now available online on KMS), has produced Green Homes Investment Platform (available as part
of the knowledge Management System), delivered 5 situation assessments on energy efficiency in different
jurisdictions and/or sectors, 2 thematic briefs on energy efficiency issues, and published 1 journal or conference paper."></actual>
    </period>
    <period>
     <period-start iso-date="2021-01-01"></period-start>
     <period-end iso-date="2021-12-31"></period-end>
     <target value="Increase in number of KMS records/unique visitors and webinars/number of participants"></target>
     <actual value="CCEE has delivered the Implementation plan of the Kenya National Strategy
for Energy Efficiency and Conservation, 1 conference paper in the Energy Policy Journal, 1 report on best practices for city level EE investments, 1 guide on innovative business models and financing
for energy efficiency. Further, CCEE also delivered a special issue in the journal Energy Policy, 2 issue briefs and 1 journal article in 2022."></actual>
    </period>
    <period>
     <period-start iso-date="2020-01-01"></period-start>
     <period-end iso-date="2020-12-31"></period-end>
     <target value="Increase in number of KMS records/unique visitors and webinars/number of participants"></target>
     <actual value="CCEE has published a book &quot;EE in developing countries&quot;, developed financial models and tools for EE, published a global ESCO report and has collected additional 20 cases of good practices in cities."></actual>
    </period>
   </indicator>
  </result>
  <result type="1">
   <title>
    <narrative xml:lang="EN">Identified opportunities and developed concept proposals for bundled/aggregated investment projects through direct engagements with countries (at national and subnational levels)</narrative>
   </title>
   <reference code="277898" vocabulary="99"></reference>
   <indicator aggregation-status="0" ascending="0" measure="1">
    <title>
     <narrative xml:lang="EN">Number of engagements</narrative>
    </title>
    <period>
     <period-start iso-date="2019-01-01"></period-start>
     <period-end iso-date="2019-12-31"></period-end>
     <target value="Three new engagements that lead to development of energy efficiency investment city aggregation project proposals"></target>
     <actual value="CCEE has delivered an inception report on future project implementation, established a global ESCO network and created a framework for global mapping of legislation that supports ESCO-based EE investments."></actual>
    </period>
    <period>
     <period-start iso-date="2020-01-01"></period-start>
     <period-end iso-date="2020-12-31"></period-end>
     <target value="Four new engagements that lead to development of energy efficiency investment city aggregation project proposals"></target>
     <actual value="CCEE has engaged with countries and has reporting on virtual training with representatives from several Latin American municipalities, has signed a collaboration agreement between C2E2 and the state-owned Electridade de
Mocambique. C2E2 has also developed a Sourcebook on Upscaling EE in municipalities through project bundling and has developed tools for EE appraisal."></actual>
    </period>
    <period>
     <period-start iso-date="2021-01-01"></period-start>
     <period-end iso-date="2021-12-31"></period-end>
     <target value="Five new engagements that lead to development of energy efficiency investment city aggregation project proposals"></target>
     <actual value="In 2021 and 2022 combined, Amongst others, CCEE has signed collaboration deals with the association of municipalities of
Panama and the Municipality of Montevideo, Uruguay, has provided training on EE to East African countries and has produced various assessments of opportunities for EE in Panama, the MENA region, Ukraine and Mongolia."></actual>
    </period>
   </indicator>
  </result>
