  <result type="1">
   <title>
    <narrative xml:lang="EN">4.3 Review legislation, make suggestions for new legislation within the ports/terminals sector.</narrative>
   </title>
   <reference code="275682" vocabulary="99"></reference>
   <indicator aggregation-status="0" ascending="1" measure="1">
    <title>
     <narrative xml:lang="EN">4.3.a Status on policy work.</narrative>
    </title>
    <period>
     <period-start iso-date="2023-01-01"></period-start>
     <period-end iso-date="2023-12-31"></period-end>
     <target value="4.3.a Provide expertise and recommendation to key government authorities to develop standard engagement and guidance tools for local adaptation for implementing corruption free seaports and trade corridors."></target>
     <actual value="As part of reviewing national maritime laws and practices, MACN, with a local consultant, created a &#x201c;White Paper on Integrity Risks and Gaps in the Ukrainian Maritime Sector.&#x201d;"></actual>
    </period>
    <period>
     <period-start iso-date="2022-01-01"></period-start>
     <period-end iso-date="2022-12-31"></period-end>
     <target value="4.3.a. Dialogue initiated to translate key maritime legislations (existing and new) and disseminate it to the industry in the form of an Industry Guides is on hold - Recommendation to relevant government authorities to improve and align maritime legislation and practices to international standards based on integrity gap assessment is on hold."></target>
     <actual value="Not achieved."></actual>
    </period>
    <period>
     <period-start iso-date="2021-01-01"></period-start>
     <period-end iso-date="2021-12-31"></period-end>
     <target value="4.3.a. Update existing MACN Ukraine toolkit and Port call guides for companies calling Ukrainian ports."></target>
     <actual value="Target achieved. Risk assessment of port related challenges initiated, and Integrity Tools were revised and updated. This led to the development of Member Guides and a Handbook for Ukraine&apos;s port industry in collaboration with European Business Association (EBA).
Proposal letter submitted to align maritime legislation and practices to EU and International standards."></actual>
    </period>
   </indicator>
