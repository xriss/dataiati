  <result type="1">
   <title>
    <narrative xml:lang="EN">Briefings, Events, and Roundtable Discussions on the impact of development policies and multilateral cooperation to developing countries.</narrative>
   </title>
   <reference code="268074" vocabulary="99"></reference>
   <indicator aggregation-status="0" ascending="0" measure="1">
    <title>
     <narrative xml:lang="EN">Continued discussions on successful development policies and multilateral cooperation to support the achievement of the SDGs, and help mitigate factors that encourage poverty and conflict, by producing new policy ideas that consider the perspectives of multiple stakeholders in the field, address gaps, and find evidence-based solutions.</narrative>
    </title>
    <period>
     <period-start iso-date="2020-01-01"></period-start>
     <period-end iso-date="2020-12-31"></period-end>
     <target value="A minimum of two workshops or events that provide participants with evidence-based analysis and policy approaches for addressing challenges to multilateral cooperation and sustainable development."></target>
     <actual value="Achieved"></actual>
    </period>
    <period>
     <period-start iso-date="2021-01-01"></period-start>
     <period-end iso-date="2021-12-31"></period-end>
     <target value="Continued from above."></target>
     <actual value="Achieved"></actual>
    </period>
   </indicator>
  </result>
  <result type="1">
   <title>
    <narrative xml:lang="EN">Knowledge dissemination via publications and commentary</narrative>
   </title>
   <reference code="268076" vocabulary="99"></reference>
   <indicator aggregation-status="0" ascending="0" measure="1">
    <title>
     <narrative xml:lang="EN">Provide timely and relevant policy recommendations that examine how the problems affecting vulnerable and poor communities can be addressed, especially with regard to threats from climate change or geopolitical competition, and what workable solutions could be implemented by multilateral and development actors.</narrative>
    </title>
    <period>
     <period-start iso-date="2020-01-01"></period-start>
     <period-end iso-date="2020-12-31"></period-end>
     <target value="Brookings scholars will produce series of publicly available blog posts, op-eds, essays, and papers on issues related to poverty reduction, conflict mitigation, climate change, geopolitical competition, and multilateral institutions."></target>
     <actual value="Achieved"></actual>
    </period>
    <period>
     <period-start iso-date="2021-01-01"></period-start>
     <period-end iso-date="2021-12-31"></period-end>
