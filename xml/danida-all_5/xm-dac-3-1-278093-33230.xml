  <title xml:lang="EN">
   <narrative xml:lang="EN">18-PBSP &#x2013; Sustainable Integration of Philippine Smallholder Farmers into the Global Cacao Value Chain</narrative>
  </title>
  <description type="2" xml:lang="EN">
   <narrative xml:lang="EN">The objective is to create sustainable income opportunities for smallholder farmers in the Phillipines by developing a more robust and diversified agri industry based on sourcing from smallholders.</narrative>
  </description>
