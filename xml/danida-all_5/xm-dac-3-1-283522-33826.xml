  <title xml:lang="EN">
   <narrative xml:lang="EN">Evaluation of the Danish Support for Climate Change Adaptation in Developing Countries</narrative>
  </title>
  <description type="2" xml:lang="EN">
   <narrative xml:lang="EN">The overall theme for the evaluation will be to examine how and to what extent the Danish development aid portfolio is addressing longer-term resilience in the target countries, and to identify mechanisms that have been successful in this respect</narrative>
  </description>
