  <title xml:lang="EN">
   <narrative xml:lang="EN">IPPF project Geneva Friendship Retreat 2018-20</narrative>
  </title>
  <description type="2" xml:lang="EN">
   <narrative xml:lang="EN">The project sets out to provide, through the organisation of an annual friendship retreat, an ongoing space for human rights experts in Geneva to learn about key issues on sexual and reproductive health and rights (SRHR) and strengthen working relationships with delegates from other countries.</narrative>
  </description>
