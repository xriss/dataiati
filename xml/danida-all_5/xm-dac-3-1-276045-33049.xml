  <result type="2">
   <title>
    <narrative xml:lang="EN">A larger cohort of member state delegations supporting SRHR at the United Nations in Geneva</narrative>
   </title>
   <reference code="266016" vocabulary="99"></reference>
   <indicator aggregation-status="0" ascending="0" measure="1">
    <title>
     <narrative xml:lang="EN">% of FG middle ground delegations that actively support SRHR-related language in key negotiations within 12 months of participating in FG retreat.</narrative>
    </title>
    <period>
     <period-start iso-date="2021-01-01"></period-start>
     <period-end iso-date="2021-12-31"></period-end>
     <target value="64% (21 out of 33) middle ground delegations actively support SRHR-related language in key negotiations within 12 months of participating in the retreat."></target>
     <actual value="Target achieved."></actual>
    </period>
   </indicator>
  </result>
