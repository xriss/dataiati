  <title xml:lang="EN">
   <narrative xml:lang="EN">CKU CKU-fund (2019-ongoing) - Center for Church-Based Development (CKU) CKU-fund 2019-ongoing</narrative>
  </title>
  <description type="2" xml:lang="EN">
   <narrative xml:lang="EN">The primary objective of the CKU Fund is to support projects implemented in partnership between CKU&#x2019;s Danish member organisations and their local faith-based partners. Support is granted to projects that seek to create meaningful changes and development in local societies.</narrative>
  </description>
