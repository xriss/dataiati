  <result type="1">
   <title>
    <narrative xml:lang="EN">Awareness and exposure of the Danish Government policy practices and de-risking process for offshore wind development raised within the National Energy Administration and associated authorities.</narrative>
   </title>
   <reference code="270933" vocabulary="99"></reference>
   <indicator aggregation-status="0" ascending="1" measure="1">
    <title>
     <narrative xml:lang="EN">Improved capacity within partner organizations/institutions tasked with regulation of Marine Spatial Planning</narrative>
    </title>
    <period>
     <period-start iso-date="2019-01-01"></period-start>
     <period-end iso-date="2019-12-31"></period-end>
     <target value="baseline"></target>
     <actual value="0"></actual>
    </period>
    <period>
     <period-start iso-date="2020-01-01"></period-start>
     <period-end iso-date="2020-12-31"></period-end>
     <target value="Improved capacity within partner organizations/institutions tasked with regulation of Marine Spatial Planning"></target>
     <actual value="Report from a consultancy firm was finalized in 2020 and will be presented at a workshop early 2021"></actual>
    </period>
    <period>
     <period-start iso-date="2021-01-01"></period-start>
     <period-end iso-date="2021-12-31"></period-end>
     <target value="Improved capacity within partner organizations/institutions tasked with regulation of Marine Spatial Planning"></target>
     <actual value="The final work and report related to the MSP is finalized by local consultants at Azure International. The result highlight the most optimal near and far-shore areas of mainland China. Several workshops have been held to present the findings to our partners at CREEI and the Provincial Energy Bureaus (PEB) in Guangdong, Jiangsu, and Zhejiang."></actual>
    </period>
   </indicator>
  </result>
  <result type="1">
   <title>
    <narrative xml:lang="EN">Technical inputs to support the National Energy Administration/Provinces in best practices in tendering a full-scale offshore wind farm</narrative>
   </title>
   <reference code="270934" vocabulary="99"></reference>
   <indicator aggregation-status="0" ascending="1" measure="1">
    <title>
     <narrative xml:lang="EN">Scope of tendering practices and necessary support requirements from the central and local government has been established</narrative>
    </title>
    <period>
     <period-start iso-date="2020-01-01"></period-start>
     <period-end iso-date="2020-12-31"></period-end>
     <target value="Scope of tendering practices and necessary support requirements from the central and local government has been established"></target>
     <actual value="Activity is ongoing
Consultancy on the MSP work is finalized and ready to be used for future strategic engagements in China
Priority provinces are being defined and provincial outreach and visits will be utilized during 2021"></actual>
    </period>
    <period>
     <period-start iso-date="2021-01-01"></period-start>
     <period-end iso-date="2021-12-31"></period-end>
     <target value="Scope of tendering practices and necessary support requirements from the central and local government has been established."></target>
     <actual value="The DEA has been in dialogue with relevant stakeholders to locate a proper site for a Sino-Danish demonstration project, with the aim of securing a best practice Sino-Danish demonstration project in cooperation with NEA and/or relevant Provincial Energy Bureaus in the coastal provinces. This output is tainted by the fact that the interest in China on the side of Danish developer companies is limited."></actual>
    </period>
   </indicator>
  </result>
