  <result type="1">
   <title>
    <narrative xml:lang="EN">Resultat 2
(revideret logframe- COVID-19)</narrative>
   </title>
   <reference code="274763" vocabulary="99"></reference>
   <indicator aggregation-status="0" ascending="1" measure="1">
    <title>
     <narrative xml:lang="EN">8 sundhedsklinikker har forbedret kapacitet til at h&#xe5;ndtere COVID-19, kolera og andre sundhedsproblemer</narrative>
    </title>
    <period>
     <period-start iso-date="2020-01-01"></period-start>
     <period-end iso-date="2020-12-31"></period-end>
     <target value="8 sundhedsklinikker har forbedret kapacitet til at h&#xe5;ndtere COVID-19, kolera og andre sundhedsproblemer"></target>
     <actual value="8 sundhedsklinikker inkl. 5 landdistriktshospitaler, 2 isolationscentre og 1 karant&#xe6;necenter i Amran by samt 5 distrikter (Khamer, Al-Soud, Al-Madan, Maswar, Habor Zulima og Al-Qafla har forbedret kapacitet  bl.a. solceller til elektricitet, generatorer, airconditionanl&#xe6;g, WASH-faciliteter, 5 sm&#xe5;, mobile sundhedsklinikker til landomr&#xe5;der, indhegning til isolation og andet udstyr inkl. v&#xe6;rnemidler mm.. For-bedring af vandforsyningssystemer, istands&#xe6;ttelse af latriner, installa-tion af mobile latriner, installation af h&#xe5;ndvaskefaciliteter, levering og installation af vandlagertanke, levering af reng&#xf8;ringss&#xe6;t til latri-ner; forbedring af de medicinske faciliteter, levering af sanitetsudstyr, levering af klimaanl&#xe6;g, levering af iltflasker til medicinsk brug, leve-ring af medicinske senge og levering af br&#xe6;ndstof."></actual>
    </period>
    <period>
     <period-start iso-date="2019-01-01"></period-start>
     <period-end iso-date="2019-12-31"></period-end>
     <target value="N/A"></target>
     <actual value="N/A"></actual>
    </period>
   </indicator>
  </result>
  <result type="1">
   <title>
    <narrative xml:lang="EN">Resultat (output) 1</narrative>
   </title>
   <reference code="274762" vocabulary="99"></reference>
   <indicator aggregation-status="0" ascending="1" measure="1">
    <title>
     <narrative xml:lang="EN">13.689 elever og l&#xe6;rere har f&#xe5;et &#xf8;get adgang til WASH-faciliteter p&#xe5; 29 skoler</narrative>
    </title>
    <period>
     <period-start iso-date="2019-01-01"></period-start>
     <period-end iso-date="2019-12-31"></period-end>
     <target value="N/A"></target>
     <actual value="N/A"></actual>
    </period>
    <period>
     <period-start iso-date="2020-01-01"></period-start>
     <period-end iso-date="2020-12-31"></period-end>
     <target value="13.689 elever og l&#xe6;rere har f&#xe5;et &#xf8;get adgang til WASH-faciliteter p&#xe5; 29 skoler"></target>
     <actual value="Oxfam oversteg det fastsatte antal modtagere ved at n&#xe5; ud til i alt 15.689 personer med adgang til WASH-faciliteter (7.060 piger og 8.629 drenge). Elever og l&#xe6;rere p&#xe5; 29 skoler fik bedre adgang til en sikker skole gennem bedre WASH-faciliteter i Amran bl.a. blev 13 skoler forbundet til eksisterende vandforsyningssystemer og 17 sko-ler, hvor der ikke var adgang til vand fik installeret vandtanke (15.000 &#x2013; 20.000 l.), hvilket forventes at kunne give skolerne nok vand i peri-oder uden regn. Flere fik installeret nye soldrevne pumper. 34 latri-ner blev bygget p&#xe5; skoler uden latriner og 147 latriner blev repareret p&#xe5; 26 skoler; 90 h&#xe5;ndvaske bygget eller repareret mm. Disse blev alle installeret med blik for beskyttelse af piger og kvinder."></actual>
    </period>
   </indicator>
  </result>
