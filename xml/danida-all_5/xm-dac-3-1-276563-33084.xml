  <result type="1">
   <title>
    <narrative xml:lang="EN">Resultat 3
(revideret logframe &#x2013; CO-VID-19)</narrative>
   </title>
   <reference code="274764" vocabulary="99"></reference>
   <indicator aggregation-status="0" ascending="1" measure="1">
    <title>
     <narrative xml:lang="EN">Internt fordrevne og v&#xe6;rtsamfundene har forbedret adgang til f&#xf8;devarer og WASH</narrative>
    </title>
    <period>
     <period-start iso-date="2020-01-01"></period-start>
     <period-end iso-date="2020-12-31"></period-end>
     <target value="Internt fordrevne og v&#xe6;rtsesamfund- har forbedret adgang til f&#xf8;devarer og WASH"></target>
     <actual value="13.426 IDPs i IDPs lejre i Huth, Khamer og Al-Qafla distrikter og 42.000 mennesker i Khamer By fik bedre adgang til vand blandt an-det gennem WASH (vandtanke, latriner, hygiejnepakker; br&#xe6;ndstof til de lokale vandforsyningsmyndigheder, der muliggjorde sikkert vand til 42.000 mennesker i en to m&#xe5;neder periode m.m.) Forbedring af vandforsyning i Khamer, til ialt10.500 mennesker (4.850 K og 5.650 M). Derudover gennemf&#xf8;rtes 75 affaldskampagner, som for-bedrede affaldsh&#xe5;ndteringen i Khamir, Huth og Bani Suraim og n&#xe5;e-de 35.630 personer i b&#xe5;de flygtningelejre og v&#xe6;rtssamfund, og 13.181 internt fordrevne modtog en kontantudbetaling (65,000 YR) til mad og andre basale behov. Forbedringer i vandforsyningen i Hajjah, herunder b&#xe5;de direkte vandleverancer samt installation af en solcelledrevet vandpumpe p&#xe5; et vandv&#xe6;rk, i alt 28,067 personer (b&#xe5;de internt fordrevne og v&#xe6;rtsamfund), heraf ca. 51% kvinder."></actual>
    </period>
    <period>
     <period-start iso-date="2019-01-01"></period-start>
     <period-end iso-date="2019-12-31"></period-end>
     <target value="N/A"></target>
     <actual value="N/A"></actual>
    </period>
