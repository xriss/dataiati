   <title>
    <narrative xml:lang="EN">Local employment partnerships (LEPs) are signed and implemented</narrative>
   </title>
   <reference code="270681" vocabulary="99"></reference>
   <indicator aggregation-status="0" ascending="1" measure="1">
    <title>
     <narrative xml:lang="EN">Number of LEPs facilitated; 
Number of beneficiaries reached through the employment partnerships (at least 50% women, at least 40% youth)</narrative>
    </title>
    <period>
     <period-start iso-date="2018-01-01"></period-start>
     <period-end iso-date="2018-12-31"></period-end>
     <target value="Two pilot regions selected.
Two local territorial diagnostics conducted with the aim of identifying sectors with high job creation potential and the service lines to be established.
Two training seminars conducted for local partners of LEPs"></target>
     <actual value="- Rivne and Kherson selected for the first two years. Based on agreed criteria and level of development of social partners.
- Completed.
- Three trainings delivered on LEP concept. *its benefits as well as requirements in terms of stakeholders representation."></actual>
    </period>
   </indicator>
  </result>
