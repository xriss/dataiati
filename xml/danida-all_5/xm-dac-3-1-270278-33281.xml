  <related-activity ref="XM-DAC-3-1-270278" type="1"></related-activity>
  <result type="1">
   <title>
    <narrative xml:lang="EN">Construction of a sustainable physical infrastructure of the IND HQ for the Federal Government of Somalia that meets international standards.</narrative>
   </title>
   <reference code="271901" vocabulary="99"></reference>
   <indicator aggregation-status="0" ascending="1" measure="1">
    <title>
     <narrative xml:lang="EN">Completion of UNOPS detailed designs incorporating green building and green technology standards in accordance with environmentally sustainable methods. Completion of construction of the IND.Building is able to accommodate 260 IND staff comfortably. The building is fitted with the required electrical and water installations necessary for full operational use. The building is constructed in accordance with national and international building standards and codes. All external works and installations are in place and operational.</narrative>
    </title>
    <period>
     <period-start iso-date="2021-01-01"></period-start>
     <period-end iso-date="2021-12-31"></period-end>
     <target value="Finalised contruction"></target>
     <actual value="100 /"></actual>
    </period>
    <period>
     <period-start iso-date="2019-01-01"></period-start>
     <period-end iso-date="2019-12-31"></period-end>
     <target value="25 % of project completed"></target>
     <actual value="25 % completed"></actual>
    </period>
    <period>
     <period-start iso-date="2020-01-01"></period-start>
     <period-end iso-date="2020-12-31"></period-end>
     <target value="75 % completed"></target>
     <actual value="60 % completed"></actual>
    </period>
    <period>
     <period-start iso-date="2022-01-01"></period-start>
     <period-end iso-date="2022-12-31"></period-end>
     <target value="Handover and inauguration of the facility to the Federal Authorities."></target>
     <actual value="Handover officiated in Nov 2022 and now hosts 260 IND staff."></actual>
    </period>
    <period>
     <period-start iso-date="2018-01-01"></period-start>
     <period-end iso-date="2018-12-31"></period-end>
     <target value="Construction commenced and proceding as planned."></target>
     <actual value="on track"></actual>
    </period>
   </indicator>
  </result>
  <result type="2">
   <title>
    <narrative xml:lang="EN">Improved working environment for the immigration &amp; Naturalisation Directorate which strenghtens its capacity to deliver on its mandate to its citizens.</narrative>
   </title>
   <reference code="271900" vocabulary="99"></reference>
   <indicator aggregation-status="0" ascending="1" measure="1">
    <title>
     <narrative xml:lang="EN">Registered entry and exits to Somalia are more efficiently recorded than before this project. Immigration crimes are prevented and detected more efficiently. Passports, identity cards and travel documents are processed and issued more speedily. Increased efficiency of admission and readmission of nationals by 50 % into Somalia.</narrative>
    </title>
    <period>
     <period-start iso-date="2022-01-01"></period-start>
     <period-end iso-date="2022-12-31"></period-end>
     <target value="Official handover and inauguration of Immigration HQ to Federal Authorities for use."></target>
     <actual value="Official handover and inauguration of Immigration HQ took place in Nov 2022."></actual>
