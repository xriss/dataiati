  <result type="1">
   <title>
    <narrative xml:lang="EN">Reduced time or cost for border compliance or documentary compliance</narrative>
   </title>
   <reference code="268874" vocabulary="99"></reference>
   <indicator aggregation-status="0" ascending="1" measure="1">
    <title>
     <narrative xml:lang="EN">Number of projects, which resulted in reduced time or cost for border compliance or documentary compliance</narrative>
    </title>
    <period>
     <period-start iso-date="2020-01-01"></period-start>
     <period-end iso-date="2020-12-31"></period-end>
     <target value="2 projects resulting in increased predictability regarding time of border compliance."></target>
     <actual value="1 project (Colombia) in 2020."></actual>
    </period>
    <period>
     <period-start iso-date="2021-01-01"></period-start>
     <period-end iso-date="2021-12-31"></period-end>
     <target value="2 projects completed, which resulted in increased predictability regarding time of border compliance"></target>
     <actual value="2 projects (Colombia and Brazil)."></actual>
    </period>
    <period>
     <period-start iso-date="2022-01-01"></period-start>
     <period-end iso-date="2022-12-31"></period-end>
     <target value="2 projects completed that resulted in increased predictability regarding time of border compliance."></target>
     <actual value="9 projects in 2022 (Actual realized savings, Morocco and Senegal. Projected savings  Jordan, Tunisia, Ecuador, Bangladesh, Madagascar, Senegal and Thailand)."></actual>
    </period>
   </indicator>
  </result>
