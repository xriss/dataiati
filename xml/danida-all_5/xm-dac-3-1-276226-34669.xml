  <result type="1">
   <title>
    <narrative xml:lang="EN">1. C-IED strategy for the IGAD region, October 2020-June 2022
2. Regional C-IED threat assessment
3. MS commitments to further development of national C-IED strategies and capabilities.
4. Capacity development of MS implemented.
5. Information system for formal and informal communication concerning the IED threat and countermeasure between MS in place.</narrative>
   </title>
   <reference code="271891" vocabulary="99"></reference>
   <indicator aggregation-status="0" ascending="1" measure="1">
    <title>
     <narrative xml:lang="EN">Strategy endorsement by IGAD member states</narrative>
    </title>
    <period>
     <period-start iso-date="2020-01-01"></period-start>
     <period-end iso-date="2020-12-31"></period-end>
     <target value="Initiate IGAD  comprehensive C-IED strategy"></target>
     <actual value="No data or information available as engagement started in Dec. 2020."></actual>
    </period>
    <period>
     <period-start iso-date="2021-01-01"></period-start>
     <period-end iso-date="2021-12-31"></period-end>
     <target value="Approved threat assessment"></target>
     <actual value="Threat assessment has not been finalized, and will be finalized in the last quarter of the engagement, however continued monitoring and analysis of the threat assessment continues. The compilation of the threat assessment is a continuous endeavour and was presented at the TCM meetings. The mapping of of Al-Shabaab structure and amniyat dept for IED production and activities has been completed and was presented to the member states at the 3rd TCM. in Feb 2022."></actual>
    </period>
    <period>
     <period-start iso-date="2022-01-01"></period-start>
     <period-end iso-date="2022-12-31"></period-end>
     <target value="Approved evidence-based C-IED strategy including capacity development and information system in place."></target>
     <actual value="Threat assessments have been submitted and are finalized on an ongoing basis. 4 quarterly Threat assessments have been received. The Regional strategy received approval at the the IGAD Ambassador&apos;s level, however the heads of state meeting was postponed to January 2023 for final ascension and ratification."></actual>
    </period>
    <period>
     <period-start iso-date="2023-01-01"></period-start>
     <period-end iso-date="2023-12-31"></period-end>
     <target value="No Cost Extension to allow for final approval/ascension of the Regional CIED Strategy"></target>
     <actual></actual>
    </period>
   </indicator>
  </result>
  <result type="2">
   <title>
    <narrative xml:lang="EN">The regional C-IED strategy developed and adopted at MS level based on guidance and benchmarks that MS have applied resulting in improved national C-IED strategies and capabilities, empowering them to institutionalize and operationalise the knowledge, capabilities and experiences that have been amassed in countering IEDs in the region.</narrative>
   </title>
   <reference code="271890" vocabulary="99"></reference>
   <indicator aggregation-status="0" ascending="1" measure="1">
    <title>
     <narrative xml:lang="EN">IGAD MS have developed an intergovernmental C-IED community of practice through information and intelligence sharing, joint analysis, cooperative planning and capacity development.</narrative>
    </title>
    <period>
     <period-start iso-date="2022-01-01"></period-start>
     <period-end iso-date="2022-12-31"></period-end>
     <target value="IGAD assumes ownership of the process and coordinaed C-IED capacity development of its MS; Imporved communication, both formal and informal within and between MS concerning the IED threat and countermeasures"></target>
     <actual></actual>
    </period>
    <period>
     <period-start iso-date="2023-01-01"></period-start>
     <period-end iso-date="2023-12-31"></period-end>
     <target value="Final approval/ascension of Regional CIED Strategy"></target>
     <actual></actual>
    </period>
   </indicator>
  </result>
