  <result type="1">
   <title>
    <narrative xml:lang="EN">New business model and adapted techniques (improved seeds, MIS and mobile payment) developed , tested and rolled out with PO&#x2019;s and their members in order to expand inclusive value chain development</narrative>
   </title>
   <reference code="271839" vocabulary="99"></reference>
   <indicator aggregation-status="0" ascending="1" measure="1">
    <title>
     <narrative xml:lang="EN">Inclusive business models are developed, tested and rolled out</narrative>
    </title>
    <period>
     <period-start iso-date="2021-01-01"></period-start>
     <period-end iso-date="2021-12-31"></period-end>
     <target value="N/A"></target>
     <actual value="In 2021, PO&#x2019;s contribution was 7454 &#x20ac; (compared to 1,179&#x20ac; in 2020) and OLVEA&#x2019;s contribution was 7774&#x20ac; (compared to 6,349 &#x20ac; in 2020) for the operation of the MIS. A provision of 20% of the Fund  has  been  made  to  cover  the  cost  of  running  the  MIS  (purchase, repair and maintenance of smartphone and equipment) to ensure the sustainable  use  of  the  MIS  after  the  project  ends. MIS  works  without subsidies"></actual>
    </period>
    <period>
     <period-start iso-date="2023-01-01"></period-start>
     <period-end iso-date="2023-12-31"></period-end>
     <target value="MIS is maintained without subsidies."></target>
     <actual value="MIS is maintained without subsidies on sesame and shea value chain. POs and OLVEA contribution was 52672&#x20ac; for the operation of the MIS. 8787 producers used the business for seeds and input. 3 POs used mobile payment."></actual>
    </period>
    <period>
     <period-start iso-date="2022-01-01"></period-start>
     <period-end iso-date="2022-12-31"></period-end>
     <target value="MIS is maintained without subsidies"></target>
     <actual value="MIS is maintained without subsidies on sesame and shea value chain. POs and OLVEA contribution was 52672&#x20ac; for the operation of the MIS. 8787 producers used the business for seeds and input. 3 POs used the mobile payment."></actual>
    </period>
    <period>
     <period-start iso-date="2019-01-01"></period-start>
     <period-end iso-date="2019-12-31"></period-end>
     <target value="The MIS business model is fully operational and initial subsidies are phased out"></target>
     <actual value="The MIS business model is operational with initial subsidies. This initial subsidy was phased out at 2019 with 50% purchase smartphones and 80% internet mobile for smartphones. The MIS management fund will be replenished after the sale of sesame oil by OLVEA. POs and Olvea BF, will contribute respectively 20% and 80% of the cost of the system."></actual>
    </period>
    <period>
     <period-start iso-date="2020-01-01"></period-start>
     <period-end iso-date="2020-12-31"></period-end>
     <target value="N/A"></target>
     <actual value="The MIS management fund was set up. In 2020, contribution was 1 179 &#x20ac; (15%) and OLVEA&#x2019;s contribution was 6 349 &#x20ac; (85%) for the operation of the MIS. After a first stocktake of MIS fund, PO would be happy to contribute more. However, the MIS business model is operational with initial subsidies until 2020. This initial subsidy was 40% of mobile internet for smartphones. This is the last year of the subsidies."></actual>
    </period>
   </indicator>
  </result>
