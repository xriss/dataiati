  <description type="3">
   <narrative xml:lang="EN">7000 horticulture farmers7 cooperatives100 SMEs50000 rural consumers</narrative>
  </description>
  <description type="1">
   <narrative xml:lang="EN">HortiPlus is a four-year project in Burkina Faso to improve food and nutrition security by increasing production, income and climate resilience of 7,000 horticulture farmers, improving business performance of 7 cooperatives and 100 SMEs, and enhancing dietary diversity of 50,000 rural consumers.</narrative>
  </description>
  <description type="2">
   <narrative xml:lang="EN">To increase production (+50%), income (+50%) and climate resilience of 7,000 horticulture farmersTo improve business performance of 7 cooperatives and 100 SMEsTo enhance dietary diversity of 50,000 rural consumers</narrative>
  </description>
