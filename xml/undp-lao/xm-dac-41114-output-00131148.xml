   <indicator aggregation-status="1" ascending="0" measure="5">
    <title>
     <narrative xml:lang="EN">People, including vulnerable groups, have greater access to basic and accountable services</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">The following indicators will measure the number of consultations, trainings and dissemination campaigns to increase people&apos;s access to basic and accountable services. This includes public service provisions delivered through establishing 3 One Door Service Centers (ODSCs), promoting vulnerable groups&apos; access to employment through conducting job readiness training and a &apos;Disability inclusive&apos; job fair, and deepening engagement with government agencies responsible for submitting the report under the UNPRPD in 2023-2024.</narrative>
    </description>
