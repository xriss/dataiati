   <indicator aggregation-status="1" ascending="0" measure="1">
    <title>
     <narrative xml:lang="EN">Number of community-based infrastructure (GHs) rehabilitated</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">The number of greenhouses, previously constructed by MAIL, that are rehabilitated under this consolidated project. No other forms of on-farm or community-level infrastructure will be counted under this indicator as they have either been discontinued (eg, compost units, vermiculture, etc.) or are now tracked under other indicators (irrigation, cold chain facility, sorting/grading equipment).</narrative>
    </description>
    <baseline value="0" year="2021"></baseline>
    <period>
     <period-start iso-date="2024-01-01"></period-start>
     <period-end iso-date="2024-12-31"></period-end>
