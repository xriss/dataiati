   <indicator aggregation-status="1" ascending="0" measure="1">
    <title>
     <narrative xml:lang="EN">Number of agriculture trade events organized</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">Trade events are described as either: domestic or international market-linkage events.  Trade events include aggregated buyers and suppliers in open spaces dedicated to business transactions and commerce.  Businesses will include: inputs suppliers, farmers, logistics providers, processors, packagers, traders / distributors, wholesalers, retailers.</narrative>
    </description>
