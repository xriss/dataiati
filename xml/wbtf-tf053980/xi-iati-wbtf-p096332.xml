    <title>
     <narrative xml:lang="EN">Amount of solid waste deposited in the waste dump</narrative>
    </title>
    <baseline iso-date="2006-12-21" value="253 ton/day" year="2006">
     <comment>
      <narrative xml:lang="EN"></narrative>
     </comment>
    </baseline>
    <period>
     <period-start iso-date="2006-12-21"></period-start>
     <period-end iso-date="2010-08-31"></period-end>
     <target value="600 ton/day"></target>
     <actual value="650">
      <comment>
       <narrative xml:lang="EN">The value exceeds the target because the SWM provider in the suburban areas of the city has extended its services above theplannedlevel (from 110 to more than 120 lifts per day) in order to respond to the increase in primary waste collection.</narrative>
      </comment>
     </actual>
    </period>
   </indicator>
