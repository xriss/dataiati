  <title>
   <narrative xml:lang="EN">Trauma Recovery for South Sudanese</narrative>
  </title>
  <description type="1">
   <narrative xml:lang="EN">To address the psychological rehabilitation needs of South Sudanese torture and trauma survivors living in the Nguenyyiel camp and one additional site in Year 2 through direct services and capacity building of local and refugee service providers.</narrative>
