  <title>
   <narrative xml:lang="EN">Nepal Climate Change Support Programme</narrative>
  </title>
  <description type="1">
   <narrative xml:lang="EN">To build capacity of the Government of Nepal to develop, cost, budget and implement adaptation measures at the local level aimed at mainstreaming climate change in key development sectors (agriculture, forestry, water and energy), including through public private partnerships.</narrative>
  </description>
