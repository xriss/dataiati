   <indicator ascending="1" measure="1">
    <title>
     <narrative xml:lang="FR">3a. Le nombre de projets/propositions de lois et de r&#xe8;glementations l&#xe9;gales vot&#xe9;s ou adopt&#xe9;s aux instances l&#xe9;gislatives, locales ou nationales, en faveur du Droit &#xe0; la Protection Sociale au b&#xe9;n&#xe9;fice des travailleurs/euses informels vuln&#xe9;rables et formels pr&#xe9;caires, suite aux actions politiques des organisations partenaires, des synergies nationales et continentales.</narrative>
    </title>
    <baseline value="0" year="2015">
     <comment>
      <narrative xml:lang="FR">En 2015, divers projets/propositions de lois ont &#xe9;t&#xe9; pr&#xe9;sent&#xe9;s &#xe0; des instances l&#xe9;gislatives, mais aucune n&#x2019;a &#xe9;t&#xe9; vot&#xe9;e en 2015.</narrative>
     </comment>
    </baseline>
    <period>
     <period-start iso-date="2017-01-01"></period-start>
     <period-end iso-date="2021-12-31"></period-end>
     <target value="27">
      <comment>
