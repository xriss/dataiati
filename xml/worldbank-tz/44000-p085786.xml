  <conditions attached="1">
   <condition type="2">
    <narrative xml:lang="EN">Borrower shall ensure that the Project is carried out in accordance with the POM and Service Guidelines on Community Participation</narrative>
   </condition>
   <condition type="2">
    <narrative xml:lang="EN">Borrower shall implement the Project in accordance with ESMF and RPF</narrative>
   </condition>
   <condition type="2">
    <narrative xml:lang="EN">Borrower shall maintain LGA Finance Committees which shall be responsible for overseeing implementation of the Project at thelocalgovernment level</narrative>
   </condition>
   <condition type="2">
    <narrative xml:lang="EN">Borrower shall maintain the NSC under terms of reference and with membership composition satisfactory to the Association</narrative>
   </condition>
   <condition type="2">
    <narrative xml:lang="EN">Borrower shall maintain the TASAF MU for duration of the Project with staffing and resources satisfactory to the Associaiton</narrative>
   </condition>
   <condition type="2">
    <narrative xml:lang="EN">Borrower shall maintain throughout Project Implementation a SET to provide the NSC with advice regarding the compliance ofproposedsubprojects with sector norms and standards</narrative>
   </condition>
   <condition type="2">
    <narrative xml:lang="EN">Borrower shall prepare and furnish to Association a report integrating results of monitoring and evaluation activities,  progressachieved, recommended measures and achievement of objectives (MTR)</narrative>
   </condition>
   <condition type="2">
    <narrative xml:lang="EN">Borrower shall prepare and submit to Association annual progress reports on or about September 30th of each year of Projectimplementation</narrative>
   </condition>
   <condition type="2">
    <narrative xml:lang="EN">Borrower shall update the Procurement Plan in accordance with guidelines acceptable to the Association, and furnish such updatenotlater than 12 months after the date of the preceding Plan</narrative>
   </condition>
   <condition type="2">
    <narrative xml:lang="EN">CMC shall prepare quarterly progress reports including financial reports for submission to the Village Council and consolidatedsubmission by LGAs to TASAF MU and SET</narrative>
   </condition>
   <condition type="2">
    <narrative xml:lang="EN">Each village shall establish a Village Fund in accordance with provisions of LGA Act, into which TASAF MU shall disburse fundsfromNVF</narrative>
   </condition>
   <condition type="2">
    <narrative xml:lang="EN">Regional Commissioners shall maintain throughout Project implementation a Regional Consultative Committee to monitor progress madeby LGAs in developing resource accountability measures</narrative>
   </condition>
   <condition type="2">
    <narrative xml:lang="EN">TASAF MU shall enter into a Memorandum of Understanding with each LGA participating in the Project, setting forth respectiveresponsiblities at each stage of subproject cycle</narrative>
   </condition>
   <condition type="2">
    <narrative xml:lang="EN">The respective LGA and VC shall enter into a subproject financing agreement with each CMC under terms/conditions satisfactory tothe Association</narrative>
   </condition>
  </conditions>
