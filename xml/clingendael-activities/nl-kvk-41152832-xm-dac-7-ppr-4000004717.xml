  <result type="3">
   <title>
    <narrative xml:lang="EN">Impact of Clingendael Humanitarian Negotiation Project in 2021</narrative>
   </title>
   <document-link format="APPLICATION/PDF" url="https://aidstream.s3.us-west-2.amazonaws.com/documents/Annual-Report_Humanitarian-Negotiation_2021-20220826120855.pdf">
    <title>
     <narrative xml:lang="EN">In this annual report of 2021 the reader can find the output, outcomes and impact of Clingendael&apos;s Humanitarian Negotiation Project (2021-2024). The reader can find the improved knowledge and confidence of the aid workers (outcomes), the improved results of the humanitarian negotiations that they are in (impact). The reader can also find that 84% of the participants were national staff and 100% of participants would recommend the course to their colleagues.</narrative>
    </title>
    <category code="B01"></category>
    <language code="EN"></language>
    <document-date iso-date="2022-04-01"></document-date>
   </document-link>
   <indicator measure="2">
    <title>
     <narrative xml:lang="EN">Improvement in confidence to negotiate</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">100% of all participants reported growth in confidence above an 8 (on a scale 1-10) to negotiate. This is measured by asking about confidence to respond to tactics, prepare strategically, lead a team, support colleagues, analysing the counterpart and recognizing good mandates</narrative>
    </description>
    <period>
     <period-start iso-date="2021-01-01"></period-start>
     <period-end iso-date="2021-12-31"></period-end>
    </period>
   </indicator>
   <indicator measure="2">
    <title>
     <narrative xml:lang="EN">Evaluation of participants of the training</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">100% of respondents to our evaluation survey would recommend the training to their colleagues, and 100% rated Clingendael&#x2019;s trainers as good or excellent.</narrative>
    </description>
    <period>
     <period-start iso-date="2021-01-01"></period-start>
     <period-end iso-date="2021-12-31"></period-end>
    </period>
   </indicator>
   <indicator measure="2">
    <title>
     <narrative xml:lang="EN">Percentage of aid workers in high-extreme access constraints areas</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">73% of aid workers and mediators in our courses are operational in countries with high, very high or extreme access constraints. Other work in HQs from where they support access or implementation negotiations.</narrative>
    </description>
    <period>
     <period-start iso-date="2021-01-01"></period-start>
     <period-end iso-date="2021-12-31"></period-end>
    </period>
   </indicator>
   <indicator measure="2">
    <title>
     <narrative xml:lang="EN">Percentage of national staff in our training</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">84% of professionals in our courses are national staff of their organizations through which we contribute to the localization agenda of the sector</narrative>
    </description>
    <period>
     <period-start iso-date="2021-01-01"></period-start>
     <period-end iso-date="2021-12-31"></period-end>
    </period>
   </indicator>
   <indicator measure="2">
    <title>
     <narrative xml:lang="EN">Impact six months after the training</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">Six months after the course, 51 participants of our foundation course responded to our impact survey. 82% report that they had been directly involved in one or more humanitarian negotiation(s). 86% of them state they used the techniques they learned in the course which made a positive difference in 98% of cases with 79% stating it made&#x2019; a lot&#x2019; of difference.</narrative>
    </description>
    <period>
     <period-start iso-date="2021-01-01"></period-start>
     <period-end iso-date="2021-12-31"></period-end>
    </period>
   </indicator>
   <indicator measure="1">
    <title>
     <narrative xml:lang="EN">Participants in our training</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">We worked with 300 professionals in the humanitarian space from 74 different humanitarian, mediation or diplomatic organisations operational in 47 countries. 42% of these professionals identified as female.</narrative>
    </description>
    <period>
     <period-start iso-date="2021-01-01"></period-start>
     <period-end iso-date="2021-12-31"></period-end>
    </period>
   </indicator>
  </result>
