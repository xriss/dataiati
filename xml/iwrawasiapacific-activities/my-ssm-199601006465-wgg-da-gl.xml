  <result aggregation-status="1" type="2">
   <title>
    <narrative xml:lang="EN">UN mechanisms, regional and country level entities evolve SGBV standards that integrate the needs and perspectives of women and girls, including WWDs, and hold national governments accountable.</narrative>
   </title>
   <description>
    <narrative xml:lang="EN">Agencies that hold power over SGBV standards, such as the UN mechanisms, regional and country level entities ,evolve SGBV standards that integrate the needs and perspectives of women and girls, including WWDs, and hold national governments accountable.</narrative>
   </description>
   <indicator ascending="1" measure="1">
    <title>
     <narrative xml:lang="EN">Number of alternative solutions provided to state duty-bearers (UN, Regional, National and Local, dutch embassies) to help shape laws, policies, and programmes to reduce Sexual and Gender Based Violence(SGBV)</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">The number of proposed or accepted solutions that have been submitted to state duty bearers.</narrative>
    </description>
