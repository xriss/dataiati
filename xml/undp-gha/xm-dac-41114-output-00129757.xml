  <result aggregation-status="1" type="1">
   <title>
    <narrative xml:lang="EN">Annual Output Results</narrative>
   </title>
   <indicator aggregation-status="1" ascending="0" measure="1">
    <title>
     <narrative xml:lang="EN">Number of training (disaggregation by type of capacity building )  developed and delivered in the UNPRPD programme.</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">Under this output, the programme will conduct 6 capacity training programmes to build the capacity of NCPD, Ghana Federation of Disability, OPDs, CSOs, and disability focal points in sector ministries and government agencies including the Ghana Statistical Service, Ministry of Education, Ministry of Health etc). They will be equipped with knowledge and practical tools on disability inclusive data collection, effective coordination mechanisms, implementing the CRPD and developing knowledge products to advance disability inclusion across national systems and address existing skill gaps.</narrative>
    </description>
    <baseline value="1" year="2021"></baseline>
