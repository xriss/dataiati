  <title>
   <narrative xml:lang="EN">MRV-systems and decarbonization pathways</narrative>
  </title>
  <description>
   <narrative xml:lang="EN">The project aims to enhance MRV-systems and building long-term deep decarbonization pathways in Under 2 states, regions and provinces with land use, land use change and forestry (LULUCF)</narrative>
  </description>
