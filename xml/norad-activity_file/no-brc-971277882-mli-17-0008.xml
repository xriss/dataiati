  <title>
   <narrative xml:lang="EN">IITA Climate Smart Agricultural Technologies Mali</narrative>
  </title>
  <description>
   <narrative xml:lang="EN">Introduction of climate smart agricultural technologies and innovations in the Sahel and dry savannah regions of Mali  that will improve rural livelihoods and food security.</narrative>
  </description>
