  <title>
   <narrative xml:lang="EN">IJ/EJN Free Media and Ethical Journalism</narrative>
  </title>
  <description>
   <narrative xml:lang="EN">Freedom of Expression and independent media and hatespeech. Part of the project focuses on preventing harassment of female journalists online and arranging courses for female journalist students to address issues of safety.</narrative>
