  <title>
   <narrative xml:lang="EN">Capacity Building for Climate Smart Natural Resource Management</narrative>
  </title>
  <description>
   <narrative xml:lang="EN">The project aims to contribute to food security, improved livelihood, and poverty reduction through capacity building in climate smart natural resource management and policy analysis for sustainable development at higher education institutions in Ethiopia and Malawi.</narrative>
  </description>
