  <tag code="1" vocabulary="2">
   <narrative xml:lang="EN">1 - End poverty in all its forms everywhere</narrative>
  </tag>
  <tag code="10" vocabulary="2">
   <narrative xml:lang="EN">10 - Reduce inequality within and among countries</narrative>
  </tag>
  <tag code="12" vocabulary="2">
   <narrative xml:lang="EN">12 - Ensure sustainable consumption and production patterns</narrative>
  </tag>
  <tag code="13" vocabulary="2">
   <narrative xml:lang="EN">13 - Take urgent action to combat climate change and its impacts</narrative>
  </tag>
  <tag code="14" vocabulary="2">
   <narrative xml:lang="EN">14 - Conserve and sustainably use the oceans, seas and marine resources for sustainable development</narrative>
  </tag>
  <tag code="15" vocabulary="2">
   <narrative xml:lang="EN">15 - Protect, restore and promote sustainable use of terrestrial ecosystems, sustainably manage forests, combat desertification, and halt and reverse land degradation and halt biodiversity loss</narrative>
  </tag>
  <tag code="16" vocabulary="2">
   <narrative xml:lang="EN">16 - Promote peaceful and inclusive societies for sustainable development, provide access to justice for all and build effective, accountable and inclusive institutions at all levels</narrative>
  </tag>
  <tag code="2" vocabulary="2">
   <narrative xml:lang="EN">2 - End hunger, achieve food security and improved nutrition and promote sustainable agriculture</narrative>
  </tag>
  <tag code="7" vocabulary="2">
   <narrative xml:lang="EN">7 - Ensure access to affordable, reliable, sustainable and modern energy for all</narrative>
  </tag>
  <tag code="8" vocabulary="2">
   <narrative xml:lang="EN">8 - Promote sustained, inclusive and sustainable economic growth, full and productive employment and decent work for all</narrative>
  </tag>
