  <title>
   <narrative xml:lang="EN">Institutional Cooperation, Auditor General of Uganda</narrative>
  </title>
  <description>
   <narrative xml:lang="EN">The project is based on a three year Memorandum of Understanding with the cooperating Supreme Audit Institution (SAI). Main objective is good governance and anti-corruption. Institutional strengthening with focus on audit in the Petroleum Sector</narrative>
  </description>
