  <title>
   <narrative xml:lang="EN">Building Federal Democracy in Myanmar</narrative>
  </title>
  <description>
   <narrative xml:lang="EN">The programme aims to contribute to restoring democracy in Myanmar by supporting democratic actors in Myanmar to build a new constitutional framework and form effective and accountable institutions that ensure inclusive and participatory governance at all levels.</narrative>
  </description>
