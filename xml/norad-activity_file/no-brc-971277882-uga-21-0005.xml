  <title>
   <narrative xml:lang="EN">GOAL - Uganda youth engine - cassava value chain project</narrative>
  </title>
  <description>
   <narrative xml:lang="EN">An agriculture project within the cassava value chain, located in the Agogo district in Northern Uganda, targeting 3500 young women and men, with at least 70% of them being women.</narrative>
  </description>
