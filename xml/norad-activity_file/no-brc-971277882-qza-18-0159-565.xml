  <title>
   <narrative xml:lang="EN">FA-Sustainable Integrated Development, Western Uganda</narrative>
  </title>
  <description>
   <narrative xml:lang="EN">The project will seek to provide icreased access to sustainably managed improved sanitation facilities, as well as improved adoption of positive hygiene behavioral practices among 3,000 households and 8 primary schools - reaching a total of 15,000 people.</narrative>
  </description>
