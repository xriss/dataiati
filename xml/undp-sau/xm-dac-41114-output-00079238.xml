  <conditions attached="1">
   <condition type="1">
    <narrative xml:lang="EN">Consistent with the Article III of the SBAA [or the Supplemental Provisions to the Project Document], the responsibility for the safety and security of the Implementing Partner and its personnel and property, and of UNDP&#x2019;s property in the Implementing Partner&#x2019;s custody, rests with the Implementing Partner.  To this end, the Implementing Partner shall: a)	put in place an appropriate security plan and maintain the security plan, taking into account the security situation in the country where the project is being carried; b)	assume all risks and liabilities related to the Implementing Partner&#x2019;s security, and the full implementation of the security plan.</narrative>
   </condition>
   <condition type="1">
    <narrative xml:lang="EN">Social and environmental sustainability will be enhanced through application of the UNDP Social and Environmental Standards (http://www.undp.org/ses) and related Accountability Mechanism (http://www.undp.org/secu-srm).</narrative>
   </condition>
  </conditions>
  <result aggregation-status="1" type="1">
   <title>
    <narrative xml:lang="EN">Annual Output Results</narrative>
   </title>
   <indicator ascending="0" measure="5">
    <title>
     <narrative xml:lang="EN">Output Indicator</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">Quality of transport policies and level of inter-agency coordination 
-Level of public transport services and use of Intelligent Transport Systems
-Level of road safety and eco-friendly transport</narrative>
    </description>
    <baseline year="2012">
     <comment>
      <narrative xml:lang="EN">-Lack of national transport strategy to guide sector activities as focus for inter-agency coordination
-No public transport in cities, and ITS capacities not developed 
-High levels of road death rates and high levels of vehicle pollution levels</narrative>
     </comment>
    </baseline>
    <period>
     <period-start iso-date="2021-01-01"></period-start>
     <period-end iso-date="2021-12-31"></period-end>
     <target>
      <comment>
       <narrative xml:lang="EN">Transit Road outside Cities study completed</narrative>
      </comment>
     </target>
     <actual>
      <comment>
       <narrative xml:lang="EN">The National Transport Logistic Services (NTLS) was developed to help fulfill the Kingdom of Saudi Arabia (KSA) Vision 2030 by identifying the challenges faced by government entities and establishing targets and initiatives to overcome those challenges and the Project is participating in achieving the NTS, set targets, and KSA Vision 2030 strategic objectives</narrative>
      </comment>
     </actual>
    </period>
    <period>
     <period-start iso-date="2022-01-01"></period-start>
     <period-end iso-date="2022-12-31"></period-end>
     <target>
      <comment>
       <narrative xml:lang="EN">Integrated Coordination between MOTLS &amp; MOMRA for Developing Transport Network</narrative>
      </comment>
     </target>
     <actual>
      <comment>
       <narrative xml:lang="EN">The scope of roads was determined based on a successfully integration between MOTLS and MOMRAH where all roads inside urban range will be delivered to MOMRAH and all road outside urban range to be delivered to MOTLS</narrative>
      </comment>
     </actual>
    </period>
    <period>
     <period-start iso-date="2020-01-01"></period-start>
     <period-end iso-date="2020-12-31"></period-end>
     <target>
      <comment>
       <narrative xml:lang="EN">Road Network Developed</narrative>
      </comment>
     </target>
     <actual>
      <comment>
       <narrative xml:lang="EN">&#x2022;	Identified an International Firm via Biding Process to work on the studies for Transit Roads outside the major cities in the Kingdom . Due to COVID-19 the studies have been delayed for the year 2021.
&#x2022;	Providing continuous support to the development of Transport Data, Statistics and Analysis unit and system at MOT.</narrative>
      </comment>
     </actual>
    </period>
   </indicator>
  </result>
