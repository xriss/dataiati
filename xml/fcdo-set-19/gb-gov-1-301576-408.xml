  <title>
   <narrative xml:lang="EN">Ethiopia - providing community-based psychosocial support to survivors of sexual violence in conflict</narrative>
  </title>
  <description type="1">
   <narrative xml:lang="EN">To help survivors of conflict related psychological trauma and SGBV in northern Ethiopia build resilience through the rollout of an adapted emergency community based psychosocial support that builds on the existing social capital</narrative>
  </description>
