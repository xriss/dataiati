  <reporting-org ref="GB-GOV-1" type="10">
   <narrative xml:lang="EN">UK - Foreign, Commonwealth Development Office (FCDO)</narrative>
  </reporting-org>
  <title>
   <narrative xml:lang="EN">Met Office - WISER Asia Pacific &#x2013; Weather and Climate Information Services for Asia Pacific</narrative>
  </title>
  <description type="1">
   <narrative xml:lang="EN">To improve quality, access, and use of Weather and Climate Information Services (WCIS) to strengthen the resilience of vulnerable people in ODA-eligible countries across the Asia Pacific region. This is implemented under four themes (a) Improve capability of information providers (Met Offices, Line Ministries, Disaster Agencies, etc) to disseminate WCIS (b) Support regional coordination (c) improve generation and communication of Impact Based Forecasting (IBF) to vulnerable communities and sectors and (d) Enhance integration of Weather and Climate Information Services (WCIS) into regional, national and sub-national climate adaptation policy and actions.</narrative>
  </description>
