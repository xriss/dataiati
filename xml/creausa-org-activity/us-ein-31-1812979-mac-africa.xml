   <indicator aggregation-status="1" ascending="1" measure="1">
    <title>
     <narrative xml:lang="EN">5.1 # of laws, policies and strategies blocked, adopted and improved and 5.2 Types of laws, policies and strategies blocked, adopted or improved</narrative>
    </title>
    <description>
