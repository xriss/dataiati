    </period>
   </indicator>
   <indicator aggregation-status="1" ascending="0" measure="1">
    <title>
     <narrative xml:lang="EN">Number of innovative new products or services delivered by business enterprises</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">&#x201c;Innovation&#x201d; is defined as: (1) a new approach, idea, product or service that has not been tested anywhere; (2) an approach, idea, product or service that is new to Malawi; and (3) an approach idea, product or service that has not been applied to the sector in question in which the proposed project is being implemented.</narrative>
    </description>
