  </reporting-org>
  <title xml:lang="EN">
   <narrative xml:lang="EN">Irrigation Water Security, Resilience and Value-Addition Project</narrative>
  </title>
  <description type="1" xml:lang="EN">
   <narrative xml:lang="EN">The project will focus on the irrigation sub-sector. It aims at supporting irrigated agriculture in public irrigation schemes, through: (i) strengthened performance of the operator of the irrigation service; (ii) modernized irrigation infrastructure, reducing losses and ensuring more flexible access to water; and (iii) improved agricultural value addition, productivity and market access.</narrative>
  </description>
  <description type="2" xml:lang="EN">
   <narrative xml:lang="EN">To improve the quality of irrigation water services; to strengthen the operational performance of the irrigation operators; and to increase crop yields.</narrative>
  </description>
