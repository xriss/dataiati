  <title>
   <narrative xml:lang="EN">Tony Elumelu Foundation (TEF)</narrative>
   <narrative xml:lang="FR">Tony Elumelu Foundation (TEF)</narrative>
  </title>
  <description type="2">
   <narrative xml:lang="EN">10,000 entrepreneurs to create 1 million jobs and generate USD10 billion in additional revenue in Africa</narrative>
   <narrative xml:lang="FR"></narrative>
  </description>
  <description type="3">
   <narrative xml:lang="EN">Africa&#x2019;s next generation of entrepreneurs and business leaders who are citizens and legal residents of any one of the 54 African countries, who operate a start-up or MSME in Africa youth aged between 15 and 35 years old.</narrative>
   <narrative xml:lang="FR"></narrative>
  </description>
  <description type="1">
   <narrative xml:lang="EN">TEF Entrepreneurship Program is a 10-year, USD100 million commitment to identify, train, mentor and fund 10,000 African entrepreneurs. The project supports high potential youth led start-ups in Africa to access business development services and networking support in order to grow and create decent jobs.</narrative>
   <narrative xml:lang="FR"></narrative>
  </description>
  <participating-org ref="XM-DAC-YEIMDTF" role="1" type="40">
