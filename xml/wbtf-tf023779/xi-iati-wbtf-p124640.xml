  <result aggregation-status="0" type="1">
   <title>
    <narrative xml:lang="EN">Intermediate Results Indicator</narrative>
   </title>
   <indicator ascending="1" measure="2">
    <title>
     <narrative xml:lang="EN">Household income (poverty indicator)</narrative>
    </title>
    <baseline iso-date="2011-12-31" value="4360000.00" year="2011">
     <comment>
      <narrative xml:lang="EN">Average income per year in LAK  for targeted households as surveyed by the Project Team</narrative>
     </comment>
    </baseline>
    <period>
     <period-start iso-date="2011-12-31"></period-start>
     <period-end iso-date="2015-04-22"></period-end>
     <target value="20.00">
      <comment>
       <narrative xml:lang="EN">Cumulative increase in beneficiary annual income by the end of the project.</narrative>
      </comment>
     </target>
     <actual value="16.00">
      <comment>
       <narrative xml:lang="EN">On average, family income for the household that still remain engaged in sericulrure was estimated an increase of approximately16percent per year.</narrative>
      </comment>
     </actual>
    </period>
   </indicator>
  </result>
  <result aggregation-status="0" type="2">
   <title>
    <narrative xml:lang="EN">PDO Indicator</narrative>
   </title>
   <indicator ascending="1" measure="1">
    <title>
     <narrative xml:lang="EN">Number of households in silk production partnerships with lead firms</narrative>
    </title>
    <baseline iso-date="2011-04-22" value="428.00" year="2011">
     <comment>
      <narrative xml:lang="EN">Existing number of households in partnership with various lead firms prior to the SSPP Project, according to silk profile report</narrative>
     </comment>
    </baseline>
    <period>
     <period-start iso-date="2011-04-22"></period-start>
     <period-end iso-date="2015-04-22"></period-end>
     <target value="1200.00"></target>
     <actual value="63.00">
      <comment>
       <narrative xml:lang="EN">The planned number of households anticipated by lead firms in their business plans was 180 for the first year. As August 2012,there were 120 households engaging silk production activities. Some households were dropped afterward. As of May 2013 there areonly 69 households which have mulberry plantation gardens. By which 63 households are expected to move to the cocoon raising stage.</narrative>
      </comment>
     </actual>
    </period>
   </indicator>
  </result>
