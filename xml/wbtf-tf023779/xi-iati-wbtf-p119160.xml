  <result aggregation-status="0" type="2">
   <title>
    <narrative xml:lang="EN">PDO Indicator</narrative>
   </title>
   <indicator ascending="1" measure="1">
    <title>
     <narrative xml:lang="EN">Awareness and capacity on biogas have been increased among communities</narrative>
    </title>
    <baseline iso-date="2009-10-01" value="0.00" year="2009">
     <comment>
      <narrative xml:lang="EN">Almost no knowledge and information on rural biogas in rural areas.</narrative>
     </comment>
    </baseline>
    <period>
     <period-start iso-date="2009-10-01"></period-start>
     <period-end iso-date="2014-05-31"></period-end>
     <target value="250.00">
      <comment>
       <narrative xml:lang="EN">Around 250 women/youth in the villages have participated in biogas training and 50 households are volunteer/engaged to participatein the biogas pilot</narrative>
      </comment>
     </target>
     <actual value="120.00">
      <comment>
       <narrative xml:lang="EN">One workshop at district level was organized. Another, workshop will be organized towards at end-March 2014. 20 volunteershousehold were selected from the two districts.</narrative>
      </comment>
     </actual>
    </period>
   </indicator>
  </result>
  <result aggregation-status="0" type="2">
   <title>
    <narrative xml:lang="EN">PDO Indicator</narrative>
   </title>
   <indicator ascending="1" measure="1">
    <title>
     <narrative xml:lang="EN">Increased Government support to scale-up biogas.</narrative>
    </title>
    <baseline iso-date="2009-10-01" value="2.00" year="2009">
     <comment>
      <narrative xml:lang="EN">Few officials in the policy making ministries have very limited knowledge on biogas.</narrative>
     </comment>
    </baseline>
    <period>
     <period-start iso-date="2009-10-01"></period-start>
     <period-end iso-date="2014-05-31"></period-end>
     <target value="50.00">
      <comment>
       <narrative xml:lang="EN">50 officials from the key line ministries participated in JSDF project training, the benefits of biogas to rural poor and itslinkage with CDM have been better understood.  Packages on biogas available.</narrative>
      </comment>
     </target>
     <actual value="30.00">
      <comment>
       <narrative xml:lang="EN">Officials at Directors level from MAI, EPA, MOPIC, AREA and University of Sana&#x2019;a, University of Taiz attended two nationalworkshops.</narrative>
      </comment>
     </actual>
    </period>
   </indicator>
  </result>
  <result aggregation-status="0" type="2">
   <title>
    <narrative xml:lang="EN">PDO Indicator</narrative>
   </title>
   <indicator ascending="1" measure="1">
    <title>
     <narrative xml:lang="EN">Reduction in households&apos; gas expenses by 60- 80%</narrative>
    </title>
    <baseline iso-date="2009-10-01" value="0.00" year="2009">
     <comment>
      <narrative xml:lang="EN">Households spend 4000 rials (US$20) per month as cooking gas in addition to fuel wood.</narrative>
     </comment>
    </baseline>
    <period>
     <period-start iso-date="2009-10-01"></period-start>
     <period-end iso-date="2015-01-31"></period-end>
     <target value="120.00">
      <comment>
       <narrative xml:lang="EN">200 households using biodigesters reduce 60-80% of their expenses for cooking gas.</narrative>
      </comment>
     </target>
     <actual value="0.00">
      <comment>
       <narrative xml:lang="EN">Installation of biogas units is yet to start. Installation of a few pilots is scheduled in May/June 2014. Further installation isput off in line with the early closing decision.</narrative>
      </comment>
     </actual>
    </period>
   </indicator>
  </result>
  <result aggregation-status="0" type="2">
   <title>
    <narrative xml:lang="EN">PDO Indicator</narrative>
   </title>
   <indicator ascending="1" measure="1">
    <title>
     <narrative xml:lang="EN">Private sector engagement in biogas digesters mobilized.</narrative>
    </title>
    <baseline iso-date="2009-10-01" value="0.00" year="2009">
     <comment>
      <narrative xml:lang="EN">No systemic engagement of the private sector.</narrative>
     </comment>
    </baseline>
    <period>
     <period-start iso-date="2009-10-01"></period-start>
     <period-end iso-date="2014-05-31"></period-end>
     <target value="3.00">
      <comment>
       <narrative xml:lang="EN">At least 3 private entrepreneurs engaged in development of locally suited biogas digesters.</narrative>
      </comment>
     </target>
     <actual value="3.00">
      <comment>
       <narrative xml:lang="EN">Private sector/owners of warehouses from Sana&#x2019;a, Taiz and Aden participated in two national workshops.</narrative>
      </comment>
     </actual>
    </period>
   </indicator>
  </result>
  <result aggregation-status="0" type="2">
   <title>
    <narrative xml:lang="EN">PDO Indicator</narrative>
   </title>
   <indicator ascending="1" measure="2">
    <title>
     <narrative xml:lang="EN">Women from the 120 households using biodigesters reduce 80% of thier wood collection time.</narrative>
    </title>
    <baseline iso-date="2009-10-01" value="0.00" year="2009">
     <comment>
      <narrative xml:lang="EN">Women spend 6-8 hours per day collecting wood.</narrative>
     </comment>
    </baseline>
    <period>
     <period-start iso-date="2009-10-01"></period-start>
     <period-end iso-date="2015-01-31"></period-end>
     <target value="80.00">
      <comment>
       <narrative xml:lang="EN">Women from the 120 households using biodigesters reduce the time spent on wood collection by 80%</narrative>
      </comment>
     </target>
     <actual value="0.00">
      <comment>
       <narrative xml:lang="EN">Assessment of reduction in time consumed can only be taken up after the biogas units are installed.</narrative>
      </comment>
     </actual>
    </period>
   </indicator>
  </result>
