   <indicator ascending="1" measure="1">
    <title>
     <narrative xml:lang="EN">Production forests whose management has been transferred to the private sector</narrative>
    </title>
    <baseline iso-date="2007-11-20" value="0.00" year="2007">
     <comment>
      <narrative xml:lang="EN">All public forests are currently managed by KFS, no management responsibility has been transferred to the private sector.</narrative>
     </comment>
    </baseline>
    <period>
     <period-start iso-date="2007-11-20"></period-start>
     <period-end iso-date="2013-06-28"></period-end>
     <target value="5.00"></target>
     <actual value="0.00">
      <comment>
       <narrative xml:lang="EN">This target will likely not be reached because, outside of direct project control, the process toward transfer of management ofsome forests to the private sector was stopped by the National Alliance of Community Forest Associations (NACOFA) through a courtinjunction.Note: June 22 value is incorrect and should read 0.</narrative>
      </comment>
     </actual>
    </period>
   </indicator>
  </result>
