  <result aggregation-status="1" type="1">
   <title>
    <narrative xml:lang="EN">Annual Output Results</narrative>
   </title>
   <indicator aggregation-status="1" ascending="0" measure="1">
    <title>
     <narrative xml:lang="EN">Number of views/likes/retweets and downloads of the knowledge products.</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">This indicator measures the level of audience engagement with the project&#x2019;s knowledge products by tracking the number of views, likes, shares/retweets, and downloads across digital platforms, websites, and social media channels where the products are disseminated.</narrative>
    </description>
    <baseline value="0" year="2026"></baseline>
    <period>
     <period-start iso-date="2026-01-01"></period-start>
     <period-end iso-date="2026-12-31"></period-end>
     <target value="5000"></target>
    </period>
   </indicator>
   <indicator aggregation-status="1" ascending="0" measure="1">
    <title>
     <narrative xml:lang="EN">Number of collaborations established among participants.</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">This indicator measures the number of new collaborations, joint initiatives, or partnerships formed among participating innovators and stakeholders as a direct result of project engagements, networking sessions, or facilitated interactions.</narrative>
    </description>
    <baseline value="0" year="2026"></baseline>
    <period>
     <period-start iso-date="2026-01-01"></period-start>
     <period-end iso-date="2026-12-31"></period-end>
     <target value="0"></target>
    </period>
   </indicator>
   <indicator aggregation-status="1" ascending="0" measure="1">
    <title>
     <narrative xml:lang="EN">Number of case studies or success stories identified, reviewed, and included in the compiled list.</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">This indicator measures the total number of case studies or success stories that have been systematically identified, reviewed for relevance and quality, and formally included in the project&#x2019;s compiled list of documented best practices.</narrative>
    </description>
    <baseline value="0" year="2026"></baseline>
    <period>
     <period-start iso-date="2026-01-01"></period-start>
     <period-end iso-date="2026-12-31"></period-end>
     <target value="5"></target>
    </period>
   </indicator>
   <indicator aggregation-status="1" ascending="0" measure="1">
    <title>
     <narrative xml:lang="EN">Number of participating innovators and other stakeholders (at least 30% women).</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">This indicator measures the total number of innovators and other relevant stakeholders who participate in the global workshop/exhibition/fair to be organized by the project, ensuring that women represent at least 30% of all participants to promote gender inclusion and equitable engagement.</narrative>
    </description>
    <baseline value="0" year="2026"></baseline>
    <period>
     <period-start iso-date="2026-01-01"></period-start>
     <period-end iso-date="2026-12-31"></period-end>
     <target value="30"></target>
    </period>
   </indicator>
   <indicator aggregation-status="1" ascending="0" measure="1">
    <title>
     <narrative xml:lang="EN">Number of knowledge products prepared and distributed.</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">This indicator measures the total number of knowledge products&#x2014;such as briefs, reports, toolkits, newsletters, infographics, or digital content&#x2014;that are developed, finalized, and disseminated to target audiences to support learning, visibility, and knowledge sharing within the project.</narrative>
    </description>
    <baseline value="0" year="2026"></baseline>
    <period>
     <period-start iso-date="2026-01-01"></period-start>
     <period-end iso-date="2026-12-31"></period-end>
     <target value="3"></target>
    </period>
   </indicator>
   <indicator aggregation-status="1" ascending="0" measure="1">
    <title>
     <narrative xml:lang="EN">Number of users accessing the online database or hub.</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">This indicator measures the total number of users who access the online database or innovation hub within a given reporting period, reflecting the platform&#x2019;s reach, relevance, and level of engagement among target audiences.</narrative>
    </description>
    <baseline value="0" year="2026"></baseline>
    <period>
     <period-start iso-date="2026-01-01"></period-start>
     <period-end iso-date="2026-12-31"></period-end>
     <target value="500"></target>
    </period>
   </indicator>
   <indicator aggregation-status="1" ascending="0" measure="1">
    <title>
     <narrative xml:lang="EN">A needs assessment to identify the technical support required for establishing innovation centers or hubs completed.</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">This indicator tracks whether a comprehensive needs assessment has been conducted to determine the technical, operational, infrastructural, and capacity&#x2011;building requirements necessary for establishing innovation centers or hubs. The assessment should include consultations with stakeholders, analysis of existing capacities, and identification of gaps that must be addressed.</narrative>
    </description>
    <baseline value="0" year="2026"></baseline>
    <period>
     <period-start iso-date="2026-01-01"></period-start>
     <period-end iso-date="2026-12-31"></period-end>
     <target value="1"></target>
    </period>
   </indicator>
  </result>
