   <indicator aggregation-status="1" ascending="0" measure="1">
    <title>
     <narrative xml:lang="EN">Number of analytic reports produced and disseminated (Gender analysis)</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">This indicator tracks the number of analytic reports produced and disseminated. key point of focus for these reports will be value chain and gender analysis for selected crops to identify Small scale Producers (SSPs) product priorities, risks, data sources, as well as other agricultural productivity and climate risk mitigation/adaptation initiatives</narrative>
    </description>
