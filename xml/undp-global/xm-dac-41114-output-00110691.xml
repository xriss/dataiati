   <indicator ascending="0" measure="5">
    <title>
     <narrative xml:lang="EN">Output Indicator</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">3.1: Number of Poverty-Environment Action knowledge-sharing and learning products that are referenced by regional and global networks

3.2: Number of countries adopting Poverty-Environment Action tools/ approaches resulting from South-South knowledge collaborations

3.3: Number of regional and global Poverty-Environment Action partner programmes and agencies that apply an integrated mainstreaming approach</narrative>
    </description>
    <baseline year="2018">
     <comment>
      <narrative xml:lang="EN">To be established</narrative>
     </comment>
    </baseline>
    <period>
     <period-start iso-date="2021-01-01"></period-start>
     <period-end iso-date="2021-12-31"></period-end>
     <target>
      <comment>
       <narrative xml:lang="EN">&#x2022;	Number of Poverty-Environment Action knowledge-sharing and learning products that are referenced by regional and global networks. Target: 23
&#x2022;	Number of countries adopting Poverty-Environment Action tools/approaches resulting from South-South knowledge collaboration. Target: 7
&#x2022;	Number of regional and global Poverty-Environment Action partner programmes and agencies that apply an integrated mainstreaming approach. Target: 7</narrative>
      </comment>
     </target>
     <actual>
      <comment>
       <narrative xml:lang="EN">- 20 Poverty-Environment Action knowledge-sharing and learning products referenced by regional and global networks. 
- 6 countries adopted Poverty-Environment Action tools/approaches resulting from South-South knowledge collaboration. 
- 6 regional and global Poverty-Environment Action partner programmes and agencies applied an integrated mainstreaming approach.</narrative>
      </comment>
     </actual>
    </period>
    <period>
     <period-start iso-date="2020-01-01"></period-start>
     <period-end iso-date="2020-12-31"></period-end>
     <target>
      <comment>
       <narrative xml:lang="EN">&#x2022;	Number of Poverty-Environment Action knowledge-sharing and learning products that are referenced by regional and global networks. Target: 15
&#x2022;	Number of countries adopting Poverty-Environment Action tools/approaches resulting from South-South knowledge collaboration. Target: 5
&#x2022;	Number of regional and global Poverty-Environment Action partner programmes and agencies that apply an integrated mainstreaming approach. Target: 3</narrative>
      </comment>
     </target>
     <actual>
      <comment>
       <narrative xml:lang="EN">&#x2022;	20 Poverty-Environment Action tools and products have so far been referenced. Target achieved.
&#x2022;	Technical assistance project between Indonesia and South Africa facilitated by GIZ and Poverty-Environment Action launched in June 2020.
&#x2022;	7 regional and global Poverty-Environment Action partner programmes and agencies applied an integrated mainstreaming approach. PEA has partnered with ADB on Blue Economy, GIZ and PAGE on Green Bonds, UN Women on Gender in Agriculture Green Economy Coalition at country and global level, including a call to action on Covid-19 recovery during World Environment Day 2020 (5 June) In Mozambique, the SUNRED team has incorporated lessons from the World Bank funded MozFIP agroforestry project implemented in the Zambezia province and managed by the National Fund for Sustainable Development (FNDS)</narrative>
      </comment>
     </actual>
    </period>
