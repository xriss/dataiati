    <description>
     <narrative xml:lang="EN">Number of countries that developed National Cooling Action Plans</narrative>
    </description>
    <baseline year="2018">
     <comment>
      <narrative xml:lang="EN">No country (0) has developed a National Cooling Action Plan.</narrative>
     </comment>
    </baseline>
    <period>
     <period-start iso-date="2020-01-01"></period-start>
     <period-end iso-date="2020-12-31"></period-end>
     <target>
      <comment>
       <narrative xml:lang="EN">Six (6) countries to develop a National Cooling Action Plan.</narrative>
      </comment>
     </target>
     <actual>
      <comment>
       <narrative xml:lang="EN">Five (5) countries; Chile (6-Oct-20), Costa Rica (1-Jan-20), Cuba	(1-Mar-20), Panama (1-Jan-20) and Trinidad and Tobago (1-Feb-20) have develop a National Cooling Action Plan.</narrative>
      </comment>
     </actual>
    </period>
    <period>
     <period-start iso-date="2021-01-01"></period-start>
     <period-end iso-date="2021-12-31"></period-end>
     <target>
      <comment>
       <narrative xml:lang="EN">Eight (8) countries to develop a National Cooling Action Plan.</narrative>
      </comment>
     </target>
     <actual>
      <comment>
       <narrative xml:lang="EN">Four countries; Ghana (30-Jun-21), Lebanon	(19-May-21), Mexico (1-May-21) and Nigeria (1-Oct-21) have develop a National Cooling Action Plan.</narrative>
      </comment>
     </actual>
    </period>
    <period>
     <period-start iso-date="2022-01-01"></period-start>
     <period-end iso-date="2022-12-31"></period-end>
     <target>
      <comment>
       <narrative xml:lang="EN">All selected Parties operating under Article 5 of the Montreal Protocol have National Cooling Action Plans.</narrative>
      </comment>
     </target>
    </period>
   </indicator>
