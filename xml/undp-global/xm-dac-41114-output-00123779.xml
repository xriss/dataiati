   <indicator aggregation-status="0" ascending="0" measure="5">
    <title>
     <narrative xml:lang="EN">Number of functional local multi-stakeholder platforms that promote returnees&#x2019; reintegration</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">Some municipalities have experience in facilitating multi-stakeholder partnerships for promoting employment. As part of ROMACTD Council of Europe has conducted a number of local level capacity building activities and advocacy on the issue of reintegration.</narrative>
    </description>
    <baseline year="2020">
     <comment>
      <narrative xml:lang="EN">N/A</narrative>
     </comment>
    </baseline>
    <period>
     <period-start iso-date="2024-01-01"></period-start>
     <period-end iso-date="2024-12-31"></period-end>
     <target>
      <comment>
       <narrative xml:lang="EN">&quot;Local multi-stakeholder platforms functional: 
4 meetings held
1 partnerships per beneficiary municipalities established&quot;</narrative>
      </comment>
     </target>
     <actual>
      <comment>
       <narrative xml:lang="EN">9</narrative>
      </comment>
     </actual>
    </period>
    <period>
     <period-start iso-date="2023-01-01"></period-start>
     <period-end iso-date="2023-12-31"></period-end>
     <target>
      <comment>
       <narrative xml:lang="EN">&quot;Local multi-stakeholder platforms functional: 
4 meetings held
2 partnerships per beneficiary municipalities established&quot;</narrative>
      </comment>
     </target>
     <actual>
      <comment>
       <narrative xml:lang="EN">Nine local multi stakeholders platforms established, functional (regular periodic meetings held) and coordinated by beneficiary municipalities three in Serbia, (three in Albania, three in North Macedonia)</narrative>
      </comment>
     </actual>
    </period>
   </indicator>
   <indicator aggregation-status="0" ascending="0" measure="5">
    <title>
     <narrative xml:lang="EN">Number of local returnees reintegration strategies in place</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">The issue of reintegration of returnees is not systematically addressed at local level. Returnees&#x2019; needs are mainly addressed by local NGOs from donor funding.</narrative>
    </description>
    <baseline year="2020">
     <comment>
      <narrative xml:lang="EN">N/A</narrative>
     </comment>
    </baseline>
    <period>
     <period-start iso-date="2024-01-01"></period-start>
     <period-end iso-date="2024-12-31"></period-end>
     <target>
      <comment>
       <narrative xml:lang="EN">Fifty percent  
of activities in the local reintegration strategies implemented</narrative>
      </comment>
     </target>
     <actual>
      <comment>
       <narrative xml:lang="EN">Albania, North Macedonia and Serbia: Majority of planned activities implemented, implementation assessed as positive  through survey</narrative>
      </comment>
     </actual>
    </period>
    <period>
     <period-start iso-date="2023-01-01"></period-start>
     <period-end iso-date="2023-12-31"></period-end>
     <target>
      <comment>
       <narrative xml:lang="EN">Fourty percent 
of activities in the local reintegration strategies implemented</narrative>
      </comment>
     </target>
     <actual>
      <comment>
       <narrative xml:lang="EN">Albania: Implementation of wide range of activities related to local action plans in full progress.

N. Macedonia: Implementation of wide range of activities related to local strategies in full progress 

Serbia: Implementation of wide range of activities related to local action plans in full  progress</narrative>
      </comment>
     </actual>
    </period>
   </indicator>
   <indicator aggregation-status="0" ascending="0" measure="5">
