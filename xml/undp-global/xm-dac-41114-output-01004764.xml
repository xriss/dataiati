  <result aggregation-status="1" type="1">
   <title>
    <narrative xml:lang="ES">Annual Output Results</narrative>
   </title>
   <indicator aggregation-status="1" ascending="0" measure="1">
    <title>
     <narrative xml:lang="ES">Number of public institutions trained through the Regional Women&#x2019;s Leadership Course: Driving a Just, Inclusive, and Resilient Energy and Climate Transition in Latin America and the Caribbean (in-person and virtual formats)</narrative>
    </title>
    <description>
     <narrative xml:lang="ES">This indicator captures the total number of public institutions that have participated in and received training through the Regional Women&#x2019;s Leadership Course. The course aims to build institutional capacity to promote gender-responsive approaches in energy, climate, and biodiversity transitions across Latin America and the Caribbean. Training is delivered in both in-person and virtual formats.</narrative>
    </description>
    <baseline value="0" year="2025"></baseline>
    <period>
     <period-start iso-date="2025-01-01"></period-start>
     <period-end iso-date="2025-12-31"></period-end>
     <target value="10"></target>
    </period>
   </indicator>
   <indicator aggregation-status="1" ascending="0" measure="1">
    <title>
     <narrative xml:lang="ES">Number of women community leaders trained through the Regional Women&#x2019;s Leadership Course: Driving a Just, Inclusive, and Resilient Energy and Climate Transition in Latin America and the Caribbean (in-person and virtual formats)</narrative>
    </title>
    <description>
     <narrative xml:lang="ES">This indicator measures the total number of women community leaders who have successfully completed training through the Regional Women&#x2019;s Leadership Course, which focuses on strengthening leadership capacities to promote gender-responsive approaches in energy, climate, and biodiversity transitions across Latin America and the Caribbean. The course is delivered in both in-person and virtual formats.</narrative>
    </description>
    <baseline value="0" year="2025"></baseline>
    <period>
     <period-start iso-date="2025-01-01"></period-start>
     <period-end iso-date="2025-12-31"></period-end>
     <target value="30"></target>
    </period>
   </indicator>
  </result>
