  <result aggregation-status="1" type="1">
   <title>
    <narrative xml:lang="EN">Annual Output Results</narrative>
   </title>
   <indicator ascending="0" measure="5">
    <title>
     <narrative xml:lang="EN">Output Indicator</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">-	Number of new and improved finance mechanisms in place and/or operational with increased finance aligned towards biodiversity 
-	Number of policy proposals influenced by new data on biodiversity finance, economic valuation and natural capital accounting
-	Amount of funds catalyzed through the implementation of finance mechanisms (mobilized, realigned, delivered more effectively, and/or through cost avoidance);  
-	Number of government officials and experts with enhanced skills to design, implement and advocate for biodiversity finance solutions (disaggregated by gender)</narrative>
    </description>
    <baseline year="2018">
     <comment>
      <narrative xml:lang="EN">BIOFIN Phase II will continue to build on the results achieved in Phase I: 
-	The BIOFIN Methodology is tested and available with guidance, case studies and lessons learned in BIOFIN Phase I; 
-	BIOFIN assessments are in place in 30 countries providing information, analysis and recommendations on the existing policies and institutions, biodiversity expenditure and financial gap data along with the prioritized financial needs at country level; 
-	Biodiversity Finance Plans are in place in 30 countries providing a basis for the prioritization and implementation of finance solutions at country level; 
-	Global and Country teams are in place along with Steering Committees and Technical working groups at country level.
In Costa Rica
- Biodiversity financing gap was estimated at USD 25M annually
- Multiple but isolated efforts in Costa Rica for biodiversity finance.</narrative>
     </comment>
    </baseline>
    <period>
     <period-start iso-date="2020-01-01"></period-start>
     <period-end iso-date="2020-12-31"></period-end>
     <target>
      <comment>
       <narrative xml:lang="EN">5 MoUs signed for mobilization of resources and 25 M USD secured funding.</narrative>
      </comment>
     </target>
     <actual>
      <comment>
       <narrative xml:lang="EN">7 MoUs signed for mobilization of resources and $84,907,700.00 M USD mobilized funding. New BIOFIN practitioners for 2020 include 316 men, and 341 women in national capacity development activities and efforts.</narrative>
      </comment>
     </actual>
    </period>
    <period>
     <period-start iso-date="2021-01-01"></period-start>
     <period-end iso-date="2021-12-31"></period-end>
     <target>
      <comment>
       <narrative xml:lang="EN">5 MoUs signed for mobilization of resources and 25M USD mobilized funding. *MoUs include (MINAE-draft, SBD, Private Sector Co., Green-Sustainable Bond, 2 Achademic Institutions)</narrative>
      </comment>
     </target>
     <actual>
      <comment>
       <narrative xml:lang="EN">Crowdfunding campaign raises over US$ 1 million</narrative>
      </comment>
     </actual>
    </period>
   </indicator>
  </result>
