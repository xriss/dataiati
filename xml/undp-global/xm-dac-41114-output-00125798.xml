   <indicator ascending="0" measure="5">
    <title>
     <narrative xml:lang="EN">Output Indicator</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">Number of Inclusive, gender responsive, REDD+ policies and measures implemented by targeted REDD+ countries</narrative>
    </description>
    <baseline year="2021">
     <comment>
      <narrative xml:lang="EN">In 2021, UN-REDD started a new strategic framework, with a focus on assisting countries realise, finance and enhance forest solutions to the climate emergency. An inception exercise provided the basis for annual planning.</narrative>
     </comment>
    </baseline>
    <period>
     <period-start iso-date="2021-01-01"></period-start>
     <period-end iso-date="2021-12-31"></period-end>
     <target>
      <comment>
       <narrative xml:lang="EN">Four UN-REDD partner countries implement inclusive, gender responsive policies and measures to realise forest solutions.</narrative>
      </comment>
     </target>
