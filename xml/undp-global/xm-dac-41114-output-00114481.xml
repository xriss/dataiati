   <indicator ascending="0" measure="5">
    <title>
     <narrative xml:lang="EN">Output Indicator</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">2.1 # of peer-learning events successfully conducted 
2.2  # of participants in the MLP</narrative>
    </description>
    <baseline year="2019">
     <comment>
      <narrative xml:lang="EN">2.1. MLP piloted during phase 1 of the project with 2 peer-learning events
2.2. Delegations of 2 or 3 representatives per country/territory have participated in previous peer-learning exchanges</narrative>
     </comment>
    </baseline>
    <period>
     <period-start iso-date="2020-01-01"></period-start>
     <period-end iso-date="2020-12-31"></period-end>
     <target>
      <comment>
       <narrative xml:lang="EN">1.1.3 mutual learning events organized
1.2. 80</narrative>
      </comment>
     </target>
     <actual>
      <comment>
       <narrative xml:lang="EN">1.1. Due to COVID-19 related restrictions the peer-learning events on monitoring of ALMPs; evaluation of PES Performance and use of IT tools in PES Work have been postponed. As part of the preparation of the mutual learning events i) 6 technical briefs and 6 guidance notes prepared for participants; ii) 32 national reports from participating countries received, analyzed and peer reviewed; iii) 5 EU PES representatives shared experience and guidance (Portugal, Ireland, France, Romania, Slovenia); iv) 3 workshops held and v) 3 detailed technical reports with over 50 recommendations and steps forward for participating institutions designed and confirmed by PESs; vi) 6 sets of recommendations from Participatory Inclusiveness Assessment (phase 1) validated and vii) 10 request for technical assistance stemming from recommendations submitted by the ministries in charge for labour and PES. 
1.2. Mutual learning events have been postponed to 2021</narrative>
      </comment>
     </actual>
    </period>
    <period>
     <period-start iso-date="2021-01-01"></period-start>
     <period-end iso-date="2021-12-31"></period-end>
     <target>
      <comment>
       <narrative xml:lang="EN">2.1. 7 mutual learning programmes
2.2. 200 participants</narrative>
      </comment>
     </target>
    </period>
   </indicator>
  </result>
