   <indicator aggregation-status="0" ascending="0" measure="5">
    <title>
     <narrative xml:lang="EN">Level of regional cooperation and dialogue on climate change and resilience building</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">Improved cooperation and resilience of the local and regional stakeholders to threats and risks posed by climate change</narrative>
    </description>
    <baseline year="2021">
     <comment>
      <narrative xml:lang="EN">Level 1</narrative>
     </comment>
    </baseline>
    <period>
     <period-start iso-date="2023-01-01"></period-start>
     <period-end iso-date="2023-12-31"></period-end>
     <target>
      <comment>
       <narrative xml:lang="EN">Level 2</narrative>
      </comment>
     </target>
     <actual>
      <comment>
       <narrative xml:lang="EN">A regional-climate change dialogue was created and operationalized through engaging with national governments and regional intergovernmental institutions, which are active in the beneficiary countries. Series of high-level regional conferences and intra-country awareness-raising events have been conducted to build understanding and awareness of links between climate-fragility risks, socio-economic development, and gender issues and corresponding adaptation measures. Furthermore, series of webinars were organized to promote a regional knowledge sharing and management platform between civil servants, academia and the scientific community from Kyrgyzstan, Tajikistan, and Uzbekistan.
In total of 30 events were organized by the Project, engaging, 1786 people (780 women; 1006 men) through a series of workshops, webinars and meetings conducted both at national and regional levels.</narrative>
      </comment>
     </actual>
    </period>
   </indicator>
