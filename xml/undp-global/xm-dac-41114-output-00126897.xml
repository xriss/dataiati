   <indicator ascending="0" measure="5">
    <title>
     <narrative xml:lang="EN">Output Indicator</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">Advanced evidence based, effective and feasible legislative and/or regulatory measures for the 5 main NCDs risk factors. By end 2022.

Advanced whole-of-government and whole-of-society response to NCDs including stewardship and accountability. By end 2022.</narrative>
    </description>
    <baseline year="2021">
     <comment>
      <narrative xml:lang="EN">NCDs place a significant health and development burden on Fiji. Fiji requires urgent support in national governance and financing to address NCDs, including through prevention and in the context of COVID-19.</narrative>
     </comment>
    </baseline>
    <period>
     <period-start iso-date="2021-01-01"></period-start>
     <period-end iso-date="2021-12-31"></period-end>
     <target>
      <comment>
       <narrative xml:lang="EN">Complete legal environment assessment on NCDs
Initiate investment case on NCDs
Parliamentary briefings on NCDs
Initiate NCD budget analysis</narrative>
      </comment>
     </target>
     <actual>
      <comment>
       <narrative xml:lang="EN">LEA first draft completed (October)
Investment case data collection completed and first draft developed 
Budget analysis process agreed and initiated
Parliamentary briefings awaiting finalization of investment case and LEA.</narrative>
      </comment>
     </actual>
    </period>
    <period>
     <period-start iso-date="2022-01-01"></period-start>
     <period-end iso-date="2022-12-31"></period-end>
     <target>
      <comment>
       <narrative xml:lang="EN">Complete NCD Strategy
Support consultations for NCD strategy
Complete costing of NCD strategy</narrative>
      </comment>
     </target>
    </period>
