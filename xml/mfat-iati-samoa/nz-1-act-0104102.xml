   <narrative xml:lang="EN">New Zealand Ministry of Foreign Affairs and Trade</narrative>
  </reporting-org>
  <title>
   <narrative xml:lang="EN">Samoa Individual Short Term Training Scholarships Allocations for 24-27 Triennium</narrative>
  </title>
  <description type="1">
   <narrative xml:lang="EN">This Activity aims to increase the knowledge and skills of individuals so that they can contribute to the development of&#xa0;Samoa, and to positively impact the bilateral relationship by providing short term scholarships (for no less than one week up to a maximum of 12 months in length) to scholars from Samoa. These short-term scholarships can take the form of vocational training, an apprenticeship, or other workplace experience.</narrative>
  </description>
