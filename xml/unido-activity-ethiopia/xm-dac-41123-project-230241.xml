  <iati-identifier>XM-DAC-41123-PROJECT-230241</iati-identifier>
  <reporting-org ref="XM-DAC-41123" type="40">
   <narrative xml:lang="EN">United Nations Industrial Development Organization</narrative>
  </reporting-org>
  <title>
   <narrative xml:lang="EN">Promoting adaptation and resilience through innovation and entrepreneurship for green jobs and livelihood improvement in Ethiopia</narrative>
  </title>
  <description type="1">
   <narrative xml:lang="EN">The overall objective of the project is to build resilience and adaptive capacities of vulnerable communities in southeastern and southern Ethiopia through the promotion of climate-resilient agro-pastoral productive practices, emergency preparedness and innovative business models for value addition and employment along the agro-pastoral and non-wood forestry products value chains. The project will have three main components Component 1: 1. Institutional capacity building and enabling environment Component 2. Implementation of climate-resilient primary processing and value addition practices in target areas Component 3. Partnerships, knowledge management, communication and coordination</narrative>
  </description>
