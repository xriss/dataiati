  <result aggregation-status="1" type="1">
   <title>
    <narrative xml:lang="EN">Annual Output Results</narrative>
   </title>
   <indicator aggregation-status="1" ascending="0" measure="1">
    <title>
     <narrative xml:lang="EN">Number of digital CRVS-related guidelines or policies developed to promote people-centric and inclusive practices within targeted institutions.</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">A higher number indicates progress in institutionalizing inclusive digital CRVS practices. A low number suggests that reforms may remain informal or fragmented.</narrative>
    </description>
    <baseline value="0" year="2024"></baseline>
    <period>
     <period-start iso-date="2026-01-01"></period-start>
     <period-end iso-date="2026-12-31"></period-end>
     <target value="1"></target>
    </period>
   </indicator>
   <indicator aggregation-status="1" ascending="0" measure="1">
    <title>
     <narrative xml:lang="EN">Digitally strengthened CRVS systems in place (including disability-friendly access).</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">A &#x201c;Yes&#x201d; indicates that the JP has successfully delivered a functioning, inclusive digital CRVS system, a cornerstone for achieving SDG 16.9, 16.10 and 17.18.  
A &#x201c;No&#x201d; at end of programme indicates significant implementation gaps and would be a red flag in final evaluation.</narrative>
    </description>
    <baseline value="0" year="2024"></baseline>
    <period>
     <period-start iso-date="2026-01-01"></period-start>
     <period-end iso-date="2026-12-31"></period-end>
     <target value="1"></target>
    </period>
   </indicator>
   <indicator aggregation-status="1" ascending="0" measure="1">
    <title>
     <narrative xml:lang="EN">The population registry incorporates design principles agreed by programme design group (Yes/No)</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">Ensuring that the registry design adheres to agreed principles is critical for sustainability, usability, and rights&#x2011;based digital governance. A &#x201c;Yes&#x201d; signifies that upstream governance of the system was robust and participatory.</narrative>
    </description>
    <baseline value="0" year="2024"></baseline>
    <period>
     <period-start iso-date="2026-01-01"></period-start>
     <period-end iso-date="2026-12-31"></period-end>
     <target value="1"></target>
    </period>
   </indicator>
   <indicator aggregation-status="1" ascending="0" measure="1">
    <title>
     <narrative xml:lang="EN">Number of RGD personnel trained on digital registration systems and inclusive service delivery protocols.</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">High values indicate broad capacity-building coverage, foundational for behaviour change and quality service delivery.</narrative>
    </description>
    <baseline value="0" year="2024"></baseline>
    <period>
     <period-start iso-date="2026-01-01"></period-start>
     <period-end iso-date="2026-12-31"></period-end>
     <target value="1250"></target>
    </period>
   </indicator>
   <indicator aggregation-status="1" ascending="0" measure="2">
    <title>
     <narrative xml:lang="EN">Percentage reduction in marriage registration times.</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">Improved marriage registration efficiency contributes to legal protection and clearer civil status records, which can affect property rights, social entitlements, and gender equality.</narrative>
    </description>
    <baseline value="0" year="2024"></baseline>
    <period>
     <period-start iso-date="2026-01-01"></period-start>
     <period-end iso-date="2026-12-31"></period-end>
     <target value="0"></target>
    </period>
   </indicator>
   <indicator aggregation-status="1" ascending="0" measure="1">
    <title>
     <narrative xml:lang="EN">Number of key government agencies adopting the interoperable system.</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">Interoperability is a cornerstone of &#x201c;whole-of-government&#x201d; digital governance. A higher number of adopting agencies indicates stronger institutional buy-in and the potential for joined&#x2011;up service delivery and data use for SDG monitoring. A low number suggests barriers in governance, trust, or technical readiness.</narrative>
    </description>
    <baseline value="0" year="2024"></baseline>
    <period>
     <period-start iso-date="2026-01-01"></period-start>
     <period-end iso-date="2026-12-31"></period-end>
     <target value="0"></target>
    </period>
   </indicator>
   <indicator aggregation-status="1" ascending="0" measure="1">
    <title>
     <narrative xml:lang="EN">Number of mass media campaigns (radio, TV, social media) launched to raise awareness on digital CRVS services.</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">Mass media campaigns amplify key messages and can significantly increase awareness and demand for digital CRVS services. The number of campaigns indicates communication intensity and continuity.</narrative>
    </description>
    <baseline value="0" year="2024"></baseline>
    <period>
     <period-start iso-date="2026-01-01"></period-start>
     <period-end iso-date="2026-12-31"></period-end>
     <target value="2"></target>
    </period>
   </indicator>
   <indicator aggregation-status="1" ascending="0" measure="2">
    <title>
     <narrative xml:lang="EN">Percentage reduction in death registration times.</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">More timely death registration improves data quality for mortality statistics and supports families in accessing related benefits (inheritance, pensions). A significant reduction suggests that process re&#x2011;engineering is effective.</narrative>
    </description>
    <baseline value="0" year="2024"></baseline>
    <period>
     <period-start iso-date="2026-01-01"></period-start>
     <period-end iso-date="2026-12-31"></period-end>
     <target value="0"></target>
    </period>
   </indicator>
   <indicator aggregation-status="1" ascending="0" measure="1">
    <title>
     <narrative xml:lang="EN">Number of local media partners engaged in communications and advocacy efforts to promote digital CRVS awareness.</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">Partnerships with media organizations can increase sustainability and localization of CRVS messaging, embedding it in regular content and local narratives rather than short&#x2011;term campaigns alone.</narrative>
    </description>
    <baseline value="0" year="2024"></baseline>
    <period>
     <period-start iso-date="2026-01-01"></period-start>
     <period-end iso-date="2026-12-31"></period-end>
     <target value="1"></target>
    </period>
   </indicator>
   <indicator aggregation-status="1" ascending="0" measure="2">
    <title>
     <narrative xml:lang="EN">Percentage reduction in birth registration times.</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">Shorter registration times mean more timely access to legal identity and services, especially for vulnerable families, and indicate improved efficiency and responsiveness of state institutions.</narrative>
    </description>
    <baseline value="0" year="2024"></baseline>
    <period>
     <period-start iso-date="2026-01-01"></period-start>
     <period-end iso-date="2026-12-31"></period-end>
     <target value="0"></target>
    </period>
   </indicator>
   <indicator aggregation-status="1" ascending="0" measure="1">
    <title>
     <narrative xml:lang="EN">A CRVS-related disability access audit report with recommendations handed over as inputs for policy reforms.</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">The audit creates an evidence base for making CRVS services more inclusive. Its completion and handover is a precondition for systemic changes in policy and practice.</narrative>
    </description>
    <baseline value="0" year="2024"></baseline>
    <period>
     <period-start iso-date="2026-01-01"></period-start>
     <period-end iso-date="2026-12-31"></period-end>
     <target value="1"></target>
    </period>
   </indicator>
   <indicator aggregation-status="1" ascending="0" measure="1">
    <title>
     <narrative xml:lang="EN">Number of digital national birth, death, marriage, and divorce certificates issued across select divisions.</narrative>
    </title>
    <description>
     <narrative xml:lang="EN">This indicator captures actual adoption and use of the digital system by citizens. Rising numbers (especially when compared with total registrations) suggest successful uptake and trust in digital CRVS services.</narrative>
    </description>
