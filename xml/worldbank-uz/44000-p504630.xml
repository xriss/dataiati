  <title xml:lang="EN">
   <narrative xml:lang="EN">Electricity Distribution Improvement and Strengthening through Commercialization and Transformation</narrative>
  </title>
  <description type="1" xml:lang="EN">
   <narrative xml:lang="EN">The proposed Program will help improve efficiency and reliability of electricity supply and support integration of distributed renewable energy through investments in digital technologies and low voltage electricity distribution network.</narrative>
  </description>
  <description type="2" xml:lang="EN">
   <narrative xml:lang="EN">To enable the integration of increased renewable energy capacity into the power distribution network and improve the financial sustainability of the power distribution company</narrative>
  </description>
