  <title xml:lang="EN">
   <narrative xml:lang="EN">Advancing Uzbekistan&apos;s Economic and Social Transformation Development Policy Operation</narrative>
  </title>
  <description type="2" xml:lang="EN">
   <narrative xml:lang="EN">To support Uzbekistan&apos;s transition to an inclusive and private-sector led market economy through (a) strengthening market institutions and the environment for private sector growth; (b) improving state-owned enterprise management; and (c) increasing social inclusion and resilience.</narrative>
